        background: transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-family: inherit;
    }

        .login-logo-button:disabled {
            cursor: default;
            opacity: 0.65;
        }

    .login-logo-left {
        width: 20px;
        height: 20px;
        object-fit: contain;
        margin-top: -9px;
    }

    .login-logo-wordmark {
        font-family: 'SF Pro Display', 'Arial', sans-serif;
        font-weight: 650;
        font-size: 24px;
        color: #1f2951;
        text-transform: none;
        display: inline-flex;
        align-items: center;
    }

    .login-logo-accent {
        color: #ffa900;
        font-weight: 650;
        display: inline-flex;
        align-items: center;
    }

    .login-logo-m3 {
        width: 30px;
        margin-left: 3px;
        margin-right: 3px;
        margin-bottom: 3px;
