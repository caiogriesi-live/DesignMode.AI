</style>

<script src="https://accounts.google.com/gsi/client" async defer></script>

<script>
    window.loginGoogle = window.loginGoogle || (function () {
        "use strict";

        let dotNetHelper = null;
        let clientId = "";
        let renderRetryTimer = null;
        let resizeTimer = null;
        let lastRenderedWidth = 0;
        let initialized = false;

        function getHost() {
            return document.getElementById("loginGoogleButton");
        }

        function getSafeButtonWidth() {
            const host = getHost();

            if (!host) {
                return 320;
            }

            const rect = host.getBoundingClientRect();
            const availableWidth = Math.floor(rect.width || 320);

            /*
                Leave a small gutter for borders, sub-pixel rounding,
                mobile zoom, and device-pixel-ratio differences.
            */
            const safeWidth = Math.floor(availableWidth - 6);

            return Math.max(120, Math.min(400, safeWidth));
        }

        function render(forceRender) {
            const host = getHost();

            if (!host || !clientId) {
                return;
            }

            if (!window.google || !google.accounts || !google.accounts.id) {
                if (renderRetryTimer) {
                    clearTimeout(renderRetryTimer);
                }

                renderRetryTimer = setTimeout(function () {
                    render(forceRender);
                }, 250);

                return;
            }

            const width = getSafeButtonWidth();

            if (
                initialized &&
                !forceRender &&
                Math.abs(width - lastRenderedWidth) < 2
            ) {
                return;
            }

            try {
                google.accounts.id.initialize({
                    client_id: clientId,
                    callback: handleCredentialResponse,
                    ux_mode: "popup",
                    auto_select: false,
                    cancel_on_tap_outside: false
                });

                host.innerHTML = "";

                google.accounts.id.renderButton(
                    host,
                    {
                        type: "standard",
                        theme: "outline",
                        size: "large",
                        text: "continue_with",
                        shape: "pill",
                        logo_alignment: "left",
                        width: width
                    }
                );

                initialized = true;
                lastRenderedWidth = width;
            }
            catch (error) {
                console.error("Unable to initialize Google Identity Services:", error);
            }
        }

        async function handleCredentialResponse(response) {
            const idToken = response && response.credential;

            if (!idToken || !dotNetHelper) {
                return;
            }

            try {
                await dotNetHelper.invokeMethodAsync(
                    "CompleteGoogleLogin",
                    idToken
                );
            }
            catch (error) {
                console.error("Google login failed:", error);
            }
        }

        function scheduleResize() {
            if (resizeTimer) {
                clearTimeout(resizeTimer);
            }

            resizeTimer = setTimeout(function () {
                resizeTimer = null;
                render(true);
            }, 120);
        }

        window.addEventListener("resize", scheduleResize);
        window.addEventListener("orientationchange", scheduleResize);

        return {
            initialize: function (helper, configuredClientId) {
                dotNetHelper = helper;
                clientId = (configuredClientId || "").trim();

                requestAnimationFrame(function () {
                    render(true);
                });
            },

            setDisabled: function (disabled) {
                const wrap = document.querySelector(".login-google-wrap");

                if (wrap) {
                    wrap.classList.toggle("is-disabled", !!disabled);
                }
            },

            rerender: function () {
                requestAnimationFrame(function () {
                    render(true);
                });
            }
        };
    })();
</script>

@code {
    private const string GoogleClientId =
        "920601965266-dio1oduk6jek0jnlti1t8nbgsnb5a7g9.apps.googleusercontent.com";

    private string username = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;
    private string curPath = string.Empty;

    private bool isLoggingIn = false;
    private bool isGoogleLoggingIn = false;

    private DotNetObjectReference<object>? _googleDotNetHelper;
    private bool _googleInitialized = false;

    private InviteClientData InviteData { get; set; } = new InviteClientData();

    // Get FULL URL (includes query string)
    private string GetCurrentPath()
    {
        return Nav.Uri;
    }

    protected override async Task OnInitializedAsync()
    {
        isLoggingIn = false;
        isGoogleLoggingIn = false;
        errorMessage = string.Empty;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var authenticatedEmail =
                authState.User.FindFirst("email")?.Value
                ?? authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? authState.User.Identity?.Name
                ?? string.Empty;

            if (!string.IsNullOrWhiteSpace(authenticatedEmail))
            {
                await RedirectLoggedInUser(authenticatedEmail);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_googleInitialized)
        {
            _googleInitialized = true;
            _googleDotNetHelper = DotNetObjectReference.Create<object>(this);

            try
            {
                await JS.InvokeVoidAsync(
                    "loginGoogle.initialize",
                    _googleDotNetHelper,
                    GoogleClientId);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Google button initialization error: {ex.Message}");
            }
        }
    }

    private async Task HandleLogin()
    {
        if (isLoggingIn)
            return;

        isLoggingIn = true;
        isGoogleLoggingIn = false;
        errorMessage = string.Empty;
        curPath = GetCurrentPath();

        StateHasChanged();
        await SetGoogleDisabled(true);

        try
        {
            if (string.IsNullOrWhiteSpace(username) ||
                string.IsNullOrWhiteSpace(password))
            {
                errorMessage = "Email and password are required.";
                await StopLoggingIn();
                return;
            }

            username = username.Trim();

            var success = await Auth.Login(
                username,
                password,
                ApiConfig.ApiBaseUrl);

            if (!success)
            {
                errorMessage = "Invalid credentials.";
                await StopLoggingIn();
                return;
            }

            await SavePending.SavePendingIdeasAfterLogin(ApiConfig.ApiBaseUrl);
            await SavePending.SavePendingCompanyInfoAfterLogin(ApiConfig.ApiBaseUrl);

            await RedirectLoggedInUser(username);
        }
        catch (Exception ex)
        {
            errorMessage = $"Login error: {ex.Message}";
            await StopLoggingIn();
        }
    }

    [JSInvokable]
    public async Task CompleteGoogleLogin(string idToken)
    {
        if (isLoggingIn)
            return;

        isLoggingIn = true;
        isGoogleLoggingIn = true;
        errorMessage = string.Empty;

        await InvokeAsync(StateHasChanged);
        await SetGoogleDisabled(true);

        try
        {
            if (string.IsNullOrWhiteSpace(idToken))
            {
                errorMessage = "Google did not return a valid sign-in token.";
                await StopLoggingIn();
                return;
            }

            var success = await Auth.LoginWithGoogle(
                idToken,
                ApiConfig.ApiBaseUrl);

            if (!success)
            {
                errorMessage = "Google login failed. Please try again.";
                await StopLoggingIn();
                return;
            }

            await SavePending.SavePendingIdeasAfterLogin(ApiConfig.ApiBaseUrl);
            await SavePending.SavePendingCompanyInfoAfterLogin(ApiConfig.ApiBaseUrl);

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();

            if (authState.User.Identity?.IsAuthenticated != true)
            {
                errorMessage =
                    "Google login succeeded, but the authenticated session is not ready.";
                await StopLoggingIn();
                return;
            }

            var authenticatedEmail =
                authState.User.FindFirst("email")?.Value
                ?? authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? authState.User.Identity?.Name
                ?? string.Empty;

            if (string.IsNullOrWhiteSpace(authenticatedEmail))
            {
                errorMessage =
                    "Google login succeeded, but we could not determine your account email.";
                await StopLoggingIn();
                return;
            }

            await RedirectLoggedInUser(authenticatedEmail.Trim());
        }
        catch (Exception ex)
        {
            errorMessage = $"Google login error: {ex.Message}";
            await StopLoggingIn();
        }
    }

    private async Task StopLoggingIn()
    {
        isLoggingIn = false;
        isGoogleLoggingIn = false;

        await InvokeAsync(StateHasChanged);
        await SetGoogleDisabled(false);

        try
        {
            await JS.InvokeVoidAsync("loginGoogle.rerender");
        }
        catch
        {
            // Ignore a Google button re-render failure; email login still works.
        }
    }

    private async Task SetGoogleDisabled(bool disabled)
    {
        try
        {
            await JS.InvokeVoidAsync("loginGoogle.setDisabled", disabled);
        }
        catch
        {
            // Google may still be loading.
        }
    }

    private Task RedirectLoggedInUser(string email) => PostAuthNavigation.NavigateAsync();

    private async Task<string?> CheckUserOnboarded(string usernameValue, string url)
    {
        try
        {
            using HttpClient client = new HttpClient();

            string functionUrl =
                $"{url}api/CheckUserOnboarded?username={Uri.EscapeDataString(usernameValue)}&code=REDACTED_FOR_GROOMING";

            var response = await client.GetAsync(functionUrl);

            if (!response.IsSuccessStatusCode)
                return null;

            var result =
                await response.Content.ReadFromJsonAsync<CheckUserOnboardedResponse>();

            return result?.Onboarded;
        }
        catch
        {
            return null;
        }
    }

    public class CheckUserOnboardedResponse
    {
        public bool Success { get; set; }
        public string? Username { get; set; }
        public string? UserId { get; set; }
        public string? Onboarded { get; set; }
    }

    private string EncryptEmail(string email)
    {
        if (string.IsNullOrEmpty(email))
            return "";

        try
        {
            var bytes = Encoding.UTF8.GetBytes(email);
            return Convert.ToBase64String(bytes);
        }
        catch
        {
            return "";
        }
    }

    private async Task<InviteClientData?> GetInviteClientByEmail(string email)
    {
        try
        {
            using var client = new HttpClient();

            var requestBody = new
            {
                email = email
            };

            var json =
                System.Text.Json.JsonSerializer.Serialize(requestBody);

            var content =
                new StringContent(json, Encoding.UTF8, "application/json");

            var response = await client.PostAsync(
                $"{ApiConfig.ApiBaseUrl}api/GetInviteClientByEmail?code=REDACTED_FOR_GROOMING",
                content);

            if (response.IsSuccessStatusCode)
            {
                var responseContent =
                    await response.Content.ReadAsStringAsync();

                using var document =
                    System.Text.Json.JsonDocument.Parse(responseContent);

                var root = document.RootElement;

                if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    var firstItem = root;

                    string? GetStringValue(
                        System.Text.Json.JsonElement element,
                        string propertyName)
                    {
                        if (element.TryGetProperty(propertyName, out var property))
                        {
                            return ExtractValue(property);
                        }

                        foreach (var prop in element.EnumerateObject())
                        {
                            if (prop.Name.Equals(
                                propertyName,
                                StringComparison.OrdinalIgnoreCase))
                            {
                                return ExtractValue(prop.Value);
                            }
                        }

                        return null;
                    }

                    string? ExtractValue(
                        System.Text.Json.JsonElement property)
                    {
                        if (property.ValueKind ==
                            System.Text.Json.JsonValueKind.Object)
                        {
                            if (property.TryGetProperty(
                                "s",
                                out var stringValue))
                            {
                                return stringValue.GetString();
                            }

                            if (property.TryGetProperty(
                                "S",
                                out var stringValueUpper))
                            {
                                return stringValueUpper.GetString();
                            }

                            if (property.TryGetProperty(
                                "BOOL",
                                out var boolValue))
                            {
                                return boolValue.GetBoolean().ToString();
                            }

                            if (property.TryGetProperty(
                                "bool",
                                out var boolValueLower))
                            {
                                return boolValueLower.GetBoolean().ToString();
                            }

                            if (property.TryGetProperty(
                                "N",
                                out var numberValue))
                            {
                                return numberValue.GetString();
                            }

                            if (property.TryGetProperty(
                                "n",
                                out var numberValueLower))
                            {
                                return numberValueLower.GetString();
                            }
                        }
                        else if (
                            property.ValueKind ==
                            System.Text.Json.JsonValueKind.String)
                        {
                            return property.GetString();
                        }
                        else if (
                            property.ValueKind ==
                                System.Text.Json.JsonValueKind.True ||
                            property.ValueKind ==
                                System.Text.Json.JsonValueKind.False)
                        {
                            return property.GetBoolean().ToString();
                        }
                        else if (
                            property.ValueKind ==
                            System.Text.Json.JsonValueKind.Number)
                        {
                            return property.ToString();
                        }

                        return null;
                    }

                    return new InviteClientData
                        {
                            Id = GetStringValue(firstItem, "Id"),
                            Name = GetStringValue(firstItem, "Name"),
                            Industry = GetStringValue(firstItem, "Industry"),
                            Prompt = GetStringValue(firstItem, "Prompt"),
                            Email = GetStringValue(firstItem, "Email"),
                            ImagePath =
                                GetStringValue(firstItem, "ImagePath")
                                ?? GetStringValue(firstItem, "Imagepath"),
                            UseSameImageSeedForAll =
                                GetBoolValue(
                                    firstItem,
                                    "UseSameImageSeedForAll"),
                            ImageId = GetStringValue(firstItem, "ImageId"),
                            TimeStamp =
                                GetStringValue(firstItem, "Timestamp")
                                ?? GetStringValue(firstItem, "TimeStamp")
                        };
                }
            }

            if (response.StatusCode ==
                System.Net.HttpStatusCode.NotFound)
            {
                return null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Exception getting invite client: {ex.Message}");
        }

        return null;
    }

    private bool GetBoolValue(
        System.Text.Json.JsonElement element,
        string propertyName)
    {
        if (element.TryGetProperty(propertyName, out var property))
        {
            return ExtractBoolValue(property);
        }

        foreach (var prop in element.EnumerateObject())
        {
            if (prop.Name.Equals(
                propertyName,
                StringComparison.OrdinalIgnoreCase))
            {
                return ExtractBoolValue(prop.Value);
            }
        }

        return false;
    }

    private bool ExtractBoolValue(
        System.Text.Json.JsonElement property)
    {
        if (property.ValueKind ==
            System.Text.Json.JsonValueKind.Object)
        {
            if (property.TryGetProperty("BOOL", out var boolValue))
            {
                return boolValue.GetBoolean();
            }

            if (property.TryGetProperty(
                "bool",
                out var boolValueLower))
            {
                return boolValueLower.GetBoolean();
            }
        }

        if (
            property.ValueKind ==
                System.Text.Json.JsonValueKind.True ||
            property.ValueKind ==
                System.Text.Json.JsonValueKind.False)
        {
            return property.GetBoolean();
        }

        if (property.ValueKind ==
            System.Text.Json.JsonValueKind.String)
        {
            if (bool.TryParse(
                property.GetString(),
                out bool result))
            {
                return result;
            }
        }

        return false;
    }

