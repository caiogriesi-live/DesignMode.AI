    private async Task<CheckSubscriptionResponse> CheckUserSubscription(
        string email,
        string url)
    {
        try
        {
            using HttpClient client = new HttpClient();

            string functionUrl =
                $"{url}api/CheckUserSubscription?email={Uri.EscapeDataString(email)}&code=REDACTED_FOR_GROOMING";

            var response = await client.GetAsync(functionUrl);

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();

                var result =
                    System.Text.Json.JsonSerializer.Deserialize<CheckSubscriptionResponse>(
                        json,
                        new System.Text.Json.JsonSerializerOptions
                            {
                                PropertyNameCaseInsensitive = true
                            });

                return result ?? new CheckSubscriptionResponse
                    {
                        Success = false,
                        HasSubscription = false
                    };
            }
        }
        catch
        {
            // Fall through to default result.
        }

        return new CheckSubscriptionResponse
            {
                Success = false,
                HasSubscription = false
            };
    }

    public class CheckSubscriptionResponse
    {
        public bool Success { get; set; }
        public string? Email { get; set; }
        public string? UserId { get; set; }
        public bool HasSubscription { get; set; }
        public int SubscriptionCount { get; set; }
        public List<SubscriptionDto>? Subscriptions { get; set; }
    }

