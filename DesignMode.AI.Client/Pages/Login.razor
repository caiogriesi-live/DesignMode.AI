                Google Identity Services renders an iframe at the exact pixel width
                passed to renderButton(). Do not stretch the iframe after rendering;
                doing so can clip the right side on narrow mobile screens.
            */
        .login-google-button > div {
            max-width: 100% !important;
            min-width: 0 !important;
            margin: 0 auto !important;
