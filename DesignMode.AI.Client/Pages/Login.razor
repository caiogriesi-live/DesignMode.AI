@page "/login"
@using DesignMode.AI.Shared.Security
@using DesignMode.AI.Client.Services
@using DesignMode.AI.Shared.Util
@using System.Text
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@inject AuthService Auth
@inject NavigationManager Nav
@inject PostAuthNavigationService PostAuthNavigation
@inject SavePending SavePending
@inject ApiConfigService ApiConfig
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<link href="assets/css/brief-landing.css" rel="stylesheet" />

<!--
    Google Identity Services.
    Keep this Client ID in sync with the working Google auth used elsewhere
    in the app. This must be an OAuth 2.0 "Web application" Client ID, and
    every deployed origin must be listed in Authorized JavaScript origins.
-->
<meta name="google-signin-client_id"
      content="920601965266-dio1oduk6jek0jnlti1t8nbgsnb5a7g9.apps.googleusercontent.com" />

<div class="login-page">
    <div class="login-background">

        <!-- Logo above the card -->
        <button type="button"
                class="login-logo-button"
                disabled="@isLoggingIn"
                @onclick="GoToHome"
                aria-label="Go to home">
            <img src="assets/img/logo-left.png"
                 class="login-logo-left"
                 alt="DesignMode logo" />

            <span class="login-logo-wordmark">
                design<span class="login-logo-accent">
                    <img src="images/logo-m3.svg"
                         class="login-logo-m3"
                         alt="" />
                </span>ode.ai
            </span>
        </button>

        <!-- Login card -->
        <div class="login-card">

            <h1 class="login-title" tabindex="-1">
                Log in
            </h1>

            <p class="login-subtitle">
                Transform plain-language ideas into designs and connect with creators.
            </p>

            <!-- Google login first -->
            <div class="login-google-wrap @(isLoggingIn ? "is-disabled" : "")">
                <div id="loginGoogleButton"
                     class="login-google-button"
                     aria-label="Continue with Google">
                </div>
            </div>

            <div class="login-divider" aria-hidden="true">
                <hr />
                <span>OR</span>
                <hr />
            </div>

            <!-- Standard login -->
            <div class="login-form">

                <input @bind="username"
                       type="email"
                       name="email"
                       autocomplete="username"
                       placeholder="Email Address"
                       disabled="@isLoggingIn"
                       class="login-input" />

                <input @bind="password"
                       type="password"
                       name="password"
                       autocomplete="current-password"
                       placeholder="Password"
                       disabled="@isLoggingIn"
                       class="login-input" />

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="login-error">
                        @errorMessage
                    </div>
                }

                <button @onclick="HandleLogin"
                        disabled="@isLoggingIn"
                        class="login-primary-button">
                    @if (isLoggingIn && !isGoogleLoggingIn)
                    {
                        <span>Logging in...</span>
                    }
                    else
                    {
                        <span>Continue</span>
                    }
                </button>

                <!-- Forgot password & Sign up links -->
                <div class="login-links-row">
                    <button type="button"
                            class="login-text-link"
                            disabled="@isLoggingIn"
                            @onclick="GoToForgot">
                        Forgot password?
                    </button>

                    <button type="button"
                            class="login-text-link"
                            disabled="@isLoggingIn"
                            @onclick="GoToSignup">
                        Sign up
                    </button>
                </div>

                <!-- Legal copy -->
                <div class="login-legal">
                    By continuing with Google or logging in, you agree to our
                    <a href="/terms.html"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="login-link">
                        Terms
                    </a>
                    and
                    <a href="/privacy.html"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="login-link">
                        Privacy Policy
                    </a>.
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    * {
        box-sizing: border-box;
    }

    html,
    body,
    #app {
        margin: 0;
        min-height: 100%;
    }

    .login-page {
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        overflow-y: auto;
        background: #f2f3f8;
    }

    .login-background {
        width: 100%;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 25px 18px 48px;
        background: url('images/header-bg.png') center calc(100% + 350px) / cover no-repeat, linear-gradient(180deg, #ffffff 2%, #CDE8EE 60%);
        animation: loginFadeIn 0.8s ease forwards;
    }

    @@keyframes loginFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
