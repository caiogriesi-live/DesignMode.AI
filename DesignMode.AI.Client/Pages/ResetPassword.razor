@page "/resetpassword"
@using DesignMode.AI.Shared.Security;
@using DesignMode.AI.Client.Services;
@using DesignMode.AI.Shared.Util;
@using Microsoft.AspNetCore.WebUtilities;
@inject AuthService Auth
@inject NavigationManager Nav
@inject SavePending SavePending
@inject ApiConfigService ApiConfig
@inject IJSRuntime JS

<link href="assets/css/brief-landing.css" rel="stylesheet" />

<div class="wrapper" style="overflow-x: auto; overflow-y: auto; width: 100%; height: 100vh;">
    <div class="page-header"
         style="background: url('images/header-bg.png') center calc(100% + 350px) no-repeat,
            linear-gradient(180deg, #Fff 2%, #CDE8EE 60%);
            background-size: cover;
            background-color: #f2f3f8;
            width: 100%;
            min-height: 100vh;
            overflow-y: auto;
            position: relative;
            animation: fadeInImage 1s ease-in forwards;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            align-items: center;
            padding-top: 25px;">

        <!-- Logo above the card -->
        <div class="logo-container text-center" style="margin-bottom: 20px;">
            <img src="assets/img/logo-left.png" width="26px" height="26px" class="navbar-brand-img h-100" alt="main_logo"
                 style="width: 20px; height: 20px; margin-top: -9px; object-fit: contain;">
            <span style="font-family: 'SF Pro Display','Arial'; font-weight: 650; font-size: 24px; color: #1f2951; text-transform: none;">
                design<span style="color: #ffa900; font-weight: 650;">
                    <img src="images/logo-m3.svg" style="
                            width: 30px;
                            margin-left: 3px;
                            margin-right: 3px;
                            margin-bottom: 3px;
                        ">
                </span>ode.ai
            </span>
        </div>

        <!-- Reset Password Card -->
        <div class="login-box text-center"
             style="background: white; padding: 40px; border-radius: 12px;
            box-shadow: 0px 4px 20px rgba(0,0,0,0.1); min-width: 320px; max-width: 400px;">

            @if (!isTokenValidated)
            {
                <!-- Validating token -->
                <div style="text-align: center;">
                    <div style="font-size: 48px; margin-bottom: 20px;">
                        ⏳
                    </div>
                    <h1 class="text-dark h1font" tabindex="-1" style="font-size: 28px; color: #1f2951 !important; margin-bottom:10px;">
                        Validating Link
                    </h1>
                    <p style="color:#5d5d5d;font-size:16px; margin-bottom:20px;font-weight: 400;">
                        Please wait while we validate your reset link...
                    </p>
                </div>
            }
            else if (isTokenValid && !isPasswordReset)
            {
                <!-- Show reset password form -->
                <h1 class="text-dark h1font" tabindex="-1" style="font-size: 28px; color: #1f2951 !important; margin-bottom:10px;">
                    Reset Password
                </h1>

                <p style="color:#5d5d5d;font-size:16px; margin-bottom:20px;font-weight: 400;">
                    Please enter your new password below.
                </p>

                <!-- New Password input -->
                <input type="password" @bind="newPassword" placeholder="New Password"
                       disabled="@isLoading"
                       style="
                          display:block;
                          margin:10px auto;
                          padding: 10px 12px 12px 15px;
                          width:100%;
                          border:1px solid #ccc;
                          border-radius:25px;
                          text-indent:10px;
                          @(isLoading ? "background-color:#f5f5f5;" : "")
                               " />

                <!-- Confirm Password input -->
                <input type="password" @bind="confirmPassword" placeholder="Confirm New Password"
                       disabled="@isLoading"
                       style="
                          display:block;
                          margin:10px auto;
                          padding: 10px 12px 12px 15px;
                          width:100%;
                          border:1px solid #ccc;
                          border-radius:25px;
                          text-indent:10px;
                          @(isLoading ? "background-color:#f5f5f5;" : "")
                               " />

                <!-- Password strength indicator -->
                @if (!string.IsNullOrEmpty(newPassword) && !isLoading)
                {
                    <div style="font-size: 12px; margin-top: 5px; text-align: left;">
                        Password strength:
                        <span style="color: @GetPasswordStrengthColor(newPassword)">
                            @GetPasswordStrengthText(newPassword)
                        </span>
                    </div>
                }

                <!-- Error message display -->
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div style="color: #dc3545; font-size: 14px; margin-top: 10px; margin-bottom: 10px;">
                        @errorMessage
                    </div>
                }

                <!-- Success message display -->
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div style="color: #28a745; font-size: 14px; margin-top: 10px; margin-bottom: 10px;">
                        @successMessage
                    </div>
                }

                <!-- Reset password button -->
                <button @onclick="HandleResetPassword"
                        disabled="@isLoading"
                        style="margin-top:15px; padding:12px; width:100%; border:none;
                               border-radius:25px; background:#244d88; color:#fff; font-weight:bold;
                               @(isLoading ? "opacity: 0.6; cursor: not-allowed;" : "")">
                    @if (isLoading)
                    {
                        <span>Resetting Password...</span>
                    }
                    else
                    {
                        <span>Reset Password</span>
                    }
                </button>

                <!-- Back to login link -->
                <div style="margin-top: 20px;">
                    <a @onclick="!isLoading ? GoToLogin : null"
                       style="color:#244d88; text-decoration:none; cursor:@(isLoading ? "not-allowed" : "pointer"); @(isLoading ? "opacity:0.5;" : "")">
                        ← Back to Log in
                    </a>
                </div>
            }
            else if (isTokenValid && isPasswordReset)
            {
                <!-- Success message after password reset -->
                <div style="text-align: center;">
                    <div style="font-size: 64px; margin-bottom: 20px;">
                        ✓
                    </div>
                    <h1 class="text-dark h1font" tabindex="-1" style="font-size: 28px; color: #1f2951 !important; margin-bottom:10px;">
                        Password Reset Successful!
                    </h1>
                    <p style="color:#5d5d5d;font-size:16px; margin-bottom:20px;font-weight: 400;">
                        Your password has been successfully reset.
                    </p>
                    <p style="color:#5d5d5d;font-size:14px; margin-bottom:30px;">
                        You can now log in with your new password.
                    </p>
                    <button @onclick="GoToLogin"
                            style="margin-top:15px; padding:12px; width:100%; border:none;
                                   border-radius:25px; background:#244d88; color:#fff; font-weight:bold;">
                        Go to Log in
                    </button>
                </div>
            }
            else if (!isTokenValid && token != null)
            {
                <!-- Invalid/expired token error -->
                <div style="text-align: center;">
                    <div style="font-size: 64px; margin-bottom: 20px;">
                        ⚠️
                    </div>
                    <h1 class="text-dark h1font" tabindex="-1" style="font-size: 28px; color: #1f2951 !important; margin-bottom:10px;">
                        Invalid Reset Link
                    </h1>
                    <p style="color:#5d5d5d;font-size:16px; margin-bottom:20px;font-weight: 400;">
                        This password reset link is invalid or has expired.
                    </p>
                    <p style="color:#5d5d5d;font-size:14px; margin-bottom:30px;">
                        Please request a new password reset link.
                    </p>
                    <button @onclick="GoToForgotPassword"
                            style="margin-top:15px; padding:12px; width:100%; border:none;
                                   border-radius:25px; background:#244d88; color:#fff; font-weight:bold;">
                        Request New Reset Link
                    </button>
                </div>
            }

            <!-- Footer -->
            <div style="margin-top:20px; font-size:12px; color:#666;">
                <a href="/terms.html" target="_blank"
                   style="color:#666; text-decoration:none; margin-right:8px; @(isLoading ? "opacity:0.5; cursor:not-allowed; pointer-events:none;" : "")"
                   @onclick="!isLoading ? null : (Action)null">Terms of Use</a> |
                <a href="/privacy.html" target="_blank"
                   style="color:#666; text-decoration:none; margin-left:8px; @(isLoading ? "opacity:0.5; cursor:not-allowed; pointer-events:none;" : "")"
                   @onclick="!isLoading ? null : (Action)null">Privacy Policy</a>
            </div>
        </div>

    </div>
</div>

@code {
    private string? token = null;

    string newPassword = "";
    string confirmPassword = "";
    string errorMessage = "";
    string successMessage = "";
    bool isLoading = false;
    bool isTokenValidated = false;
    bool isTokenValid = false;
    bool isPasswordReset = false;

    protected override async Task OnInitializedAsync()
    {
        // Get token from query string
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var tokenValue))
        {
            token = tokenValue.FirstOrDefault();
        }

        await ValidateToken();
    }

    async Task ValidateToken()
    {
        if (string.IsNullOrEmpty(token))
        {
            // No token provided, redirect to forgot password page
            Nav.NavigateTo("/forgot", true);
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();
            // Validate the token with your API
            isTokenValid = await Auth.ValidateResetToken(token, ApiConfig.ApiBaseUrl);
            isTokenValidated = true;

            if (!isTokenValid)
            {
                errorMessage = "Invalid or expired reset token.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while validating your reset link.";
            Console.WriteLine($"Token validation error: {ex.Message}");
            isTokenValid = false;
            isTokenValidated = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    async Task HandleResetPassword()
    {
        if (isLoading) return;

        // Clear previous messages
        errorMessage = "";
        successMessage = "";
        StateHasChanged();

        // Validate passwords
        if (string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessage = "Please enter a new password.";
            return;
        }

        if (string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = "Please confirm your new password.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        // Validate password strength
        if (!IsPasswordStrong(newPassword))
        {
            errorMessage = "Password must be at least 8 characters and contain uppercase, lowercase, number, and special character.";
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            // Call your reset password API with token and new password
            var success = await Auth.ResetPassword(token, newPassword, ApiConfig.ApiBaseUrl);

            if (success)
            {
                isPasswordReset = true;
                successMessage = "Password reset successful!";
                newPassword = "";
                confirmPassword = "";
            }
            else
            {
                errorMessage = "Failed to reset password. Please try again or request a new reset link.";
                isLoading = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred. Please try again later.";
            Console.WriteLine($"Password reset error: {ex.Message}");
            isLoading = false;
            StateHasChanged();
        }
    }

    bool IsPasswordStrong(string password)
    {
        // At least 8 characters
        if (password.Length < 8) return false;

        // Contains uppercase letter
        if (!password.Any(char.IsUpper)) return false;

        // Contains lowercase letter
        if (!password.Any(char.IsLower)) return false;

        // Contains digit
        if (!password.Any(char.IsDigit)) return false;

        // Contains special character
        if (!password.Any(ch => !char.IsLetterOrDigit(ch))) return false;

        return true;
    }

    string GetPasswordStrengthColor(string password)
    {
        var strength = GetPasswordStrength(password);
        return strength switch
        {
            "Weak" => "#dc3545",
            "Medium" => "#ffc107",
            "Strong" => "#28a745",
            _ => "#6c757d"
        };
    }

    string GetPasswordStrengthText(string password)
    {
        return GetPasswordStrength(password);
    }

    string GetPasswordStrength(string password)
    {
        if (string.IsNullOrEmpty(password)) return "None";

        int score = 0;

        // Length check
        if (password.Length >= 8) score++;
        if (password.Length >= 12) score++;

        // Complexity checks
        if (password.Any(char.IsUpper)) score++;
        if (password.Any(char.IsLower)) score++;
        if (password.Any(char.IsDigit)) score++;
        if (password.Any(ch => !char.IsLetterOrDigit(ch))) score++;

        return score switch
        {
            <= 2 => "Weak",
            <= 4 => "Medium",
            _ => "Strong"
        };
    }

    void GoToLogin()
    {
        // if (!isLoading)
        // {
            Nav.NavigateTo("/login", true);
        //}
    }

    void GoToForgotPassword()
    {
        if (!isLoading)
        {
            Nav.NavigateTo("/forgot", true);
        }
    }
}