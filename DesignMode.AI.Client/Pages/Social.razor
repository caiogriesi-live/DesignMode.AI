@code {
    private string CompanyName { get; set; } = "";
    private string IndustrySearch { get; set; } = "";
    private string SelectedIndustry { get; set; } = "";
    private bool ShowIndustryOptions { get; set; } = false;
    private int SelectedIndex { get; set; } = -1;
    private bool IsLoading { get; set; } = false;

    private readonly List<string> Industries = new()
    {
        "Beauty",
        "Skincare",
        "Fashion",
        "Food & Beverage",
        "Technology",
        "SaaS",
        "Healthcare",
        "Real Estate",
        "Fitness",
        "Finance",
        "Ecommerce",
        "Wellness",
        "Education",
        "Coaching",
        "Consulting",
        "Restaurants",
        "Hospitality",
        "Travel",
        "Home Services",
        "Professional Services",
        "Retail",
        "Events",
        "Entertainment",
        "Nonprofit",
        "Other"
    };

    private IEnumerable<string> FilteredIndustries =>
        string.IsNullOrWhiteSpace(IndustrySearch)
            ? Industries.Take(6)
            : Industries
                .Where(i => i.Contains(IndustrySearch, StringComparison.OrdinalIgnoreCase))
                .Take(6);

    private void SelectIndustry(string industry)
    {
        SelectedIndustry = industry;
        IndustrySearch = industry;
        ShowIndustryOptions = false;
        SelectedIndex = -1;
    }

    public async Task SavePendingCompanyInfoWithLocalBeforeLogin(
        string url,
        string anonymousUserId)
    {
        const string localStorageKey = "unsaved_company_industry";

        if (!await _localStorage.ContainKeyAsync(localStorageKey))
            return;

        var pendingCompany = await _localStorage.GetItemAsync<CompanyIndustryRequestLocal>(localStorageKey);

        if (pendingCompany == null ||
            string.IsNullOrWhiteSpace(pendingCompany.Name) ||
            string.IsNullOrWhiteSpace(pendingCompany.Industry))
            return;

        pendingCompany.UserId = anonymousUserId;
        pendingCompany.Local = anonymousUserId;

        await _localStorage.SetItemAsync(localStorageKey, pendingCompany);

        var request = new CompanyIndustryLocalRequest
            {
                Name = pendingCompany.Name,
                Industry = pendingCompany.Industry,
                UserId = anonymousUserId,
                Local = anonymousUserId
            };

        string functionUrl = $"{url}api/SaveCompanyIndustryLocal?code=REDACTED_FOR_GROOMING";

        HttpClient client = new HttpClient();
        var response = await client.PostAsJsonAsync(functionUrl, request);

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"❌ Failed to save company info with local data: {error}");
            return;
        }
    }
    public class CompanyIndustryLocalRequest
    {
        public string Name { get; set; }
        public string Industry { get; set; }
        public string UserId { get; set; }
        public string Local { get; set; }
    }

    private void ToggleDropdown()
    {
        ShowIndustryOptions = !ShowIndustryOptions;
    }

    private void HandlePageClick()
    {
        // Close dropdown when clicking anywhere on the page
        if (ShowIndustryOptions)
        {
            ShowIndustryOptions = false;
            SelectedIndex = -1;
            StateHasChanged();
        }
    }

    private async void OnIndustryKeyDown(KeyboardEventArgs e)
    {
        var filtered = FilteredIndustries.ToList();

        if (e.Key == "ArrowDown")
        {
            await JS.InvokeVoidAsync("window.event.preventDefault");
            if (filtered.Any())
            {
                SelectedIndex = Math.Min(SelectedIndex + 1, filtered.Count - 1);
            }
            ShowIndustryOptions = true;
        }
        else if (e.Key == "ArrowUp")
        {
            await JS.InvokeVoidAsync("window.event.preventDefault");
            SelectedIndex = Math.Max(SelectedIndex - 1, -1);
            ShowIndustryOptions = true;
        }
        else if (e.Key == "Enter")
        {
            await JS.InvokeVoidAsync("window.event.preventDefault");
            if (SelectedIndex >= 0 && SelectedIndex < filtered.Count)
            {
                SelectIndustry(filtered[SelectedIndex]);
            }
            else if (filtered.Count == 1)
            {
                SelectIndustry(filtered[0]);
            }
            else if (!string.IsNullOrWhiteSpace(IndustrySearch))
            {
                // If no match found and user has typed something, use the typed value
                SelectedIndustry = IndustrySearch;
                ShowIndustryOptions = false;
                SelectedIndex = -1;
            }
        }
        else if (e.Key == "Escape")
        {
            ShowIndustryOptions = false;
            SelectedIndex = -1;
        }
        else if (e.Key == "Tab")
        {
            ShowIndustryOptions = false;
            SelectedIndex = -1;
        }
        else
        {
            // Any other key - show dropdown
            ShowIndustryOptions = true;
            SelectedIndex = -1;
        }
    }

    private async void OnOptionKeyDown(KeyboardEventArgs e, string industry)
    {
        if (e.Key == "Enter")
        {
            await JS.InvokeVoidAsync("window.event.preventDefault");
            SelectIndustry(industry);
        }
    }

    private bool isMobileMenuOpen = false;
    private ElementReference scrollContainer;
    private List<string> animatedElements = new();

    public class CompanyIndustryRequestLocal
    {
        public string Name { get; set; }
        public string Industry { get; set; }
        public string UserId { get; set; }
        public string Local { get; set; }
    }

    private async Task GoToInit()
    {
        var industry = !string.IsNullOrWhiteSpace(SelectedIndustry)
            ? SelectedIndustry
            : IndustrySearch;

        if (string.IsNullOrWhiteSpace(CompanyName) || string.IsNullOrWhiteSpace(industry))
            return;

        IsLoading = true;
        StateHasChanged();

        try
        {
            const string anonymousUserKey = "dm_anonymous_user_id";

            // Clear any previous anonymous user id
            await _localStorage.RemoveItemAsync(anonymousUserKey);

            // Generate a new anonymous user id
            var anonymousUserId = Guid.NewGuid().ToString("N");
            await _localStorage.SetItemAsync(anonymousUserKey, anonymousUserId);

            var pendingCompany = new CompanyIndustryRequestLocal
                {
                    Name = CompanyName,
                    Industry = industry,
                    UserId = anonymousUserId,
                    Local = anonymousUserId
                };

            await _localStorage.SetItemAsync("unsaved_company_industry", pendingCompany);

            await SavePendingCompanyInfoWithLocalBeforeLogin(
                ApiConfig.ApiBaseUrl,
                anonymousUserId
            );

            Nav.NavigateTo($"/designerintro?name={CompanyName}&industry={industry}&type=social", forceLoad: true, replace: true);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void GoToSignUp()
    {
        Nav.NavigateTo("/signup", forceLoad: true);
    }

    private void GoToLogIn()
    {
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private string Login { get; set; } = "";
    [Inject] AuthenticationStateProvider AuthStateProvider { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await UpdateLoginAsync();
    }

    private async Task UpdateLoginAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Login = authState.User.Identity.Name ?? "Logged In";
        }
        else
        {
            Login = "";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;

        Login = authState.User.Identity?.IsAuthenticated == true
            ? authState.User.Identity.Name ?? "Logged In"
            : "";

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;

        await JS.InvokeVoidAsync("eval", @"
            window.removeEventListener('scroll', window.checkScrollAnimations);
        ");
    }

    private async Task OnScroll()
    {
        var js = (IJSObjectReference)null;
        try
        {
            js = await JS.InvokeAsync<IJSObjectReference>("import", "./js/scroll-animations.js");
            await js.InvokeVoidAsync("checkScrollAnimations");
        }
        finally
        {
            if (js != null) await js.DisposeAsync();
        }
        StateHasChanged();
    }

    [Inject] IJSRuntime JS { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("eval", @"
                window.checkScrollAnimations = function() {
                    const elements = document.querySelectorAll('.animate-on-scroll');
                    elements.forEach(el => {
                        const rect = el.getBoundingClientRect();
                        const isVisible = rect.top < window.innerHeight - 100 && rect.bottom > 0;
                        if (isVisible && !el.classList.contains('animated')) {
                            el.classList.add('animated');
                            const animation = el.getAttribute('data-animation') || 'fadeInUp';
                            el.classList.add(animation);
                        }
                    });
                };
                window.addEventListener('scroll', checkScrollAnimations);
                window.checkScrollAnimations();
            ");
        }
    }
}

