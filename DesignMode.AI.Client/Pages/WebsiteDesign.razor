@code {

    private bool isMobileMenuOpen = false;
    private ElementReference scrollContainer;
    private List<string> animatedElements = new();

    private void GoToInit()
    {
        Nav.NavigateTo("/signup", forceLoad: true, replace: true);
    }

    private void GoToSignUp()
    {
        // Update this with your actual sign up route
        Nav.NavigateTo("/signup", forceLoad: true);
    }

    private void GoToLogIn()
    {
        // Update this with your actual login route
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }
    private string Login { get; set; } = "";
    [Inject] AuthenticationStateProvider AuthStateProvider { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        await UpdateLoginAsync();
    }

    private async Task UpdateLoginAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Login = authState.User.Identity.Name ?? "Logged In";
        }
        else
        {
            Login = "";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;

        Login = authState.User.Identity?.IsAuthenticated == true
            ? authState.User.Identity.Name ?? "Logged In"
            : "";

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;

        await JS.InvokeVoidAsync("eval", @"
        window.removeEventListener('scroll', window.checkScrollAnimations);
    ");
    }
    private async Task OnScroll()
    {
        var js = (IJSObjectReference)null;
        try
        {
            js = await JS.InvokeAsync<IJSObjectReference>("import", "./js/scroll-animations.js");
            await js.InvokeVoidAsync("checkScrollAnimations");
        }
        finally
        {
            if (js != null) await js.DisposeAsync();
        }
        StateHasChanged();
    }

    [Inject] IJSRuntime JS { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("eval", @"
                window.checkScrollAnimations = function() {
                    const elements = document.querySelectorAll('.animate-on-scroll');
                    elements.forEach(el => {
                        const rect = el.getBoundingClientRect();
                        const isVisible = rect.top < window.innerHeight - 100 && rect.bottom > 0;
                        if (isVisible && !el.classList.contains('animated')) {
                            el.classList.add('animated');
                            const animation = el.getAttribute('data-animation') || 'fadeInUp';
                            el.classList.add(animation);
                        }
                    });
                };
                window.addEventListener('scroll', checkScrollAnimations);
                window.checkScrollAnimations();
            ");
        }
    }
}

