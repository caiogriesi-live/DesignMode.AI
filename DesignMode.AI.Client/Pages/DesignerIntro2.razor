        string encryptedEmail = EncryptEmail(_enteredEmail);
        var url = $"/init/mainconcept?i=1&id={inviteId}&e={encryptedEmail}&eid={encryptedEmail}";

        _hasNavigated = true;
        NavigationManager.NavigateTo(url, forceLoad: true);
    }

