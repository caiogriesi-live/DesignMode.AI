    private async Task<string?> SaveInviteClientImageWithRetryAsync(
        string inviteId,
        string imageId,
        string imageUrl,
        string countId,
        string style,
        string stylePrompt,
        string important,
        string project,
        string outputRequirements,
        int maxAttempts = 3)
    {
        for (int attempt = 1; attempt <= maxAttempts; attempt++)
        {
            Console.WriteLine(
                $"💾 Saving invite image {countId}. Attempt {attempt} of {maxAttempts}...");

            string? savedId = await SaveInviteClientImageAsync(
                inviteId,
                imageId,
                imageUrl,
                countId,
                style,
                stylePrompt,
                important,
                project,
                outputRequirements);

            if (!string.IsNullOrWhiteSpace(savedId))
            {
                Console.WriteLine(
                    $"✅ Invite image {countId} saved on attempt {attempt}: {savedId}");
                return savedId;
            }

            if (attempt < maxAttempts)
            {
                int delayMilliseconds = 1000 * attempt;
                Console.WriteLine(
                    $"⚠️ Invite image {countId} save attempt {attempt} failed. " +
                    $"Retrying in {delayMilliseconds / 1000} second(s)...");

                await Task.Delay(delayMilliseconds);
            }
        }

        Console.WriteLine(
            $"❌ Invite image {countId} could not be saved after {maxAttempts} attempts.");
        return null;
    }

