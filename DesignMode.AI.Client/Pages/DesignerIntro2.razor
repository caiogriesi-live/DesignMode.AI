<body>
    <div class="ambient-stage-glow" id="ambientStageGlow" aria-hidden="true"></div>

    <div class="card intro-3d search-mode" id="introContainer">

        <!-- avatar section -->
        <div class="avatar-section" id="avatarSection">
            <div class="avatar-ring" id="avatarRing">
                <img class="avatar-img" id="designerAvatar" src="https://i.pravatar.cc/400?img=12" alt="designer avatar">
                <div class="pulse-ring" id="pulseRing"></div>
                <div class="orbit-container" id="orbitContainer">
                    <div class="orbit-icon" style="color: #d62976;"><i class="fab fa-instagram"></i></div>
                    <div class="orbit-icon" style="color: #1877f2;"><i class="fab fa-facebook"></i></div>
                    <div class="orbit-icon" style="color: #1da1f2;"><i class="fab fa-twitter"></i></div>
                    <div class="orbit-icon" style="color: #ff0050;"><i class="fab fa-tiktok"></i></div>
                </div>
            </div>
            <div class="designer-name" id="designerName">
                <span>Aria Chen</span> <i class="fas fa-check-circle" style="color: #007aff;"></i>
            </div>
            <div class="search-badge" id="searchBadge">
                <i class="fas fa-search"></i> searching designer...
            </div>
        </div>

        <!-- progress & text -->
        <div class="progress-area" id="progressArea">
            <div class="progress-text">
                <span id="progressLabel">🔍 Analyzing company & industry</span>
                <span id="progressPercent">0%</span>
            </div>
            <div class="progress-bar-bg">
                <div class="progress-fill" id="progressFill" style="width: 0%;"></div>
            </div>
            <div class="step-label" id="stepLabel">
                <i class="fas fa-rotate-right fa-spin"></i> <span id="stepText">Initializing creative engine...</span>
            </div>
        </div>

        <!-- social icons row -->
        <div class="social-icons-row" id="socialIconsRow">
            <div class="social-icon-item" style="--i:1;">
                <i class="fab fa-instagram" style="color: #d62976;"></i>
                <span>Instagram</span>
            </div>
            <div class="social-icon-item" style="--i:2;">
                <i class="fab fa-facebook" style="color: #1877f2;"></i>
                <span>Facebook</span>
            </div>
            <div class="social-icon-item" style="--i:3;">
                <i class="fab fa-tiktok" style="color: #000000; text-shadow: 0 0 6px #ff0050;"></i>
                <span>TikTok</span>
            </div>
        </div>

        <div class="dots-ring" id="dotsRing">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
        </div>

        <div class="data-transfer-glow" id="dataGlow">
            <i class="fas fa-bolt"></i> data transfer <i class="fas fa-arrow-right"></i> <i class="fas fa-circle" style="font-size: 0.4rem;"></i>
        </div>
    </div>

    <!-- REQUIRED ACCOUNT CREATION MODAL -->
    <div class="modal-overlay" id="modalOverlay" role="dialog" aria-modal="true" aria-labelledby="workspaceModalTitle">
        <div class="modal-content account-modal-content">
            <div class="modal-icon" id="accountModalIcon">
                <i class="fas fa-user-plus"></i>
            </div>

            <div class="modal-title" id="workspaceModalTitle">
                Create your free workspace
            </div>

            <div class="modal-subtitle" id="accountModalSubtitle">
                Create your account so your personalized directions, previews, and brand system are saved automatically.
            </div>

            <div class="modal-google-wrap" id="modalGoogleWrap">
                <div id="googleSignInButton" class="google-signin-button"></div>
            </div>

            <div class="modal-or-divider" id="modalOrDivider" aria-hidden="true">
                <hr />
                <span>OR</span>
                <hr />
            </div>

            <div class="modal-input-group">
                <input type="email"
                       id="modalEmailInput"
                       name="email"
                       autocomplete="username"
                       placeholder="Email address">

                <input type="password"
                       id="modalPasswordInput"
                       name="password"
                       autocomplete="new-password"
                       placeholder="Password">

                <div class="modal-error" id="modalError" role="alert"></div>

                <button class="modal-btn modal-btn-primary" id="modalSubmitBtn">
                    Create Account &amp; Continue →
                </button>

                <div class="modal-login-row">
                    <span id="accountModePrompt">Already have an account?</span>
                    <a href="#" id="accountModeToggle">Log in</a>
                </div>

                <div class="modal-legal" id="accountModalLegal">
                    By creating an account, you agree to our
                    <a href="/terms.html" target="_blank" rel="noopener noreferrer">Terms</a>
                    and
                    <a href="/privacy.html" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.
                </div>

                <div class="modal-success" id="modalSuccess">
                    <i class="fas fa-check-circle"></i>
                    <span id="modalSuccessText">Account created. Saving your workspace...</span>
                </div>
            </div>
        </div>
    </div>

    <!-- BRAND FEELING MODAL OVERLAY - Premium Apple Style -->
    <div class="modal-overlay" id="brandFeelingModal" style="display:none;">
        <div class="modal-content">
            <button class="modal-close-icon" id="brandModalCloseBtn">
                <i class="fas fa-times"></i>
            </button>
            <div class="modal-icon">
                <i class="fas fa-heart"></i>
            </div>
            <div class="modal-title">
                How should your brand feel?
            </div>
            <div class="modal-subtitle">
                Choose the emotion you want people to experience when they interact with your brand.
            </div>
            <div class="brand-options-grid">
                <button class="brand-option-btn" data-value="Trustworthy">
                    <i class="fas fa-shield-alt"></i>
                    <span>Trustworthy</span>
                </button>
                <button class="brand-option-btn" data-value="Premium">
                    <i class="fas fa-crown"></i>
                    <span>Premium</span>
                </button>
                <button class="brand-option-btn" data-value="Playful">
                    <i class="fas fa-smile"></i>
                    <span>Playful</span>
                </button>
                <button class="brand-option-btn" data-value="Bold">
                    <i class="fas fa-rocket"></i>
                    <span>Bold</span>
                </button>
                <button class="brand-option-btn" data-value="Innovative">
                    <i class="fas fa-lightbulb"></i>
                    <span>Innovative</span>
                </button>
            </div>
            <div class="modal-success" id="brandModalSuccess">
                <i class="fas fa-check-circle"></i>
                Great choice! Continuing with your brand direction...
            </div>
        </div>
    </div>
</body>

<style>
    html,
    body {
        margin: 0;
        height: 100%;
    }

    body {
        min-height: 100vh;
        background: #f2f3f8;
    }

    #app {
        min-height: 100vh;
    }

    .page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .card {
        max-width: 780px;
        width: 100%;
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-radius: 3rem 3rem 2.5rem 2.5rem;
        box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.25), 0 10px 30px -10px rgba(0, 0, 0, 0.05);
        padding: 2.5rem 2rem 2.8rem;
        transition: box-shadow 0.3s, min-height 0.8s cubic-bezier(0.65, 0, 0.35, 1), filter 0.4s ease;
        border: 1px solid rgba(255, 255, 255, 0.4);
        position: relative;
        overflow: hidden;
        min-height: 520px;
        display: flex;
        flex-direction: column;
    }

        .card.blurred {
            filter: blur(8px);
            pointer-events: none;
        }

    .intro-3d {
        perspective: 1200px;
        animation: intro3D 1.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        transform-style: preserve-3d;
        opacity: 0;
        transform: rotateX(12deg) rotateY(-6deg) scale(0.92) translateY(18px);
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 400px;
        transition: min-height 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    }

        .intro-3d.search-mode {
            min-height: 600px;
        }

        .intro-3d.expanded {
            min-height: 100%;
        }

    @@keyframes intro3D {
        0% {
            opacity: 0;
            transform: rotateX(18deg) rotateY(-12deg) scale(0.85) translateY(40px);
            filter: blur(6px);
        }

        60% {
            opacity: 1;
            transform: rotateX(4deg) rotateY(2deg) scale(1.02) translateY(-4px);
            filter: blur(0);
        }

        100% {
            opacity: 1;
            transform: rotateX(0deg) rotateY(0deg) scale(1) translateY(0);
            filter: blur(0);
        }
    }

    .avatar-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        min-height: 500px;
        transition: min-height 1.2s cubic-bezier(0.65, 0, 0.35, 1), padding-top 1.2s cubic-bezier(0.65, 0, 0.35, 1), justify-content 1.2s cubic-bezier(0.65, 0, 0.35, 1);
        padding-top: 0;
        flex-shrink: 0;
    }

        .avatar-section.compact {
            min-height: 240px;
            justify-content: flex-start;
            padding-top: 0.5rem;
        }

    .avatar-ring {
        position: relative;
        width: 200px;
        height: 200px;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: transform 0.8s cubic-bezier(0.65, 0, 0.35, 1), width 0.8s cubic-bezier(0.65, 0, 0.35, 1), height 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .avatar-section.big-avatar .avatar-ring {
        width: 220px;
        height: 220px;
    }

    .avatar-section.big-avatar.compact .avatar-ring {
        width: 160px;
        height: 160px;
    }

    .avatar-img {
        width: 170px;
        height: 170px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 20px 48px -12px rgba(0, 0, 0, 0.25);
        border: 5px solid white;
        transition: transform 0.3s ease, box-shadow 0.3s, width 0.8s cubic-bezier(0.65, 0, 0.35, 1), height 0.8s cubic-bezier(0.65, 0, 0.35, 1);
        background: #f0f0f5;
        display: block;
        position: relative;
        z-index: 2;
    }

    .avatar-section.big-avatar .avatar-img {
        width: 190px;
        height: 190px;
    }

    .avatar-section.big-avatar.compact .avatar-img {
        width: 130px;
        height: 130px;
    }

    .pulse-ring {
        position: absolute;
        inset: -14px;
        border-radius: 50%;
        border: 5px solid rgba(0, 140, 255, 0.3);
        animation: pulseFound 2s ease-in-out infinite;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.4s;
        z-index: 1;
    }

    .avatar-section.big-avatar .pulse-ring {
        inset: -16px;
    }

    .avatar-section.big-avatar.compact .pulse-ring {
        inset: -12px;
    }

    .pulse-ring.active {
        opacity: 1;
    }

    @@keyframes pulseFound {
        0% {
            transform: scale(1);
            opacity: 0.7;
        }

        70% {
            transform: scale(1.28);
            opacity: 0;
        }

        100% {
            transform: scale(1);
            opacity: 0;
        }
    }

    .orbit-container {
        position: absolute;
        inset: -80px;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
        opacity: 0;
        transition: opacity 0.8s ease, inset 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .avatar-section.big-avatar .orbit-container {
        inset: -90px;
    }

    .avatar-section.big-avatar.compact .orbit-container {
        inset: -65px;
    }

    .orbit-container.active {
        opacity: 1;
        animation: spinOrbit 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @@keyframes spinOrbit {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .orbit-icon {
        position: absolute;
        width: 55px;
        height: 55px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        box-shadow: 0 8px 24px -8px rgba(0,0,0,0.12);
        border: 1px solid rgba(255,255,255,0.6);
        transition: transform 0.3s ease, width 0.8s cubic-bezier(0.65, 0, 0.35, 1), height 0.8s cubic-bezier(0.65, 0, 0.35, 1);
        top: 50%;
        left: 50%;
        transform-origin: center center;
    }

    .avatar-section.big-avatar .orbit-icon {
        width: 60px;
        height: 60px;
        font-size: 1.8rem;
    }

    .avatar-section.big-avatar.compact .orbit-icon {
        width: 46px;
        height: 46px;
        font-size: 1.3rem;
    }

    .orbit-icon:nth-child(1) {
        transform: translate(-50%, -50%) translateX(-100px);
    }

    .orbit-icon:nth-child(2) {
        transform: translate(-50%, -50%) translateX(100px);
    }

    .orbit-icon:nth-child(3) {
        transform: translate(-50%, -50%) translateY(-100px);
    }

    .orbit-icon:nth-child(4) {
        transform: translate(-50%, -50%) translateY(100px);
    }

    .avatar-section.big-avatar .orbit-icon:nth-child(1) {
        transform: translate(-50%, -50%) translateX(-110px);
    }

    .avatar-section.big-avatar .orbit-icon:nth-child(2) {
        transform: translate(-50%, -50%) translateX(110px);
    }

    .avatar-section.big-avatar .orbit-icon:nth-child(3) {
        transform: translate(-50%, -50%) translateY(-110px);
    }

    .avatar-section.big-avatar .orbit-icon:nth-child(4) {
        transform: translate(-50%, -50%) translateY(110px);
    }

    .avatar-section.big-avatar.compact .orbit-icon:nth-child(1) {
        transform: translate(-50%, -50%) translateX(-78px);
    }

    .avatar-section.big-avatar.compact .orbit-icon:nth-child(2) {
        transform: translate(-50%, -50%) translateX(78px);
    }

    .avatar-section.big-avatar.compact .orbit-icon:nth-child(3) {
        transform: translate(-50%, -50%) translateY(-78px);
    }

    .avatar-section.big-avatar.compact .orbit-icon:nth-child(4) {
        transform: translate(-50%, -50%) translateY(78px);
    }

    .orbit-container.active .orbit-icon {
        animation: counterSpin 8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @@keyframes counterSpin {
        0% {
            transform: translate(-50%, -50%) translateX(var(--tx, 0px)) rotate(0deg);
        }

        100% {
            transform: translate(-50%, -50%) translateX(var(--tx, 0px)) rotate(-360deg);
        }
    }

    .orbit-icon:nth-child(1) {
        --tx: -100px;
    }

    .orbit-icon:nth-child(2) {
        --tx: 100px;
    }

    .orbit-icon:nth-child(3) {
        --tx: 0px;
        --ty: -100px;
        transform: translate(-50%, -50%) translateY(-100px);
    }

    .orbit-icon:nth-child(4) {
        --tx: 0px;
        --ty: 100px;
        transform: translate(-50%, -50%) translateY(100px);
    }

    .avatar-section.big-avatar .orbit-icon:nth-child(1) {
        --tx: -110px;
    }

    .avatar-section.big-avatar .orbit-icon:nth-child(2) {
        --tx: 110px;
    }

    .avatar-section.big-avatar .orbit-icon:nth-child(3) {
        --tx: 0px;
        --ty: -110px;
        transform: translate(-50%, -50%) translateY(-110px);
    }

    .avatar-section.big-avatar .orbit-icon:nth-child(4) {
        --tx: 0px;
        --ty: 110px;
        transform: translate(-50%, -50%) translateY(110px);
    }

    .avatar-section.big-avatar.compact .orbit-icon:nth-child(1) {
        --tx: -78px;
    }

    .avatar-section.big-avatar.compact .orbit-icon:nth-child(2) {
        --tx: 78px;
    }

    .avatar-section.big-avatar.compact .orbit-icon:nth-child(3) {
        --tx: 0px;
        --ty: -78px;
        transform: translate(-50%, -50%) translateY(-78px);
    }

    .avatar-section.big-avatar.compact .orbit-icon:nth-child(4) {
        --tx: 0px;
        --ty: 78px;
        transform: translate(-50%, -50%) translateY(78px);
    }

    .orbit-icon:nth-child(3) {
        animation-name: counterSpinY;
    }

    .orbit-icon:nth-child(4) {
        animation-name: counterSpinY;
    }

    @@keyframes counterSpinY {
        0% {
            transform: translate(-50%, -50%) translateY(var(--ty, 0px)) rotate(0deg);
        }

        100% {
            transform: translate(-50%, -50%) translateY(var(--ty, 0px)) rotate(-360deg);
        }
    }

    .designer-name {
        margin-top: 1.2rem;
        font-weight: 600;
        font-size: 1.6rem;
        letter-spacing: -0.3px;
        color: #1c1c1e;
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
        z-index: 2;
        transition: font-size 0.8s cubic-bezier(0.65, 0, 0.35, 1), margin-top 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .avatar-section.big-avatar .designer-name {
        font-size: 1.8rem;
        margin-top: 1.2rem;
    }

    .avatar-section.big-avatar.compact .designer-name {
        font-size: 1.3rem;
        margin-top: 0.6rem;
    }

    .designer-name i {
        color: #007aff;
        font-size: 1.2rem;
        opacity: 0.8;
    }

    .search-badge {
        background: #e9edf2;
        border-radius: 40px;
        padding: 0.5rem 1.8rem;
        font-size: 1rem;
        font-weight: 500;
        color: #2c3e50;
        margin-top: 0.5rem;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        backdrop-filter: blur(4px);
        background: rgba(230, 235, 245, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.7);
        position: relative;
        z-index: 2;
        transition: font-size 0.8s cubic-bezier(0.65, 0, 0.35, 1), padding 0.8s cubic-bezier(0.65, 0, 0.35, 1), margin-top 0.8s cubic-bezier(0.65, 0, 0.35, 1);
        text-align: center;
        max-width: 100%;
    }

    .avatar-section.big-avatar .search-badge {
        font-size: 1.1rem;
        padding: 0.6rem 2rem;
        margin-top: 0.6rem;
    }

    .avatar-section.big-avatar.compact .search-badge {
        font-size: 0.9rem;
        padding: 0.35rem 1.4rem;
        margin-top: 0.3rem;
    }

    .search-badge i {
        font-size: 0.85rem;
        color: #007aff;
    }

    .progress-area {
        margin: 0rem 0 1.2rem;
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease, transform 0.8s ease, margin 0.8s cubic-bezier(0.65, 0, 0.35, 1);
        pointer-events: none;
        flex-shrink: 0;
    }

        .progress-area.visible {
            opacity: 1;
            transform: translateY(0);
            pointer-events: auto;
        }

    .progress-text {
        display: flex;
        justify-content: space-between;
        font-size: 0.9rem;
        font-weight: 450;
        color: #1d1d1f;
        letter-spacing: -0.2px;
        padding: 0 2px;
    }

        .progress-text span:first-child {
            color: #1c1c1e;
            font-weight: 500;
        }

        .progress-text span:last-child {
            color: #3a6ea5;
            font-weight: 500;
            background: rgba(0, 122, 255, 0.06);
            padding: 0 12px;
            border-radius: 30px;
        }

    .progress-bar-bg {
        width: 100%;
        height: 8px;
        background: #e7ecf3;
        border-radius: 20px;
        margin: 12px 0 4px;
        overflow: hidden;
        box-shadow: inset 0 1px 3px rgba(0,0,0,0.04);
    }

    .progress-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #007aff, #47a9ff);
        border-radius: 20px;
        transition: width 0.8s cubic-bezier(0.23, 1, 0.32, 1);
        box-shadow: 0 0 10px #007aff55;
    }

    .step-label {
        margin-top: 1.2rem;
        font-size: 1rem;
        font-weight: 450;
        color: #1d1d1f;
        min-height: 2.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
        background: rgba(245, 247, 250, 0.5);
        border-radius: 80px;
        padding: 0.5rem 1.2rem;
        backdrop-filter: blur(2px);
        border: 1px solid rgba(255,255,255,0.6);
    }

        .step-label i {
            font-size: 1.1rem;
            color: #007aff;
        }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 1000;
        animation: modalFadeIn 0.4s ease;
