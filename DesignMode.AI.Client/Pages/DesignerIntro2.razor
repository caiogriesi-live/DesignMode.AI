                out var idIndustry);

        var uriParam =
            NavigationManager.ToAbsoluteUri(
                currentPage);

        string queryString =
            uriParam.Query;

        var parsedQuery =
            HttpUtility.ParseQueryString(
                queryString);

        if (parsedQuery["name"] != null)
        {
            Name =
                parsedQuery["name"];
        }

        if (parsedQuery["industry"] != null)
        {
            Industry =
                parsedQuery["industry"];
        }

        if (!_modalsResolvedEmail)
        {
            _modalsResolvedEmail =
                true;

            if (!string.IsNullOrWhiteSpace(email))
            {
                _enteredEmail =
                    email;

                // Signup/login and pending saves already completed before the modal closed.

                SaveEmailResponse? result =
                    await SaveEmailAsync(
                        ApiConfig.ApiBaseUrl,
                        email,
                        anonymousUserId ?? string.Empty,
                        currentPage);

                if (result is null)
                {
                    _modalsResolvedEmail = false;
                    await JSRuntime.InvokeVoidAsync("designerIntroGenerationFailed",
                        "Your account is ready, but the project could not be saved. Please try again.");
                    return;
                }

                // Account is now created and logged in.
                // This is the ONLY point where the image URL / Runware generation pipeline starts.
                await LoadInviteDataFromUrl();

                if (!_allInviteSavesCompleted)
                {
                    IsLoadingInviteData = false;
                    await JSRuntime.InvokeVoidAsync("designerIntroGenerationFailed",
                        string.IsNullOrWhiteSpace(InviteErrorMessage)
                            ? "Your workspace could not be completed. Please refresh and try again."
                            : InviteErrorMessage);
                }
                StateHasChanged();
            }

            StateHasChanged();

            if (!IsLoadingInviteData &&
                _modalsResolvedEmail)
            {
                StateHasChanged();

                await TryNavigateWhenReadyAsync();
            }
        }
    }



    public async Task<SaveEmailResponse?> SaveEmailAsync(
        string url,
        string email,
        string local,
        string currentPage)
    {
        var progressQuery = QueryHelpers.ParseQuery(new Uri(currentPage).Query);
        progressQuery.TryGetValue("companyIndustryId", out var companyIndustryId);

        var request =
            new SaveEmailLocalRequest
                {
                    Email = email,
                    Local = local,
                    CurrentPage = currentPage,
                    CompanyIndustryId = companyIndustryId.FirstOrDefault(),
                    Name = Name,
                    Industry = Industry
                };

        string functionUrl =
            $"{url.TrimEnd('/')}/api/SaveEmail?code=REDACTED_FOR_GROOMING";

        HttpResponseMessage response =
            await Http.PostAsJsonAsync(
                functionUrl,
                request);

        if (!response.IsSuccessStatusCode)
        {
            string error =
                await response.Content.ReadAsStringAsync();

            Console.WriteLine(
                $"❌ Failed to save email, current page, and update CompanyIndustry: {error}");

            return null;
        }

        SaveEmailResponse? result =
            await response.Content.ReadFromJsonAsync<SaveEmailResponse>();

        Console.WriteLine(
            $"✅ Email and current page saved for Local: {local}. Page: {currentPage}");

        return result;
    }

