    private async Task TryNavigateWhenReadyAsync()
    {
        if (_hasNavigated ||
            !_clientSequenceReady ||
            !_modalsResolvedEmail ||
            !_modalsResolvedBrand ||
            IsLoadingInviteData ||
            !_allInviteSavesCompleted ||
            _inviteSaveFailed)
