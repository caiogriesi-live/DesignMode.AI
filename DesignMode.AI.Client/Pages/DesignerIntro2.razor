    private CancellationTokenSource? jobPollingCancellation;
    private async Task<DesignModeJobStatus?> GetJobStatus(
    string jobId,
    CancellationToken cancellationToken)
    {
        string functionUrl =
            $"{ApiConfig.ApiBaseUrl}" +
            $"api/GetJobStatus/{Uri.EscapeDataString(jobId)}" +
            "?code=REDACTED_FOR_GROOMING";

        using HttpResponseMessage response =
            await Http.GetAsync(
                functionUrl,
                cancellationToken);

        string responseBody =
            await response.Content.ReadAsStringAsync(
                cancellationToken);

        if (!response.IsSuccessStatusCode)
        {
            Console.WriteLine(
                $"GetJobStatus failed: " +
                $"{(int)response.StatusCode}. " +
                $"Body: {responseBody}");

            return null;
        }

        return System.Text.Json.JsonSerializer.Deserialize<DesignModeJobStatus>(
            responseBody,
            new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });
    }
    private async Task PollJobStatus(
    string jobId,
    CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                DesignModeJobStatus? job =
                    await GetJobStatus(
                        jobId,
                        cancellationToken);

                if (job is not null)
                {
                    await InvokeAsync(() =>
                    {
                        CurrentJob = job;

                        StatusMessage =
                            job.Status switch
                            {
                                "Queued" =>
                                    "Your request is queued.",

                                "Processing" =>
                                    "Generating your idea...",

                                "Completed" =>
                                    "Your idea is ready.",

                                "Failed" =>
                                    job.Error ??
                                    "Idea generation failed.",

                                _ =>
                                    job.Status
                            };

                        StateHasChanged();
                    });

                    if (string.Equals(
                            job.Status,
                            "Completed",
                            StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(
                            job.Status,
                            "Failed",
                            StringComparison.OrdinalIgnoreCase))
                    {
                        return;
                    }
                }

                await Task.Delay(
                    TimeSpan.FromSeconds(2),
                    cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
            // Normal when the component is disposed
            // or a new job replaces the previous job.
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Status polling failed: {ex}");

            await InvokeAsync(() =>
            {
                StatusMessage =
                    "Unable to retrieve the current job status.";

                StateHasChanged();
            });
        }
    }
