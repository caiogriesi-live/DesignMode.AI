    [JSInvokable]
    public async Task<WorkspaceAccountResult> CompleteWorkspaceGoogleLogin(string idToken)
    {
        if (string.IsNullOrWhiteSpace(idToken))
        {
            return new WorkspaceAccountResult
                {
                    Success = false,
                    ErrorMessage = "Google did not return a valid sign-in token."
                };
        }

