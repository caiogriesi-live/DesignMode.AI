            if (authState.User.Identity?.IsAuthenticated != true)
            {
                return new WorkspaceAccountResult
                    {
                        Success = false,
                        ErrorMessage = "Google sign-in succeeded, but the authenticated session is not ready."
                    };
            }

            var authenticatedEmail =
                authState.User.FindFirst("email")?.Value
                ?? authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? authState.User.Identity?.Name
                ?? string.Empty;

            if (string.IsNullOrWhiteSpace(authenticatedEmail))
            {
                return new WorkspaceAccountResult
                    {
                        Success = false,
                        ErrorMessage = "Google login succeeded, but we could not determine your account email."
                    };
            }

            authenticatedEmail = authenticatedEmail.Trim();
            _enteredEmail = authenticatedEmail;

            return new WorkspaceAccountResult
                {
                    Success = true,
                    Email = authenticatedEmail
                };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Google workspace sign-in error: {ex}");

            return new WorkspaceAccountResult
                {
                    Success = false,
                    ErrorMessage = $"Google sign-in error: {ex.Message}"
                };
        }
    }

    private bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return false;

        try
        {
            var addr = new System.Net.Mail.MailAddress(email.Trim());
            return addr.Address.Equals(email.Trim(), StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

    private bool IsPasswordStrong(string password)
    {
        if (string.IsNullOrEmpty(password) || password.Length < 8)
            return false;

        if (!password.Any(char.IsUpper))
            return false;

        if (!password.Any(char.IsLower))
            return false;

        if (!password.Any(char.IsDigit))
            return false;

        if (!password.Any(ch => !char.IsLetterOrDigit(ch)))
            return false;

        return true;
    }

    [JSInvokable]
    public async Task OnEmailModalClosed(string? email)
    {
        string? anonymousUserId =
            await FunnelBrowserIdentity.ReadAsync(JSRuntime);

        string currentPage =
            NavigationManager.Uri;

        var queryParams =
            QueryHelpers.ParseQuery(
                new Uri(currentPage).Query);

        bool companyNameFound =
