                                InviteErrorMessage = "The final invite image could not be saved. Please try again.";
                                Console.WriteLine("❌ Final invite image save did not complete. Redirect cancelled.");
                                await InvokeAsync(StateHasChanged);
                                return;
                            }

                            _allInviteSavesCompleted = true;
                            _inviteSaveFailed = false;
                            Console.WriteLine($"✅ All invite image saves completed. Final saved ID: {finalInviteImageId}");
                            await InvokeAsync(StateHasChanged);

                            // Tell the browser the real generation pipeline is complete.
                            // This advances the progress bar from its 95% hold to 100%.
                            await JSRuntime.InvokeVoidAsync("designerIntroGenerationComplete");
                        }
                        else
                        {
                            _inviteSaveFailed = true;
                            InviteErrorMessage = "The final invite image was not generated, so the invite could not be completed.";
                            Console.WriteLine("❌ Final invite image URL is empty. Redirect cancelled.");
                            await InvokeAsync(StateHasChanged);
                            return;
                        }
                    }
                }

                if (!_allInviteSavesCompleted)
                {
                    _inviteSaveFailed = true;
                    InviteErrorMessage = "Not all invite image saves were completed. Redirect cancelled.";
                    Console.WriteLine("❌ Not all invite image saves were completed. Redirect cancelled.");
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                IsLoadingInviteData = false;
                await InvokeAsync(StateHasChanged);
                if (!IsLoadingInviteData && _modalsResolvedEmail)
                {
                    StateHasChanged();
                    await TryNavigateWhenReadyAsync();
                }

                Console.WriteLine($"✅ Invite data loaded for: {Name}");
            }
        }
        catch (System.Exception ex)
        {
            _inviteSaveFailed = true;
            _allInviteSavesCompleted = false;
            IsLoadingInviteData = false;
            InviteErrorMessage = "We couldn't finish saving your invite images. Please try again.";
            Console.WriteLine($"❌ Error loading or saving invite data: {ex}");
            await InvokeAsync(StateHasChanged);

            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "designerIntroGenerationFailed",
                    InviteErrorMessage);
            }
            catch
            {
                // The page may already be navigating/disposed.
            }
        }
    }

