    private string EncryptEmail(string email)
    {
        if (string.IsNullOrEmpty(email))
            return "";

        try
        {
            // Simple encryption for demo - in production, use proper encryption
            var bytes = Encoding.UTF8.GetBytes(email);
            return Convert.ToBase64String(bytes);
        }
        catch
        {
            return "";
        }
    }

    public static Guid CreateCompanyGuid(string name, string industry)
    {
        string input = $"{name?.Trim().ToLowerInvariant()}|{industry?.Trim().ToLowerInvariant()}";
        byte[] hash = SHA256.HashData(Encoding.UTF8.GetBytes(input));
        byte[] guidBytes = new byte[16];
        Array.Copy(hash, guidBytes, 16);
        return new Guid(guidBytes);
    }

