    /* Animated stage glow: the card itself always remains white. */
    .card {
        --stage-glow-start: #c7d2fe;
        --stage-glow-end: #bae6fd;
        --stage-progress-start: #6c8cff;
        --stage-progress-end: #56c5ff;
        background: #ffffff;
        box-shadow: 0 30px 70px -24px color-mix(in srgb, var(--stage-glow-start) 72%, transparent), 0 16px 44px -24px color-mix(in srgb, var(--stage-glow-end) 76%, transparent), 0 10px 30px -14px rgba(15, 23, 42, 0.12), 0 0 0 1px rgba(255, 255, 255, 0.82) inset;
        transition: box-shadow 1.1s cubic-bezier(0.65, 0, 0.35, 1), min-height 0.8s cubic-bezier(0.65, 0, 0.35, 1), filter 0.4s ease;
        will-change: box-shadow;
    }

    .progress-fill {
        background: linear-gradient(90deg, var(--stage-progress-start), var(--stage-progress-end));
        transition: width 1.05s cubic-bezier(0.65, 0, 0.35, 1), background 1.05s cubic-bezier(0.65, 0, 0.35, 1), box-shadow 1.05s cubic-bezier(0.65, 0, 0.35, 1);
        box-shadow: 0 0 14px color-mix(in srgb, var(--stage-progress-start) 45%, transparent);
        will-change: width, background;
    }

    .progress-text span:last-child,
    .step-label i,
    .data-transfer-glow i {
        transition: color 0.9s cubic-bezier(0.65, 0, 0.35, 1), background-color 0.9s cubic-bezier(0.65, 0, 0.35, 1);
    }


    /* Visible stage halo. The card remains white. */
    body {
        position: relative;
        isolation: isolate;
        overflow-x: hidden;
        background: #f7f8fc;
    }

    .ambient-stage-glow {
        --page-pulse-start: #dbeafe;
        --page-pulse-end: #fce7f3;
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
        opacity: 1;
    }

        .ambient-stage-glow::before,
        .ambient-stage-glow::after {
            content: '';
            position: absolute;
            width: min(72vw, 900px);
            height: min(72vw, 900px);
            border-radius: 50%;
            filter: blur(70px) saturate(135%);
            opacity: 0.72;
            will-change: transform, opacity, background-color;
            transition: background-color 1.1s cubic-bezier(0.65, 0, 0.35, 1);
        }

        .ambient-stage-glow::before {
            top: 50%;
            left: 50%;
            background-color: var(--page-pulse-start);
            animation: ambientPulseOne 4.2s ease-in-out infinite;
        }

        .ambient-stage-glow::after {
            top: 50%;
            left: 50%;
            background-color: var(--page-pulse-end);
            animation: ambientPulseTwo 4.2s ease-in-out infinite;
        }

    .card {
        z-index: 2;
    }

    .modal-overlay {
        z-index: 1000;
    }

    @@keyframes ambientPulseOne {
        0%, 100% {
            opacity: 0.38;
            transform: translate(-72%, -62%) scale(0.78);
        }

        50% {
            opacity: 0.9;
            transform: translate(-64%, -56%) scale(1.12);
        }
    }

    @@keyframes ambientPulseTwo {
        0%, 100% {
            opacity: 0.82;
            transform: translate(-30%, -38%) scale(1.08);
        }

        50% {
            opacity: 0.32;
            transform: translate(-38%, -46%) scale(0.76);
        }
    }

    @@media (max-width: 768px) {
        .ambient-stage-glow::before,
        .ambient-stage-glow::after {
            width: 110vw;
            height: 110vw;
            filter: blur(52px) saturate(130%);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ambient-stage-glow::before,
        .ambient-stage-glow::after {
            animation: none;
            opacity: 0.58;
        }

        .ambient-stage-glow::before {
            transform: translate(-70%, -60%) scale(1);
        }

        .ambient-stage-glow::after {
            transform: translate(-32%, -40%) scale(1);
        }
    }

