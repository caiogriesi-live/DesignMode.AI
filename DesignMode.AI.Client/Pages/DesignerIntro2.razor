        const imageGenerationStages = [
            { p: 0, label: '🎨 Starting image generation', step: 'Preparing your personalized preview prompts', icon: 'fa-wand-magic-sparkles', glow: ['#f5f3ff', '#fff1f5'], progress: ['#8b5cf6', '#ec4899'] },
            { p: 12, label: '🧠 Building creative prompts', step: 'Turning your brand direction into image prompts', icon: 'fa-lightbulb', glow: ['#fff0f6', '#f8f0ff'], progress: ['#d946ef', '#f472b6'] },
            { p: 28, label: '🖼️ Generating preview 1 of 3', step: 'Creating your first personalized visual direction', icon: 'fa-image', glow: ['#eef6ff', '#f2f7ff'], progress: ['#3b82f6', '#60a5fa'] },
            { p: 46, label: '🖼️ Generating preview 2 of 3', step: 'Creating your second personalized visual direction', icon: 'fa-images', glow: ['#effdf8', '#eefbf3'], progress: ['#10b981', '#34d399'] },
            { p: 64, label: '🖼️ Generating preview 3 of 3', step: 'Creating your third personalized visual direction', icon: 'fa-photo-film', glow: ['#fffbea', '#fff6e8'], progress: ['#f59e0b', '#fbbf24'] },
            { p: 82, label: '💾 Saving your generated previews', step: 'Attaching generated images to your workspace', icon: 'fa-floppy-disk', glow: ['#eef9ff', '#eff6ff'], progress: ['#06b6d4', '#3b82f6'] },
            { p: 95, label: '✨ Finalizing your workspace', step: 'Finishing image saves and brand assets', icon: 'fa-wand-magic-sparkles', glow: ['#f1fdf5', '#eefbf8'], progress: ['#22c55e', '#14b8a6'] }
        ];

        let avatarIndex = 0;
        let progressTimer = null;
        let isEmailResolved = false;
        let isBrandResolved = false;
        let isProgressComplete = false;
        let isGenerationComplete = false;
