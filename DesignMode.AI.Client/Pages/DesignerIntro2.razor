    [JSInvokable]
    public async Task<WorkspaceAccountResult> CreateWorkspaceAccount(string email, string password)
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            return new WorkspaceAccountResult
                {
                    Success = false,
                    ErrorMessage = "Email and password are required."
                };
        }

        email = email.Trim();

        if (!IsValidEmail(email))
        {
            return new WorkspaceAccountResult
                {
                    Success = false,
                    ErrorMessage = "Please enter a valid email address."
                };
        }

        if (!IsPasswordStrong(password))
        {
            return new WorkspaceAccountResult
                {
                    Success = false,
                    ErrorMessage = "Password must be at least 8 characters and contain uppercase, lowercase, number, and special character."
                };
        }

        try
        {
            // Same signup call used on /signup. No phone field in this modal.
            var result = await Auth.Signup(
                email,
                password,
                string.Empty,
                ApiConfig.ApiBaseUrl);

            if (!result.Success)
            {
                return new WorkspaceAccountResult
                    {
                        Success = false,
                        ErrorMessage = result.ErrorMessage ?? "Unable to create your account."
                    };
            }

            // Same automatic login used on /signup.
            var loginSuccess = await Auth.Login(
                email,
                password,
                ApiConfig.ApiBaseUrl);

            if (!loginSuccess)
            {
                return new WorkspaceAccountResult
                    {
                        Success = false,
                        ErrorMessage = "Signup succeeded, but login failed. Please use the Log in link."
                    };
            }

            // Same post-login pending saves used on /signup.
            await SavePending.SavePendingIdeasAfterLogin(ApiConfig.ApiBaseUrl);
            await SavePending.SavePendingCompanyInfoAfterLogin(ApiConfig.ApiBaseUrl);

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                return new WorkspaceAccountResult
                    {
                        Success = false,
                        ErrorMessage = "Your account was created, but the authenticated session is not ready."
                    };
            }

            _enteredEmail = email;

            return new WorkspaceAccountResult
                {
                    Success = true,
                    Email = email
                };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Workspace signup error: {ex}");

            return new WorkspaceAccountResult
                {
                    Success = false,
                    ErrorMessage = $"Signup error: {ex.Message}"
