            dotNetHelper = helper;
            checkAndNotifyModalsClosed();
        };

        window.designerIntroGenerationComplete = function () {
            isGenerationComplete = true;
            isGenerationFailed = false;

            if (progressTimer) {
                clearInterval(progressTimer);
                progressTimer = null;
            }

            if (imageProgressTimer) {
                clearInterval(imageProgressTimer);
                imageProgressTimer = null;
            }

            updateProgress(
                100,
                '✅ Ready · workspace prepared',
                'Your personalized previews and brand system are ready',
                'fa-check-circle',
                stages[stages.length - 1]
            );

            isProgressComplete = true;
            checkAndNotifyModalsClosed();
        };

        window.designerIntroGenerationFailed = function (message) {
            isGenerationFailed = true;

            if (imageProgressTimer) {
                clearInterval(imageProgressTimer);
                imageProgressTimer = null;
            }

            progressLabel.textContent = '⚠️ We hit a problem preparing your workspace';
            stepText.textContent = message || 'Please refresh and try again.';
            const iconEl = stepLabel.querySelector('i');
            if (iconEl) {
                iconEl.className = 'fas fa-triangle-exclamation';
                iconEl.style.color = '#dc3545';
            }
        };

        window.designerIntroImagesReady = function () {
            return Array.from(document.images).every(img => img.complete && img.naturalWidth > 0);
        };

        function notifyEmailModalClosed(email) {
            return dotNetHelper ? dotNetHelper.invokeMethodAsync('OnEmailModalClosed', email) : Promise.resolve();
        }

        function notifyBrandModalClosed() {
            return dotNetHelper ? dotNetHelper.invokeMethodAsync('OnBrandModalClosed') : Promise.resolve();
        }

        function notifyModalsClosed() {
            return dotNetHelper ? dotNetHelper.invokeMethodAsync('OnModalsClosed') : Promise.resolve();
        }

        function checkAndNotifyModalsClosed() {
            if (!redirectNotificationSent && dotNetHelper && isProgressComplete && isEmailResolved && isBrandResolved) {
                redirectNotificationSent = true;
                notifyModalsClosed().catch(() => { redirectNotificationSent = false; });
            }
        }

        function loadImage(url) {
            return new Promise(resolve => {
                const image = new Image();
                image.onload = () => resolve(true);
                image.onerror = () => resolve(false);
                image.src = url;
                if (image.complete) resolve(image.naturalWidth > 0);
            });
        }

        async function preloadAvatarImages() {
            await Promise.all(avatars.map(item => loadImage(item.img)));
        }

        function waitForImageElement(img) {
            if (img.complete && img.naturalWidth > 0) return Promise.resolve(true);
            return new Promise(resolve => {
                const finish = success => resolve(success);
                img.addEventListener('load', () => finish(true), { once: true });
                img.addEventListener('error', () => finish(false), { once: true });
            });
        }

        async function waitForAllImages() {
            await preloadAvatarImages();
            const images = Array.from(document.images);
            const results = await Promise.all(images.map(waitForImageElement));
            return results.every(Boolean);
        }

        function switchAvatar() {
            avatarIndex = (avatarIndex + 1) % avatars.length;
