            if (ambientStageGlow) {
                ambientStageGlow.style.setProperty('--page-pulse-start', stage.glow[0]);
                ambientStageGlow.style.setProperty('--page-pulse-end', stage.glow[1]);
            }

            progressFill.style.boxShadow = `0 0 16px ${stage.progress[0]}55`;
            progressPercent.style.color = stage.progress[0];
            progressPercent.style.backgroundColor = `${stage.progress[0]}12`;
            const iconEl = stepLabel.querySelector('i');
            if (iconEl) iconEl.style.color = stage.progress[0];
        }

        function updateProgress(value, labelText, stepTextContent, iconClass = 'fa-rotate-right', stage = null) {
            const clamped = Math.min(isGenerationComplete ? 100 : MAX_PROGRESS, Math.max(0, value));
            progressFill.style.transitionTimingFunction = EASE;
            progressFill.style.width = clamped + '%';
            progressPercent.textContent = Math.round(clamped) + '%';
            if (labelText) progressLabel.textContent = labelText;
            if (stage) applyStageTheme(stage);

            if (stepTextContent) {
                stepText.textContent = stepTextContent;
                const iconEl = stepLabel.querySelector('i');
                if (iconEl) {
                    iconEl.className = 'fas ' + iconClass;
                    iconEl.classList.toggle('fa-spin', iconClass.includes('fa-spin'));
                }
            }
        }

        function showContent() {
            progressArea.classList.add('visible');
            socialRow.classList.add('visible');
            dataGlow.classList.add('visible');
            dotsRing.classList.add('visible');
        }

        function resetProgressForImageGeneration() {
            if (progressTimer) {
                clearInterval(progressTimer);
                progressTimer = null;
            }

            if (imageProgressTimer) {
                clearInterval(imageProgressTimer);
                imageProgressTimer = null;
            }

            isProgressComplete = false;
            isGenerationComplete = false;
            isGenerationFailed = false;
            imageProgressIndex = 0;

            progressArea.classList.add('visible');
            socialRow.classList.add('visible');
            dataGlow.classList.add('visible');
            dotsRing.classList.add('visible');

            const firstStage = imageGenerationStages[0];
            updateProgress(
                0,
                firstStage.label,
                firstStage.step,
                firstStage.icon,
                firstStage
            );
        }

        function startImageGenerationProgress() {
            resetProgressForImageGeneration();

            // Start moving again immediately after the modal closes.
            // The real Runware completion callback still controls 100%.
            setTimeout(() => {
                if (isGenerationComplete || isGenerationFailed) return;

                imageProgressIndex = 1;
                const firstMovingStage = imageGenerationStages[imageProgressIndex];
                updateProgress(
                    firstMovingStage.p,
                    firstMovingStage.label,
                    firstMovingStage.step,
                    firstMovingStage.icon,
                    firstMovingStage
                );

                imageProgressTimer = setInterval(() => {
                    if (isGenerationComplete || isGenerationFailed) {
                        clearInterval(imageProgressTimer);
                        imageProgressTimer = null;
                        return;
                    }

                    imageProgressIndex++;

                    if (imageProgressIndex < imageGenerationStages.length) {
                        const stage = imageGenerationStages[imageProgressIndex];
                        updateProgress(stage.p, stage.label, stage.step, stage.icon, stage);
                    }

                    if (imageProgressIndex >= imageGenerationStages.length - 1) {
                        clearInterval(imageProgressTimer);
                        imageProgressTimer = null;
                    }
                }, 4500);
            }, 250);
        }

        function hasValidConfiguredGoogleClientId() {
            return !!GOOGLE_CLIENT_ID
                && !GOOGLE_CLIENT_ID.includes('REPLACE_WITH_')
                && GOOGLE_CLIENT_ID.endsWith('.apps.googleusercontent.com');
        }

        function getGoogleSignupButtonWidth() {
            const wrapRect = modalGoogleWrap?.getBoundingClientRect();
            const hostRect = googleSignInButton?.getBoundingClientRect();

            const measuredWidth = Math.floor(
                Math.min(
                    hostRect?.width || Number.POSITIVE_INFINITY,
                    wrapRect?.width || Number.POSITIVE_INFINITY
                )
            );

            const availableWidth = Number.isFinite(measuredWidth) && measuredWidth > 0
                ? measuredWidth
                : 320;

            /*
                Google Identity Services renders a fixed-width iframe.
                Leave a small safety gutter so sub-pixel rounding, borders,
                browser zoom, and mobile device pixel ratios cannot clip the
                right edge of the Google pill.
            */
            const safeWidth = Math.floor(availableWidth - 6);

            return Math.max(120, Math.min(400, safeWidth));
        }

        function renderGoogleSignupButton(forceRender = false) {
            if (!hasValidConfiguredGoogleClientId()) {
                googleSignInButton.innerHTML = '';
                showModalError(
                    'Google sign-up is not configured yet. Add a valid OAuth 2.0 Web application Client ID to the google-signin-client_id meta tag.'
                );
                return;
            }

            if (!window.google || !google.accounts || !google.accounts.id) {
                if (googleRenderRetryTimer) {
                    clearTimeout(googleRenderRetryTimer);
                }

                googleRenderRetryTimer = setTimeout(() => renderGoogleSignupButton(forceRender), 250);
                return;
            }

            const buttonWidth = getGoogleSignupButtonWidth();

            if (
                googleButtonRendered &&
                !forceRender &&
                Math.abs(buttonWidth - lastGoogleButtonWidth) < 2
            ) {
                return;
            }

            try {
                google.accounts.id.initialize({
                    client_id: GOOGLE_CLIENT_ID,
                    callback: handleGoogleCredentialResponse,
                    ux_mode: 'popup',
                    auto_select: false,
                    cancel_on_tap_outside: false
                });

                googleSignInButton.innerHTML = '';

                google.accounts.id.renderButton(
                    googleSignInButton,
                    {
                        type: 'standard',
                        theme: 'outline',
                        size: 'large',
                        text: 'continue_with',
                        shape: 'pill',
                        logo_alignment: 'left',
                        width: buttonWidth
                    }
                );

                lastGoogleButtonWidth = buttonWidth;
                googleButtonRendered = true;
            } catch (error) {
                console.error('Unable to initialize Google Identity Services:', error);
                showModalError(
                    'Google sign-up could not be initialized. Verify the Client ID is an active OAuth 2.0 Web application client and that this exact site origin is listed in Authorized JavaScript origins.'
                );
            }
        }

        function scheduleGoogleSignupButtonResize() {
            if (!isEmailModalOpen || !modalOverlay.classList.contains('active')) {
                return;
            }

            if (googleResizeTimer) {
                clearTimeout(googleResizeTimer);
            }

            googleResizeTimer = setTimeout(() => {
                googleResizeTimer = null;
                renderGoogleSignupButton(true);
            }, 120);
        }

        window.addEventListener('resize', scheduleGoogleSignupButtonResize);
        window.addEventListener('orientationchange', scheduleGoogleSignupButtonResize);

        async function handleGoogleCredentialResponse(response) {
            const idToken = response?.credential;

            if (!idToken) {
                showModalError('Google did not return a valid sign-in credential.');
                setAccountFormProcessing(false);
                return;
            }

            modalError.classList.remove('show');
            modalError.textContent = '';
            setAccountFormProcessing(true, 'google');

            try {
                if (!dotNetHelper) {
                    showModalError('The account form is still loading. Please try again.');
                    setAccountFormProcessing(false);
                    return;
                }

                const result = await dotNetHelper.invokeMethodAsync(
                    'CompleteWorkspaceGoogleLogin',
                    idToken
                );

                const success = result?.success ?? result?.Success ?? false;
                const errorMessage = result?.errorMessage ?? result?.ErrorMessage;
                const email = result?.email ?? result?.Email ?? '';

                if (!success) {
                    showModalError(errorMessage || 'Google sign-in failed. Please try again.');
                    setAccountFormProcessing(false);
                    return;
                }

                await completeAuthenticatedAccount(email);
            } catch (error) {
                console.error('Google sign-in failed:', error);
                showModalError('Google sign-in failed. Please try again.');
                setAccountFormProcessing(false);
            }
        }

        function applyAccountModalMode(mode) {
            accountModalMode = mode === 'login' ? 'login' : 'signup';
            const isLogin = accountModalMode === 'login';

            accountModalIcon.innerHTML = isLogin
                ? '<i class="fas fa-right-to-bracket"></i>'
                : '<i class="fas fa-user-plus"></i>';

            workspaceModalTitle.textContent = isLogin
                ? 'Welcome back'
                : 'Create your free workspace';

            accountModalSubtitle.textContent = isLogin
                ? 'Log in to continue with your personalized directions, previews, and brand system.'
                : 'Create your account so your personalized directions, previews, and brand system are saved automatically.';

            modalPasswordInput.setAttribute(
                'autocomplete',
                isLogin ? 'current-password' : 'REDACTED_FOR_GROOMING'
            );

            modalSubmitBtn.textContent = isLogin
                ? 'Log In & Continue →'
                : 'Create Account & Continue →';

            accountModePrompt.textContent = isLogin
                ? 'Don’t have an account?'
                : 'Already have an account?';

            accountModeToggle.textContent = isLogin
                ? 'Create one'
                : 'Log in';

            accountModalLegal.style.display = isLogin ? 'none' : '';

            modalSuccessText.textContent = isLogin
                ? 'Logged in. Loading your workspace...'
                : 'Account created. Saving your workspace...';

            modalError.classList.remove('show');
            modalError.textContent = '';
            modalSuccess.classList.remove('show');

            modalEmailInput.disabled = false;
            modalPasswordInput.disabled = false;
            modalSubmitBtn.disabled = false;
            modalGoogleWrap.classList.remove('is-disabled');

            if (!hasValidConfiguredGoogleClientId()) {
                modalGoogleWrap.classList.add('is-disabled');
            }

            requestAnimationFrame(() => renderGoogleSignupButton(true));
        }

        let checkingAccountSession = false;
        async function showEmailModal() {
            if (isEmailModalOpen || isBrandModalOpen || isEmailResolved || checkingAccountSession) return;
            checkingAccountSession = true;
            try {
                const email = await dotNetHelper.invokeMethodAsync('GetWorkspaceSessionEmail');
                if (email) {
                    await completeAuthenticatedAccount(email);
                    return;
                }
            } catch (error) {
                window.designerIntroGenerationFailed('We could not resume your signed-in workspace. Please refresh and try again.');
                return;
            } finally {
                checkingAccountSession = false;
            }

            isEmailModalOpen = true;

            // Freeze the pre-account progress while the required account modal is open.
            if (progressTimer) {
                clearInterval(progressTimer);
                progressTimer = null;
            }

            modalOverlay.classList.add('active');
            introContainer.classList.add('blurred');

            modalEmailInput.value = '';
            modalPasswordInput.value = '';
            modalSuccess.classList.remove('show');
            modalError.classList.remove('show');
            modalError.textContent = '';

            modalSubmitBtn.disabled = false;
            modalSubmitBtn.style.display = '';
            applyAccountModalMode('signup');

            modalGoogleWrap.classList.remove('is-disabled');
            modalGoogleWrap.style.display = '';
            modalOrDivider.style.display = '';

            if (!hasValidConfiguredGoogleClientId()) {
                modalGoogleWrap.classList.add('is-disabled');
            }

            // Wait one animation frame so the modal has its final responsive
            // width before Google creates its iframe-based button.
            requestAnimationFrame(() => renderGoogleSignupButton(true));

            modalEmailInput.disabled = false;
            modalPasswordInput.disabled = false;
            modalEmailInput.style.display = '';
            modalPasswordInput.style.display = '';
            modalEmailInput.focus();
        }

        function openQueuedBrandModal() {
            if (!brandModalRequested || isEmailModalOpen || isBrandModalOpen || isBrandResolved) return;

            if (queuedBrandOpenTimer) {
                clearTimeout(queuedBrandOpenTimer);
            }

            queuedBrandOpenTimer = setTimeout(() => {
                queuedBrandOpenTimer = null;

                if (isEmailModalOpen || modalOverlay.classList.contains('active')) {
                    return;
                }

                showBrandModal();
            }, 350);
        }

        function hideEmailModalAfterSuccessfulSubmit() {
            if (!isEmailResolved) return;

            modalOverlay.classList.remove('active');
            isEmailModalOpen = false;

            if (brandModalRequested && !isBrandResolved) {
                openQueuedBrandModal();
            } else {
                introContainer.classList.remove('blurred');
            }
        }

        function showModalError(message) {
            modalError.textContent = message || (accountModalMode === 'login' ? 'Unable to log in. Please try again.' : 'Unable to create your account. Please try again.');
            modalError.classList.add('show');
        }

        function setAccountFormProcessing(isProcessing, provider = 'email') {
            modalSubmitBtn.disabled = isProcessing;
            modalEmailInput.disabled = isProcessing;
            modalPasswordInput.disabled = isProcessing;

            modalGoogleWrap.classList.toggle('is-disabled', isProcessing);

            const isLogin = accountModalMode === 'login';

            if (isProcessing && provider === 'email') {
                modalSubmitBtn.textContent = isLogin
                    ? 'Logging in...'
                    : 'Creating account...';
            } else {
                modalSubmitBtn.textContent = isLogin
                    ? 'Log In & Continue →'
                    : 'Create Account & Continue →';
            }
        }

        async function completeAuthenticatedAccount(email) {
            if (isEmailResolved) return;
            if (!await dotNetHelper.invokeMethodAsync('NavigateAfterWorkspaceAuthentication')) return;

            const authenticatedEmail = (await dotNetHelper.invokeMethodAsync('GetWorkspaceSessionEmail') || '').trim();

            if (!authenticatedEmail) {
                showModalError('Your account is signed in, but we could not determine the account email.');
                setAccountFormProcessing(false);
                return;
            }

            if (!isEmailResolved) {
                isEmailResolved = true;
            }

            modalSuccess.classList.add('show');
            modalSubmitBtn.style.display = 'none';
            modalGoogleWrap.style.display = 'none';
            modalOrDivider.style.display = 'none';
            modalEmailInput.style.display = 'none';
            modalPasswordInput.style.display = 'none';

            hideEmailModalAfterSuccessfulSubmit();

            // New authenticated phase: reset to 0%, then begin image generation.
            startImageGenerationProgress();

            // Continue project association + Runware generation after modal closure.
            notifyEmailModalClosed(authenticatedEmail).catch(error => {
                console.error('Post-signup workspace generation failed:', error);
                window.designerIntroGenerationFailed(
                    'We could not finish generating your workspace. Please refresh and try again.'
                );
            });

            checkAndNotifyModalsClosed();
        }

        async function handleModalSubmit() {
            if (modalSubmitBtn.disabled) return;

            const email = modalEmailInput.value.trim();
            const password = modalPasswordInput.value;

            modalError.classList.remove('show');
            modalError.textContent = '';

            if (!email || !modalEmailInput.checkValidity()) {
                showModalError('Please enter a valid email address.');
                modalEmailInput.focus();
                return;
            }

            if (!password) {
                showModalError('Password is required.');
                modalPasswordInput.focus();
                return;
            }

            setAccountFormProcessing(true, 'email');

            try {
                if (!dotNetHelper) {
                    showModalError('The account form is still loading. Please try again.');
                    setAccountFormProcessing(false);
                    return;
                }

                const result = await dotNetHelper.invokeMethodAsync(
                    accountModalMode === 'login'
                        ? 'LoginWorkspaceAccount'
                        : 'CreateWorkspaceAccount',
                    email,
                    password
                );

                const success = result?.success ?? result?.Success ?? false;
                const errorMessage = result?.errorMessage ?? result?.ErrorMessage;

                if (!success) {
                    showModalError(errorMessage || (accountModalMode === 'login' ? 'Unable to log in. Please check your email and password.' : 'Unable to create your account. Please try again.'));
                    setAccountFormProcessing(false);
                    return;
                }

                await completeAuthenticatedAccount(email);
            } catch (error) {
                console.error(accountModalMode === 'login' ? 'Login failed:' : 'Account creation failed:', error);
                showModalError(accountModalMode === 'login' ? 'Unable to log in. Please try again.' : 'Unable to create your account. Please try again.');
                setAccountFormProcessing(false);
            }
        }

        function requestBrandModal() {
            brandModalRequested = true;
            openQueuedBrandModal();
        }

        function showBrandModal() {
            if (isEmailModalOpen || modalOverlay.classList.contains('active')) {
                brandModalRequested = true;
                return;
            }

            if (isBrandModalOpen || isBrandResolved) return;

            brandModalRequested = false;
            isBrandModalOpen = true;
            brandModal.style.display = '';
            brandModal.classList.add('active');
            introContainer.classList.add('blurred');
            brandModalSuccess.classList.remove('show');
            selectedBrandFeeling = null;
            brandOptionBtns.forEach(btn => btn.classList.remove('selected'));
        }

        function hideBrandModal() {
            brandModal.classList.remove('active');
            isBrandModalOpen = false;
            introContainer.classList.remove('blurred');

            if (!isBrandResolved) {
                isBrandResolved = true;
                notifyBrandModalClosed().finally(checkAndNotifyModalsClosed);
            }
        }

        function dismissBrandModal() {
            // Closing is not a selection. Do not choose a default value and do not
            // display the "Great choice" success state.
            selectedBrandFeeling = null;
            brandModalSuccess.classList.remove('show');
            brandOptionBtns.forEach(btn => btn.classList.remove('selected'));
            hideBrandModal();
        }

        function handleBrandSelection(value) {
            selectedBrandFeeling = value;
            brandOptionBtns.forEach(btn => btn.classList.toggle('selected', btn.dataset.value === value));
            brandModalSuccess.classList.add('show');
            setTimeout(hideBrandModal, 1200);
        }

        brandOptionBtns.forEach(btn => {
            btn.addEventListener('click', function () {
                if (!this.classList.contains('selected')) handleBrandSelection(this.dataset.value);
            });
        });

        brandModalCloseBtn.addEventListener('click', dismissBrandModal);

        brandModal.addEventListener('click', e => {
            if (e.target === brandModal) dismissBrandModal();
        });

        accountModeToggle.addEventListener('click', e => {
            e.preventDefault();

            if (modalSubmitBtn.disabled) return;

            applyAccountModalMode(
                accountModalMode === 'signup' ? 'login' : 'signup'
            );

            modalPasswordInput.value = '';
            modalEmailInput.focus();
        });

        modalSubmitBtn.addEventListener('click', handleModalSubmit);
        modalEmailInput.addEventListener('keydown', e => {
            if (e.key === 'Enter') handleModalSubmit();
        });
        modalPasswordInput.addEventListener('keydown', e => {
            if (e.key === 'Enter') handleModalSubmit();
        });

        // Intentionally no close button, skip handler, backdrop-close handler,
        // or Escape handler. This modal only closes after successful submission.

        async function finishProgress() {
            if (!isEmailResolved) {
                // The required account modal owns the transition to the next phase.
                // Do not mark progress complete before signup.
                return;
            }

            // After signup, the image generation progress sequence owns the bar.
            if (!isGenerationComplete && !isGenerationFailed) {
                return;
            }

            if (isGenerationComplete) {
                window.designerIntroGenerationComplete();
            }
        }

        function runSequence() {
            let switchCount = 0;
            const switchInterval = setInterval(() => {
                switchAvatar();
                searchBadge.innerHTML = `<i class="fas fa-search"></i> searching designer...`;
                switchCount++;

                if (switchCount >= 8) {
                    clearInterval(switchInterval);
                    pulseFound();
                    avatarSection.classList.add('compact');
                    introContainer.classList.remove('search-mode');
                    introContainer.classList.add('expanded');
                    showContent();

                    const stepDuration = 32000 / stages.length;
                    let stepIndex = 0;
                    updateProgress(stages[0].p, stages[0].label, stages[0].step, stages[0].icon, stages[0]);

                    setTimeout(showEmailModal, 4000);
                    setTimeout(requestBrandModal, 8000);

                    progressTimer = setInterval(() => {
                        stepIndex++;
                        if (stepIndex < stages.length) {
                            const stage = stages[stepIndex];
                            updateProgress(stage.p, stage.label, stage.step, stage.icon, stage);
                        }

                        if (stepIndex >= stages.length - 1) {
                            clearInterval(progressTimer);
                            finishProgress();
                        }
                    }, stepDuration);
                }
            }, 375);
        }

        preloadAvatarImages().finally(() => {
            setTimeout(runSequence, 2100);
        });
    };
</script>

