@inherits DesignMode.AI.Client.Components.GenerationAwareComponent
@using System.Collections.Generic
@using DesignMode.AI.Shared.Models
@using DesignMode.AI.Client.Services
@using Microsoft.AspNetCore.Components;
@using Microsoft.AspNetCore.Components.Authorization;
@using System.Text.RegularExpressions;
@if (IsBusy)
{
    <div class="modal-busy-overlay">
        <div class="loader-container" style="
    background-color: #fff;
    width: 250px;
    height: 250px;
    opacity: 1;
    border-radius: 10px;
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.15);
    padding-bottom: 7px;
    ">
            <div class="generating-text" style="
    font-size: 20px;
    ">
                Generating Image
            </div>
            <dotlottie-player src="https://lottie.host/fef2cd20-1bdf-4bd1-b1e3-5b8479431618/HUaIdfX7EN.lottie" background="transparent" speed="1" style="width: 150px;height: 150px;" direction="1" playmode="normal" loop="" autoplay=""></dotlottie-player>
        </div>
    </div>
    <!-- Lottie script -->
    <script src="https://unpkg.com/@@dotlottie/player-component@latest/dist/dotlottie-player.mjs" type="module"></script>
}

@if (Show)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="vertical-modal-wrapper" style="height: auto;min-height: fit-content;padding-bottom: 0px;width: 720px;padding-right: 41px;" @onclick:stopPropagation>
            <button class="modal-close" @onclick="CloseModal">×</button>

            <div class="modal-scroll-content" style="margin-left: 0px; margin-right: 0px; overflow-y: auto;">
                <div class="modal-header">
                    <h2 style="font-size: 25px;">Generate New Image for Your @DeliverableName</h2>
                </div>

                <div class="style-options">
                    <div class="style-option">
                        <label class="checkbox-container">
                            <input type="checkbox" checked="@KeepBrandStyle" @onchange="@((e) => KeepBrandStyle = (bool)e.Value)" />
                            <span class="checkmark"></span>
                            Keep brand style
                        </label>
                    </div>
                    <div class="style-option">
                        <label class="checkbox-container">
                            <input type="checkbox" checked="@ExploreNewStyle" @onchange="@((e) => ExploreNewStyle = (bool)e.Value)" />
                            <span class="checkmark"></span>
                            Explore new style
                        </label>
                    </div>
                </div>
                <!-- === Brand Image Selection Section === -->
                <div class="brand-image-section" style="    border: 2px solid #e6e7eb;
    border-radius: 10px;
    padding: 20px;">
                    <h4 style="font-size: 1.15rem;">Brand Image <span style="color: #9ca3af; font-weight: normal;">(optional)</span></h4>
                    <p class="brand-image-note" style="color: #000;font-size: 16px;font-weight:450;">Use a preloaded brand image or upload a new one to apply your brand style to the next generated image.</p>

                    <div class="brand-image-actions" style="
    margin-bottom: -4px;
    ">
                        <div class="preloaded-images">
                            @if (PreloadedBrandImages?.Count > 0)
                            {
                                <div class="brand-image-list">
                                    @foreach (var image in PreloadedBrandImages)
                                    {
                                        <img src="@image"
                                             class="brand-thumb @(SelectedBrandImage == image ? "selected" : "")"
                                             @onclick="@(() => SelectBrandImage(image))"
                                             alt="Brand image" />
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="no-images-note" style="
    padding-top: 8px;
        ">
                                    No preloaded images found.
                                </div>
                            }
                        </div>

                        <div class="upload-section" style="
    margin-right: 9px;
    ">
                            <label class="upload-button" style="background-color:black;color:white;">
                                <input type="file" accept="image/*" @onchange="UploadNewBrandImage" style="display:none;background-color:black;color:white;" />
                                Upload Brand Image
                            </label>
                        </div>
                    </div>
                </div>


                <div class="prompt-input-section">
                    <h4 style="font-size: 1.15rem;">Description <span style="color: #9ca3af; font-weight: normal;">(optional)</span></h4>
                    <textarea class="prompt-textarea"
                              placeholder="Describe what you want in your next image. You can include campaign goals, mood, or style details.  E.g., Create a bright, energetic image showcasing fitness and citrus vibes for a summer campaign."
                              @bind="ImageDescription"
                              rows="4"></textarea>
                </div>

                <div class="campaign-note">
                    This image will be added to your current @DeliverableName set.
                </div>

                <div class="generate-button-section">
                    <button class="generate-button" style="background-color: #244d88;" @onclick="GenerateImage">
                        Generate Image
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private ApiConfigService ApiConfig { get; set; }
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; }
    [Inject] private HttpClient Http { get; set; }

    private bool IsBusy = false;

    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public List<string> RunwareImageIds { get; set; } = new List<string>();
    [Parameter] public List<string> SecondaryRunwareImageIds { get; set; } = new List<string>();
    [Parameter] public List<DesignMode.AI.Client.Pages.Init.Gen.ConceptImageWithIdeaDto> SelectedImages { get; set; }
    [Parameter] public EventCallback<List<string>> OnImagesRemoved { get; set; }
    [Parameter] public EventCallback<bool> OnConfirm { get; set; }
    [Parameter] public string DeliverableName { get; set; } = "Social Media Campaign";
    [Parameter] public List<string> PromptTexts { get; set; } = new List<string>();
    [Parameter] public string PromptText { get; set; } = "";

    // Form state
    private string ImageDescription { get; set; } = "";
    private string finalPrompt { get; set; } = "";
    private bool KeepBrandStyle { get; set; } = true;
    private bool ExploreNewStyle { get; set; } = false;

    private List<string> PreloadedBrandImages { get; set; } = new(); // preloaded URLs
    private string SelectedBrandImage { get; set; }

    private void SelectBrandImage(string image)
    {
        SelectedBrandImage = image;
    }

    protected async override void OnParametersSet()
    {
        if (Show)
        {
            var deliverableName = DeliverableName;
            var normalizedDeliverable = Normalize(deliverableName);

            Console.WriteLine($"CreateNewImage modal opened for deliverable: {deliverableName}");

            // Check single PromptText
            if (!string.IsNullOrEmpty(PromptText))
            {
                var parts = PromptText.Split('|');
                if (parts.Length > 5)
                {
                    var normalizedPart = Normalize(parts[5]);

                    if (normalizedPart.Contains(normalizedDeliverable) ||
                        normalizedDeliverable.Contains(normalizedPart))
                    {
                        finalPrompt = PromptText;
                    }
                }
            }

            // Check PromptTexts list
            if (PromptTexts != null)
            {
                foreach (var prompt in PromptTexts)
                {
                    var parts = prompt.Split('|');
                    if (parts.Length > 5)
                    {
                        var normalizedPart = Normalize(parts[5]);

                        if (normalizedPart.Contains(normalizedDeliverable) ||
                            normalizedDeliverable.Contains(normalizedPart))
                        {
                            finalPrompt = prompt;
                            break;
                        }
                    }
                }
            }

            ImageDescription = "";
            KeepBrandStyle = true;
            ExploreNewStyle = false;
        }
    }

    private string Normalize(string input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return string.Empty;

        return Regex.Replace(input, @"[\s\-_\|]", "")
                    .ToLowerInvariant()
                    .Trim();
    }

    private string RunwareImageUrl { get; set; }

    private RunwareResponse RunwareResult { get; set; }

    private async Task<string> CallRunwareImageFunction(string positivePrompt, int width, int height, int numberResults)
    {
        HttpClient client = new HttpClient();
        string functionUrl = $"{ApiConfig.ApiBaseUrl}api/CallRunwareAPI?code=REDACTED_FOR_GROOMING";

        var requestBody = new
        {
            positivePrompt = positivePrompt,
            width = width,
            height = height,
            numberResults = numberResults
        };

        var response = await client.PostAsJsonAsync(functionUrl, requestBody);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<RunwareResponse>();

            if (result != null && result.Data != null)
            {
                var firstUrl = result.Data
                    .Where(img => !string.IsNullOrWhiteSpace(img.ImageURL))
                    .Select(img => img.ImageURL)
                    .FirstOrDefault();

                RunwareImageUrl = firstUrl;
                RunwareResult = result;

                Console.WriteLine($"Image URL: {RunwareImageUrl}");

                return RunwareImageUrl ?? string.Empty;
            }
        }
        else
        {
            Console.WriteLine($"Runware call failed: {response.StatusCode}");
        }

        return string.Empty;
    }


    private async Task UploadNewBrandImage(ChangeEventArgs e)
    {
        // Upload logic here
    }

    @code {
        // Add this parameter to receive the callback
        [Parameter]
        public EventCallback<string> OnImageGenerated { get; set; } // or whatever data type you need

        private async Task GenerateImage()
        {
            //IsBusy = true;
            //StateHasChanged();

            try
            {
                Console.WriteLine($"Generating image for deliverable: {DeliverableName}");
                Console.WriteLine($"Generating image with description: {ImageDescription}");
                Console.WriteLine($"Keep brand style: {KeepBrandStyle}");
                Console.WriteLine($"Explore new style: {ExploreNewStyle}");

                //var imageUrl = await CallRunwareImageFunction(finalPrompt, 896, 896, 1);

                var final = finalPrompt + "$$$" + DeliverableName;

                // Notify parent through the chain
                if (OnImageGenerated.HasDelegate)
                {
                    IsBusy = false;
                    await CloseModal();

                    if (Show) return;
                    await OnImageGenerated.InvokeAsync(final); // Pass whatever data you need
                    StateHasChanged();
                }

                // Simulate API call
                //await Task.Delay(1000);
                //await CloseModal();

                // Notify parent component (existing functionality)
                if (OnConfirm.HasDelegate)
                {
                    await OnConfirm.InvokeAsync(true);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error generating image: {ex.Message}");
            }
            finally
            {
                IsBusy = false;
                StateHasChanged();
            }
        }
    }

    private async Task CloseModal()
    {
        if (GenerationGuard is null && (IsBusy)) return;
        if (!await ConfirmGenerationCloseAsync()) return;

        Show = false;
        await ShowChanged.InvokeAsync(false);
    }
}

<style>
