    // Initialize on load and resize
    setMaxLeft();
    window.addEventListener('resize', setMaxLeft);

    function updateArrowVisibility(currentMargin) {
        const leftArrow = document.querySelector('.carousel-arrow.left');
        const rightArrow = document.querySelector('.carousel-arrow.right');

        if (!leftArrow || !rightArrow) return;

        // Hide LEFT arrow at starting position
        leftArrow.style.display = currentMargin >= MAX_RIGHT ? 'none' : 'flex';

        // Hide RIGHT arrow at ending position
        rightArrow.style.display = currentMargin <= MAX_LEFT ? 'none' : 'flex';
    }

    function getCurrentMargin(container) {
        if (container.style.marginLeft) {
            return parseInt(container.style.marginLeft) || 0;
        }
        return parseInt(window.getComputedStyle(container).marginLeft) || MAX_RIGHT;
    }

    // 🔥 Get exact width of ONE button including gap
    function getStepSize() {
        const firstButton = document.querySelector('.ai-recommendations-container button');
        if (!firstButton) return 100;

        const style = window.getComputedStyle(firstButton);
        const marginRight = parseInt(style.marginRight) || 0;

        return firstButton.offsetWidth + marginRight;
    }

    function moveAIRecommendationsLeft() {
        const container = document.querySelector('.ai-recommendations-container');
        if (!container) return;

        const STEP = getStepSize();
        let current = getCurrentMargin(container);
        let newMargin = Math.max(current - STEP, MAX_LEFT);

        container.style.transition = 'margin-left 0.3s ease-in-out';
        container.style.marginLeft = newMargin + 'px';
        //alert(MAX_LEFT);

        updateArrowVisibility(newMargin);
    }

    function moveAIRecommendationsRight() {
        const container = document.querySelector('.ai-recommendations-container');
        if (!container) return;

        const STEP = getStepSize();
        let current = getCurrentMargin(container);
        let newMargin = Math.min(current + STEP, MAX_RIGHT);

        container.style.transition = 'margin-left 0.3s ease-in-out';
        container.style.marginLeft = newMargin + 'px';
        //alert(container.style.marginLeft);

        updateArrowVisibility(newMargin);
    }

    document.addEventListener("DOMContentLoaded", function () {
        const container = document.querySelector('.ai-recommendations-container');
        if (!container) return;

        setMaxLeft(); // FIRST
        updateArrowVisibility(getCurrentMargin(container)); // THEN
        window.addEventListener('resize', setMaxLeft);
    });

    function getStepSize() {
        const firstButton = document.querySelector('.ai-recommendations-container button');
        const container = document.querySelector('.ai-recommendations-container');

        if (!firstButton || !container) return 200;

        const gap = parseInt(window.getComputedStyle(container).columnGap) || 0;

        const singleButtonSize = firstButton.offsetWidth + gap;

        const BUTTONS_PER_CLICK = 2; // 🔥 change this to 3, 4, etc.

        return singleButtonSize * BUTTONS_PER_CLICK;
    }
