    private async void HandleBrandKitToggle(string url, string id, string deliverable)
    {
        // Prevent concurrent actions
        if (isConfirming) return;

        selectedDeliverable = deliverable;
        PendingImageUrl = url;
        PendingImageId = id;

        bool isSaved = conceptImages.Any(x => x.ImageUrl == url);

        bool isMobile = await JSRuntime.InvokeAsync<bool>("isMobileScreen");

        try
        {
            if (isSaved)
            {
                // Remove from Brand Kit - both UI and database
                conceptImages.RemoveAll(x => x.ImageUrl == url);

                // Remove from database
                var deleteSuccess = await DeleteConceptImageFromDatabaseAsync(id);
                if (!deleteSuccess)
                {
                    Console.WriteLine("\u274c Failed to remove from database, reverting UI");
                    // Optionally revert UI if database operation fails
                    await LoadConceptImages(); // Reload from database to sync
                }

                if (!isMobile)
                {
                    TriggerCartAnimation();
                }

                StateHasChanged();
            }
            else
            {
                // Add to Brand Kit - both UI and database
                conceptImages.Add(new ConceptImageWithIdeaDto
                    {
                        ImageUrl = url,
                        ImageId = id,
                        DeliverableType = deliverable,
                        SubCategory = "Generic"
                    });

                // Save to database
                var saveResult = await SaveConceptImageToDatabaseAsync(id, CompanyIdeaId, promptIdfromCID);
                if (saveResult == null)
                {
                    Console.WriteLine("\u274c Failed to save to database, reverting UI");
                    // Revert UI if database operation fails
                    conceptImages.RemoveAll(x => x.ImageUrl == url);
                    await LoadConceptImages(); // Reload from database to sync
                }
                else
                {
                    if (!isMobile)
                    {
                        Console.WriteLine($"\u2705 Successfully saved to database with GUID: {saveResult}");

                        // Show concept balloon animation ONLY for successful save operations
                        _ = ShowDelayedConceptBalloonAnimation();
                    }
                }

                if (!isMobile)
                {
                    TriggerCartAnimation();
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"\u274c Error in HandleBrandKitToggle: {ex.Message}");
            // Reload from database to ensure UI is in sync
            await LoadConceptImages();
            StateHasChanged();
        }

        // Skip modal entirely for this path
        IsConfirmModalVisible = false;

        StateHasChanged();
    }

