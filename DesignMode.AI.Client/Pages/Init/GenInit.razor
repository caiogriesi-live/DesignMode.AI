            var imageIdeas = await CallGetImageIdeasFunctionInit(cid);

            // Find a prompt matching this deliverable
            var normalizedDeliverable = Normalize(deliverable);

            var matchedPrompt = imageIdeas?
                .FirstOrDefault(i =>
                    Normalize(i.SubCategory).Contains(normalizedDeliverable) ||
                    Normalize(i.DeliverableType).Contains(normalizedDeliverable)
                );

            if (matchedPrompt == null || string.IsNullOrWhiteSpace(matchedPrompt.ImagePrompt))
            {
                Console.WriteLine($"\u26a0\ufe0f No prompt found for deliverable: {deliverable}");
                return;
            }

            // Format final prompt EXACTLY the same way the modal sends it
            string formattedPrompt = $"{matchedPrompt.ImagePrompt}$$${deliverable}";

            // \u2705 Call the same generation handler as the modal
            await HandleImageGeneratedFromModal(formattedPrompt);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"\u274c Error auto-generating image: {ex.Message}");
        }
    }


    private List<VideoImageModel> groupedVideoImages = new();
