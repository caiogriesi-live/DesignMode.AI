        if (e.target === document || e.target === document.body || e.target === document.documentElement) {
            // Scrolling the main window
            scrollTop = window.scrollY || document.documentElement.scrollTop;
            scrollLeft = window.scrollX || document.documentElement.scrollLeft;
            console.log("Body scroll");
        } else {
            // Scrolling an element
            scrollTop = e.target.scrollTop;
            scrollLeft = e.target.scrollLeft;
            console.log("Element scroll:", e.target);
        }

        //alert(`Scroll position:\nTop: ${scrollTop}\nLeft: ${scrollLeft}`);
        const textStick = document.querySelector(".text-stick");
        const logoStick = document.querySelector(".logo-stick");
        const avatar = document.querySelector("img[src='assets/img/avatar.png']");

        if (scrollTop > 50) {
            textStick.classList.add("hide");
            textStick.classList.remove("show");
            logoStick.classList.add("show");
            logoStick.classList.remove("hide");

            // Adjust avatar position when scrolled (sticky header mode)
            if (avatar) {
                avatar.style.top = "50%"; // Move avatar higher when in sticky mode
                avatar.style.position = "absolute"; // Make it fixed position
                avatar.style.zIndex = "1001"; // Ensure it's above other elements
            }
        } else {
            textStick.classList.add("show");
            textStick.classList.remove("hide");
            logoStick.classList.add("hide");
            logoStick.classList.remove("show");

            // Reset avatar position when at top
            if (avatar) {
                avatar.style.top = "50%"; // Original position
                avatar.style.position = "absolute"; // Back to absolute
                avatar.style.zIndex = "auto"; // Reset z-index
            }
        }
    }, true);

    function adjustInputWidth(input) {
        const maxChars = 76;

        // Enforce the character limit
        if (input.value.length > maxChars) {
            input.value = input.value.substring(0, maxChars);
        }

        const span = document.createElement('span');
        span.style.visibility = 'hidden';
        span.style.position = 'absolute';
        span.style.whiteSpace = 'pre';
        span.style.font = window.getComputedStyle(input).font;

        span.textContent = input.value || input.placeholder;
        document.body.appendChild(span);

        // Add some padding and ensure it doesn't exceed the maximum width
        const newWidth = Math.min(span.offsetWidth + 20, 1200); // 1200px = approx. 76 chars in large font
        input.style.width = newWidth + 'px';

        document.body.removeChild(span);
    }

    function handleKeyDown(event) {
        if (event.key === "Enter") {
            // Trigger the click event on the 'Next' button when Enter is pressed
            document.getElementById('nextButton').click();
        }
    }

    window.registerClickOutside = (elementId, dotNetHelper, excludeId) => {
        const handler = (event) => {
            const popover = document.getElementById(elementId);
            const exclude = excludeId ? document.getElementById(excludeId) : null;

            // Check if we clicked outside both the popover and its trigger button
            const clickedOutside = (
                popover &&
                !popover.contains(event.target) &&
                (!exclude || !exclude.contains(event.target))
            );

            if (clickedOutside) {
                // Determine which popover to hide based on elementId
                if (elementId === "conceptPopover") {
                    dotNetHelper.invokeMethodAsync("HidePopover");
                } else if (elementId === "videosPopover") {
                    dotNetHelper.invokeMethodAsync("HideVideosPopover");
                } else if (elementId === "aiPopover") {
                    dotNetHelper.invokeMethodAsync("HideAIPopover");
                }

                // Clean up the event listener
                document.removeEventListener("click", handler);
            }
        };

        // Add the event listener with a slight delay to avoid immediate triggering
        setTimeout(() => {
            document.addEventListener("click", handler);
        }, 0);
    };
