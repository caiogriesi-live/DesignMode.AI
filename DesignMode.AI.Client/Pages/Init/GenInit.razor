<script>
    (function () {
        const root = document.querySelector('.btn-carousel');
        if (!root) return;

        const track = root.querySelector('.carousel-track');
        const leftBtn = root.querySelector('.carousel-arrow.left');
        const rightBtn = root.querySelector('.carousel-arrow.right');

        const updateArrows = () => {
            const maxScroll = track.scrollWidth - track.clientWidth;

            // If no overflow, hide both
            if (maxScroll <= 1) {
                leftBtn.classList.add('is-hidden');
                rightBtn.classList.add('is-hidden');
                return;
            }

            leftBtn.classList.toggle('is-hidden', track.scrollLeft <= 1);
            rightBtn.classList.toggle('is-hidden', track.scrollLeft >= maxScroll - 1);
        };

        const scrollByAmount = (dir) => {
            alert("test");
            // scroll by ~80% of visible width
            const amount = Math.max(180, Math.floor(track.clientWidth * 0.8));
            track.scrollBy({ left: dir * amount, behavior: 'smooth' });
        };

        leftBtn.addEventListener('click', () => scrollByAmount(-1));
        rightBtn.addEventListener('click', () => scrollByAmount(1));

        track.addEventListener('scroll', () => requestAnimationFrame(updateArrows));

        // update on resize + font/layout shifts
        const ro = new ResizeObserver(updateArrows);
        ro.observe(track);

        // initial
        updateArrows();
    })();
    window.isMobileScreen = () => {
        return window.innerWidth <= 768;
    };
</script>

