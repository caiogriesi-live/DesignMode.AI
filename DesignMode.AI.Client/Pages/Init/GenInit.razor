    private async Task LoadAndGroupAllImages()
    {
        isLoadingAllImages = true;
        StateHasChanged();

        try
        {
            var uri = NavigationManager.Uri;
            var queryString = new Uri(uri).Query;
            string cid = "company";

            if (!string.IsNullOrEmpty(cid))
            {
                var allImages = await CallGetImageIdeasFunctionInit(cid);
                var imageIdeas = allImages;
                // Add null check here
                if (allImages != null && allImages.Any())
                {
                    allImagesGenerated = allImages.ToList(); // Ensure it's a list

                    // Group images by DeliverableType and SubCategory
                    groupedImages = allImages
                        .Where(img => img != null && !string.IsNullOrEmpty(img.ImageUrl))
                        .GroupBy(img => GetGroupKey(img.DeliverableType, img.SubCategory))
                        .ToDictionary(
                            g => g.Key,
                            g => g.OrderBy(img => int.TryParse(img.CountId, out var val) ? val : int.MaxValue).ToList()
                        );

                    allImagesIdeasGenerated = imageIdeas;
                    if (imageIdeas != null && imageIdeas.Count > 0)
                    {
                        // Convert ImagePrompt properties into a List<string>
                        var imagePrompts = imageIdeas
                            .Where(i => !string.IsNullOrWhiteSpace(i.ImagePrompt))
                            .Select(i => i.ImagePrompt)
                            .ToList();

                        // Assign to your property that expects a list of strings
                        promptText = null;
                        promptTexts = imagePrompts;

                        // Still keep the full models if you need them
                        allImagesGenerated = imageIdeas
                            .Where(i => !string.IsNullOrWhiteSpace(i.ImageUrl))
                            .ToList();
                    }

                    // \u2705 Sort by TimeStamp ascending
                    var sortedIdeas = imageIdeas
                        //.Where(idea => !string.IsNullOrWhiteSpace(idea.ImageUrl))
                        .OrderBy(idea => Int32.Parse(idea.CountId))
                        .ToList();

                    // \u2705 Set MainDeliverable based on subcategory == "Generic"
                    var mainIdea = sortedIdeas.FirstOrDefault(idea =>
                        string.Equals(idea.SubCategory, "Generic", StringComparison.OrdinalIgnoreCase));

                    if (mainIdea != null)
                    {
                        MainDeliverable = mainIdea.DeliverableType;
                    }
                    StateHasChanged();
                }
                else
                {
                    allImagesGenerated = new List<ImageIdeaModelInit>();
                    groupedImages = new Dictionary<string, List<ImageIdeaModelInit>>();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading all images: {ex.Message}");
            allImagesGenerated = new List<ImageIdeaModelInit>(); // Initialize on error
            groupedImages = new Dictionary<string, List<ImageIdeaModelInit>>();
        }
        finally
        {
            isLoadingAllImages = false;
            StateHasChanged();
        }
    }
