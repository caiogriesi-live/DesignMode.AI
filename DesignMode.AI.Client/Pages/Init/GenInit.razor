    private bool IsLoadingVideo { get; set; } = false;

    private bool isRefreshingImages = false; // Add this with your other state variables

    private async Task RefreshAllImages()
    {
        try
        {
            IsLoadingVideo = true;
            StateHasChanged();

            var uri = NavigationManager.Uri;
            var queryString = new Uri(uri).Query;
            string cid = GetQueryParameter(queryString, "cid", null);

            var updatedImageIdeas = await CallGetImageIdeasFunctionInit(cid);

            if (updatedImageIdeas != null)
            {
                // \u2705 1. Normalize data (IMPORTANT FIX)
                foreach (var img in updatedImageIdeas)
                {
                    if (img == null) continue;

                    img.DeliverableType = img.DeliverableType?.Trim();
                    img.SubCategory = img.SubCategory?.Trim();
                }

                // 2. Filter valid images
                allImagesGenerated = updatedImageIdeas
                    .Where(i => i != null && !string.IsNullOrWhiteSpace(i.ImageUrl))
                    .OrderBy(img => int.TryParse(img.CountId, out var n) ? n : int.MaxValue)
                    .ToList();

                // \u2705 3. Safe MainDeliverable handling
                var cleanedMainDeliverable = MainDeliverable?.Replace("- ", "")?.Trim() ?? "";

                var mainDeliverableImages = allImagesGenerated
                    .Where(img =>
                        img != null &&
                        !string.IsNullOrWhiteSpace(img.DeliverableType) &&
                        img.DeliverableType.Equals(cleanedMainDeliverable, StringComparison.OrdinalIgnoreCase) &&
                        (string.IsNullOrWhiteSpace(img.SubCategory) ||
                         img.SubCategory.Equals("Generic", StringComparison.OrdinalIgnoreCase)))
                    .OrderBy(img => int.TryParse(img.CountId, out var val) ? val : int.MaxValue)
                    .ToList();

                RunwareImageUrls = mainDeliverableImages
                    .Select(img => img.ImageUrl)
                    .Where(url => !string.IsNullOrWhiteSpace(url))
                    .ToList();

                RunwareImageId = mainDeliverableImages
                    .Select(img => img.Id)
                    .Where(id => !string.IsNullOrWhiteSpace(id))
                    .ToList();

                // 4. All subcategories (clean)
                var allUniqueSubcategories = updatedImageIdeas
                    .Where(img =>
                        img != null &&
                        !string.IsNullOrWhiteSpace(img.SubCategory) &&
                        !img.SubCategory.Equals("Generic", StringComparison.OrdinalIgnoreCase))
                    .Select(img => img.SubCategory)
                    .Distinct()
                    .ToList();

                var subcategoriesWithImages = allImagesGenerated
                    .Where(img =>
                        img != null &&
                        !string.IsNullOrWhiteSpace(img.SubCategory) &&
                        !img.SubCategory.Equals("Generic", StringComparison.OrdinalIgnoreCase))
                    .Select(img => img.SubCategory)
                    .Distinct()
                    .ToList();

                var subcategoriesWithoutImages = allUniqueSubcategories
                    .Where(sub => !subcategoriesWithImages.Contains(sub))
                    .ToList();

                SecondaryDeliverables = subcategoriesWithImages
                    .Concat(subcategoriesWithoutImages)
                    .ToList();

                // 5. Secondary images with safety checks
                var secondaryImagesWithImages = allImagesGenerated
                    .Where(img =>
                        img != null &&
                        !string.IsNullOrWhiteSpace(img.SubCategory) &&
                        !img.SubCategory.Equals("Generic", StringComparison.OrdinalIgnoreCase))
                    .OrderBy(img => int.TryParse(img.CountId, out var val) ? val : int.MaxValue)
                    .ToList();

                SecondaryRunwareImageUrls = secondaryImagesWithImages
                    .Select(img => img.ImageUrl)
                    .Where(url => !string.IsNullOrWhiteSpace(url))
                    .ToList();

                SecondaryRunwareImageIds = secondaryImagesWithImages
                    .Select(img => img.Id)
                    .Where(id => !string.IsNullOrWhiteSpace(id))
                    .ToList();

                // 6. Rebuild groupedImages safely
                groupedImages = new Dictionary<string, List<ImageIdeaModelInit>>();

                // MAIN
                if (!string.IsNullOrEmpty(MainDeliverable))
                {
                    groupedImages[MainDeliverable] = allImagesGenerated
                        .Where(img =>
                            img != null &&
                            img.DeliverableType != null &&
                            img.DeliverableType.Equals(cleanedMainDeliverable, StringComparison.OrdinalIgnoreCase) &&
                            (string.IsNullOrWhiteSpace(img.SubCategory) ||
                             img.SubCategory.Equals("Generic", StringComparison.OrdinalIgnoreCase)))
                        .OrderBy(img => int.TryParse(img.CountId, out var val) ? val : int.MaxValue)
                        .ToList();
                }

                // SECONDARY (with images first order preserved)
                foreach (var deliverable in subcategoriesWithImages)
                {
                    groupedImages[deliverable] = allImagesGenerated
                        .Where(img =>
                            img != null &&
                            img.SubCategory != null &&
                            img.SubCategory.Equals(deliverable, StringComparison.OrdinalIgnoreCase))
                        .OrderBy(img => int.TryParse(img.CountId, out var val) ? val : int.MaxValue)
                        .ToList();
                }

                // SECONDARY (empty groups)
                foreach (var deliverable in subcategoriesWithoutImages)
                {
                    groupedImages[deliverable] = new List<ImageIdeaModelInit>();
                }
            }
            else
            {
                if (allImagesGenerated == null)
                {
                    allImagesGenerated = new List<ImageIdeaModelInit>();
                }

                RunwareImageUrls = new List<string>();
                RunwareImageId = new List<string>();
                SecondaryRunwareImageUrls = new List<string>();
                SecondaryRunwareImageIds = new List<string>();

                var allSubcategories = SecondaryDeliverables ?? new List<string>();

                var deliverablesWithImages = allImagesGenerated
                    .Where(img =>
                        img != null &&
                        !string.IsNullOrWhiteSpace(img.ImageUrl) &&
                        !string.IsNullOrWhiteSpace(img.SubCategory) &&
                        allSubcategories.Contains(img.SubCategory))
                    .Select(img => img.SubCategory)
                    .Distinct()
                    .ToList();

                var deliverablesWithoutImages = allSubcategories
                    .Where(sub => !deliverablesWithImages.Contains(sub))
                    .ToList();

                SecondaryDeliverables = deliverablesWithImages
                    .Concat(deliverablesWithoutImages)
                    .ToList();

                groupedImages = new Dictionary<string, List<ImageIdeaModelInit>>();

                if (!string.IsNullOrEmpty(MainDeliverable))
                {
                    groupedImages[MainDeliverable] = allImagesGenerated
                        .Where(img =>
                            img != null &&
                            img.DeliverableType?.Equals(MainDeliverable, StringComparison.OrdinalIgnoreCase) == true &&
                            (string.IsNullOrWhiteSpace(img.SubCategory) ||
                             img.SubCategory.Equals("Generic", StringComparison.OrdinalIgnoreCase)))
                        .OrderBy(img => int.TryParse(img.CountId, out var val) ? val : int.MaxValue)
                        .ToList();
                }

                foreach (var deliverable in SecondaryDeliverables)
                {
                    groupedImages[deliverable] = allImagesGenerated
                        .Where(img =>
                            img != null &&
                            img.SubCategory?.Equals(deliverable, StringComparison.OrdinalIgnoreCase) == true)
                        .OrderBy(img => int.TryParse(img.CountId, out var val) ? val : int.MaxValue)
                        .ToList();
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
        }
        finally
        {
            isRefreshingImages = false;
            IsLoadingVideo = false;
            StateHasChanged();
        }
    }

