    private string GetImageIdFromUrl(string url)
    {
        // Find the matching ID from your image collections
        if (RunwareImageUrls != null)
        {
            for (int i = 0; i < RunwareImageUrls.Count; i++)
            {
                if (RunwareImageUrls[i] == url)
                {
                    return RunwareImageId[i];
                }
            }
        }

        if (SecondaryRunwareImageUrls != null)
        {
            for (int i = 0; i < SecondaryRunwareImageUrls.Count; i++)
            {
                if (SecondaryRunwareImageUrls[i] == url)
                {
                    return SecondaryRunwareImageIds[i];
                }
            }
        }

        return string.Empty; // or handle null case as needed
    }
