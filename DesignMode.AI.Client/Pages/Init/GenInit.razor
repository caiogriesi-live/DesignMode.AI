    private async void OpenExpandForDeliverable(string deliverable)
    {
        try
        {
            var deliverableLower = deliverable?.ToLower() ?? "";

            // Social Media
            if (deliverableLower.Contains("social"))
            {
                OpenSocialPostModal();
            }
            // Website
            else if (deliverableLower.Contains("web") || deliverableLower.Contains("website"))
            {
                OpenWebsiteModal();
            }
            // Print Materials
            else if (deliverableLower.Contains("print"))
            {
                OpenPrintMaterialsModal();
            }
            // Package Label
            else if (deliverableLower.Contains("label") || deliverableLower.Contains("package"))
            {
                OpenPackageLabelModal();
            }
            // Digital Marketing
            else if (deliverableLower.Contains("digital") || deliverableLower.Contains("marketing"))
            {
                OpenDigitalMarketingModal();
            }
            // Video
            else if (deliverableLower.Contains("video"))
            {
                OpenVideoModal();
            }
            // Branding & Logo
            else if (deliverableLower.Contains("logo") || deliverableLower.Contains("brand"))
            {
                OpenBrandingModal();
            }
            // Event
            else if (deliverableLower.Contains("event"))
            {
                OpenEventModal();
            }
            else
            {
                // Fallback to AI Recommendations modal
                OpenAIRecommendationsModal();
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"\u274c Error opening expand modal for {deliverable}: {ex.Message}");
        }
    }
    private (string buttonText, bool shouldShow) GetExpandButtonInfo(string deliverable)
    {
        var deliverableLower = deliverable?.ToLower() ?? "";

        if (deliverableLower.Contains("social"))
            return ("Expand into Social Posts", true);
        else if (deliverableLower.Contains("web") || deliverableLower.Contains("website"))
            return ("Expand into Website", true);
        else if (deliverableLower.Contains("print"))
            return ("Expand into Print Materials", true);
        else if (deliverableLower.Contains("label") || deliverableLower.Contains("package"))
            return ("Expand into Package Label", true);
        else if (deliverableLower.Contains("digital") || deliverableLower.Contains("marketing"))
            return ("Expand into Digital Marketing", true);
        else if (deliverableLower.Contains("video"))
            return ("Expand into Video", true);
        else if (deliverableLower.Contains("logo") || deliverableLower.Contains("brand"))
            return ("Expand into Branding", true);
        else if (deliverableLower.Contains("event"))
            return ("Expand into Events & Activations", true);
        else
            return ("Expand", false);
    }
