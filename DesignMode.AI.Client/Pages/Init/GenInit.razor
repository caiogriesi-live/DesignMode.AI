    private async Task<string> GenerateUniqueVideoIdAsync()
    {
        string newGuid;

        while (true)
        {
            // 1. Generate new candidate GUID
            newGuid = Guid.NewGuid().ToString();

            // 2. Call your API to see if it exists
            var check = await CheckVideoIdExistsAsync(newGuid);

            // 3. If it does NOT exist → we are done
            if (check?.Exists == false)
            {
                Console.WriteLine("\u2705 Unique VideoId found: " + newGuid);
                return newGuid;
            }

            Console.WriteLine("\u26a0\ufe0f Duplicate VideoId generated, retrying...");
        }
    }
