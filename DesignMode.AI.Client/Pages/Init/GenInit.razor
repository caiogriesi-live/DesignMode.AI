    private async Task HandleImagesRemoved(List<string> removedImageIds)
    {
        // Remove from conceptImages
        conceptImages.RemoveAll(x => removedImageIds.Contains(x.ImageId));

        // Remove from SelectedImageUrls and SelectedImageIds
        var urlsToRemove = conceptImages
            .Where(x => removedImageIds.Contains(x.ImageId))
            .Select(x => x.ImageUrl)
            .ToList();

        foreach (var url in urlsToRemove)
        {
            SelectedImageUrls.Remove(url);
        }

        // Also remove from SelectedImageIds
        foreach (var id in removedImageIds)
        {
            SelectedImageIds.Remove(id);
        }

        await LoadConceptImages();
        StateHasChanged(); // Ensure UI updates
    }

    private async void OnImageConfirm(bool confirmed)
    {
        try
        {
            isConfirming = true;
            StateHasChanged();

            // Store pending values locally to avoid race conditions
            var pendingUrl = PendingImageUrl;
            var pendingId = PendingImageId;
            var pendingSave = PendingSave;

            bool isMobile = await JSRuntime.InvokeAsync<bool>("isMobileScreen");

            if (confirmed && !string.IsNullOrEmpty(pendingUrl))
            {
                // Add operation
                if (!conceptImages.Any(x => x.ImageUrl == pendingUrl || x.ImageId == pendingId))
                {
                    conceptImages.Add(new ConceptImageWithIdeaDto
                        {
                            ImageUrl = pendingUrl,
                            ImageId = pendingId,
                            // Add other required properties if needed
                            DeliverableType = "Generic", // or get from context
                            SubCategory = "Generic" // or get from context
                        });

                    // Update SelectedImageUrls immediately
                    SelectedImageUrls.Add(pendingUrl);
                    SelectedImageIds.Add(pendingId);

                    if (!isMobile)
                    {
                        TriggerCartAnimation();
                    }
                    StateHasChanged();
                }

                // Optional: reload from database to ensure consistency
                await Task.Delay(100); // Small delay
                await LoadConceptImages();
            }
            else if (!confirmed && !string.IsNullOrEmpty(pendingUrl))
            {
                // Remove operation - update UI immediately without waiting for database
                var removedCount = conceptImages.RemoveAll(x =>
                    x.ImageUrl == pendingUrl || x.ImageId == pendingId);

                if (removedCount > 0)
                {
                    // Update SelectedImageUrls immediately
                    SelectedImageUrls.Remove(pendingUrl);
                    SelectedImageIds.Remove(pendingId);

                    if (!isMobile)
                    {
                        TriggerCartAnimation();
                    }
                    StateHasChanged();
                }

                // Small delay before reloading from database
                await Task.Delay(100);
                await LoadConceptImages();
            }
        }
        finally
        {
            PendingImageUrl = null;
            PendingImageId = null;
            PendingSave = false;
            isConfirming = false;
            StateHasChanged();
        }
    }
