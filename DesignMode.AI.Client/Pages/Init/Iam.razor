@page "/init/iam"
@using Telerik.Blazor.Components
@using Telerik.SvgIcons
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<link href="assets/css/brief-landing.css" rel="stylesheet" />

<div class="role-select-wrapper">
    <div class="role-select-container">
        <!-- Header -->
        <div class="role-header">
            <div class="logo-container">
                <img src="assets/img/logo-left.png" width="26px" height="26px" alt="main_logo" />
                <span class="logo-text">
                    design<span class="logo-highlight">
                        <img src="images/logo-m3.svg" style="width: 30px; margin-left: 3px; margin-right: 3px; margin-bottom: 3px;">
                    </span>ode.ai
                </span>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content-role">
            <h1 class="page-title">Join the Creative Ecosystem</h1>
            <p class="page-subtitle">Select your role to continue — we'll tailor the experience just for you</p>

            <!-- Role Cards -->
            <div class="role-grid">
                <!-- Client Card -->
                <div class="role-card client-card @(selectedRole == RoleType.Client ? "selected" : "")"
                     @onclick="() => SelectRole(RoleType.Client)">
                    <div class="role-icon client-icon">
                        <TelerikSvgIcon Icon="@SvgIcon.User" />
                    </div>
                    <h2 class="role-title">I'm a Client</h2>
                    <p class="role-description">Start a project, hire top designers, and bring your vision to life</p>
                    <ul class="role-features">
                        <li><TelerikSvgIcon Icon="@SvgIcon.Check" /> Post design requests</li>
                        <li><TelerikSvgIcon Icon="@SvgIcon.Check" /> Work with vetted creators</li>
                        <li><TelerikSvgIcon Icon="@SvgIcon.Check" /> Track project milestones</li>
                    </ul>
                    <div class="role-check">
                        @if (selectedRole == RoleType.Client)
                        {
                            <TelerikSvgIcon Icon="@SvgIcon.CheckCircle" class="check-icon" />
                        }
                    </div>
                </div>

                <!-- Designer Card -->
                <div class="role-card designer-card @(selectedRole == RoleType.Designer ? "selected" : "")"
                     @onclick="() => SelectRole(RoleType.Designer)">
                    <div class="role-icon designer-icon">
                        <TelerikSvgIcon Icon="@SvgIcon.Brush" />
                    </div>
                    <h2 class="role-title">I'm a Designer</h2>
                    <p class="role-description">Showcase your portfolio, collaborate, and grow your creative career</p>
                    <ul class="role-features">
                        <li><TelerikSvgIcon Icon="@SvgIcon.Check" /> Access premium briefs</li>
                        <li><TelerikSvgIcon Icon="@SvgIcon.Check" /> Team up with brands</li>
                        <li><TelerikSvgIcon Icon="@SvgIcon.Check" /> Get featured & rewarded</li>
                    </ul>
                    <div class="role-check">
                        @if (selectedRole == RoleType.Designer)
                        {
                            <TelerikSvgIcon Icon="@SvgIcon.CheckCircle" class="check-icon" />
                        }
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="action-buttons">
                <TelerikButton OnClick="@ContinueWithRole"
                               Class="continue-button"
                               Enabled="@(selectedRole != null)">
                    <TelerikSvgIcon Icon="@SvgIcon.ArrowRight" />
                    Continue as @(selectedRole?.ToString() ?? "Guest")
                </TelerikButton>

@*                 <TelerikButton OnClick="@ResetSelection"
                               Class="reset-button"
                               Enabled="@(selectedRole != null)">
                    <TelerikSvgIcon Icon="@SvgIcon.Refresh" />
                    Clear Selection
                </TelerikButton> *@
            </div>
        </div>

        <!-- Loading Overlay -->
        @if (IsLoading)
        {
            <div class="loading-overlay">
                <div class="loading-spinner"></div>
                <p>@LoadingMessage</p>
            </div>
        }
    </div>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .role-select-wrapper {
        min-height: 100vh;
        width: 100%;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        overflow-x: hidden;
        position: relative;
        display: flex;
        align-items: flex-start;
    }

    .role-select-container {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        padding: 2rem;
        box-sizing: border-box;
    }

    .role-header {
        margin-bottom: 3rem;
        width: 100%;
    }

    .logo-container {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .logo-text {
        font-family: 'SF Pro Display', 'Arial', sans-serif;
        font-weight: 650;
        font-size: 24px;
        color: #1f2951;
    }

    .logo-highlight {
        color: #ffa900;
    }

    .main-content-role {
        text-align: center;
        width: 100%;
    }

    .page-title {
        font-family: 'SF Pro Display', 'Arial', sans-serif;
        font-size: clamp(28px, 5vw, 48px);
        font-weight: 700;
        color: #1f2951;
        margin-bottom: 1rem;
    }

    .page-subtitle {
        font-family: 'SF Pro Display', 'Arial', sans-serif;
        font-size: clamp(14px, 3vw, 18px);
        color: #6c757d;
        margin-bottom: 3rem;
    }

    .role-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2rem;
        margin-bottom: 3rem;
        width: 100%;
    }

    .role-card {
        flex: 1;
        min-width: 320px;
        max-width: 450px;
        background: white;
        border-radius: 28px;
        padding: 2rem 1.8rem;
        cursor: pointer;
        transition: all 0.3s ease;
        border: 2px solid transparent;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        position: relative;
        text-align: center;
    }

    .role-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
    }

    .role-card.selected {
        border-color: #ffa900;
        background: linear-gradient(135deg, #ffffff 0%, #fff9f0 100%);
        box-shadow: 0 15px 35px rgba(255, 169, 0, 0.2);
    }

    .client-card.selected {
        border-color: #4A90E2;
        background: linear-gradient(135deg, #ffffff 0%, #f0f7ff 100%);
    }

    .designer-card.selected {
        border-color: #ffa900;
        background: linear-gradient(135deg, #ffffff 0%, #fff9f0 100%);
    }

    .role-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 2.5rem;
    }

    .client-icon {
        background: linear-gradient(135deg, #e8f0fe 0%, #d4e4fc 100%);
        color: #4A90E2;
    }

    .designer-icon {
        background: linear-gradient(135deg, #fff0e0 0%, #ffe4cc 100%);
        color: #ffa900;
    }

    .role-icon svg {
        width: 44px;
        height: 44px;
    }

    .role-title {
        font-family: 'SF Pro Display', 'Arial', sans-serif;
        font-size: 1.75rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }

    .client-card .role-title {
        color: #4A90E2;
    }

    .designer-card .role-title {
        color: #ffa900;
    }

    .role-description {
        font-family: 'SF Pro Display', 'Arial', sans-serif;
        font-size: 1rem;
        color: #6c757d;
        margin-bottom: 1.5rem;
        line-height: 1.5;
    }

    .role-features {
        list-style: none;
        padding: 0;
        margin: 0;
        text-align: left;
    }

    .role-features li {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 0;
        font-family: 'SF Pro Display', 'Arial', sans-serif;
        font-size: 0.9rem;
        color: #495057;
    }

    .role-features li svg {
        width: 18px;
        height: 18px;
        color: #28a745;
        flex-shrink: 0;
    }

    .role-check {
        position: absolute;
        top: 20px;
        right: 20px;
    }

    .check-icon {
        color: #ffa900;
        width: 28px;
        height: 28px;
    }

    .client-card .check-icon {
        color: #4A90E2;
    }

    .action-buttons {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        margin-top: 2rem;
        width: 100%;
        flex-wrap: wrap;
    }

    .continue-button,
    .reset-button {
        padding: 12px 32px;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 50px;
        transition: all 0.3s ease;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: 'SF Pro Display', 'Arial', sans-serif;
        border: none;
    }

    .continue-button {
        background: linear-gradient(135deg, #ffa900 0%, #ff6b00 100%);
        color: white;
    }

    .continue-button:hover:not(.k-disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 169, 0, 0.4);
    }

    .continue-button.k-disabled,
    .continue-button:disabled {
        background: #ccc;
        cursor: not-allowed;
        transform: none;
        opacity: 0.6;
    }

    .reset-button {
        background: white;
        color: #6c757d;
        border: 2px solid #dee2e6;
    }

    .reset-button:hover:not(.k-disabled) {
        background: #f8f9fa;
        border-color: #adb5bd;
        color: #495057;
        transform: translateY(-2px);
    }

    .reset-button.k-disabled,
    .reset-button:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(8px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 20px;
        z-index: 1000;
    }

    .loading-spinner {
        width: 50px;
        height: 50px;
        border: 4px solid rgba(255, 255, 255, 0.2);
        border-top: 4px solid #ffa900;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .loading-overlay p {
        color: white;
        font-size: 1.125rem;
        font-family: 'SF Pro Display', 'Arial', sans-serif;
    }

    /* Responsive Styles */
    @@media (min-width: 1200px) {
        .main-content-role {
            margin-top: 50px !important;
        }
    }

    @@media (min-width: 768px) and (max-width: 1024px) {
        .role-select-container {
            padding: 1.5rem;
        }
        .role-grid {
            gap: 1.5rem;
        }
        .role-card {
            min-width: 280px;
            padding: 1.5rem;
        }
        .role-title {
            font-size: 1.5rem;
        }
    }

    @@media (min-width: 481px) and (max-width: 767px) {
        .role-select-container {
            padding: 1.25rem;
        }
        .role-header {
            margin-bottom: 2rem;
        }
        .role-grid {
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
        }
        .role-card {
            width: 100%;
            max-width: 400px;
        }
        .action-buttons {
            flex-direction: column;
            align-items: center;
        }
        .continue-button,
        .reset-button {
            width: 100%;
            max-width: 300px;
            justify-content: center;
        }
    }

    @@media (max-width: 480px) {
        .role-select-container {
            padding: 1rem;
        }
        .logo-text {
            font-size: 20px;
        }
        .page-title {
            font-size: 24px;
        }
        .page-subtitle {
            font-size: 14px;
            margin-bottom: 2rem;
        }
        .role-grid {
            flex-direction: column;
            gap: 1rem;
        }
        .role-card {
            min-width: auto;
            padding: 1.25rem;
        }
        .role-icon {
            width: 60px;
            height: 60px;
        }
        .role-icon svg {
            width: 32px;
            height: 32px;
        }
        .role-title {
            font-size: 1.25rem;
        }
        .role-description {
            font-size: 0.875rem;
        }
        .role-features li {
            font-size: 0.8rem;
        }
        .action-buttons {
            flex-direction: column;
            gap: 1rem;
        }
        .continue-button,
        .reset-button {
            width: 100%;
            justify-content: center;
            padding: 10px 20px;
        }
        .role-check {
            top: 12px;
            right: 12px;
        }
        .check-icon {
            width: 20px;
            height: 20px;
        }
    }

    @@media (max-width: 360px) {
        .role-card {
            padding: 1rem;
        }
        .role-features li {
            font-size: 0.75rem;
        }
    }
</style>

@code {
    private enum RoleType
    {
        Client,
        Designer
    }

    private RoleType? selectedRole;
    private bool IsLoading = false;
    private string LoadingMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not { IsAuthenticated: true })
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }
    }

    private void SelectRole(RoleType role)
    {
        selectedRole = role;
    }

    private void ResetSelection()
    {
        selectedRole = null;
    }

    private async Task ContinueWithRole()
    {
        if (selectedRole == null) return;

        IsLoading = true;
        
        if (selectedRole == RoleType.Client)
        {
            LoadingMessage = "Preparing your client dashboard...";
            await Task.Delay(1000);
            // Navigate to client onboarding or dashboard
            Navigation.NavigateTo("/init/designer-select");
        }
        else if (selectedRole == RoleType.Designer)
        {
            LoadingMessage = "Setting up your designer workspace...";
            await Task.Delay(1000);
            // Navigate to designer portfolio or workspace
            Navigation.NavigateTo("/init/designerdashboard");
        }
        
        IsLoading = false;
    }
}