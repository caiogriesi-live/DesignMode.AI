@inherits DesignMode.AI.Client.Components.GenerationAwareComponent
@inject DesignMode.AI.Client.Services.AIUsageRefreshService UsageRefresh
@using System.Collections.Generic
@using System.Net.Http.Json
@using System.Text
@using DesignMode.AI.Shared.Models
@using DesignMode.AI.Client.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop

@if (IsBusy && !IsGeneratingSocialPost)
{
    <div class="modal-busy-overlay"><div class="loader"></div></div>
}

@if (Show)
{
    <div class="modal-overlay generation-workspace-overlay" @onclick="CloseModal">
        <div class="vertical-modal-wrapper generation-workspace" @onclick:stopPropagation>
            <button class="modal-close"
                    @onclick="CloseModal">
                ×
            </button>

            <div class="modal-tabs">
                <button class="tab-button @(ActiveTab == TabType.GenerateNew ? "active" : "")"
                        @onclick="() => SetActiveTab(TabType.GenerateNew)">
                    <span class="tab-icon">✨</span> Generate New
                </button>

                <button class="tab-button @(ActiveTab == TabType.GeneratedSocial ? "active" : "")"
                        aria-label="Generated Social Posts"
                        @onclick="() => SetActiveTab(TabType.GeneratedSocial)"
                        disabled="@(!IsGeneratingSocialPost && !HasExistingVersions && string.IsNullOrWhiteSpace(GeneratedSocialContent))">
                    <span class="tab-icon">📱</span> Results
                    @if (IsGeneratingSocialPost)
                    {
                        <span class="tab-badge generating">Generating...</span>
                    }
                    else if (HasExistingVersions)
                    {
                        <span class="tab-badge">@sortedSocialPosts.Count</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(GeneratedSocialContent))
                    {
                        <span class="tab-badge">New</span>
                    }
                </button>
            </div>

            <div class="modal-scroll-content">
                @if (ActiveTab == TabType.GenerateNew)
                {
                    <div class="tab-content generate-new-tab">
                        <div class="modal-header">
                            <h2>Generate Social Media Post</h2>
                        </div>

                        <div class="modal-intro">
                            Select <strong>one image</strong>. The selected image becomes the visual reference for a brand-new, platform-ready social media post image.
                        </div>

                        <div class="social-media-status">
                            <span class="social-media-count">
                                <span class="social-media-icon">📱</span>
                                @if (HasSocialMediaImages())
                                {
                                    <span>Social media images ready</span>
                                    @if (SelectedImageIds.Any())
                                    {
                                        <span class="selection-count">1 selected</span>
                                    }
                                }
                                else
                                {
                                    <span class="no-images-title">No images available</span>
                                    <span> – Generate images first to unlock social post creation</span>
                                }
                            </span>
                        </div>

                        <AIRecommendationGenerationLoader IsVisible="@isGeneratingSocialImages" Message="Generating social media source image..." />
                        @if (IsBusy && !isGeneratingSocialImages)
                        {
                            <div class="loading-container text-center">
                                <div class="spinner-border text-primary mb-2"></div>
                                <p>Loading images...</p>
                            </div>
                        }
                        else if (!isGeneratingSocialImages)
                        {
                            <div class="image-grid">
                                @if (GetUniqueSocialMediaImages().Any())
                                {
                                    var groupedImages = GetUniqueSocialMediaImages()
                                    .GroupBy(img => string.Equals(img.SubCategory, "generic", StringComparison.OrdinalIgnoreCase)
                                    ? img.DeliverableType
                                    : img.SubCategory);

                                    @foreach (var group in groupedImages)
                                    {
                                        var firstImage = group.First();
                                        var sectionTitle = string.Equals(firstImage.SubCategory, "generic", StringComparison.OrdinalIgnoreCase)
                                        ? firstImage.DeliverableType
                                        : group.Key;
                                        var validImages = group
                                        .Where(i => !string.IsNullOrWhiteSpace(i.ImageUrl))
                                        .OrderBy(i => i.CountId)
                                        .ToList();

                                        if (validImages.Any())
                                        {
                                            <div class="deliverable-section">
                                                <h3 class="section-title">@(string.IsNullOrWhiteSpace(sectionTitle) ? "Social Media" : sectionTitle)</h3>
                                                <div class="image-col">
                                                    @foreach (var image in validImages)
                                                    {
                                                        @ImageCard(image)
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                                else if (!isGeneratingSocialImages)
                                {
                                    <div class="empty-state">
                                        <div class="empty-icon">📱</div>
                                        <h3>No Social Media Images Yet</h3>
                                        <p>Create a social-media-ready visual first, then use it as the reference for the final generated post.</p>
                                        <button class="generate-images-button"
                                                @onclick="GoToGenerateImages"
                                                disabled="@isGeneratingSocialImages">
                                            Generate Social Media Image
                                        </button>
                                    </div>
                                }

                                @if (isGeneratingSocialImages && !HasSocialMediaImages())
                                {
                                    <div class="image-generating-section">
                                        <h3 class="section-title">Generating Social Media Image...</h3>
                                        <div class="image-card image-card-loading">
                                            <div class="loading-placeholder">
                                                <div class="loading-spinner-small"></div>
                                                <span>Generating source image...</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <div class="social-config-section">
                            <h3>Social Media Configuration</h3>

                            <div class="config-options two-col">
                                <div class="config-option">
                                    <label>Platform</label>
                                    <select @bind="SelectedPlatform" @bind:after="PlatformChanged" class="config-select">
                                        <option value="Instagram">Instagram</option>
                                        <option value="Facebook">Facebook</option>
                                        <option value="X">X / Twitter</option>
                                        <option value="LinkedIn">LinkedIn</option>
                                        <option value="TikTok">TikTok</option>
                                        <option value="Pinterest">Pinterest</option>
                                    </select>
                                </div>

                                <div class="config-option">
                                    <label>Post Type</label>
                                    <select @bind="SelectedPostType" class="config-select">
                                        <option value="SingleImage">Single Image Post</option>
                                        <option value="Story">Story / Reel Cover</option>
                                        <option value="Ad">Sponsored Ad</option>
                                        <option value="Announcement">Announcement</option>
                                        <option value="Promotion">Promotion</option>
                                    </select>
                                </div>

                                <div class="config-option">
                                    <label>Aspect Ratio</label>
                                    <select @bind="SelectedAspectRatio" class="config-select">
                                        <option value="1:1">1:1 Square</option>
                                        <option value="4:5">4:5 Portrait</option>
                                        <option value="9:16">9:16 Story / Reel</option>
                                        <option value="16:9">16:9 Landscape</option>
                                        <option value="1.91:1">1.91:1 Wide</option>
                                    </select>
                                </div>

                                <div class="config-option">
                                    <label>Visual Style</label>
                                    <select @bind="SelectedVisualStyle" class="config-select">
                                        <option value="BrandMatched">Match Selected Image</option>
                                        <option value="CleanModern">Clean Modern</option>
                                        <option value="BoldPromotional">Bold Promotional</option>
                                        <option value="PremiumEditorial">Premium Editorial</option>
                                        <option value="Minimal">Minimal</option>
                                    </select>
                                </div>
                            </div>

                            <div class="custom-fields-section">
                                <h4>Post Content</h4>

                                <div class="config-option">
                                    <label>Caption / Creative Direction</label>
                                    <textarea @bind="PostCaption"
                                              class="config-textarea"
                                              placeholder="Optional. Enter the message, promotion, announcement, product, or idea the post should communicate. Leave blank and AI will derive it from the company and selected image."></textarea>
                                </div>

                                <div class="config-options two-col">
                                    <div class="config-option">
                                        <label>Call-to-Action</label>
                                        <input type="text"
                                               @bind="CallToActionText"
                                               class="config-input"
                                               placeholder="e.g. Shop Now, Learn More, Book Today" />
                                    </div>

                                    <div class="config-option">
                                        <label>Hashtag Count</label>
                                        <input type="number"
                                               min="0"
                                               max="30"
                                               @bind="HashtagCount"
                                               class="config-input" />
                                    </div>
                                </div>

                                <div class="checkbox-row">
                                    <label><input type="checkbox" @bind="IncludeHashtags" /> Generate Hashtags</label>
                                    <label><input type="checkbox" @bind="IncludeCTA" /> Include CTA</label>
                                    <label><input type="checkbox" @bind="IncludeBrandLogo" /> Include Brand Identity</label>
                                    <label><input type="checkbox" @bind="IncludeTextOnImage" /> Allow Text on Graphic</label>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="tab-content generated-social-tab">
                        <div class="modal-header">
                            <h2>Generated Social Media Post</h2>
                        </div>

                        @if (IsGeneratingSocialPost)
                        {
                            <div class="generation-loading-container">
                                <div class="generation-header">
                                    <h3>Creating Your Social Media Post</h3>
                                    <div class="generation-status">@GenerationStatus</div>
                                </div>

                                <div class="progress-bar-container">
                                    <div class="progress-bar" style="width: @(GenerationProgress)%;"></div>
                                </div>

                                <div class="current-step-details">@CurrentStepDetails</div>

                                <div class="generation-steps-log">
                                    <h4>Generation Steps:</h4>
                                    <div class="steps-list">
                                        @foreach (var step in GenerationSteps)
                                        {
                                            <div class="step-item">
                                                <span class="step-check">✓</span>
                                                <span>@step</span>
                                            </div>
                                        }
                                        @if (GenerationProgress < 100)
                                        {
                                            <div class="step-item current">
                                                <span class="step-spinner"></span>
                                                <span>@GenerationStatus</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="social-skeleton">
                                    <div class="skeleton-line wide"></div>
                                    <div class="skeleton-line short"></div>
                                    <div class="skeleton-image"></div>
                                    <div class="skeleton-line"></div>
                                </div>

                                <div class="generation-tip">
                                    💡 The AI is using the selected image as the visual reference for a completely new social media post graphic.
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(GenerationError))
                        {
                            <div class="generation-error">
                                <h3>Social post generation failed</h3>
                                <p>@GenerationError</p>
                                <button class="save-button" @onclick="() => SetActiveTab(TabType.GenerateNew)">Back to Generate New</button>
                            </div>
                        }
                        else if (ActiveSocialPost != null || HasExistingVersions || !string.IsNullOrWhiteSpace(GeneratedSocialContent))
                        {
                            @if (!string.IsNullOrWhiteSpace(GeneratedSocialContent))
                            {
                                <div class="generated-social-preview">
                                    <div class="preview-toolbar">
                                        <div>
                                            <div class="current-social-heading">
                                                <span class="current-social-pill">Current</span>
                                                <strong>@SelectedPlatform Social Post</strong>
                                            </div>
                                            <span class="preview-meta">@GetCurrentPreviewMeta()</span>
                                        </div>

                                        <div class="preview-actions">
                                            <button class="toolbar-button" @onclick="OpenGeneratedSocialPost">↗ Open</button>
                                            <button class="toolbar-button primary" @onclick="DownloadGeneratedSocialPost">📥 Download</button>
                                        </div>
                                    </div>

                                    <div class="social-preview-stage">
                                        <img src="@GeneratedSocialContent"
                                             alt="Current generated social media post"
                                             class="generated-social-image" />
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(GeneratedCaption))
                                    {
                                        <div class="caption-preview">
                                            <h4>Generated Caption</h4>
                                            <p>@GeneratedCaption</p>
                                            @if (!string.IsNullOrWhiteSpace(GeneratedHashtags))
                                            {
                                                <p class="hashtags">@GeneratedHashtags</p>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (sortedSocialPosts.Any())
                            {
                                <div class="generated-history">
                                    <div class="generated-history-header">
                                        <div>
                                            <h4>Generated Social Posts</h4>
                                            <p>Click any saved version to show it full-size above.</p>
                                        </div>
                                        <span class="generated-count">@sortedSocialPosts.Count</span>
                                    </div>

                                    <div class="history-grid">
                                        @foreach (var item in sortedSocialPosts.OrderByDescending(x => ParseDate(x.TimeStamp)))
                                        {
                                            var isActive = ActiveSocialPost != null &&
                                            string.Equals(item.Id, ActiveSocialPost.Id, StringComparison.OrdinalIgnoreCase);

                                            <button type="button"
                                                    class="history-card @(isActive ? "active" : "")"
                                                    @onclick="() => ViewSocialPost(item)">
                                                <div class="history-image-wrap">
                                                    <img src="@item.ImageUrl"
                                                         alt="Saved social post @item.Version"
                                                         class="history-thumb" />
                                                    @* <span class="history-version">@item.Version</span>
                                                    @if (isActive)
                                                    {
                                                        <span class="history-current">Current</span>
                                                    } *@
                                                </div>
                                                <div class="history-card-info">
                                                    <strong>@item.Platform</strong>
                                                    <span>@(string.IsNullOrWhiteSpace(item.PostType) ? "Social Post" : item.PostType)</span>
                                                    <small>@FormatDate(item.TimeStamp)</small>
                                                </div>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state generated-empty-state">
                                <div class="empty-icon">📱</div>
                                <h3>No Social Post Generated Yet</h3>
                                <p>Go to Generate New, select one image, and create your social media post.</p>
                                <button class="save-button" @onclick="() => SetActiveTab(TabType.GenerateNew)">Start Generating</button>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (ActiveTab == TabType.GenerateNew)
            {
                <div class="footer-actions sticky-footer">
                    <button class="discard-button"
                            @onclick="CloseModal">
                        Cancel
                    </button>
                    <button class="save-button"
                            @onclick="GenerateSocialPost"
                            disabled="@(!SelectedImageIds.Any() || IsGeneratingSocialPost || isGeneratingSocialImages)"
                            style="@(!SelectedImageIds.Any() ? "background-color:#eee; color:#ababab;" : null)">
                        @GetGenerateButtonText()
                    </button>
                </div>
            }
            else
            {
                <div class="footer-actions sticky-footer">
                    <button class="discard-button"
                            disabled="@IsGeneratingSocialPost"
                            @onclick="() => SetActiveTab(TabType.GenerateNew)">
                        ← Back to Generate New Post
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Inject] private ApiConfigService ApiConfig { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private AttributionContextService AttributionContext { get; set; } = default!;
    [Inject] private Blazored.LocalStorage.ILocalStorageService LocalStorage { get; set; } = default!;

    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public DesignMode.AI.Client.Pages.Init.MakeVideoModal.ImageIdeaCountResult AllIdeas { get; set; }
    [Parameter] public List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel> SelectedImages { get; set; } = new();
    [Parameter] public EventCallback<List<string>> OnImagesSelected { get; set; }
    [Parameter] public EventCallback<bool> OnSocialPostGenerated { get; set; }
    [Parameter] public Func<string, int, int, int, Task<string>> CallRunwareImageFunction { get; set; }
    [Parameter] public Func<string, string, string, string, string, string, string, Task<string>> CallSaveImageIdeaFunction { get; set; }
    [Parameter] public string CompanyIdeaId { get; set; } = "";
    [Parameter] public string CompanyDescription { get; set; } = "";
    [Parameter] public string PromptIdFromCID { get; set; } = "";
    [Parameter] public string MainPromptText { get; set; } = "";
    [Parameter] public EventCallback OnModalClosed { get; set; }

    private enum TabType { GenerateNew, GeneratedSocial }

    private TabType ActiveTab { get; set; } = TabType.GenerateNew;
    private bool IsBusy;
    private bool IsGeneratingSocialPost;
    private bool isGeneratingSocialImages;
    private bool wasImageGenerated;
    private bool hasLoadedVersions;
    private bool autoGenerationTriggered;
    private string GenerationStatus = "";
    private string CurrentStepDetails = "";
    private string GenerationError = "";
    private int GenerationProgress;
    private List<string> GenerationSteps = new();

    private string SelectedPlatform = "Instagram";
    private string SelectedPostType = "SingleImage";
    private string SelectedAspectRatio = "1:1";
    private string SelectedVisualStyle = "BrandMatched";
    private string PostCaption = "";
    private string CallToActionText = "";
    private bool IncludeHashtags = true;
    private bool IncludeCTA = true;
    private bool IncludeBrandLogo = true;
    private bool IncludeTextOnImage = true;
    private int HashtagCount = 10;

    private string SelectedCompanyName = "";
    private string currentVersion = "1";
    private string GeneratedSocialContent = "";
    private string GeneratedCaption = "";
    private string GeneratedHashtags = "";
    private HashSet<string> SelectedImageIds = new();
    private HashSet<string> SelectedImageUrls = new();
    private List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel> newlyGeneratedImages = new();
    private List<SocialRecord> sortedSocialPosts = new();
    private SocialRecord? ActiveSocialPost;

    private bool HasExistingVersions => sortedSocialPosts.Any();

    protected override async Task OnParametersSetAsync()
    {
        if (!Show)
            return;

        ReadCompanyFromCid();

        if (!hasLoadedVersions && !string.IsNullOrWhiteSpace(SelectedCompanyName))
        {
            await LoadExistingVersionsAsync();
            hasLoadedVersions = true;
        }

        if (!autoGenerationTriggered && !HasSocialMediaImages() && !isGeneratingSocialImages)
        {
            autoGenerationTriggered = true;
            await GoToGenerateImages();
        }
    }

    private void ReadCompanyFromCid()
    {
        try
        {
            var queryString = new Uri(NavigationManager.Uri).Query;
            var cid = GetQueryParameter(queryString, "cid", "");
            if (string.IsNullOrWhiteSpace(cid)) return;

            var parts = cid.Split(new[] { "|~~|@@|^^|" }, StringSplitOptions.None);
            if (parts.Length < 2) return;

            SelectedCompanyName = Encoding.UTF8.GetString(Convert.FromBase64String(parts[0]));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to decode company from cid: {ex.Message}");
        }
    }

    private string ReadIndustryFromCid()
    {
        try
        {
            var queryString = new Uri(NavigationManager.Uri).Query;
            var cid = GetQueryParameter(queryString, "cid", "");
            if (string.IsNullOrWhiteSpace(cid)) return "";

            var parts = cid.Split(new[] { "|~~|@@|^^|" }, StringSplitOptions.None);
            return parts.Length >= 2
                ? Encoding.UTF8.GetString(Convert.FromBase64String(parts[1]))
                : "";
        }
        catch
        {
            return "";
        }
    }

    private static string GetQueryParameter(string query, string key, string defaultValue)
    {
        if (string.IsNullOrWhiteSpace(query)) return defaultValue;
        var values = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(query);
        return values.TryGetValue(key, out var value) ? value.ToString() : defaultValue;
    }

    private bool HasSocialMediaImages() => GetUniqueSocialMediaImages().Any();

    private List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel> GetUniqueSocialMediaImages()
    {
        var allImages = new List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel>();
        if (SelectedImages != null) allImages.AddRange(SelectedImages);
        if (newlyGeneratedImages != null) allImages.AddRange(newlyGeneratedImages);

        return allImages
            .Where(img => !string.IsNullOrWhiteSpace(img.ImageUrl) &&
                (img.DeliverableType?.Contains("social", StringComparison.OrdinalIgnoreCase) == true ||
                 img.SubCategory?.Contains("social", StringComparison.OrdinalIgnoreCase) == true ||
                 img.DeliverableType?.Contains("digital", StringComparison.OrdinalIgnoreCase) == true ||
                 img.SubCategory?.Contains("digital", StringComparison.OrdinalIgnoreCase) == true))
            .GroupBy(img => img.ImageUrl, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();
    }

    private RenderFragment ImageCard(DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel image) => builder =>
    {
        var selected = SelectedImageIds.Contains(image.Id);
        var seq = 0;

        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", $"image-card selectable {(selected ? "selected" : "")}");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => ToggleSelection(image.ImageUrl, image.Id)));

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "image-card-inner");

        builder.OpenElement(seq++, "img");
        builder.AddAttribute(seq++, "src", image.ImageUrl);
        builder.AddAttribute(seq++, "alt", "Social media source image");
        builder.AddAttribute(seq++, "class", "selectable-image");
        builder.CloseElement();

        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "selection-indicator");
        builder.AddContent(seq++, selected ? "✓ Selected" : "Select");
        builder.CloseElement();

        builder.CloseElement();
        builder.CloseElement();
    };

    private async Task ToggleSelection(string url, string id)
    {
        SelectedImageIds.Clear();
        SelectedImageUrls.Clear();

        if (!string.IsNullOrWhiteSpace(id)) SelectedImageIds.Add(id);
        if (!string.IsNullOrWhiteSpace(url)) SelectedImageUrls.Add(url);

        if (OnImagesSelected.HasDelegate)
            await OnImagesSelected.InvokeAsync(SelectedImageIds.ToList());

        StateHasChanged();
    }

    private async Task PlatformChanged()
    {
        hasLoadedVersions = false;
        sortedSocialPosts.Clear();
        ActiveSocialPost = null;
        GeneratedSocialContent = "";
        await LoadExistingVersionsAsync();
        hasLoadedVersions = true;
    }

    private void SetActiveTab(TabType tab)
    {
        if (IsGeneratingSocialPost) return;
        ActiveTab = tab;
    }

    private string GetGenerateButtonText() =>
        SelectedImageIds.Any() ? "Generate Social Media Post" : "Select an Image to Generate Post";

    private async Task GenerateSocialPost()
    {
        if (IsGeneratingSocialPost || !SelectedImageIds.Any()) return;
        await using var generationOperation = await BeginGenerationAsync();

        IsGeneratingSocialPost = true;
        ActiveTab = TabType.GeneratedSocial;
        GenerationError = "";
        GenerationSteps.Clear();
        UpdateGenerationStatus("Starting social post generation...", "Preparing your selected image and post settings", 5);
        StateHasChanged();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated != true)
                throw new InvalidOperationException("You must be signed in to generate a social media post.");

            var allImages = new List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel>();
            if (SelectedImages != null) allImages.AddRange(SelectedImages);
            if (newlyGeneratedImages != null) allImages.AddRange(newlyGeneratedImages);

            UpdateGenerationStatus("Selecting reference image...", "Using your selected image as the visual reference", 15);
            var selectedImage = allImages.FirstOrDefault(img =>
                SelectedImageIds.Contains(img.Id) && !string.IsNullOrWhiteSpace(img.ImageUrl));

            if (selectedImage == null)
                throw new InvalidOperationException("The selected image could not be found.");

            ReadCompanyFromCid();
            var industry = ReadIndustryFromCid();
            if (string.IsNullOrWhiteSpace(SelectedCompanyName))
                throw new InvalidOperationException("Company name could not be determined.");

            if (!hasLoadedVersions)
            {
                await LoadExistingVersionsAsync();
                hasLoadedVersions = true;
            }

            var nextVersion = GetNextVersion();
            var versionText = $"v{nextVersion}";

            UpdateGenerationStatus("Building creative brief...", "Combining your selected image, platform, and post settings", 30);

            var generationContext = await AttributionContext.AuthorizeGenerationAsync(CompanyIdeaId);
            var request = new GenerateSocialPostRequest
                {
                    ImageUrl = selectedImage.ImageUrl,
                    SelectedImageId = selectedImage.Id,
                    CompanyName = SelectedCompanyName,
                    Industry = industry,
                    CompanyDescription = CompanyDescription,
                    Prompt = MainPromptText,
                    Platform = SelectedPlatform,
                    PostType = SelectedPostType,
                    AspectRatio = SelectedAspectRatio,
                    VisualStyle = SelectedVisualStyle,
                    Caption = PostCaption,
                    CallToAction = CallToActionText,
                    IncludeHashtags = IncludeHashtags,
                    HashtagCount = HashtagCount,
                    IncludeCTA = IncludeCTA,
                    IncludeBrandLogo = IncludeBrandLogo,
                    IncludeTextOnImage = IncludeTextOnImage,
                    GenerationJobId = Guid.NewGuid().ToString(),
                    ProjectId = generationContext?.ProjectId,
                    FunnelId = generationContext?.FunnelId
                };

            UpdateGenerationStatus("Generating social post...", "AI is creating a new social media post from the selected image", 55);

            using var message = new HttpRequestMessage(HttpMethod.Post,
                $"{ApiConfig.ApiBaseUrl}api/GenerateSocialMediaPost?code=REDACTED_FOR_GROOMING")
            { Content = JsonContent.Create(request) };
            var authToken = await LocalStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrWhiteSpace(authToken))
                message.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", authToken);
            var response = await Http.SendAsync(message);
            if (await UsageRefresh.HandleResponseAsync(response)) return;

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                throw new InvalidOperationException($"GenerateSocialMediaPost returned {(int)response.StatusCode}: {error}");
            }

            var result = await response.Content.ReadFromJsonAsync<GenerateSocialPostResult>();
            if (result == null || !result.Success || string.IsNullOrWhiteSpace(result.PreviewUrl))
                throw new InvalidOperationException(result?.Error ?? "The function did not return a generated social post image.");

            GeneratedSocialContent = result.PreviewUrl;
            GeneratedCaption = result.Caption ?? "";
            GeneratedHashtags = result.Hashtags ?? "";

            UpdateGenerationStatus("Saving social post image...", $"Saving {versionText} under SavedImages", 82);

            var saved = await SaveGeneratedSocialImageAsync(
                result.PreviewUrl,
                SelectedCompanyName,
                SelectedPlatform,
                nextVersion.ToString());

            if (saved == null || string.IsNullOrWhiteSpace(saved.ImageUrl))
                throw new InvalidOperationException("The generated social post image could not be saved.");

            GeneratedSocialContent = saved.ImageUrl;

            UpdateGenerationStatus("Saving social post version...", $"Adding {versionText} to social post history", 92);

            var socialId = GetLogicalSocialId(result.SocialPostId);
            await SaveSocialPostRecordAsync(new SaveSocialPostRecordRequest
                {
                    SocialId = socialId,
                    CompanyName = SelectedCompanyName,
                    Platform = SelectedPlatform,
                    Version = versionText,
                    TimeStamp = DateTime.UtcNow.ToString("o"),
                    ImageUrl = saved.ImageUrl,
                    Caption = GeneratedCaption,
                    Hashtags = GeneratedHashtags,
                    PostType = SelectedPostType,
                    AspectRatio = SelectedAspectRatio,
                    SourceImageUrl = selectedImage.ImageUrl
                });

            await LoadExistingVersionsAsync();
            currentVersion = nextVersion.ToString();

            var latest = sortedSocialPosts.FirstOrDefault(x =>
                string.Equals(x.Version, versionText, StringComparison.OrdinalIgnoreCase));

            if (latest != null)
                ViewSocialPost(latest);

            UpdateGenerationStatus("Complete!", "Your social media post was generated and saved successfully.", 100);

            if (OnSocialPostGenerated.HasDelegate)
                await OnSocialPostGenerated.InvokeAsync(true);
        }
        catch (Exception ex)
        {
            GenerationError = ex.Message;
            UpdateGenerationStatus("Error", ex.Message, 0);
            Console.WriteLine($"GenerateSocialPost error: {ex}");
        }
        finally
        {
            IsGeneratingSocialPost = false;
            IsBusy = false;
            StateHasChanged();
        }
    }

    private int GetNextVersion()
    {
        return sortedSocialPosts
            .Select(x => (x.Version ?? "").Replace("v", "", StringComparison.OrdinalIgnoreCase))
            .Select(x => int.TryParse(x, out var number) ? number : 0)
            .DefaultIfEmpty(0)
            .Max() + 1;
    }

    private string GetLogicalSocialId(string? generatedId)
    {
        var existing = sortedSocialPosts
            .Where(x => !string.IsNullOrWhiteSpace(x.SocialId))
            .OrderByDescending(x => ParseDate(x.TimeStamp))
            .Select(x => x.SocialId)
            .FirstOrDefault();

        if (!string.IsNullOrWhiteSpace(existing)) return existing;
        if (!string.IsNullOrWhiteSpace(generatedId)) return generatedId;
        return Guid.NewGuid().ToString();
    }

    private async Task<SaveSocialImageResponse?> SaveGeneratedSocialImageAsync(
        string imageUrl,
        string companyName,
        string platform,
        string version)
    {
        var response = await Http.PostAsJsonAsync(
            $"{ApiConfig.ApiBaseUrl}api/SaveSocialMediaPostImage?code=REDACTED_FOR_GROOMING",
            new
            {
                ImageUrl = imageUrl,
                CompanyName = companyName,
                Platform = platform,
                Version = version,
                FileName = "social-post.png"
            });

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            throw new InvalidOperationException($"SaveSocialMediaPostImage returned {(int)response.StatusCode}: {error}");
        }

        return await response.Content.ReadFromJsonAsync<SaveSocialImageResponse>();
    }

    private async Task SaveSocialPostRecordAsync(SaveSocialPostRecordRequest request)
    {
        var response = await Http.PostAsJsonAsync(
            $"{ApiConfig.ApiBaseUrl}api/SaveSocialMediaPost?code=REDACTED_FOR_GROOMING",
            request);

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            throw new InvalidOperationException($"SaveSocialMediaPost returned {(int)response.StatusCode}: {error}");
        }
    }

    private async Task LoadExistingVersionsAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectedCompanyName)) return;

        var response = await Http.PostAsJsonAsync(
            $"{ApiConfig.ApiBaseUrl}api/GetSocialMediaPostsByCompany?code=REDACTED_FOR_GROOMING",
            new
            {
                CompanyName = SelectedCompanyName,
                Platform = SelectedPlatform
            });

        if (!response.IsSuccessStatusCode)
        {
            sortedSocialPosts = new();
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<GetSocialPostsResponse>();
        sortedSocialPosts = result?.Data?
            .OrderByDescending(x => ParseDate(x.TimeStamp))
            .ToList() ?? new();

        var latest = sortedSocialPosts.FirstOrDefault();
        if (latest != null)
        {
            currentVersion = (latest.Version ?? "v1").Replace("v", "", StringComparison.OrdinalIgnoreCase);
            ViewSocialPost(latest);
        }
    }

    private void ViewSocialPost(SocialRecord item)
    {
        ActiveSocialPost = item;
        GeneratedSocialContent = item.ImageUrl ?? "";
        GeneratedCaption = item.Caption ?? "";
        GeneratedHashtags = item.Hashtags ?? "";
        SelectedPlatform = string.IsNullOrWhiteSpace(item.Platform) ? SelectedPlatform : item.Platform;
        currentVersion = (item.Version ?? "v1").Replace("v", "", StringComparison.OrdinalIgnoreCase);
    }

    private async Task OpenGeneratedSocialPost()
    {
        if (!string.IsNullOrWhiteSpace(GeneratedSocialContent))
            await JS.InvokeVoidAsync("open", GeneratedSocialContent, "_blank");
    }

    private async Task DownloadGeneratedSocialPost()
    {
        if (string.IsNullOrWhiteSpace(GeneratedSocialContent)) return;

        var fileName = $"{Sanitize(SelectedCompanyName)}-{Sanitize(SelectedPlatform)}-social-v{currentVersion}.png";
        await JS.InvokeVoidAsync("eval", $@"
            (() => {{
                const a = document.createElement('a');
                a.href = '{EscapeJs(GeneratedSocialContent)}';
                a.download = '{EscapeJs(fileName)}';
                a.target = '_blank';
                document.body.appendChild(a);
                a.click();
                a.remove();
            }})();");
    }

    private string GetCurrentPreviewMeta()
    {
        var version = ActiveSocialPost?.Version ?? $"v{currentVersion}";
        var type = ActiveSocialPost?.PostType ?? SelectedPostType;
        var ratio = ActiveSocialPost?.AspectRatio ?? SelectedAspectRatio;
        return $"{version} · {type} · {ratio}";
    }

    private static DateTime ParseDate(string? value) =>
        DateTime.TryParse(value, out var dt) ? dt : DateTime.MinValue;

    private static string FormatDate(string? value) =>
        DateTime.TryParse(value, out var dt) ? dt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt") : (value ?? "");

    private static string Sanitize(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "social";
        return new string(value
            .Where(ch => char.IsLetterOrDigit(ch) || ch == '-' || ch == '_')
            .ToArray());
    }

    private static string EscapeJs(string value) =>
        value.Replace("\\", "\\\\").Replace("'", "\\'").Replace("\r", "").Replace("\n", "");

    private void UpdateGenerationStatus(string status, string details, int progress)
    {
        if (!string.IsNullOrWhiteSpace(GenerationStatus) &&
            GenerationProgress > 0 &&
            !GenerationStatus.Equals(status, StringComparison.OrdinalIgnoreCase))
        {
            if (!GenerationSteps.Contains(GenerationStatus))
                GenerationSteps.Add(GenerationStatus);
        }

        GenerationStatus = status;
        CurrentStepDetails = details;
        GenerationProgress = progress;
        StateHasChanged();
    }

    private async Task GoToGenerateImages()
    {
        if (isGeneratingSocialImages) return;
        await using var generationOperation = await BeginGenerationAsync();
        if (CallRunwareImageFunction == null || CallSaveImageIdeaFunction == null) return;

        isGeneratingSocialImages = true;
        StateHasChanged();

        try
        {
            var prompt = BuildSourceImagePrompt();
            var imageUrl = await CallRunwareImageFunction(prompt, 1024, 1024, 1);
            if (string.IsNullOrWhiteSpace(imageUrl)) return;

            var timestamp = DateTime.UtcNow.ToString("yyyyMMddTHHmmssZ");
            var allImages = new List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel>();
            if (SelectedImages != null) allImages.AddRange(SelectedImages);
            if (newlyGeneratedImages != null) allImages.AddRange(newlyGeneratedImages);

            var nextCountId = allImages
                .Select(img => int.TryParse(img.CountId, out var count) ? count : 0)
                .DefaultIfEmpty(0)
                .Max() + 1;

            var savedId = await CallSaveImageIdeaFunction(
                "Social Media Content",
                "Generic",
                prompt,
                imageUrl,
                PromptIdFromCID,
                timestamp,
                nextCountId.ToString());

            newlyGeneratedImages.Clear();
            newlyGeneratedImages.Add(new DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel
                {
                    Id = string.IsNullOrWhiteSpace(savedId) ? Guid.NewGuid().ToString() : savedId,
                    ImageUrl = imageUrl,
                    ImagePrompt = prompt,
                    DeliverableType = "Social Media Content",
                    SubCategory = "Generic",
                    CountId = nextCountId.ToString()
                });

            wasImageGenerated = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Generate social source image failed: {ex.Message}");
        }
        finally
        {
            isGeneratingSocialImages = false;
            StateHasChanged();
        }
    }

    private string BuildSourceImagePrompt()
    {
        var company = string.IsNullOrWhiteSpace(SelectedCompanyName) ? "the brand" : SelectedCompanyName;
        return $"Create one polished social-media-ready visual for {company}. " +
               $"Use this brand direction: {MainPromptText}. Company context: {CompanyDescription}. " +
               "Do not add browser chrome, phone mockups, editor UI, or presentation boards. Generate the finished visual itself.";
    }

    private async Task CloseModal()
    {
        if (GenerationGuard is null && (IsBusy || IsGeneratingSocialPost || isGeneratingSocialImages)) return;
        if (!await ConfirmGenerationCloseAsync()) return;

        Show = false;
        autoGenerationTriggered = false;
        hasLoadedVersions = false;
        await ShowChanged.InvokeAsync(false);

        if (OnModalClosed.HasDelegate && wasImageGenerated)
            await OnModalClosed.InvokeAsync();
    }

