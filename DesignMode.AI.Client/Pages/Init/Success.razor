    private async Task<InviteClientDataSuccess?> GetInviteClientByIdAsync(string id)
    {
        try
        {
            using HttpClient client = new HttpClient();

            string functionUrl =
                $"{ApiConfig.ApiBaseUrl}api/GetInviteClientById?code=REDACTED_FOR_GROOMING";

            var requestBody = new
            {
                Id = id
            };

            var jsonContent = new StringContent(
                JsonConvert.SerializeObject(requestBody),
                Encoding.UTF8,
                "application/json");

            var response = await client.PostAsync(functionUrl, jsonContent);

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();

                var inviteClientData = JsonConvert.DeserializeObject<InviteClientDataSuccess>(json);

                return inviteClientData;
            }

            Console.WriteLine(
                $"❌ Failed to fetch invite client. Status: {response.StatusCode}");

            return null;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"❌ Exception in GetInviteClientByIdAsync: {ex.Message}");

            return null;
        }
    }

