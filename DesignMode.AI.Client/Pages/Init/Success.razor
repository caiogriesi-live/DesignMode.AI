    private async void ExecuteRedirect(InviteClientDataSuccess inviteResponse)
    {
        if (!isProcessing) return;

        // Clean up timers
        countdownTimer?.Stop();
        countdownTimer?.Dispose();
        redirectTimer?.Stop();
        redirectTimer?.Dispose();

        isProcessing = false;
        showProcessingNotification = false;

        if (WebsiteContext is not null)
        {
            await JS.InvokeVoidAsync("designModeAttribution.markFunnelComplete");
            NavigationManager.NavigateTo(WebsiteContext.WorkspaceUrl, forceLoad: true);
            return;
        }

        var timestampCompanyIdeaId = DateTime.UtcNow.ToString("yyyyMMddTHHmmssZ");
        var existingInfo = $"{Convert.ToBase64String(Encoding.UTF8.GetBytes(inviteResponse.Name))}|~~|@@|^^|{Convert.ToBase64String(Encoding.UTF8.GetBytes(inviteResponse.Industry))}|~~|@@|^^|{timestampCompanyIdeaId}";
        var prompt = $"{inviteResponse.Prompt}";

        var url = $"init/gen?name={Uri.EscapeDataString(inviteResponse.Name)}" +
          $"&industry={Uri.EscapeDataString(inviteResponse.Industry)}" +
          $"&cid={Uri.EscapeDataString(existingInfo)}" +
          $"&prompt={Uri.EscapeDataString(":" + prompt)}";

        string[] inviteDataArr = Array.Empty<string>();

        if (!string.IsNullOrWhiteSpace(Imagepath))
        {
            inviteDataArr = System.Text.Json.JsonSerializer.Deserialize<string[]>(Imagepath)
                            ?? Array.Empty<string>();
        }

        if (!string.IsNullOrWhiteSpace(Imagepath) && inviteDataArr.Length > 0)
        {
            url += $"&seed={Uri.EscapeDataString(inviteDataArr[0])}";
        }

        var uri = new Uri(NavigationManager.Uri);

        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        var sessionId = query["session_id"];
        var inviteId = query["inviteId"];

        if (!string.IsNullOrWhiteSpace(inviteId))
        {
            url += $"&inviteid={Uri.EscapeDataString(inviteId)}";
        }

        await JS.InvokeVoidAsync("designModeAttribution.markFunnelComplete");
        NavigationManager.NavigateTo(url, forceLoad: true);
    }
    private async Task<CheckSubscriptionResponse> CheckUserSubscription(string email, string url)
    {
        using HttpClient client = new HttpClient();

        string functionUrl =
            $"{url}api/CheckUserSubscription?email={Uri.EscapeDataString(email)}&code=REDACTED_FOR_GROOMING";

        var response = await client.GetAsync(functionUrl);

        if (response.IsSuccessStatusCode)
        {
            var json = await response.Content.ReadAsStringAsync();

            var result = System.Text.Json.JsonSerializer.Deserialize<CheckSubscriptionResponse>(
                json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
            );

            return result;
        }

        return new CheckSubscriptionResponse
            {
                Success = false,
                HasSubscription = false
            };
    }

