@page "/init/success"
@using Telerik.Blazor.Components
@using Telerik.Blazor
@using Telerik.SvgIcons
@using DesignMode.AI.Client.Services
@using Microsoft.AspNetCore.Components;
@using Microsoft.AspNetCore.Components.Authorization;
@using System.Text;
@using DesignMode.AI.Shared.Models;
@using Newtonsoft.Json;
@using System.Text.RegularExpressions;
@using DesignMode.AI.Client.Pages;
@using DesignMode.AI.Client.Pages.Init;
@inject NavigationManager NavigationManager
@inject ApiConfigService ApiConfig
@inject AuthenticationStateProvider AuthStateProvider
@inject SessionService _sessionService
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IJSRuntime JS
@* Make sure to call the database to verify payment *@
@if (isSuccessPage)
{
    <!-- PROCESSING NOTIFICATION OVERLAY -->
    @if (showProcessingNotification)
    {
        <div class="redirect-notification-overlay">
            <div class="redirect-notification-card processing-card">
                <div class="processing-icon">✨</div>
                <h3 class="redirect-title">@processingTitle</h3>
                <p class="redirect-message">@processingMessage</p>

                <!-- Progress Steps -->
                <div class="progress-steps">
                    <div class="progress-step @(currentStep >= 1 ? "completed" : "") @(currentStep == 1 ? "active" : "")">
                        <div class="step-indicator">
                            @if (currentStep > 1)
                            {
                                <span>✓</span>
                            }
                            else
                            {
                                <span>1</span>
                            }
                        </div>
                        <div class="step-label">Unlocking Brand System</div>
                    </div>
                    <div class="progress-step @(currentStep >= 2 ? "completed" : "") @(currentStep == 2 ? "active" : "")">
                        <div class="step-indicator">
                            @if (currentStep > 2)
                            {
                                <span>✓</span>
                            }
                            else
                            {
                                <span>2</span>
                            }
                        </div>
                        <div class="step-label">Generating Brand Ideas</div>
                    </div>
                    <div class="progress-step @(currentStep >= 3 ? "completed" : "") @(currentStep == 3 ? "active" : "")">
                        <div class="step-indicator">
                            @if (currentStep > 3)
                            {
                                <span>✓</span>
                            }
                            else
                            {
                                <span>3</span>
                            }
                        </div>
                        <div class="step-label">Creating Visual Assets</div>
                    </div>
                    <div class="progress-step @(currentStep >= 4 ? "completed" : "") @(currentStep == 4 ? "active" : "")">
                        <div class="step-indicator">
                            @if (currentStep > 4)
                            {
                                <span>✓</span>
                            }
                            else
                            {
                                <span>4</span>
                            }
                        </div>
                        <div class="step-label">Saving Your Progress</div>
                    </div>
                </div>

                <!-- Carousel Section - Shows at Step 3 -->
                @if (currentStep >= 3 && generatedDeliverables.Any())
                {
                    <div class="carousel-container">
                        <div class="carousel-header">
                            <span class="carousel-icon">🎨</span>
                            <span class="carousel-title">Generated Visual Assets</span>
                        </div>

                        <div class="carousel-content">
                            <button class="carousel-nav prev" @onclick="PrevDeliverable" disabled="@(currentDeliverableIndex == 0)">
                                ‹
                            </button>

                            <div class="carousel-slide">
                                <div class="deliverable-name">@generatedDeliverables[currentDeliverableIndex].Name</div>

                                @if (generatedDeliverables[currentDeliverableIndex].ImageUrl != null)
                                {
                                    <div class="deliverable-image-wrapper @(currentDeliverableIndex == newDeliverableIndex ? "new-image-animation" : "")">
                                        <img src="@generatedDeliverables[currentDeliverableIndex].ImageUrl"
                                             alt="@generatedDeliverables[currentDeliverableIndex].Name"
                                             class="deliverable-image" />
                                        <div class="image-badge">Asset @(currentDeliverableIndex + 1) of @generatedDeliverables.Count</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="deliverable-image-placeholder">
                                        <div class="generating-spinner"></div>
                                        <p>Generating image...</p>
                                    </div>
                                }
                            </div>

                            <button class="carousel-nav next" @onclick="NextDeliverable" disabled="@(currentDeliverableIndex == generatedDeliverables.Count - 1)">
                                ›
                            </button>
                        </div>

                        <div class="carousel-dots">
                            @for (int i = 0; i < generatedDeliverables.Count; i++)
                            {
                                <div class="dot @(currentDeliverableIndex == i ? "active" : "")"
                                     @onclick="() => GoToDeliverable(i)">
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Loading Spinner -->
                @if (currentStep <= 4)
                {
                    <div class="loading-spinner">
                        <div class="spinner"></div>
                    </div>
                }

                <!-- Success Message -->
                @if (currentStep > 4)
                {
                    <div class="completion-message">
                        <div class="completion-icon">🎉</div>
                        <p>All set! Redirecting you to your brand studio...</p>
                        <div class="redirect-progress">
                            <div class="redirect-progress-bar" style="width: @((3 - countdown) / 3f * 100)%"></div>
                        </div>
                    </div>
                }

                <button class="redirect-cancel-btn" @onclick="CancelProcessing">
                    Cancel
                </button>
            </div>
        </div>
    }

    <!-- SUCCESS/THANK YOU PAGE -->
    <div class="dashboard-container">
        <div class="main-wrapper">
            <div class="inner-content full-height success-container">

                <!-- SUCCESS ANIMATION -->
                <div class="success-animation">
                    <div class="checkmark-circle">
                        <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                            <circle class="checkmark__circle" cx="26" cy="26" r="25" fill="none" stroke="#10b981" stroke-width="4" />
                            <path class="checkmark__check" fill="none" stroke="#10b981" stroke-width="4" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
                        </svg>
                    </div>
                </div>

                <!-- THANK YOU MESSAGE -->
                <h1 class="success-title">Thank You for Your Purchase! 🎉</h1>
                <p class="success-subtitle">Your payment was successful and your account has been upgraded.</p>

                <!-- PLAN DETAILS -->
                <div class="plan-details-card">
                    <div class="plan-icon">✨</div>
                    <h3 class="plan-details-title">@selectedPlanName Plan Activated</h3>
                    <div class="plan-details-billing">@billingDescription</div>
                    <div class="plan-details-price">@priceDisplay</div>
                </div>

                <!-- WHAT'S NEXT -->
                <div class="whats-next-section">
                    <h3 class="whats-next-title">What's next?</h3>
                    <div class="next-steps-grid">
                        <div class="next-step-card">
                            <div class="step-icon">🚀</div>
                            <h4>Start Creating</h4>
                            <p>Access all your premium features and AI tools</p>
                        </div>
                        <div class="next-step-card">
                            <div class="step-icon">📧</div>
                            <h4>Check Your Email</h4>
                            <p>We've sent a confirmation receipt to your inbox</p>
                        </div>
                        <div class="next-step-card">
                            <div class="step-icon">💬</div>
                            <h4>Need Help?</h4>
                            <p>Contact our support team anytime</p>
                        </div>
                    </div>
                </div>
                <!-- SHARE SECTION -->
                <div class="share-section">
                    <p class="share-text">Love your new plan? Share with your team! 🎯</p>
                    <div class="share-buttons">
                        <button class="share-btn" @onclick="CopyInviteLink">
                            📋 Copy Invite Link
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
}
else
{
    <!-- ORIGINAL UPGRADE PAGE -->
    <div class="dashboard-container">
        <div class="main-wrapper">
            <div class="inner-content full-height">

                <!-- TOP BAR -->
                <div class="top-bar">
                    <div class="page-header">
                        <span class="designer-badge" style="cursor:pointer;" @onclick="GoBack">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" style="margin-left: 2px;">
                                <path d="M228,128a12,12,0,0,1-12,12H69l51.52,51.51a12,12,0,0,1-17,17l-72-72a12,12,0,0,1,0-17l72-72a12,12,0,0,1,17,17L69,116H216A12,12,0,0,1,228,128Z"></path>
                            </svg>
                        </span>

                        <h1 class="page-title">Choose the right plan for you ✨</h1>
                        <p class="page-subtitle">Turn your selected concept into fully unlocked brand systems.</p>
                    </div>

                    <!-- SECURE CHECKOUT BADGE - TOP RIGHT -->
                    <div class="secure-badge">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2L4 6V12C4 16.97 7.84 21.74 12 22C16.16 21.74 20 16.97 20 12V6L12 2Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                            <path d="M12 11V15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            <circle cx="12" cy="9" r="1" fill="currentColor" />
                        </svg>
                        <span>Secure Checkout</span>
                        <span class="encryption-text">256-bit encryption</span>
                    </div>
                </div>

            </div>
        </div>
    </div>
}

<style>
    /* Processing Notification Styles */
    .redirect-notification-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        animation: fadeIn 0.3s ease-out;
    }

    .redirect-notification-card {
        background: white;
        border-radius: 32px;
        padding: 48px;
        max-width: 550px;
        width: 90%;
        text-align: center;
        animation: slideUp 0.4s ease-out;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }

    .processing-card {
        max-width: 600px;
    }

    .processing-icon {
        font-size: 72px;
        margin-bottom: 20px;
        animation: pulse 2s ease-in-out infinite;
    }

    .redirect-title {
        font-size: 28px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 12px;
    }

    .redirect-message {
        font-size: 16px;
        color: #64748b;
        line-height: 1.5;
        margin-bottom: 32px;
    }

    /* Progress Steps */
    .progress-steps {
        display: flex;
        justify-content: space-between;
        margin-bottom: 32px;
        position: relative;
    }

        .progress-steps::before {
            content: '';
            position: absolute;
            top: 20px;
            left: 40px;
            right: 40px;
            height: 2px;
            background: #e5e7eb;
            z-index: 1;
        }

    .progress-step {
        flex: 1;
        text-align: center;
        position: relative;
        z-index: 2;
    }

    .step-indicator {
        width: 40px;
        height: 40px;
        background: #f1f5f9;
        border: 2px solid #e5e7eb;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px;
        font-weight: 600;
        color: #64748b;
        transition: all 0.3s ease;
    }

    .progress-step.completed .step-indicator {
        background: #10b981;
        border-color: #10b981;
        color: white;
    }

    .progress-step.active .step-indicator {
        background: #2563eb;
        border-color: #2563eb;
        color: white;
        animation: bounce 0.5s ease;
    }

    .step-label {
        font-size: 12px;
        font-weight: 500;
        color: #64748b;
    }

    .progress-step.completed .step-label,
    .progress-step.active .step-label {
        color: #1e293b;
        font-weight: 600;
    }

    /* Carousel Styles */
    .carousel-container {
        margin: 24px 0 32px;
        padding: 20px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 20px;
        animation: slideUp 0.5s ease-out;
    }

    .carousel-header {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-bottom: 20px;
    }

    .carousel-icon {
        font-size: 24px;
    }

    .carousel-title {
        font-size: 18px;
        font-weight: 600;
        color: #0f172a;
    }

    .carousel-content {
        display: flex;
        align-items: center;
        gap: 16px;
        position: relative;
    }

    .carousel-nav {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: white;
        border: 1px solid #e2e8f0;
        font-size: 24px;
        font-weight: bold;
        color: #475569;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-bottom: 5px;
    }

        .carousel-nav:hover:not(:disabled) {
            background: #2563eb;
            color: white;
            transform: scale(1.05);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

        .carousel-nav:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

    .carousel-slide {
        flex: 1;
        text-align: center;
    }

    .deliverable-name {
        font-size: 20px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 16px;
        padding: 8px 16px;
        background: white;
        border-radius: 40px;
        display: inline-block;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .deliverable-image-wrapper {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        background: white;
        padding: 12px;
    }

    .deliverable-image {
        width: 100%;
        max-height: 300px;
        object-fit: contain;
        border-radius: 12px;
        transition: transform 0.3s ease;
    }

        .deliverable-image:hover {
            transform: scale(1.02);
        }

    .new-image-animation {
        animation: imageSlideIn 0.6s ease-out;
    }

    .image-badge {
        position: absolute;
        bottom: 20px;
        right: 20px;
        background: rgba(0,0,0,0.7);
        backdrop-filter: blur(8px);
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .deliverable-image-placeholder {
        min-height: 200px;
        background: white;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 40px;
    }

    .generating-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid #e2e8f0;
        border-top-color: #2563eb;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    .carousel-dots {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 20px;
    }

    .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #cbd5e1;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .dot.active {
            width: 24px;
            border-radius: 4px;
            background: #2563eb;
        }

        .dot:hover {
            background: #94a3b8;
            transform: scale(1.2);
        }

    @@keyframes imageSlideIn {
        from {
            opacity: 0;
            transform: translateX(30px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* Loading Spinner */
    .loading-spinner {
        margin: 32px 0;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 3px solid #e5e7eb;
        border-top-color: #2563eb;
        border-radius: 50%;
        margin: 0 auto;
        animation: spin 1s linear infinite;
    }

    /* Completion Message */
    .completion-message {
        margin: 32px 0;
    }

    .completion-icon {
        font-size: 48px;
        margin-bottom: 16px;
        animation: bounce 0.6s ease;
    }

    .completion-message p {
        font-size: 16px;
        color: #0f172a;
        font-weight: 500;
        margin-bottom: 20px;
    }

    .redirect-progress {
        width: 100%;
        height: 6px;
        background: #e5e7eb;
        border-radius: 3px;
        overflow: hidden;
        margin-top: 16px;
    }

    .redirect-progress-bar {
        height: 100%;
        background: linear-gradient(90deg, #2563eb, #1e3a8a);
        border-radius: 3px;
        transition: width 0.3s linear;
    }

    .redirect-cancel-btn {
        background: #f1f5f9;
        border: none;
        padding: 10px 24px;
        border-radius: 40px;
        font-size: 14px;
        font-weight: 500;
        color: #475569;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-top: 16px;
    }

        .redirect-cancel-btn:hover {
            background: #e2e8f0;
            transform: translateY(-2px);
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes slideUp {
        from {
            transform: translateY(30px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.1);
        }
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes bounce {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.2);
        }
    }

    /* Success Page Styles */
    .success-container {
        max-width: 800px;
        margin: 0 auto;
        text-align: center;
        padding: 40px 20px;
    }

    /* Success Animation */
    .success-animation {
        margin-bottom: 32px;
    }

    .checkmark-circle {
        width: 80px;
        height: 80px;
        margin: 0 auto;
        position: relative;
    }

    .checkmark {
        width: 100%;
        height: 100%;
        animation: checkmark 0.6s ease-in-out forwards;
    }

    .checkmark__circle {
        stroke-dasharray: 166;
        stroke-dashoffset: 166;
        stroke-width: 4;
        stroke-miterlimit: 10;
        stroke: #10b981;
        fill: none;
        animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
    }

    .checkmark__check {
        transform-origin: 50% 50%;
        stroke-dasharray: 48;
        stroke-dashoffset: 48;
        animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.4s forwards;
    }

    @@keyframes stroke {
        100% {
            stroke-dashoffset: 0;
        }
    }

    @@keyframes checkmark {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    .success-title {
        font-size: 36px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 12px;
    }

    .success-subtitle {
        font-size: 18px;
        color: #64748b;
        margin-bottom: 40px;
    }

    /* Plan Details Card */
    .plan-details-card {
        background: linear-gradient(135deg, #f0fdf4, #dcfce7);
        border-radius: 20px;
        padding: 32px;
        margin-bottom: 48px;
        border: 1px solid #bbf7d0;
    }

    .plan-icon {
        font-size: 48px;
        margin-bottom: 16px;
    }

    .plan-details-title {
        font-size: 24px;
        font-weight: 700;
        color: #166534;
        margin-bottom: 8px;
    }

    .plan-details-billing {
        font-size: 16px;
        color: #15803d;
        margin-bottom: 8px;
    }

    .plan-details-price {
        font-size: 20px;
        font-weight: 600;
        color: #065f46;
    }

    /* What's Next Section */
    .whats-next-section {
        margin-bottom: 48px;
    }

    .whats-next-title {
        font-size: 24px;
        font-weight: 600;
        color: #0f172a;
        margin-bottom: 24px;
    }

    .next-steps-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
    }

    .next-step-card {
        background: #f8fafc;
        border-radius: 16px;
        padding: 24px;
        transition: all 0.3s ease;
    }

        .next-step-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }

    .step-icon {
        font-size: 36px;
        margin-bottom: 12px;
    }

    .next-step-card h4 {
        font-size: 18px;
        font-weight: 600;
        color: #0f172a;
        margin-bottom: 8px;
    }

    .next-step-card p {
        font-size: 14px;
        color: #64748b;
        margin: 0;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 16px;
        justify-content: center;
        margin-bottom: 48px;
        flex-wrap: wrap;
    }

    /* Share Section */
    .share-section {
        padding-top: 32px;
        border-top: 1px solid #e5e7eb;
    }

    .share-text {
        font-size: 16px;
        color: #64748b;
        margin-bottom: 16px;
    }

    .share-buttons {
        display: flex;
        gap: 12px;
        justify-content: center;
    }

    .share-btn {
        background: #f1f5f9;
        border: none;
        padding: 10px 20px;
        border-radius: 40px;
        font-size: 14px;
        font-weight: 500;
        color: #475569;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .share-btn:hover {
            background: #e2e8f0;
            transform: translateY(-2px);
        }

    /* Responsive */
    @@media (max-width: 640px) {
        .success-title {
            font-size: 28px;
        }

        .success-subtitle {
            font-size: 16px;
        }

        .action-buttons {
            flex-direction: column;
        }

        .next-steps-grid {
            grid-template-columns: 1fr;
        }

        .redirect-notification-card {
            padding: 32px 24px;
        }

        .redirect-title {
            font-size: 24px;
        }

        .progress-steps {
            flex-direction: column;
            gap: 16px;
        }

            .progress-steps::before {
                display: none;
            }

        .step-indicator {
            margin: 0 auto 8px;
        }

        .carousel-content {
            flex-direction: column;
        }

        .carousel-slide {
            order: 1;
        }

        .carousel-nav {
            order: 2;
        }

        .deliverable-name {
            font-size: 16px;
        }
    }

    /* Original Styles */
    .page {
        background-color: #fff !important;
