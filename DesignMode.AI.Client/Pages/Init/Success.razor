    private async Task<string> CallRunwareImageFunction(string positivePrompt, int width, int height, int numberResults)
    {
        try
        {
            HttpClient client = new HttpClient();
            string functionUrl = $"{ApiConfig.ApiBaseUrl}api/CallRunwareAPI?code=REDACTED_FOR_GROOMING";

            var requestBody = new
            {
                positivePrompt = positivePrompt,
                width = width,
                height = height,
                numberResults = numberResults
            };

            // Ensure we wait for the response
            var response = await client.PostAsJsonAsync(functionUrl, requestBody);

            // Ensure we wait for the content
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RunwareResponse>();

                // Add a small delay to ensure the image is ready on the server
                await Task.Delay(500);

                if (result != null && result.Data != null)
                {
                    var firstUrl = result.Data
                        .Where(img => !string.IsNullOrWhiteSpace(img.ImageURL))
                        .Select(img => img.ImageURL)
                        .FirstOrDefault();

                    Console.WriteLine($"Image URL generated: {firstUrl}");
                    return firstUrl ?? string.Empty;
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Runware call failed: {response.StatusCode}, Error: {errorContent}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in CallRunwareImageFunction: {ex.Message}");
        }

        return string.Empty;
    }

    private void CancelProcessing()
    {
        if (!isProcessing) return;

        // Stop all timers
        countdownTimer?.Stop();
        countdownTimer?.Dispose();
        redirectTimer?.Stop();
        redirectTimer?.Dispose();

        isProcessing = false;
        showProcessingNotification = false;

        StateHasChanged();
    }
