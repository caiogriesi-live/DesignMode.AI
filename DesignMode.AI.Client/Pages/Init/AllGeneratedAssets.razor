@using System.Collections.Generic
@using DesignMode.AI.Shared.Models
@using DesignMode.AI.Client.Services
@using Microsoft.AspNetCore.Components;
@using Microsoft.AspNetCore.Components.Authorization;
@using Newtonsoft.Json;

@if (IsBusy)
{
    <div class="modal-busy-overlay">
        <div class="loader"></div>
    </div>
}

@if (Show)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="vertical-modal-wrapper" @onclick:stopPropagation>
            <button class="modal-close" @onclick="CloseModal">×</button>

            <div class="modal-scroll-content">
                <div class="modal-header">
                    <h2>All Generated Assets</h2>
                </div>
                <div style="margin-bottom: 30px;">
                    Review all your generated images. Click any image to add/remove from Brand Kit.
                </div>

                <!-- Brand Kit Status -->
                <div class="brand-kit-status">
                    <span class="brand-kit-count">
                        <span class="brand-kit-icon">✨</span>
                        @(conceptImages?.Count ?? 0) assets in Brand Kit
                    </span>
                </div>

                <div class="image-grid">
                    @if (SelectedImages != null && SelectedImages.Any())
                    {
@*                         // Convert the entire SelectedImages list to a JSON string
                        var selectedImagesJson = JsonConvert.SerializeObject(SelectedImages, Formatting.None);

                        // (Optional) You can log or pass it to AI later
                        Console.WriteLine(selectedImagesJson); *@

                        // Group by DeliverableType and SubCategory
                        var groupedImages = SelectedImages
                        .GroupBy(img => img.SubCategory?.ToLower() == "generic" ? img.DeliverableType : img.SubCategory);

                        @foreach (var group in groupedImages)
                        {
                            var firstImage = group.First();
                            var sectionTitle = group.Key;

                            // If this is a generic group, get the DeliverableType from the first image
                            if (firstImage.SubCategory?.ToLower() == "generic")
                            {
                                sectionTitle = firstImage.DeliverableType;
                            }

                            // Only render the section if there are images with valid URLs
                            var validImages = group
                            .Where(i => !string.IsNullOrWhiteSpace(i.ImageUrl))
                            .OrderBy(i => i.CountId)
                            .ToList();

                            if (validImages.Any())
                            {
                                <div class="deliverable-section">
                                    <h3 class="section-title">@sectionTitle</h3>
                                    <div class="image-col">
                                        @foreach (var image in validImages)
                                        {
                                            @ImageCard(image)
                                        }
                                    </div>
                                </div>
                            }
                        }

                    }
                    else
                    {
                        <div class="empty-state">
                            <p>No generated assets found</p>
                        </div>
                    }
                </div>
            </div>

            <div class="footer-actions sticky-footer">
                <button class="discard-button" @onclick="CloseModal">
                    Discard
                </button>
                <button class="save-button"
                        @onclick="SaveChanges"
                        disabled="@(!HasChanges)"
                        style="@(!HasChanges ? "background-color:#eee; color: #ababab;" : null)">
                    @GetSaveButtonText()
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private ApiConfigService ApiConfig { get; set; }
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; }
    [Inject] private HttpClient Http { get; set; }
    [Inject] private NavigationManager NavigationManager { get; set; }

    private bool IsBusy = false;

    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel> SelectedImages { get; set; }
    [Parameter] public EventCallback<List<string>> OnImagesRemoved { get; set; }
    [Parameter] public EventCallback<bool> OnConfirm { get; set; }

    // Add parameter for concept images to check selection status
    [Parameter] public List<DesignMode.AI.Client.Pages.Init.Gen.ConceptImageWithIdeaDto> conceptImages { get; set; }

    private HashSet<string> SelectedImageUrls = new();
    private HashSet<string> SelectedImageIds = new();
    private List<string> ImagesToAdd = new();
    private List<string> ImagesToRemove = new();
    private bool HasChanges => ImagesToAdd.Count > 0 || ImagesToRemove.Count > 0;

    protected override void OnParametersSet()
    {
        if (SelectedImages != null && SelectedImages.Any())
        {
            SelectedImageUrls = new HashSet<string>(SelectedImages.Select(x => x.ImageUrl));
            SelectedImageIds = new HashSet<string>(SelectedImages.Select(x => x.Id));
            ImagesToAdd.Clear();
            ImagesToRemove.Clear();
        }
        else
        {
            SelectedImageUrls.Clear();
            SelectedImageIds.Clear();
            ImagesToAdd.Clear();
            ImagesToRemove.Clear();
        }
    }

    private void ToggleSelection(string url, string id)
    {
        // Check if image is currently in brand kit
        bool isInBrandKit = conceptImages?.Any(x => x.ImageUrl == url) ?? false;

        if (isInBrandKit)
        {
            // Toggle removal
            if (ImagesToRemove.Contains(id))
            {
                ImagesToRemove.Remove(id);
            }
            else
            {
                ImagesToRemove.Add(id);
                // Remove from add list if it was there
                ImagesToAdd.Remove(id);
            }
        }
        else
        {
            // Toggle addition
            if (ImagesToAdd.Contains(id))
            {
                ImagesToAdd.Remove(id);
            }
            else
            {
                ImagesToAdd.Add(id);
                // Remove from remove list if it was there
                ImagesToRemove.Remove(id);
            }
        }

        StateHasChanged();
    }

    private string GetSaveButtonText()
    {
        if (!HasChanges)
        {
            return conceptImages?.Any() ?? false ? "No Changes Made" : "No Assets Selected";
        }

        var actions = new List<string>();

        if (ImagesToAdd.Count > 0)
        {
            actions.Add($"{ImagesToAdd.Count} asset{(ImagesToAdd.Count > 1 ? "s" : "")} to add");
        }

        if (ImagesToRemove.Count > 0)
        {
            actions.Add($"{ImagesToRemove.Count} asset{(ImagesToRemove.Count > 1 ? "s" : "")} to remove");
        }

        return $"Update Brand Kit ({string.Join(" and ", actions)})";
    }

    private async Task SaveChanges()
    {
        if (IsBusy) return;

        IsBusy = true;
        StateHasChanged();

        try
        {
            bool allOperationsSuccessful = true;

            // Process removals first - call database directly like EditConcept modal
            if (ImagesToRemove.Any())
            {
                foreach (var imageId in ImagesToRemove)
                {
                    bool removed = await DeleteConceptImageFromDatabaseAsync(imageId);
                    if (!removed)
                    {
                        allOperationsSuccessful = false;
                    }
                }
            }

            // Process additions - call database directly
            if (ImagesToAdd.Any())
            {
                foreach (var imageId in ImagesToAdd)
                {
                    bool added = await SaveConceptImageToDatabaseAsync(imageId);
                    if (!added)
                    {
                        allOperationsSuccessful = false;
                    }
                }
            }

            if (allOperationsSuccessful)
            {
                // IMPORTANT: Force parent to reload concept images from database
                if (OnImagesRemoved.HasDelegate)
                {
                    // Pass both additions and removals to let parent know to refresh
                    var allChangedImages = ImagesToAdd.Concat(ImagesToRemove).ToList();
                    await OnImagesRemoved.InvokeAsync(allChangedImages);
                }

                // Also call OnConfirm to ensure parent refreshes
                if (OnConfirm.HasDelegate)
                {
                    await OnConfirm.InvokeAsync(true);
                }

                // Reset changes after successful save
                ImagesToAdd.Clear();
                ImagesToRemove.Clear();

                IsBusy = false;

                // Close the modal
                await CloseModal();
            }
            else
            {
                // Handle partial failure - you might want to show an error message
                Console.WriteLine("Some operations failed. Please try again.");
            }
        }
        finally
        {
            IsBusy = false;
            StateHasChanged();
        }
    }
    private async Task<bool> DeleteConceptImageFromDatabaseAsync(string imageId)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var requestBody = new { ImageId = imageId };

                var response = await Http.PostAsJsonAsync(
                    $"{ApiConfig.ApiBaseUrl}api/DeleteConceptImage?code=REDACTED_FOR_GROOMING",
                    requestBody);

                if (response.IsSuccessStatusCode)
                {
                    Console.WriteLine("✅ Deleted concept image successfully.");
                    return true;
                }
                else
                {
                    Console.WriteLine($"❌ Failed to delete concept image: {response.StatusCode}");
                    return false;
                }
            }

            Console.WriteLine("⚠️ User not authenticated.");
            return false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception deleting concept image: {ex.Message}");
            return false;
        }
    }

    private async Task<bool> SaveConceptImageToDatabaseAsync(string imageId)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var requestBody = new { ImageId = imageId };

                var response = await Http.PostAsJsonAsync(
                    $"{ApiConfig.ApiBaseUrl}api/SaveConceptImage?code=REDACTED_FOR_GROOMING",
                    requestBody);

                if (response.IsSuccessStatusCode)
                {
                    Console.WriteLine("✅ Saved concept image successfully.");
                    return true;
                }
                else
                {
                    Console.WriteLine($"❌ Failed to save concept image: {response.StatusCode}");
                    return false;
                }
            }

            Console.WriteLine("⚠️ User not authenticated.");
            return false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception saving concept image: {ex.Message}");
            return false;
        }
    }

    private async Task CloseModal()
    {
        if (IsBusy)
            return;

        // Reset the state when closing
        ImagesToAdd.Clear();
        ImagesToRemove.Clear();
        Show = false;
        await ShowChanged.InvokeAsync(false);
    }

    private RenderFragment ImageCard(DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel image) => __builder =>
    {
        var isInBrandKit = conceptImages?.Any(x => x.ImageUrl == image.ImageUrl) ?? false;
        var isMarkedForAdd = ImagesToAdd.Contains(image.Id);
        var isMarkedForRemove = ImagesToRemove.Contains(image.Id);
        var isCurrentlySelected = isInBrandKit && !isMarkedForRemove || !isInBrandKit && isMarkedForAdd;

        <div class="image-card @(isCurrentlySelected ? "in-brand-kit" : "") @((isMarkedForAdd || isMarkedForRemove) ? "pending-change" : "")"
             @onclick="() => ToggleSelection(image.ImageUrl, image.Id)">
            <img src="@image.ImageUrl" alt="Generated asset" class="image-thumb" />
            <div class="image-controls">
                <div class="brand-kit-indicator @(isCurrentlySelected ? "selected" : "")"
                     @onclick="() => ToggleSelection(image.ImageUrl, image.Id)"
                @onclick:stopPropagation>
                    @if (isCurrentlySelected)
                    {
                        <span class="indicator-icon" title="In Brand Kit">✓</span>
                    }
                    else
                    {
                        <span class="indicator-icon" title="Add to Brand Kit">+</span>
                    }
                </div>
            </div>
            @if (isMarkedForAdd)
            {
                <div class="change-badge add-badge">
                    <span class="badge-icon">+</span>
                    To Add
                </div>
            }
            else if (isMarkedForRemove)
            {
                <div class="change-badge remove-badge">
                    <span class="badge-icon">−</span>
                    To Remove
                </div>
            }
            else if (isCurrentlySelected)
            {
                <div class="brand-kit-badge">
                    <span class="badge-icon">✨</span>
                    In Brand Kit
                </div>
            }
        </div>
    };
}
