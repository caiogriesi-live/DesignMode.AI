    private (string CompanyName, string Industry) GetCompanyFromCid()
    {
        var queryString = new Uri(NavigationManager.Uri).Query;
        var cid = GetQueryParameter(queryString, "cid", "");
        if (string.IsNullOrWhiteSpace(cid)) return ("", "");
        var parts = cid.Split(new[] { "|~~|@@|^^|" }, StringSplitOptions.None);
        if (parts.Length < 2) return ("", "");
        try
        {
            return (Encoding.UTF8.GetString(Convert.FromBase64String(parts[0])), Encoding.UTF8.GetString(Convert.FromBase64String(parts[1])));
        }
        catch { return ("", ""); }
    }

    private static string GetQueryParameter(string queryString, string key, string defaultValue)
    {
        if (string.IsNullOrWhiteSpace(queryString)) return defaultValue;
        foreach (var pair in queryString.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length > 0 && string.Equals(Uri.UnescapeDataString(parts[0]), key, StringComparison.OrdinalIgnoreCase))
                return parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "";
        }
        return defaultValue;
    }

    private static string SanitizeCompanyName(string companyName)
    {
        if (string.IsNullOrWhiteSpace(companyName)) return "Brand";
        var invalid = Path.GetInvalidFileNameChars();
        var value = new string(companyName.Where(c => !invalid.Contains(c)).ToArray()).Trim().Replace(" ", "-").Replace("&", "");
        while (value.Contains("--")) value = value.Replace("--", "-");
        return string.IsNullOrWhiteSpace(value) ? "Brand" : value;
    }

    private async Task GoToGenerateBrandingImages()
    {
        if (isGeneratingBrandingImages || CallRunwareImageFunction == null || CallSaveImageIdeaFunction == null) return;
        await using var generationOperation = await BeginGenerationAsync();
        isGeneratingBrandingImages = true;
        try
        {
            var prompt = $"Create one polished brand identity reference image for {(!string.IsNullOrWhiteSpace(LogoText) ? LogoText : "the company")}. Use this creative direction: {MainPromptText}. Make the image useful as a visual reference for logo design, color systems, typography, and social branding.";
            var generatedUrl = await CallRunwareImageFunction(prompt, 1024, 1024, 1);
            if (string.IsNullOrWhiteSpace(generatedUrl)) return;

            var imageId = await CallSaveImageIdeaFunction("Branding & Logo", "Brand Identity", prompt, generatedUrl, PromptIdFromCID, DateTime.UtcNow.ToString("yyyyMMddTHHmmssZ"), "1");
            var image = new Gen.ImageIdeaModel { Id = imageId, ImageUrl = generatedUrl, DeliverableType = "Branding & Logo", SubCategory = "Brand Identity", CountId = "1" };
            newlyGeneratedImages.Add(image);
            wasImageGenerated = true;
            ToggleSelection(image.ImageUrl, image.Id);
        }
        catch (Exception ex) { Console.WriteLine($"❌ GoToGenerateBrandingImages: {ex.Message}"); }
        finally { isGeneratingBrandingImages = false; StateHasChanged(); }
    }

    private async Task CloseModal()
    {
        if (GenerationGuard is null && (IsBusy || IsGeneratingBrandKit || isGeneratingBrandingImages)) return;
        if (!await ConfirmGenerationCloseAsync()) return;

        Show = false;
        await ShowChanged.InvokeAsync(false);
        if (OnModalClosed.HasDelegate && wasImageGenerated) await OnModalClosed.InvokeAsync();
        newlyGeneratedImages.Clear();
        wasImageGenerated = false;
        ActiveTab = TabType.GenerateNew;
        hasLoadedVersions = false;
    }

    private RenderFragment ImageCard(Gen.ImageIdeaModel image) => __builder =>
    {
        var isSelected = SelectedImageIds.Contains(image.Id);
        var isNew = newlyGeneratedImages.Contains(image);
        <div class="image-card @(isSelected ? "branding-selected" : "") @(isNew ? "newly-generated" : "")" @onclick="() => ToggleSelection(image.ImageUrl, image.Id)">
            <img src="@image.ImageUrl" alt="Branding asset" class="image-thumb" />
            <div class="image-controls"><div class="branding-selection-indicator @(isSelected ? "selected" : "")"><span class="indicator-icon">@(isSelected ? "✓" : "+")</span></div></div>
            @if (isSelected)
            {
                <div class="branding-selection-badge"><span>🎨</span> Reference Image</div>
            }
            @if (isNew)
            {
                <div class="new-image-badge"><span>🆕</span> New</div>
            }
        </div>
    };

