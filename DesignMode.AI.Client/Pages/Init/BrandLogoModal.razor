@inherits DesignMode.AI.Client.Components.GenerationAwareComponent
@using System.Collections.Generic
@using System.Net.Http.Json
@using DesignMode.AI.Shared.Models
@using DesignMode.AI.Client.Services
@using DesignMode.AI.Client.Pages.Init
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Text
@using System.IO

@inject ApiConfigService ApiConfig
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject AttributionContextService AttributionContext
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject AIUsageRefreshService UsageRefresh

@if (IsBusy && !IsGeneratingBrandKit)
{
    <div class="modal-busy-overlay"><div class="loader"></div></div>
}

@if (Show)
{
    <div class="modal-overlay generation-workspace-overlay" @onclick="CloseModal">
        <div class="vertical-modal-wrapper generation-workspace" @onclick:stopPropagation>
            <button class="modal-close" @onclick="CloseModal">×</button>

            <div class="modal-tabs">
                <button class="tab-button @(ActiveTab == TabType.GenerateNew ? "active" : "")"
                        @onclick="() => SetActiveTab(TabType.GenerateNew)">
                    <span class="tab-icon">✨</span> Generate New
                </button>
                <button class="tab-button @(ActiveTab == TabType.GeneratedBrandKit ? "active" : "")"
                        aria-label="Generated Brand Kits"
                        @onclick="() => SetActiveTab(TabType.GeneratedBrandKit)"
                        disabled="@(!IsGeneratingBrandKit && !HasExistingBrandingLogos && ActiveGeneratedBrandKit == null)">
                    <span class="tab-icon">🎨</span> Results
                    @if (IsGeneratingBrandKit)
                    {
                        <span class="tab-badge generating">Generating...</span>
                    }
                    else if (HasExistingBrandingLogos || GeneratedBrandKits.Any())
                    {
                        <span class="tab-badge">@GetGeneratedBrandKitCount()</span>
                    }
                </button>
            </div>

            <div class="modal-scroll-content">
                @if (ActiveTab == TabType.GenerateNew)
                {
                    <div class="tab-content generate-new-tab">
                        <div class="modal-header"><h2>Generate Branding &amp; Logo Kit</h2></div>
                        <div class="modal-intro">
                            Select <strong>one image</strong>. The selected image becomes the visual reference for a complete brand kit containing logo variations, a color palette, typography, brand guidelines, and a logo-focused social media kit.
                        </div>

                        <div class="brand-kit-status">
                            <span class="brand-kit-count">
                                <span class="brand-kit-icon">🎨</span>
                                @if (HasBrandingImages())
                                {
                                    <span>Branding reference images ready</span>
                                    @if (SelectedImageIds.Any())
                                    {
                                        <span class="selection-count">1 selected</span>
                                    }
                                }
                                else
                                {
                                    <span style="font-weight:bold;">No branding images available</span>
                                }
                            </span>
                        </div>

                        <AIRecommendationGenerationLoader IsVisible="@isGeneratingBrandingImages" Message="Generating branding image..." />
                        @if (!isGeneratingBrandingImages)
                        {
                        <div class="image-grid">
                            @if (SelectedImages != null && SelectedImages.Any() && HasBrandingImages())
                            {
                                var groupedImages = GetUniqueBrandingImages()
                                .GroupBy(img => img.SubCategory?.ToLower() == "generic" ? img.DeliverableType : img.SubCategory);

                                @foreach (var group in groupedImages)
                                {
                                    var firstImage = group.First();
                                    var sectionTitle = firstImage.SubCategory?.ToLower() == "generic" ? firstImage.DeliverableType : group.Key;
                                    var validImages = group.Where(i => !string.IsNullOrWhiteSpace(i.ImageUrl)).OrderBy(i => i.CountId).ToList();

                                    if (validImages.Any())
                                    {
                                        <div class="deliverable-section">
                                            <h3 class="section-title">@sectionTitle</h3>
                                            <div class="image-col">
                                                @foreach (var image in validImages)
                                                {
                                                    @ImageCard(image)
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            }
                            else
                            {
                                <div class="empty-state">
                                    <div class="empty-icon">🎨</div>
                                    <h3>No Branding Images Yet</h3>
                                    <p>Generate a branding, logo, identity, typography, or color image first, then select it here as the visual reference.</p>
                                    @if (CallRunwareImageFunction != null && CallSaveImageIdeaFunction != null)
                                    {
                                        <button class="generate-images-button" @onclick="GoToGenerateBrandingImages" disabled="@isGeneratingBrandingImages">
                                            @(isGeneratingBrandingImages ? "Generating Branding Image..." : "Generate Branding Image")
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        }

                        <div class="branding-config-section">
                            <h3>Brand Kit Configuration</h3>
                            <div class="config-options two-col">
                                <div class="config-option">
                                    <label>Logo Style</label>
                                    <select @bind="SelectedLogoStyle" class="config-select">
                                        <option value="Wordmark">Wordmark</option>
                                        <option value="Lettermark">Lettermark</option>
                                        <option value="Pictorial">Pictorial Mark</option>
                                        <option value="Combination">Combination Mark</option>
                                        <option value="Emblem">Emblem</option>
                                        <option value="Adaptive">Adaptive / Mixed System</option>
                                    </select>
                                </div>
                                <div class="config-option">
                                    <label>Color Direction</label>
                                    <select @bind="SelectedColorPalette" class="config-select">
                                        <option value="Minimal">Minimal</option>
                                        <option value="Standard">Standard</option>
                                        <option value="Vibrant">Vibrant</option>
                                        <option value="Monochromatic">Monochromatic</option>
                                        <option value="Premium">Premium / Refined</option>
                                    </select>
                                </div>
                                <div class="config-option">
                                    <label>Company / Logo Text</label>
                                    <input type="text" @bind="LogoText" class="config-input" placeholder="Company name or logo text" />
                                </div>
                                <div class="config-option">
                                    <label>Industry Focus</label>
                                    <select @bind="SelectedIndustryFocus" class="config-select">
                                        <option value="Technology">Technology</option>
                                        <option value="Finance">Finance &amp; Banking</option>
                                        <option value="Healthcare">Healthcare</option>
                                        <option value="Retail">Retail &amp; E-commerce</option>
                                        <option value="Education">Education</option>
                                        <option value="Creative">Creative &amp; Design</option>
                                        <option value="Food">Food &amp; Beverage</option>
                                        <option value="Service">Professional Services</option>
                                        <option value="General">General</option>
                                    </select>
                                </div>
                            </div>

                            <div class="deliverables-box">
                                <h4>Generated Deliverables</h4>
                                <div class="deliverables-grid">
                                    <label>✓ Logo Variations</label>
                                    <label>✓ Color Palette</label>
                                    <label>✓ Typography</label>
                                    <label>✓ Brand Guidelines</label>
                                    <label>✓ Logo Social Media Kit</label>
                                </div>
                            </div>

                            <div class="what-you-get">
                                <div><span>📐</span><strong>Logo Variations</strong></div>
                                <div><span>🎨</span><strong>Color Palette</strong></div>
                                <div><span>🔤</span><strong>Typography</strong></div>
                                <div><span>📘</span><strong>Brand Guidelines</strong></div>
                                <div><span>📱</span><strong>Social Media Kit</strong></div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="tab-content generated-branding-tab">
                        <div class="modal-header"><h2>Generated Branding &amp; Logo Kits</h2></div>

                        @if (IsGeneratingBrandKit)
                        {
                            <div class="generation-loading-container">
                                <div class="generation-header"><h3>Creating Your Brand Kit</h3><div class="generation-status">@GenerationStatus</div></div>
                                <div class="progress-bar-container"><div class="progress-bar" style="width: @(GenerationProgress)%;"></div></div>
                                <div class="current-step-details">@CurrentStepDetails</div>
                                <div class="generation-steps-log">
                                    @foreach (var step in GenerationSteps)
                                    {
                                        <div class="step-item"><span class="step-check">✓</span><span>@step</span></div>
                                    }
                                </div>
                                <div class="brand-kit-skeleton">
                                    @for (var i = 0; i < 5; i++)
                                    {
                                        <div class="skeleton-card"></div>
                                    }
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(GenerationError))
                        {
                            <div class="generation-error">
                                <h3>Brand kit generation failed</h3>
                                <p>@GenerationError</p>
                                <button class="save-button" @onclick="() => SetActiveTab(TabType.GenerateNew)">Back to Generate New</button>
                            </div>
                        }
                        else if (ActiveGeneratedBrandKit != null)
                        {
                            <div class="generated-kit-preview">
                                <div class="preview-toolbar">
                                    <div>
                                        <div class="current-kit-heading"><span class="current-kit-pill">Current</span><strong>@GetActiveCompanyDisplayName()</strong></div>
                                        <span class="preview-meta">@GetActivePreviewMeta()</span>
                                    </div>
                                </div>

                                <div class="asset-preview-grid">
                                    @foreach (var asset in GetActiveAssets())
                                    {
                                        <div class="asset-preview-card">
                                            <div class="asset-title-row"><strong>@asset.Title</strong><button class="toolbar-button" @onclick="() => OpenAsset(asset.Url)">↗ Open</button></div>
                                            <img src="@asset.Url" alt="@asset.Title" class="generated-asset-image" />
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (GeneratedBrandKits.Any())
                            {
                                <div class="generated-history">
                                    <div class="generated-history-header"><div><h4>Saved Brand Kit Versions</h4><p>Select a version to view all five saved assets.</p></div><span class="generated-count">@GeneratedBrandKits.Count</span></div>
                                    <div class="history-grid">
                                        @foreach (var item in GeneratedBrandKits.OrderByDescending(x => x.CreatedAt))
                                        {
                                            var isActive = ActiveGeneratedBrandKit != null && string.Equals(item.BrandingLogoId, ActiveGeneratedBrandKit.BrandingLogoId, StringComparison.OrdinalIgnoreCase) && string.Equals(item.Version, ActiveGeneratedBrandKit.Version, StringComparison.OrdinalIgnoreCase);
                                            <button type="button" class="history-card @(isActive ? "active" : "")" @onclick="() => ViewGeneratedBrandKit(item)">
                                                <img src="@item.LogoVariationsUrl" alt="Brand kit @item.Version" class="history-thumb" />
                                                <div class="history-card-info"><strong>@item.CompanyName</strong><span>@item.Version</span><small>@item.CreatedAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</small></div>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state generated-empty-state">
                                <div class="empty-icon">🎨</div>
                                <h3>No Brand Kit Generated Yet</h3>
                                <p>Select one image and generate your first brand kit.</p>
                                <button class="save-button" @onclick="() => SetActiveTab(TabType.GenerateNew)">Start Generating</button>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="footer-actions sticky-footer">
                @if (ActiveTab == TabType.GenerateNew)
                {
                    <button class="discard-button" @onclick="CloseModal">Cancel</button>
                    <button class="save-button" @onclick="GenerateBranding" disabled="@(!CanGenerateBrandKit || IsGeneratingBrandKit)">@GetGenerateButtonText()</button>
                }
                else
                {
                    <button class="discard-button" disabled="@IsGeneratingBrandKit" @onclick="() => SetActiveTab(TabType.GenerateNew)">← Back to Generate New Brand Kit</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private enum TabType { GenerateNew, GeneratedBrandKit }
    private TabType ActiveTab { get; set; } = TabType.GenerateNew;

    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public MakeVideoModal.ImageIdeaCountResult AllIdeas { get; set; }
    [Parameter] public List<Gen.ImageIdeaModel> SelectedImages { get; set; } = new();
    [Parameter] public EventCallback<List<string>> OnImagesSelected { get; set; }
    [Parameter] public EventCallback<bool> OnBrandingGenerated { get; set; }
    [Parameter] public Func<string, int, int, int, Task<string>> CallRunwareImageFunction { get; set; }
    [Parameter] public Func<string, string, string, string, string, string, string, Task<string>> CallSaveImageIdeaFunction { get; set; }
    [Parameter] public string CompanyIdeaId { get; set; }
    [Parameter] public string CompanyDescription { get; set; }
    [Parameter] public string PromptIdFromCID { get; set; }
    [Parameter] public string MainPromptText { get; set; }
    [Parameter] public EventCallback OnModalClosed { get; set; }

    private bool IsBusy;
    private bool IsGeneratingBrandKit;
    private bool isGeneratingBrandingImages;
    private bool wasImageGenerated;
    private bool hasLoadedVersions;
    private bool previousShow;

    private string GenerationStatus = "";
    private string CurrentStepDetails = "";
    private int GenerationProgress;
    private string GenerationError = "";
    private readonly List<string> GenerationSteps = new();

    private readonly HashSet<string> SelectedImageIds = new();
    private readonly HashSet<string> SelectedImageUrls = new();
    private readonly List<Gen.ImageIdeaModel> newlyGeneratedImages = new();

    private string SelectedLogoStyle = "Combination";
    private string SelectedColorPalette = "Standard";
    private string SelectedIndustryFocus = "General";
    private string LogoText = "";
    private bool IncludeLogoVariations = true;
    private bool IncludeColorPalette = true;
    private bool IncludeTypography = true;
    private bool GenerateBrandGuidelines = true;
    private bool IncludeSocialMediaKit = true;

    private string SelectedCompanyName = "";
    private string currentVersion = "1";
    private List<BrandingLogoRecord> sortedBrandingLogos = new();
    private List<GeneratedBrandKitRecord> GeneratedBrandKits = new();
    private GeneratedBrandKitRecord? ActiveGeneratedBrandKit;

    private bool HasExistingBrandingLogos => sortedBrandingLogos.Any();
    private bool CanGenerateBrandKit => SelectedImageIds.Any();

    protected override async Task OnParametersSetAsync()
    {
        if (Show && !previousShow)
        {
            SelectedImageIds.Clear();
            SelectedImageUrls.Clear();
            GenerationError = "";
            ActiveTab = TabType.GenerateNew;
            hasLoadedVersions = false;

            var (companyName, _) = GetCompanyFromCid();
            SelectedCompanyName = SanitizeCompanyName(companyName);

            if (string.IsNullOrWhiteSpace(LogoText)) LogoText = companyName;

            if (!string.IsNullOrWhiteSpace(SelectedCompanyName))
            {
                await LoadExistingBrandingLogoVersionsAsync(SelectedCompanyName);
                hasLoadedVersions = true;
            }
        }
        previousShow = Show;
    }

    private bool HasBrandingImages() => GetUniqueBrandingImages().Any();

    private List<Gen.ImageIdeaModel> GetUniqueBrandingImages()
    {
        var allImages = new List<Gen.ImageIdeaModel>();
        if (SelectedImages != null) allImages.AddRange(SelectedImages);
        allImages.AddRange(newlyGeneratedImages);

        return allImages
            .Where(img => !string.IsNullOrWhiteSpace(img.ImageUrl) && IsBrandingImage(img))
            .GroupBy(img => img.ImageUrl)
            .Select(g => g.First())
            .ToList();
    }

    private static bool IsBrandingImage(Gen.ImageIdeaModel img)
    {
        var text = $"{img.DeliverableType} {img.SubCategory}".ToLowerInvariant();
        return text.Contains("brand") || text.Contains("logo") || text.Contains("identity") || text.Contains("typography") || text.Contains("color");
    }

    private void ToggleSelection(string url, string id)
    {
        SelectedImageIds.Clear();
        SelectedImageUrls.Clear();
        if (!string.IsNullOrWhiteSpace(id)) SelectedImageIds.Add(id);
        if (!string.IsNullOrWhiteSpace(url)) SelectedImageUrls.Add(url);
        if (OnImagesSelected.HasDelegate) _ = OnImagesSelected.InvokeAsync(SelectedImageIds.ToList());
        StateHasChanged();
    }

    private string GetGenerateButtonText() => SelectedImageIds.Any() ? "Generate Complete Brand Kit" : "Select an Image to Generate Brand Kit";

    private async Task GenerateBranding()
    {
        if (IsGeneratingBrandKit || !CanGenerateBrandKit) return;
        await using var generationOperation = await BeginGenerationAsync();

        IsGeneratingBrandKit = true;
        ActiveTab = TabType.GeneratedBrandKit;
        GenerationError = "";
        GenerationSteps.Clear();
        UpdateGenerationStatus("Starting brand kit generation...", "Preparing the selected visual reference and brand settings", 5);

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated != true)
                throw new InvalidOperationException("You must be signed in to generate a branding and logo kit.");

            var allImages = new List<Gen.ImageIdeaModel>();
            if (SelectedImages != null) allImages.AddRange(SelectedImages);
            allImages.AddRange(newlyGeneratedImages);
            var selectedImage = allImages.FirstOrDefault(x => SelectedImageIds.Contains(x.Id) && !string.IsNullOrWhiteSpace(x.ImageUrl));
            if (selectedImage == null) throw new InvalidOperationException("The selected branding reference image could not be found.");

            var (companyNameFromCid, industryFromCid) = GetCompanyFromCid();
            var companyName = !string.IsNullOrWhiteSpace(LogoText) ? LogoText.Trim() : companyNameFromCid;
            if (string.IsNullOrWhiteSpace(companyName)) companyName = "Brand";
            var industry = SelectedIndustryFocus == "General" && !string.IsNullOrWhiteSpace(industryFromCid) ? industryFromCid : SelectedIndustryFocus;
            SelectedCompanyName = SanitizeCompanyName(companyName);

            var attribution = await AttributionContext.AuthorizeGenerationAsync(CompanyIdeaId);

            UpdateGenerationStatus("Creating brand assets...", "Generating logo variations, palette, typography, guidelines, and social logo assets", 35);
            var request = new
            {
                ImageUrl = selectedImage.ImageUrl,
                SelectedImageId = selectedImage.Id,
                Name = companyName,
                Industry = industry,
                CompanyDescription,
                Prompt = MainPromptText,
                LogoStyle = SelectedLogoStyle,
                ColorPalette = SelectedColorPalette,
                IncludeLogoVariations = true,
                IncludeColorPalette = true,
                IncludeTypography = true,
                GenerateBrandGuidelines = true,
                IncludeSocialMediaKit = true,
                UserId = user.Identity?.Name,
                CompanyIdeaId,
                PromptId = PromptIdFromCID,
                Timestamp = DateTime.UtcNow.ToString("yyyyMMddTHHmmssZ"),
                GenerationJobId = Guid.NewGuid().ToString(),
                ProjectId = attribution?.ProjectId,
                FunnelId = attribution?.FunnelId
            };

            // Do not change the injected HttpClient.Timeout here. In Blazor WASM the
            // shared client may already have sent requests, and changing Timeout after
            // first use can throw. Use a dedicated long-running client instead.
            using var generationHttp = new HttpClient
                {
                    Timeout = TimeSpan.FromMinutes(15)
                };
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrWhiteSpace(token))
                generationHttp.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            using var response = await generationHttp.PostAsJsonAsync(
                $"{ApiConfig.ApiBaseUrl}api/GenerateBrandingLogo?code=REDACTED_FOR_GROOMING",
                request);
            if (await UsageRefresh.HandleResponseAsync(response)) return;

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                throw new InvalidOperationException($"GenerateBrandingLogo returned {(int)response.StatusCode}: {error}");
            }
            await UsageRefresh.RequestRefreshAsync();

            var result = await response.Content.ReadFromJsonAsync<BrandingLogoGenerationResult>();
            if (result == null || !result.Success)
                throw new InvalidOperationException(result?.Error ?? "The branding function did not return a successful brand kit.");

            if (!hasLoadedVersions)
            {
                await LoadExistingBrandingLogoVersionsAsync(SelectedCompanyName);
                hasLoadedVersions = true;
            }

            var nextVersion = GetNextBrandingLogoVersion();
            var versionText = $"v{nextVersion}";
            var logicalBrandingLogoId = GetLogicalBrandingLogoId(result.BrandingLogoId);
            var timeStamp = DateTime.UtcNow.ToString("o");

            UpdateGenerationStatus("Saving brand kit files...", $"Saving {versionText} under SavedImages", 80);
            var saveResult = await SaveGeneratedBrandKitFilesAsync(result, SelectedCompanyName, nextVersion.ToString());
            if (saveResult == null || !saveResult.Success)
                throw new InvalidOperationException("The generated branding files could not be saved.");

            UpdateGenerationStatus("Saving brand kit version...", $"Adding {versionText} to BrandingLogo", 92);
            await SaveBrandingLogoAsync(logicalBrandingLogoId, SelectedCompanyName, versionText, timeStamp);
            await LoadExistingBrandingLogoVersionsAsync(SelectedCompanyName);

            var generatedRecord = GeneratedBrandKits.FirstOrDefault(x => string.Equals(x.Version, versionText, StringComparison.OrdinalIgnoreCase));
            if (generatedRecord != null)
            {
                generatedRecord.BrandingLogoId = logicalBrandingLogoId;
                generatedRecord.CompanyName = companyName;
                generatedRecord.LogoStyle = SelectedLogoStyle;
                generatedRecord.ColorDirection = SelectedColorPalette;
                generatedRecord.CreatedAt = DateTime.UtcNow;
                ViewGeneratedBrandKit(generatedRecord);
            }

            currentVersion = nextVersion.ToString();
            UpdateGenerationStatus("Complete!", $"Brand kit {versionText} was generated and saved", 100);

            if (OnBrandingGenerated.HasDelegate) await OnBrandingGenerated.InvokeAsync(true);
        }
        catch (TaskCanceledException ex) when (ex.InnerException is TimeoutException || ex.Message.Contains("HttpClient.Timeout", StringComparison.OrdinalIgnoreCase))
        {
            GenerationError = "Brand kit generation exceeded the client timeout. The branding request is allowed up to 15 minutes; if this continues, check the Azure Function host timeout and upstream OpenAI request duration.";
            GenerationStatus = "Generation timed out";
            CurrentStepDetails = GenerationError;
            GenerationProgress = 0;
            Console.WriteLine($"❌ GenerateBranding timed out: {ex}");
        }
        catch (Exception ex)
        {
            GenerationError = ex.Message;
            GenerationStatus = "Generation failed";
            CurrentStepDetails = ex.Message;
            GenerationProgress = 0;
            Console.WriteLine($"❌ GenerateBranding failed: {ex}");
        }
        finally
        {
            IsGeneratingBrandKit = false;
            StateHasChanged();
        }
    }

    private int GetNextBrandingLogoVersion()
    {
        if (!sortedBrandingLogos.Any()) return 1;
        return sortedBrandingLogos.Select(x => int.TryParse(x.Version?.Trim().TrimStart('v', 'V'), out var v) ? v : 0).DefaultIfEmpty(0).Max() + 1;
    }

    private string GetLogicalBrandingLogoId(string generatedId)
    {
        var existing = sortedBrandingLogos.Where(x => !string.IsNullOrWhiteSpace(x.BrandingLogoId)).OrderByDescending(x => DateTime.TryParse(x.TimeStamp, out var dt) ? dt : DateTime.MinValue).Select(x => x.BrandingLogoId).FirstOrDefault();
        if (!string.IsNullOrWhiteSpace(existing)) return existing;
        if (!string.IsNullOrWhiteSpace(generatedId)) return generatedId;
        return Guid.NewGuid().ToString();
    }

    private int GetGeneratedBrandKitCount() => sortedBrandingLogos.Count;

    private string GetBrandingLogoFolderName(string companyName, string version)
    {
        var safeVersion = (version ?? "1").Replace("v", "", StringComparison.OrdinalIgnoreCase).Trim();
        return $"{SanitizeCompanyName(companyName)}-branding-logo-v{safeVersion}";
    }

    private string GetBrandingAssetUrl(string companyName, string version, string fileName)
        => $"{ApiConfig.StorageBaseUrl}{GetBrandingLogoFolderName(companyName, version)}/{fileName}";

    private GeneratedBrandKitRecord BuildGeneratedRecord(BrandingLogoRecord record)
    {
        var version = string.IsNullOrWhiteSpace(record.Version) ? "v1" : record.Version;
        return new GeneratedBrandKitRecord
            {
                BrandingLogoId = record.BrandingLogoId,
                CompanyName = record.CompanyName,
                Version = version,
                LogoVariationsUrl = GetBrandingAssetUrl(record.CompanyName, version, "logo-variations.png"),
                ColorPaletteUrl = GetBrandingAssetUrl(record.CompanyName, version, "color-palette.png"),
                TypographyUrl = GetBrandingAssetUrl(record.CompanyName, version, "typography.png"),
                BrandGuidelinesUrl = GetBrandingAssetUrl(record.CompanyName, version, "brand-guidelines.png"),
                SocialMediaKitUrl = GetBrandingAssetUrl(record.CompanyName, version, "social-media-kit.png"),
                CreatedAt = DateTime.TryParse(record.TimeStamp, out var dt) ? dt : DateTime.MinValue
            };
    }

    private async Task LoadExistingBrandingLogoVersionsAsync(string companyName)
    {
        var response = await GetBrandingLogosByCompanyAsync(companyName);
        sortedBrandingLogos = response?.Data?.OrderByDescending(x => DateTime.TryParse(x.TimeStamp, out var dt) ? dt : DateTime.MinValue).ToList() ?? new();
        GeneratedBrandKits = sortedBrandingLogos.Select(BuildGeneratedRecord).OrderByDescending(x => x.CreatedAt).ToList();
        ActiveGeneratedBrandKit = GeneratedBrandKits.FirstOrDefault();
        if (ActiveGeneratedBrandKit != null) ViewGeneratedBrandKit(ActiveGeneratedBrandKit);
        currentVersion = ActiveGeneratedBrandKit?.Version?.Replace("v", "", StringComparison.OrdinalIgnoreCase) ?? "1";
    }

    private async Task<GetBrandingLogosResponse?> GetBrandingLogosByCompanyAsync(string companyName)
    {
        var response = await Http.PostAsJsonAsync(
            $"{ApiConfig.ApiBaseUrl}api/GetBrandingLogosByCompany?code=REDACTED_FOR_GROOMING",
            new { CompanyName = companyName });
        if (!response.IsSuccessStatusCode) return null;
        return await response.Content.ReadFromJsonAsync<GetBrandingLogosResponse>();
    }

    private async Task SaveBrandingLogoAsync(string brandingLogoId, string companyName, string version, string timeStamp)
    {
        var response = await Http.PostAsJsonAsync(
            $"{ApiConfig.ApiBaseUrl}api/SaveBrandingLogo?code=REDACTED_FOR_GROOMING",
            new { BrandingLogoId = brandingLogoId, CompanyName = companyName, Version = version, TimeStamp = timeStamp });
        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            throw new InvalidOperationException($"SaveBrandingLogo returned {(int)response.StatusCode}: {error}");
        }
    }

    private async Task<SaveBrandingLogoAssetsResponse?> SaveGeneratedBrandKitFilesAsync(BrandingLogoGenerationResult result, string companyName, string version)
    {
        var request = new
        {
            CompanyName = companyName,
            Version = version,
            LogoVariationsImageUrl = result.LogoVariationsUrl,
            ColorPaletteImageUrl = result.ColorPaletteUrl,
            TypographyImageUrl = result.TypographyUrl,
            BrandGuidelinesImageUrl = result.BrandGuidelinesUrl,
            SocialMediaKitImageUrl = result.SocialMediaKitUrl
        };

        using var saveAssetsHttp = new HttpClient
            {
                Timeout = TimeSpan.FromMinutes(15)
            };

        using var response = await saveAssetsHttp.PostAsJsonAsync(
            $"{ApiConfig.ApiBaseUrl}api/SaveBrandingLogoAssets?code=REDACTED_FOR_GROOMING",
            request);
        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            throw new InvalidOperationException($"SaveBrandingLogoAssets returned {(int)response.StatusCode}: {error}");
        }
        return await response.Content.ReadFromJsonAsync<SaveBrandingLogoAssetsResponse>();
    }

    private IEnumerable<BrandAssetLink> GetActiveAssets()
    {
        if (ActiveGeneratedBrandKit == null) return Enumerable.Empty<BrandAssetLink>();
        var assets = new List<BrandAssetLink>();
        if (IncludeLogoVariations || !string.IsNullOrWhiteSpace(ActiveGeneratedBrandKit.LogoVariationsUrl)) assets.Add(new("Logo Variations", ActiveGeneratedBrandKit.LogoVariationsUrl));
        if (IncludeColorPalette || !string.IsNullOrWhiteSpace(ActiveGeneratedBrandKit.ColorPaletteUrl)) assets.Add(new("Color Palette", ActiveGeneratedBrandKit.ColorPaletteUrl));
        if (IncludeTypography || !string.IsNullOrWhiteSpace(ActiveGeneratedBrandKit.TypographyUrl)) assets.Add(new("Typography", ActiveGeneratedBrandKit.TypographyUrl));
        if (GenerateBrandGuidelines || !string.IsNullOrWhiteSpace(ActiveGeneratedBrandKit.BrandGuidelinesUrl)) assets.Add(new("Brand Guidelines", ActiveGeneratedBrandKit.BrandGuidelinesUrl));
        if (IncludeSocialMediaKit || !string.IsNullOrWhiteSpace(ActiveGeneratedBrandKit.SocialMediaKitUrl)) assets.Add(new("Logo Social Media Kit", ActiveGeneratedBrandKit.SocialMediaKitUrl));
        return assets.Where(x => !string.IsNullOrWhiteSpace(x.Url));
    }

