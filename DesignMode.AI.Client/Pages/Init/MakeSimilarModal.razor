@code {
    @using System.Text.Json;

    @using DesignMode.AI.Client.Services;
    @using DesignMode.AI.Shared.Models;
    @using Microsoft.AspNetCore.Components;
    @using Microsoft.AspNetCore.Components.Authorization;
    @using Newtonsoft.Json;
    @using System.Net.Http.Json;
    @using System.Text;
    @using System.Text.RegularExpressions;


    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string ImageUrl { get; set; }
    [Parameter] public string ImageId { get; set; }
    [Parameter] public string Deliverable { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }

    [Inject] private NavigationManager NavigationManager { get; set; }
    [Inject] private NavigationManager Navigation { get; set; }
    [Inject] private ApiConfigService ApiConfig { get; set; }
    [Inject] private SessionService _sessionService { get; set; }
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; }
    [Inject] private HttpClient Http { get; set; } // Assuming you already use this

    private bool IsSaved = false;


    private async Task CloseModal()
    {
        if (!IsSaved)
        {
            SelectedImageUrls.Clear();
        }

        IsSaved = false; // reset for next open
        Show = false;
        await ShowChanged.InvokeAsync(false);
    }


    private HashSet<string> SelectedImageUrls = new();
    private HashSet<string> SelectedImageIds = new();

    private void ToggleSelection(string url, string id)
    {
        if (SelectedImageUrls.Contains(url))
        {
            SelectedImageUrls.Remove(url);
            SelectedImageIds.Remove(id);
        }
        else
        {
            SelectedImageUrls.Add(url);
            SelectedImageIds.Add(id);
        }
    }

    private async void SaveSelectedImages()
    {
        // Save to localStorage (keep this if you want)
        // var selectedImagesJson = System.Text.Json.JsonSerializer.Serialize(SelectedImageUrls);
        // await JSRuntime.InvokeVoidAsync("localStorage.setItem", "savedSelectedImages", selectedImagesJson);

        // Save to database
        foreach (var imageId in SelectedImageIds)
        {
            var result = await SaveConceptImageToDatabaseAsync(imageId);
            if (result != null)
            {
                Console.WriteLine($"✅ Image {imageId} saved with Guid {result}");
            }
            else
            {
                Console.WriteLine($"❌ Failed to save image {imageId}");
            }
        }

        IsSaved = true;

        // Optional: clear selection or close modal after save
        // SelectedImageUrls.Clear();
        // await CloseModal();
    }



    @inject IJSRuntime JSRuntime

    private string CardWidth = "70%"; // default

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            //var height = await JSRuntime.InvokeAsync<int>("getWindowHeight");

            // Load previous selection (optional)
            var savedImagesJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "savedSelectedImages");
            if (!string.IsNullOrEmpty(savedImagesJson))
            {
                var savedImages = System.Text.Json.JsonSerializer.Deserialize<HashSet<string>>(savedImagesJson);
                if (savedImages != null)
                {
                    SelectedImageUrls = savedImages;
                }
            }

            StateHasChanged();
        }
    }

    private async Task<string?> SaveConceptImageToDatabaseAsync(string imageId)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                string userId = user.Identity.Name;

                var requestBody = new
                {
                    ImageId = imageId
                };

                var response = await Http.PostAsJsonAsync($"{ApiConfig.ApiBaseUrl}api/SaveConceptImage?code=REDACTED_FOR_GROOMING", requestBody);

                if (!response.IsSuccessStatusCode)
                {
                    Console.WriteLine($"❌ Failed to save concept image: {response.StatusCode}");
                    return null;
                }
                else
                {
                    var jsonResponse = await response.Content.ReadFromJsonAsync<SaveConceptImageResponse>();

                    Console.WriteLine("✅ Concept image saved successfully.");

                    // Return the Guid from the response
                    return jsonResponse?.Guid;
                }
            }
            else
            {
                Console.WriteLine("⚠️ User not authenticated. Skipping concept image save.");
                return null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception in SaveConceptImageToDatabaseAsync: {ex.Message}");
            return null;
        }
    }

    private async Task<bool> DeleteConceptImageFromDatabaseAsync(string imageId)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                string userId = user.Identity.Name;

                var requestBody = new
                {
                    ImageId = imageId
                };

                var response = await Http.PostAsJsonAsync($"{ApiConfig.ApiBaseUrl}api/DeleteConceptImage?code=REDACTED_FOR_GROOMING", requestBody);

                if (!response.IsSuccessStatusCode)
                {
                    Console.WriteLine($"❌ Failed to delete concept image: {response.StatusCode}");
                    return false;
                }
                else
                {
                    Console.WriteLine("✅ Concept image deleted successfully.");
                    return true;
                }
            }
            else
            {
                Console.WriteLine("⚠️ User not authenticated. Skipping concept image delete.");
                return false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception in DeleteConceptImageFromDatabaseAsync: {ex.Message}");
            return false;
        }
    }


    public class SaveConceptImageResponse
    {
        public string Guid { get; set; }
    }

}
