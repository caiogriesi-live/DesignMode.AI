<MakeVideoSelectImages Show="@ShowMakeVideoSelectImages"
                       ShowChanged="CloseMakeVideoSelectImages"
                       SelectedImages="@SelectedImages"
                       RunwareImageIds="@RunwareImageIds"
                       SecondaryRunwareImageIds="@SecondaryRunwareImageIds"
                       OnImagesRemoved="@OnImagesRemoved"
                       AllIdeas="@AllIdeas"
                       OnConfirm="@OnConfirm"
                       OnClose="HandleSecondaryModalClosed"
                       GenerateNew=true
                       VideoId="@VideoId"/>
