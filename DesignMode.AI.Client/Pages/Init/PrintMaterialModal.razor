    private async Task GoToGenerateImages()
    {
        if (string.IsNullOrWhiteSpace(MainPromptText) || isGeneratingPrintImages || CallRunwareImageFunction == null || CallSaveImageIdeaFunction == null)
            return;
        await using var generationOperation = await BeginGenerationAsync();

        isGeneratingPrintImages = true;
        IsBusy = true;
        StateHasChanged();

        try
        {
            promptText = MainPromptText;

            var imageUrl = await CallRunwareImageFunction(promptText, 1344, 768, 1);
            if (string.IsNullOrWhiteSpace(imageUrl)) return;

            var newCountId = GetAllImages()
                .Select(img => int.TryParse(img.CountId, out var val) ? val : 0)
                .DefaultIfEmpty(0).Max() + 1;
            var timestamp = DateTime.UtcNow.ToString("yyyyMMddTHHmmssZ");
            var imageId = await CallSaveImageIdeaFunction("Secondary", "Print Materials", promptText, imageUrl, PromptIdFromCID, timestamp, newCountId.ToString());
            if (string.IsNullOrWhiteSpace(imageId)) imageId = Guid.NewGuid().ToString();

            var newImage = new Gen.ImageIdeaModel
                {
                    Id = imageId,
                    ImageUrl = imageUrl,
                    ImagePrompt = promptText,
                    DeliverableType = "Secondary",
                    SubCategory = "Print Materials",
                    CountId = newCountId.ToString()
                };

            newlyGeneratedImages.Clear();
            newlyGeneratedImages.Add(newImage);
            if (SelectedImages != null && !SelectedImages.Any(x => x.ImageUrl == imageUrl))
                SelectedImages.Add(newImage);

            ToggleSelection(newImage.ImageUrl, newImage.Id);
            wasImageGenerated = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ GoToGenerateImages: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
            isGeneratingPrintImages = false;
            StateHasChanged();
        }
    }

    private List<Gen.ImageIdeaModel> GetAllImages()
    {
        var result = new List<Gen.ImageIdeaModel>();
        if (SelectedImages != null) result.AddRange(SelectedImages);
        if (newlyGeneratedImages != null) result.AddRange(newlyGeneratedImages);
        return result;
    }

    private async Task<string> FetchDeliverableDetail(string deliverable)
    {
        var response = await Http.PostAsync(
            $"{ApiConfig.ApiBaseUrl}api/GetDeliverableDetail?code=REDACTED_FOR_GROOMING",
            new StringContent($"\"{deliverable}\"", Encoding.UTF8, "application/json"));
        if (!response.IsSuccessStatusCode) return "Print Materials";
        return Regex.Replace(await response.Content.ReadAsStringAsync(), @"\s*\r?\n\s*", " ").Trim();
    }

    private static string GetQueryParameter(string queryString, string key, string defaultValue)
    {
        if (string.IsNullOrWhiteSpace(queryString)) return defaultValue;
        var query = queryString.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
        foreach (var item in query)
        {
            var parts = item.Split('=', 2);
            if (parts.Length == 2 && parts[0].Equals(key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(parts[1]);
        }
        return defaultValue;
    }

    private static string SanitizeCompanyName(string companyName)
    {
        if (string.IsNullOrWhiteSpace(companyName)) return "Company";
        var safe = string.Concat(companyName.Where(c => !Path.GetInvalidFileNameChars().Contains(c)))
            .Replace(" ", "-")
            .Replace("&", "and");
        return Regex.Replace(safe, @"[^A-Za-z0-9._-]", "-").Trim('-');
    }

    private async Task CloseModal()
    {
        if (GenerationGuard is null && (IsBusy || IsGeneratingPdf || isGeneratingPrintImages)) return;
        if (!await ConfirmGenerationCloseAsync()) return;

        Show = false;
        await ShowChanged.InvokeAsync(false);
        if (OnModalClosed.HasDelegate && wasImageGenerated)
            await OnModalClosed.InvokeAsync();
        newlyGeneratedImages.Clear();
        wasImageGenerated = false;
        ActiveTab = TabType.GenerateNew;
        hasLoadedVersions = false;
        SelectedImageIds.Clear();
        SelectedImageUrls.Clear();
    }

