        return string.Join(" · ", new[] { ActiveGeneratedPdf.PrintType, ActiveGeneratedPdf.PaperSize, ActiveGeneratedPdf.Orientation, ActiveGeneratedPdf.Version }
            .Where(x => !string.IsNullOrWhiteSpace(x)));
