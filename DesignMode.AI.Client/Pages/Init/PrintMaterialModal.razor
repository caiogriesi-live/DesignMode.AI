    private async Task LoadExistingPrintMaterialVersionsAsync(string companyName)
    {
        var result = await GetPrintMaterialsByCompanyAsync(companyName);
        sortedPrintMaterials = result?.Data?
            .OrderByDescending(x => DateTime.TryParse(x.TimeStamp, out var dt) ? dt : DateTime.MinValue)
            .ToList() ?? new List<PrintMaterialRecord>();

        GeneratedPdfs.Clear();
        ActiveGeneratedPdf = null;
        GeneratedPreviewImageUrl = "";
        GeneratedPdfUrl = "";
        GeneratedPdfDownloadUrl = "";

        foreach (var row in sortedPrintMaterials)
        {
            var versionNumber = (row.Version ?? "v1").Trim().TrimStart('v', 'V');
            var previewUrl = GetPrintMaterialPreviewUrl(companyName, versionNumber);
            var pdfUrl = GetPrintMaterialPdfUrl(companyName, versionNumber);
            GeneratedPdfs.Add(new GeneratedPrintPdfRecord
                {
                    PreviewUrl = previewUrl,
                    PdfUrl = pdfUrl,
                    DownloadUrl = pdfUrl,
                    PrintMaterialsId = row.PrintMaterialsId ?? "",
                    Version = string.IsNullOrWhiteSpace(row.Version) ? $"v{versionNumber}" : row.Version,
                    PrintType = "Print Material",
                    PaperSize = "",
                    Orientation = "",
                    ColorMode = "",
                    CreatedAt = DateTime.TryParse(row.TimeStamp, out var created) ? created : DateTime.MinValue
                });
        }

        if (GeneratedPdfs.Any())
        {
            ViewGeneratedPdf(GeneratedPdfs.OrderByDescending(x => x.CreatedAt).First());
            currentVersion = ActiveGeneratedPdf?.Version.TrimStart('v', 'V') ?? "1";
        }
        else
        {
            currentVersion = "1";
        }
    }

    private int GetNextPrintMaterialVersion()
    {
        if (!sortedPrintMaterials.Any()) return 1;
        return sortedPrintMaterials
            .Select(x => int.TryParse((x.Version ?? "").Trim().TrimStart('v', 'V'), out var v) ? v : 0)
            .DefaultIfEmpty(0)
            .Max() + 1;
    }

    private string GetLogicalPrintMaterialsId()
    {
        var existingId = sortedPrintMaterials
            .Where(x => !string.IsNullOrWhiteSpace(x.PrintMaterialsId))
            .OrderByDescending(x => DateTime.TryParse(x.TimeStamp, out var dt) ? dt : DateTime.MinValue)
            .Select(x => x.PrintMaterialsId)
            .FirstOrDefault();
        return string.IsNullOrWhiteSpace(existingId) ? Guid.NewGuid().ToString() : existingId;
    }

    private string GetPrintMaterialFolderName(string companyName, string version)
    {
        var safeCompany = SanitizeCompanyName(companyName);
        var safeVersion = (version ?? "1").Replace("v", "", StringComparison.OrdinalIgnoreCase).Trim();
        return $"{safeCompany}-print-material-v{safeVersion}";
    }

