@inherits DesignMode.AI.Client.Components.GenerationAwareComponent
@using System.Collections.Generic
@using System.IO
@using System.Net.Http.Json
@using DesignMode.AI.Shared.Models
@using DesignMode.AI.Client.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Text
@using System.Text.RegularExpressions

@if (IsBusy)
{
    <div class="modal-busy-overlay"><div class="loader"></div></div>
}

@if (Show)
{
    <div class="modal-overlay generation-workspace-overlay" @onclick="CloseModal">
        <div class="vertical-modal-wrapper generation-workspace" @onclick:stopPropagation>
            <button class="modal-close" @onclick="CloseModal">×</button>

            <div class="modal-tabs">
                <button class="tab-button @(ActiveTab == TabType.GenerateNew ? "active" : "")"
                        @onclick="() => SetActiveTab(TabType.GenerateNew)">
                    <span class="tab-icon">✨</span> Generate New
                </button>
                <button class="tab-button @(ActiveTab == TabType.GeneratedPdf ? "active" : "")"
                        aria-label="Generated PDFs"
                        @onclick="() => SetActiveTab(TabType.GeneratedPdf)"
                        disabled="@(!IsGeneratingPdf && !HasExistingPrintMaterials && string.IsNullOrWhiteSpace(GeneratedPdfUrl))">
                    <span class="tab-icon">📄</span> Results
                    @if (IsGeneratingPdf)
                    {
                        <span class="tab-badge generating">Generating...</span>
                    }
                    else if (HasExistingPrintMaterials)
                    {
                        <span class="tab-badge">@sortedPrintMaterials.Count</span>
                    }
                </button>
            </div>

            <div class="modal-scroll-content">
                @if (ActiveTab == TabType.GenerateNew)
                {
                    <div class="tab-content generate-new-tab">
                        <div class="modal-header"><h2>Generate Print Material PDF</h2></div>
                        <details><summary>Print Materials instructions</summary><p style="white-space: pre-wrap">@MainPromptText</p></details>
                        @if (string.IsNullOrWhiteSpace(MainPromptText))
                        {
                            <p role="alert">This project has no Print Materials instructions. Generate its Print Materials AI idea before continuing.</p>
                        }
                        <div class="modal-intro">
                            Select <strong>one image</strong>. OpenAI will analyze that image as a visual brand reference, create a completely new print-material design, and then the generated artwork will be placed into a print-ready PDF.
                        </div>

                        <div class="print-material-status">
                            <span class="print-material-count">
                                <span class="print-material-icon">📄</span>
                                @if (HasPrintImages())
                                {
                                    <span>Print images ready</span>
                                    @if (SelectedImageIds.Any())
                                    {
                                        <span class="selection-count">1 selected</span>
                                    }
                                }
                                else
                                {
                                    <span style="font-weight:bold;">No images available</span>
                                    <span style="font-weight:normal;"> – Generate images first to unlock PDF creation</span>
                                }
                            </span>
                        </div>

                        @if (isGeneratingPrintImages)
                        {
                            <AIRecommendationGenerationLoader IsVisible="true" Message="Generating print source image..." />
                        }
                        else
                        {
                            <div class="image-grid">
                                @if (GetUniquePrintImages().Any())
                                {
                                    var groupedImages = GetUniquePrintImages()
                                    .GroupBy(img => img.SubCategory?.ToLower() == "generic" ? img.DeliverableType : img.SubCategory);

                                    @foreach (var group in groupedImages)
                                    {
                                        var firstImage = group.First();
                                        var sectionTitle = firstImage.SubCategory?.ToLower() == "generic"
                                        ? firstImage.DeliverableType
                                        : group.Key;
                                        var validImages = group
                                        .Where(i => !string.IsNullOrWhiteSpace(i.ImageUrl))
                                        .OrderBy(i => i.CountId)
                                        .ToList();

                                        if (validImages.Any())
                                        {
                                            <div class="deliverable-section">
                                                <h3 class="section-title">@sectionTitle</h3>
                                                <div class="image-col">
                                                    @foreach (var image in validImages)
                                                    {
                                                        @ImageCard(image)
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                                else
                                {
                                    <div class="empty-state">
                                        <div class="empty-icon">📄</div>
                                        <h3>No Print Images Yet</h3>
                                        <p>Create a print-related reference image first. OpenAI will analyze it and generate a new print-material design from its branding and visual style.</p>
                                        <button class="generate-images-button" @onclick="GoToGenerateImages" disabled="@(isGeneratingPrintImages || string.IsNullOrWhiteSpace(MainPromptText))">
                                            Generate Print Image
                                        </button>
                                    </div>
                                }
                            </div>
                        }

                        <div class="print-config-section">
                            <h3>Print Material Configuration</h3>
                            <div class="config-options two-col">
                                <div class="config-option">
                                    <label>Material Type</label>
                                    <select @bind="SelectedPrintType" class="config-select">
                                        <option value="Brochure">Brochure</option>
                                        <option value="Flyer">Flyer</option>
                                        <option value="Poster">Poster</option>
                                        <option value="BusinessCard">Business Cards</option>
                                        <option value="Letterhead">Letterhead</option>
                                        <option value="Presentation">Presentation</option>
                                        <option value="Catalog">Product Catalog</option>
                                    </select>
                                </div>
                                <div class="config-option">
                                    <label>Paper Size</label>
                                    <select @bind="SelectedPaperSize" class="config-select">
                                        <option value="A4">A4 (210×297mm)</option>
                                        <option value="Letter">Letter (8.5×11in)</option>
                                        <option value="A3">A3 (297×420mm)</option>
                                        <option value="Legal">Legal (8.5×14in)</option>
                                        <option value="Square">Square (8×8in)</option>
                                        <option value="Tabloid">Tabloid (11×17in)</option>
                                    </select>
                                </div>
                                <div class="config-option">
                                    <label>Orientation</label>
                                    <select @bind="SelectedOrientation" class="config-select">
                                        <option value="Portrait">Portrait</option>
                                        <option value="Landscape">Landscape</option>
                                    </select>
                                </div>
                                <div class="config-option">
                                    <label>Color Mode</label>
                                    <select @bind="SelectedColorMode" class="config-select">
                                        <option value="CMYK">CMYK (Print)</option>
                                        <option value="RGB">RGB (Digital View)</option>
                                        <option value="Grayscale">Grayscale</option>
                                    </select>
                                </div>
                            </div>

                            <div class="checkbox-row">
                                <label><input type="checkbox" @bind="IncludeBleedArea" /> Include Bleed Area</label>
                                <label><input type="checkbox" @bind="IncludeCropMarks" /> Include Crop Marks</label>
                                <label><input type="checkbox" @bind="AddPageNumbers" /> Add Page Numbers</label>
                                <label><input type="checkbox" @bind="IncludeCompanyLogo" /> Include Company Logo</label>
                                <label><input type="checkbox" @bind="IncludeContactInfo" /> Include Contact Info</label>
                                <label><input type="checkbox" @bind="HighResolutionOutput" /> High Resolution</label>
                            </div>

                            <div class="print-content-section">
                                <label>Print Content</label>
                                <textarea @bind="PrintContent"
                                          class="config-textarea"
                                          placeholder="Enter text/content to use in the generated print material. Leave blank to let the design use minimal brand-appropriate copy."></textarea>
                            </div>

                            @if (IncludeBleedArea)
                            {
                                <div class="bleed-options">
                                    <label>Bleed Area Size</label>
                                    <div class="range-row">
                                        <input type="range" min="1" max="10" @bind="BleedAreaSize" />
                                        <span>@BleedAreaSize mm</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="tab-content generated-pdf-tab">
                        <div class="modal-header"><h2>Generated Print Material PDF</h2></div>

                        @if (IsGeneratingPdf)
                        {
                            <div class="generation-loading-container">
                                <div class="generation-header">
                                    <h3>Creating Your Print Material</h3>
                                    <div class="generation-status">@GenerationStatus</div>
                                </div>
                                <div class="progress-bar-container"><div class="progress-bar" style="width: @(GenerationProgress)%;"></div></div>
                                <div class="current-step-details">@CurrentStepDetails</div>
                                <div class="generation-steps-log">
                                    @foreach (var step in GenerationSteps)
                                    {
                                        <div class="step-item"><span class="step-check">✓</span><span>@step</span></div>
                                    }
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(GenerationError))
                        {
                            <div class="generation-error">
                                <h3>Print-material generation failed</h3>
                                <p>@GenerationError</p>
                                <button class="save-button" @onclick="() => SetActiveTab(TabType.GenerateNew)">Back to Generate New</button>
                            </div>
                        }
                        else if (ActiveGeneratedPdf != null && !string.IsNullOrWhiteSpace(GeneratedPdfUrl))
                        {
                            <div class="generated-pdf-preview">
                                <div class="preview-toolbar">
                                    <div>
                                        <strong>Current Print Material</strong>
                                        <span class="preview-meta">@GetActivePreviewMeta()</span>
                                    </div>
                                    <div class="preview-actions">
                                        <button class="toolbar-button" @onclick="OpenGeneratedPdf">↗ Open</button>
                                        <button class="toolbar-button primary" @onclick="DownloadGeneratedPdf">📥 Download</button>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(GeneratedPreviewImageUrl))
                                {
                                    <div class="artwork-preview-stage">
                                        <img src="@GeneratedPreviewImageUrl" alt="Generated print material artwork" />
                                    </div>
                                }

                                <div class="pdf-preview-stage">
                                    <iframe src="@GeneratedPdfUrl" title="Generated print material PDF"></iframe>
                                </div>
                            </div>

                            @if (GeneratedPdfs.Any())
                            {
                                <div class="generated-history">
                                    <div class="generated-history-header">
                                        <div><h4>Saved Print PDFs</h4><p>Click a version to preview it above.</p></div>
                                        <span class="generated-count">@GeneratedPdfs.Count</span>
                                    </div>
                                    <div class="history-grid">
                                        @foreach (var item in GeneratedPdfs.OrderByDescending(x => x.CreatedAt))
                                        {
                                            var isActive = ActiveGeneratedPdf != null &&
                                            string.Equals(item.PrintMaterialsId, ActiveGeneratedPdf.PrintMaterialsId, StringComparison.OrdinalIgnoreCase) &&
                                            string.Equals(item.Version, ActiveGeneratedPdf.Version, StringComparison.OrdinalIgnoreCase);
                                            <button type="button" class="history-card @(isActive ? "active" : "")" @onclick="() => ViewGeneratedPdf(item)">
                                                @if (!string.IsNullOrWhiteSpace(item.PreviewUrl))
                                                {
                                                    <img class="history-artwork-thumb" src="@item.PreviewUrl" alt="Saved print artwork @item.Version" />
                                                }
                                                else
                                                {
                                                    <div class="pdf-card-icon">PDF</div>
                                                }
                                                <div class="history-card-info">
                                                    <strong>@item.PrintType</strong>
                                                    <span>@item.PaperSize · @item.Orientation · @item.Version</span>
                                                    <small>@item.CreatedAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</small>
                                                </div>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state generated-empty-state">
                                <div class="empty-icon">📄</div>
                                <h3>No PDF Generated Yet</h3>
                                <p>Go to Generate New, select one image, and create the PDF.</p>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (ActiveTab == TabType.GenerateNew)
            {
                <div class="footer-actions sticky-footer">
                    <button class="discard-button" @onclick="CloseModal">Cancel</button>
                    <button class="save-button"
                            @onclick="GeneratePrintMaterials"
                            disabled="@(!SelectedImageIds.Any() || IsGeneratingPdf || isGeneratingPrintImages || string.IsNullOrWhiteSpace(MainPromptText))"
                            style="@(!SelectedImageIds.Any() ? "background-color:#eee; color:#ababab;" : null)">
                        @GetGenerateButtonText()
                    </button>
                </div>
            }
            else
            {
                <div class="footer-actions sticky-footer">
                    <button class="discard-button" disabled="@IsGeneratingPdf" @onclick="() => SetActiveTab(TabType.GenerateNew)">← Back to Generate New PDF</button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Inject] private ApiConfigService ApiConfig { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private AttributionContextService AttributionContext { get; set; } = default!;
    [Inject] private Blazored.LocalStorage.ILocalStorageService LocalStorage { get; set; } = default!;
    [Inject] private AIUsageRefreshService UsageRefresh { get; set; } = default!;

    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public DesignMode.AI.Client.Pages.Init.MakeVideoModal.ImageIdeaCountResult AllIdeas { get; set; }
    [Parameter] public List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel> SelectedImages { get; set; } = new();
    [Parameter] public EventCallback<List<string>> OnImagesSelected { get; set; }
    [Parameter] public EventCallback<bool> OnPrintMaterialsGenerated { get; set; }
    [Parameter] public Func<string, int, int, int, Task<string>> CallRunwareImageFunction { get; set; }
    [Parameter] public Func<string, string, string, string, string, string, string, Task<string>> CallSaveImageIdeaFunction { get; set; }
    [Parameter] public string CompanyIdeaId { get; set; } = "";
    [Parameter] public string CompanyDescription { get; set; } = "";
    [Parameter] public string PromptIdFromCID { get; set; } = "";
    [Parameter] public string MainPromptText { get; set; } = "";
    [Parameter] public EventCallback OnModalClosed { get; set; }

    private enum TabType { GenerateNew, GeneratedPdf }
    private TabType ActiveTab { get; set; } = TabType.GenerateNew;

    private bool IsBusy;
    private bool IsGeneratingPdf;
    private bool isGeneratingPrintImages;
    private bool wasImageGenerated;
    private bool hasLoadedVersions;
    private string SelectedCompanyName = "";
    private string SelectedIndustry = "General";
    private string currentVersion = "1";

    private string GenerationStatus = "";
    private string CurrentStepDetails = "";
    private int GenerationProgress;
    private string GenerationError = "";
    private List<string> GenerationSteps = new();

    private string GeneratedPreviewImageUrl = "";
    private string GeneratedPdfUrl = "";
    private string GeneratedPdfDownloadUrl = "";
    private List<GeneratedPrintPdfRecord> GeneratedPdfs = new();
    private GeneratedPrintPdfRecord? ActiveGeneratedPdf;
    private List<PrintMaterialRecord> sortedPrintMaterials = new();
    private bool HasExistingPrintMaterials => sortedPrintMaterials.Any();

    private HashSet<string> SelectedImageIds = new();
    private HashSet<string> SelectedImageUrls = new();
    private List<Gen.ImageIdeaModel> newlyGeneratedImages = new();

    private string SelectedPrintType = "Brochure";
    private string SelectedPaperSize = "A4";
    private string SelectedOrientation = "Portrait";
    private string SelectedColorMode = "CMYK";
    private bool IncludeBleedArea = true;
    private bool IncludeCropMarks = true;
    private bool AddPageNumbers = false;
    private bool IncludeCompanyLogo = true;
    private bool IncludeContactInfo = true;
    private bool HighResolutionOutput = true;
    private int BleedAreaSize = 3;
    private string PrintContent = "";

    public string promptText { get; set; } = "";

    protected override async Task OnParametersSetAsync()
    {
        if (!Show)
            return;

        ResolveCompanyName();

        if (!hasLoadedVersions && !string.IsNullOrWhiteSpace(SelectedCompanyName))
        {
            await LoadExistingPrintMaterialVersionsAsync(SelectedCompanyName);
            hasLoadedVersions = true;
        }
    }

    private void ResolveCompanyName()
    {
        var queryString = new Uri(NavigationManager.Uri).Query;
        var cid = GetQueryParameter(queryString, "cid", CompanyIdeaId ?? "");

        if (string.IsNullOrWhiteSpace(cid))
            return;

        var parts = cid.Split(new[] { "|~~|@@|^^|" }, StringSplitOptions.None);
        if (parts.Length < 1)
            return;

        try
        {
            SelectedCompanyName = SanitizeCompanyName(
                Encoding.UTF8.GetString(Convert.FromBase64String(parts[0])));

            if (parts.Length >= 2 && !string.IsNullOrWhiteSpace(parts[1]))
            {
                SelectedIndustry = Encoding.UTF8.GetString(Convert.FromBase64String(parts[1]));
            }
        }
        catch (FormatException ex)
        {
            Console.WriteLine($"Error decoding company information: {ex.Message}");
        }
    }

    private void SetActiveTab(TabType tab)
    {
        ActiveTab = tab;
        GenerationError = "";
    }

    private bool HasPrintImages() => GetUniquePrintImages().Any();

    private List<Gen.ImageIdeaModel> GetUniquePrintImages()
    {
        var allImages = new List<Gen.ImageIdeaModel>();
        if (SelectedImages != null) allImages.AddRange(SelectedImages);
        if (newlyGeneratedImages != null) allImages.AddRange(newlyGeneratedImages);

        return allImages
            .Where(img => !string.IsNullOrWhiteSpace(img.ImageUrl) && IsPrintImage(img))
            .GroupBy(img => img.ImageUrl)
            .Select(g => g.First())
            .ToList();
    }

    private static bool IsPrintImage(Gen.ImageIdeaModel img)
    {
        var text = $"{img.DeliverableType} {img.SubCategory}";
        var keys = new[] { "print", "flyer", "brochure", "poster", "business card", "letterhead", "catalog", "stationery", "marketing material", "document", "report", "presentation", "banner", "signage" };
        return keys.Any(k => text.Contains(k, StringComparison.OrdinalIgnoreCase));
    }

    private void ToggleSelection(string url, string id)
    {
        // Print PDF generation is intentionally single-select.
        if (SelectedImageIds.Contains(id))
        {
            SelectedImageIds.Clear();
            SelectedImageUrls.Clear();
        }
        else
        {
            SelectedImageIds.Clear();
            SelectedImageUrls.Clear();
            SelectedImageIds.Add(id);
            SelectedImageUrls.Add(url);
        }

        if (OnImagesSelected.HasDelegate)
            _ = OnImagesSelected.InvokeAsync(SelectedImageIds.ToList());

        StateHasChanged();
    }

    private string GetGenerateButtonText() =>
        SelectedImageIds.Any()
            ? "Generate Print Material + PDF"
            : "Select One Image to Generate Print Material";

    private void UpdateGenerationStatus(string status, string details, int progress)
    {
        GenerationStatus = status;
        CurrentStepDetails = details;
        GenerationProgress = progress;
        if (!string.IsNullOrWhiteSpace(status) && !GenerationSteps.Contains(status))
            GenerationSteps.Add(status);
        StateHasChanged();
    }

    private async Task GeneratePrintMaterials()
    {
        if (string.IsNullOrWhiteSpace(MainPromptText) || IsGeneratingPdf || IsBusy || SelectedImageIds.Count != 1)
            return;
        await using var generationOperation = await BeginGenerationAsync();

        GenerationError = "";
        GenerationSteps.Clear();
        IsGeneratingPdf = true;
        ActiveTab = TabType.GeneratedPdf;
        StateHasChanged();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
                throw new InvalidOperationException("You must be signed in to create print materials.");

            ResolveCompanyName();

            var companyName = SelectedCompanyName;
            if (string.IsNullOrWhiteSpace(companyName))
                throw new InvalidOperationException("Company name could not be determined.");

            var selectedImage = GetUniquePrintImages()
                .FirstOrDefault(x => SelectedImageIds.Contains(x.Id));

            if (selectedImage == null || string.IsNullOrWhiteSpace(selectedImage.ImageUrl))
                throw new InvalidOperationException("The selected image could not be found.");

            if (!hasLoadedVersions)
            {
                UpdateGenerationStatus(
                    "Loading saved versions...",
                    "Checking existing PrintMaterials versions for this company",
                    8);

                await LoadExistingPrintMaterialVersionsAsync(companyName);
                hasLoadedVersions = true;
            }

            var nextVersion = GetNextPrintMaterialVersion();
            var versionText = $"v{nextVersion}";
            var logicalPrintMaterialsId = GetLogicalPrintMaterialsId();

            var attribution = await AttributionContext.AuthorizeGenerationAsync(CompanyIdeaId);
            var request = new GeneratePrintMaterialRequest
                {
                    ImageUrl = selectedImage.ImageUrl,
                    Name = companyName,
                    Industry = SelectedIndustry,
                    CompanyDescription = CompanyDescription,
                    Prompt = MainPromptText,
                    PrintType = SelectedPrintType,
                    PaperSize = SelectedPaperSize,
                    Orientation = SelectedOrientation,
                    ColorMode = SelectedColorMode,
                    IncludeBleedArea = IncludeBleedArea,
                    BleedAreaSize = BleedAreaSize,
                    IncludeCropMarks = IncludeCropMarks,
                    AddPageNumbers = AddPageNumbers,
                    IncludeCompanyLogo = IncludeCompanyLogo,
                    IncludeContactInfo = IncludeContactInfo,
                    HighResolutionOutput = HighResolutionOutput,
                    Content = PrintContent,
                    GenerationJobId = Guid.NewGuid().ToString(),
                    ProjectId = attribution?.ProjectId,
                    FunnelId = attribution?.FunnelId
                };

            UpdateGenerationStatus(
                "Generating print artwork...",
                "OpenAI is analyzing the selected image and creating a new branded print design",
                20);

            // Use a dedicated HttpClient for the long-running generation call.
            // The injected WASM HttpClient may still be configured with the
            // default 100-second timeout, while OpenAI image generation can
            // legitimately take longer. Keep the normal injected HttpClient
            // for the short save/history calls below.
            using var generationClient = new HttpClient
                {
                    Timeout = TimeSpan.FromSeconds(220)
                };
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrWhiteSpace(token))
                generationClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            using var response = await generationClient.PostAsJsonAsync(
                $"{ApiConfig.ApiBaseUrl}api/GeneratePrintMaterialPdf?code=REDACTED_FOR_GROOMING",
                request);
            if (await UsageRefresh.HandleResponseAsync(response)) return;

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                throw new InvalidOperationException(
                    $"GeneratePrintMaterialPdf returned {(int)response.StatusCode}: {error}");
            }
            await UsageRefresh.RequestRefreshAsync();

            UpdateGenerationStatus(
                "Artwork generated...",
                "OpenAI returned the new print-material artwork; preparing the PDF",
                48);

            var result = await response.Content.ReadFromJsonAsync<PrintMaterialGenerationResult>();

            if (result == null ||
                !result.Success ||
                string.IsNullOrWhiteSpace(result.PreviewUrl) ||
                string.IsNullOrWhiteSpace(result.PdfDataUrl))
            {
                throw new InvalidOperationException(
                    result?.Error ?? "The generation function did not return artwork and a PDF.");
            }

            GeneratedPreviewImageUrl = result.PreviewUrl;
            GeneratedPdfUrl = result.PdfDataUrl;
            GeneratedPdfDownloadUrl = result.PdfDataUrl;

            UpdateGenerationStatus(
                "Creating print PDF...",
                "The OpenAI-generated artwork has been placed into the configured PDF",
                68);

            UpdateGenerationStatus(
                "Saving print files...",
                $"Saving {versionText} artwork and PDF under SavedImages",
                78);

            var savedFiles = await SaveGeneratedPrintMaterialFilesAsync(
                result.PreviewUrl,
                result.PdfDataUrl,
                companyName,
                nextVersion.ToString());

            if (savedFiles == null ||
                string.IsNullOrWhiteSpace(savedFiles.ImageUrl) ||
                string.IsNullOrWhiteSpace(savedFiles.PdfUrl))
            {
                throw new InvalidOperationException(
                    "The generated print-material image/PDF could not be saved.");
            }

            UpdateGenerationStatus(
                "Saving version...",
                $"Adding {versionText} to the PrintMaterials table",
                90);

            await SavePrintMaterialAsync(
                logicalPrintMaterialsId,
                companyName,
                versionText,
                DateTime.UtcNow.ToString("o"));

            await LoadExistingPrintMaterialVersionsAsync(companyName);
            currentVersion = nextVersion.ToString();

            var record = GeneratedPdfs.FirstOrDefault(x =>
                x.Version.Equals(versionText, StringComparison.OrdinalIgnoreCase));

            if (record == null)
            {
                record = new GeneratedPrintPdfRecord
                    {
                        PreviewUrl = savedFiles.ImageUrl,
                        PdfUrl = savedFiles.PdfUrl,
                        DownloadUrl = savedFiles.PdfUrl,
                        PrintMaterialsId = logicalPrintMaterialsId,
                        Version = versionText,
                        CreatedAt = DateTime.UtcNow
                    };

                GeneratedPdfs.Insert(0, record);
            }

            record.PreviewUrl = savedFiles.ImageUrl;
            record.PdfUrl = savedFiles.PdfUrl;
            record.DownloadUrl = savedFiles.PdfUrl;
            record.PrintType = SelectedPrintType;
            record.PaperSize = SelectedPaperSize;
            record.Orientation = SelectedOrientation;
            record.ColorMode = SelectedColorMode;
            record.CreatedAt = DateTime.UtcNow;

            ViewGeneratedPdf(record);

            UpdateGenerationStatus(
                "Complete!",
                $"{versionText} artwork and PDF were generated and saved",
                100);

            if (OnPrintMaterialsGenerated.HasDelegate)
                await OnPrintMaterialsGenerated.InvokeAsync(true);
        }
        catch (TaskCanceledException ex)
        {
            GenerationError =
                "Print-material generation timed out before the Azure Function returned. " +
                "The OpenAI artwork generation may still have been processing. Please try again.";
            GenerationStatus = "Generation timed out";
            CurrentStepDetails = "The long-running generation request exceeded the client timeout.";
            GenerationProgress = 0;
            Console.WriteLine($"❌ GeneratePrintMaterials timeout: {ex}");
        }
        catch (Exception ex)
        {
            GenerationError = ex.Message;
            GenerationStatus = "Generation failed";
            CurrentStepDetails = ex.Message;
            GenerationProgress = 0;
