@inherits DesignMode.AI.Client.Components.GenerationAwareComponent
@using System.Collections.Generic
@using DesignMode.AI.Shared.Models
@using DesignMode.AI.Client.Services
@using Microsoft.AspNetCore.Components;
@using Microsoft.AspNetCore.Components.Authorization;

@if (IsBusy)
{
    <div class="new-video-generation-busy-overlay">
        <div class="loader"></div>
    </div>
}

@if (Show)
{
    <div class="new-video-generation-overlay generation-workspace-overlay" disabled="@IsGeneratingCommercial" @onclick="OnOverlayClick">
        <div class="new-video-generation-modal generation-workspace" style="        position: relative !important;
        width: min(820px, calc(100vw - 40px)) !important;
        height: min(650px, calc(100vh - 40px)) !important;
        max-height: calc(100vh - 40px) !important;
        padding: 16px 22px 26px !important;
        box-sizing: border-box !important;
        background: white !important;
        border-radius: 12px !important;
        display: flex !important;
        flex-direction: column !important;
        overflow: hidden !important;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2) !important;
        animation: newVideoZoomFadeIn 0.3s ease-out forwards !important;" @onclick:stopPropagation>
            <button class="new-video-generation-close" @onclick="CloseModal">×</button>

            <div class="new-video-generation-content">
                <div class="modal-header">
                    <h2>Generate New Video@* fire emoji 🔥 *@</h2>
                </div>
                @* <div style="margin-bottom: 30px;">
            Choose how you'd like to create your video using AI.
            </div> *@
                <div class="image-grid" style="margin-bottom: 8px;">
                    <!-- Options -->
                    <div class="modal-options">

                        <!-- Commercial Generator -->
                        <div class="option-card recommended" style="cursor: pointer;" @onclick="OpenMakeVideoSelectImages">
                            <span class="badge">AI Recommendation</span>
                            <h3>Commercial Generation</h3>
                            <span style="color: black;font-size: 16px;margin-bottom: 10px;margin-top: -7px;">AI-generated script - multiple shots - audio - text.  Pick images for each section</span>
                            @if (@RandomImage2 != null)
                            {
                                <img src="@RandomImage2" alt="Preview" class="generate-video" />
                            }
                            <button class="btn-primary"
                                    style="padding-top: 8px; position: relative;"
                                    disabled="@IsGeneratingCommercial"
                                    @onclick="OpenMakeVideoSelectImages">

                                @if (!IsGeneratingCommercial)
                                {
                                    <span>Generate Commercial</span>
                                }
                                else
                                {
                                    <div class="spinner"></div>
                                }
                            </button>

                        </div>
                        <!-- Quick Video -->
                        <div class="option-card">
                            <h3 style="font-size:16px;">Quick Video (coming soon)</h3>
                            <span style="color: black;font-size: 17px;margin-bottom: 15px;margin-top: -8px;">Generate a single short video from your selected design. Generate a single short video from your selected design.</span>
                            @if (@RandomImage1 != null)
                            {
                                <img src="@RandomImage1" alt="Preview" class="generate-video" />
                            }
                            <button class="btn-secondary" disabled="true" style="padding-top: 8px;">Generate 1 Video</button>
                        </div>
                    </div>
                    @functions {
                    RenderFragment ImageCard(DesignMode.AI.Client.Pages.Init.Gen.ConceptImageWithIdeaDto image) => __builder =>
                    {
                        var isMarkedForRemoval = RemovedImages.Contains(image.ImageId);
                        <div class="image-card @(isMarkedForRemoval ? "marked-for-removal" : "")"
                             @onclick="() => ToggleSelection(image.ImageUrl, image.ImageId)">
                            <img src="@image.ImageUrl" alt="Concept image" class="image-thumb" />
                            <div class="image-controls">
                                <button class="icon-btn"
                                        @onclick="() => ToggleSelection(image.ImageUrl, image.ImageId)"
                                        alt="Remove from Concept"
                                @onclick:stopPropagation>
                                    @if (isMarkedForRemoval)
                                    {
                                        <span style="color: red;font-weight: bold;">✕</span>
                                    }
                                    else
                                    {
                                        <text>🗑️</text>
                                    }
                                </button>
                            </div>
                        </div>
                    };
                }
            </div>
        </div>


    </div>
</div>
}

@code {
    [Inject] private ApiConfigService ApiConfig { get; set; }
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; }
    [Inject] private HttpClient Http { get; set; }
    [Inject] private NavigationManager NavigationManager { get; set; }

    private bool ShowMakeVideoSelectImages { get; set; } = false;
    private bool ShowNewVideoGenerationModal { get; set; } = false;
    private bool IsBusy = false;

    private async Task OnOverlayClick(MouseEventArgs e)
    {
        if (IsGeneratingCommercial)
            return; // ⛔ ignore outside click

        await CloseModal();
    }


    // Parameters
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public List<string> RunwareImageIds { get; set; } = new List<string>();
    [Parameter] public List<string> SecondaryRunwareImageIds { get; set; } = new List<string>();
    [Parameter] public List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel> SelectedImages { get; set; }
    [Parameter] public EventCallback<List<string>> OnImagesRemoved { get; set; }
    [Parameter] public EventCallback<bool> OnConfirm { get; set; }
    [Parameter] public string Main { get; set; }
    [Parameter] public string VideoId { get; set; }
    [Parameter] public EventCallback OnAIUsageRecorded { get; set; }

    // State variables
    private HashSet<string> SelectedImageUrls = new();
    private HashSet<string> SelectedImageIds = new();
    private List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel> OriginalImages = new();
    private List<string> RemovedImages = new();
    private bool HasChanges => RemovedImages.Count > 0;
    private bool IsConceptPopoverVisible = false;
    private ImageIdeaCountResult allIdeas { get; set; }
    private bool isAuthorized = false;

    // Loading state flags to prevent repeated calls
    private bool _randomImagesLoaded = false;
    private bool _dataLoaded = false;
    private bool _isLoadingData = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Handle random images
        if (Show && !_randomImagesLoaded)
        {
            SelectTwoDistinctRandomImages();
            _randomImagesLoaded = true;
            StateHasChanged();
        }

        // Handle data loading - only when modal is shown and data not loaded
        if (Show && !_dataLoaded && !_isLoadingData && SelectedImages?.Any() == true)
        {
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoadingData = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            isAuthorized = user.Identity?.IsAuthenticated == true;

            var uri = NavigationManager.Uri;
            var queryString = new Uri(uri).Query;
            string cid = GetQueryParameter(queryString, "cid", null);

            if (!string.IsNullOrEmpty(cid))
            {
                allIdeas = await GetImageIdeaCountsAsync(cid);
                await ProcessImageIdeasData();
            }

            // Store the original list of images
            OriginalImages = new List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel>(SelectedImages);
            SelectedImageUrls = new HashSet<string>(SelectedImages.Select(x => x.ImageUrl));
            SelectedImageIds = new HashSet<string>(SelectedImages.Select(x => x.Id));
            RemovedImages.Clear();

            _dataLoaded = true;
            StateHasChanged();
        }
        finally
        {
            _isLoadingData = false;
        }
    }

    private async Task ProcessImageIdeasData()
    {
        if (allIdeas != null && allIdeas.Ideas != null)
        {
            allIdeas.IdeaPromptMatches = new List<bool>();
            string promptTextNormalized = allIdeas.PromptText.TrimStart(':').Trim().ToLower();

            foreach (var idea in allIdeas.Ideas)
            {
                string formattedIdea = $"{idea.Title}: {idea.Description}"
                    .Trim()
                    .ToLower();
                bool matches = formattedIdea == promptTextNormalized;
                allIdeas.IdeaPromptMatches.Add(matches);
            }

            // Check if PromptText matches any idea
            bool anyPromptMatchesIdea = allIdeas.IdeaPromptMatches.Any(m => m);
            allIdeas.AnyPromptMatchesIdea = anyPromptMatchesIdea;

            // Filter ImageIdeas for video/photo content
            var filteredImageIdeas = allIdeas.ImageIdeas
                .Where(ii => (ii.DeliverableType?.ToLower().Contains("video") == true
                           || ii.DeliverableType?.ToLower().Contains("photo") == true
                           || ii.SubCategory?.ToLower().Contains("video") == true
                           || ii.SubCategory?.ToLower().Contains("photo") == true))
                .ToList();

            allIdeas.ImageIdeasFiltered = filteredImageIdeas;

            // Count how many filtered ImageIdeas match the PromptText
            int filteredPromptMatchCount = filteredImageIdeas
                .Count(ii => ii.ExtractedText?.TrimStart(':').Trim().ToLower() == promptTextNormalized);

            allIdeas.FilteredPromptMatchCount = filteredPromptMatchCount;

            // Determine video generation requirements
            await CalculateVideoRequirementsBefore(filteredImageIdeas);
        }
    }

    private async Task CalculateVideoRequirements(List<ImageIdeaItem> filteredImageIdeas)
    {
        // If there are no filtered ideas at all, require 1
        if (filteredImageIdeas == null || filteredImageIdeas.Count == 0)
        {
            HowMuchMore = 1;
            return;
        }

        // Look for ANY filtered idea that has a matching SelectedImage with a NON-empty imageUrl
        bool anyValidMatch = filteredImageIdeas.Any(filtered =>
            SelectedImages.Any(sel =>
                sel.Id == filtered.Id &&
                !string.IsNullOrWhiteSpace(sel.ImageUrl)
            )
        );

        // If none of the filtered ideas have a matching image with an URL → require 1
        HowMuchMore = anyValidMatch ? 0 : 1;

        // await InvokeAsync(StateHasChanged);  // optional
    }

    private async Task CalculateVideoRequirementsBefore(List<ImageIdeaItem> filteredImageIdeas)
    {
        // If there are no filtered ideas at all, require 1
        if (filteredImageIdeas == null || filteredImageIdeas.Count == 0)
        {
            HowMuchMore = 1;
            return;
        }

        // Look for ANY filtered idea that has a matching SelectedImage with a NON-empty imageUrl
        bool anyValidMatch = filteredImageIdeas.Any(filtered =>
            SelectedImages.Any(sel =>
                sel.Id == filtered.Id &&
                !string.IsNullOrWhiteSpace(sel.ImageUrl)
            )
        );

        // If none of the filtered ideas have a matching image with an URL → require 1
        HowMuchMore = anyValidMatch ? 0 : 1;

        // await InvokeAsync(StateHasChanged);  // optional
    }

    private bool IsGeneratingCommercial { get; set; } = false;

    private async Task OpenMakeVideoSelectImages()
    {
        await using var generationOperation = await BeginGenerationAsync();
        IsGeneratingCommercial = true;
        StateHasChanged();  // ensure spinner appears immediately

        try
        {
            if (!_dataLoaded)
                await LoadDataAsync();

            await ProcessImageIdeasData();
            await CalculateVideoRequirementsBefore(allIdeas.ImageIdeasFiltered);

            Show = false;

            if (HowMuchMore > 0)
                ShowNewVideoGenerationModal = true;
            else
                ShowMakeVideoSelectImages = true;

            await ShowChanged.InvokeAsync(false);
        }
        finally
        {
            IsGeneratingCommercial = false;
        }
    }

    private async Task CloseMakeVideoSelectImages()
    {
        ShowMakeVideoSelectImages = false;
        await ShowChanged.InvokeAsync(false);
    }

    // Random image selection
    private string RandomImage1;
    private string RandomImage2;
    private static readonly Random _rand = new();
    private int HowMuchMore { get; set; }

    // Data models
    public class ImageIdeaCountResult
    {
        public List<IdeaItem> Ideas { get; set; } = new();
        public string PromptId { get; set; } = string.Empty;
        public string PromptText { get; set; } = string.Empty;
        public int VideoMatchCount { get; set; }
        public int VideoNoMatchCount { get; set; }
        public List<string> ExtractedTexts { get; set; } = new();
        public List<ImageIdeaItem> ImageIdeas { get; set; } = new();
        public List<bool> IdeaPromptMatches { get; set; } = new();
        public List<ImageIdeaItem> ImageIdeasFiltered { get; set; } = new();
        public List<bool> ImageIdeasMatches { get; set; } = new();
        public int FilteredPromptMatchCount { get; set; }
        public bool AnyPromptMatchesIdea { get; set; }
    }

    public class IdeaItem
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }

    public class ImageIdeaItem
    {
        public string Id { get; set; } = string.Empty;       // NEW
        public string CountId { get; set; } = string.Empty;  // NEW
        public string DeliverableType { get; set; } = string.Empty;
        public string SubCategory { get; set; } = string.Empty;
        public string ExtractedText { get; set; } = string.Empty;
        public string RawPrompt { get; set; } = string.Empty;
    }
    [Parameter] public EventCallback OnSecondaryModalClosed { get; set; }

    private async Task HandleSecondaryModalClosed()
    {
        // you can do internal stuff here...

        // 🔥 bubble upward to parent page
        await OnSecondaryModalClosed.InvokeAsync();
    }


    private void SelectTwoDistinctRandomImages()
    {
        if (SelectedImages == null || SelectedImages.Count == 0)
        {
            RandomImage1 = RandomImage2 = "https://placehold.co/600x400?text=No+Images";
            return;
        }

        string[] keys = { "Video", "Social", "Event", "Animation" };

        // Pool of images matching these categories
        var pool = SelectedImages
            .Where(x =>
                (x.DeliverableType != null &&
                 keys.Any(k => x.DeliverableType.Contains(k, StringComparison.OrdinalIgnoreCase))) ||
                (x.SubCategory != null &&
                 keys.Any(k => x.SubCategory.Contains(k, StringComparison.OrdinalIgnoreCase))))
            .ToList();

        // Fallback to ANY images if no matches
        if (pool.Count == 0)
        {
            if (SelectedImages.Count == 1)
            {
                RandomImage1 = SelectedImages[0].ImageUrl;
                RandomImage2 = SelectedImages[0].ImageUrl;
                return;
            }

            var shuffled = SelectedImages.OrderBy(_ => _rand.Next()).ToList();
            RandomImage1 = shuffled[0].ImageUrl;
            RandomImage2 = shuffled[1].ImageUrl;
            return;
        }

        // If only one valid image exists
        if (pool.Count == 1)
        {
            RandomImage1 = pool[0].ImageUrl;
            var fallback = SelectedImages.FirstOrDefault(x => x.Id != pool[0].Id);
            RandomImage2 = fallback?.ImageUrl ?? pool[0].ImageUrl;
            return;
        }

        // Normal behavior: two distinct images from the pool
        var first = pool[_rand.Next(pool.Count)];
        var secondPool = pool.Where(x => x.Id != first.Id).ToList();
        var second = secondPool[_rand.Next(secondPool.Count)];

        bool IsVideo(dynamic x) =>
            (x.DeliverableType?.Contains("Video", StringComparison.OrdinalIgnoreCase) ?? false) ||
            (x.SubCategory?.Contains("Video", StringComparison.OrdinalIgnoreCase) ?? false);

        // Ensure video is second image if only one is video
        if (IsVideo(first) && !IsVideo(second))
        {
            var temp = first;
            first = second;
            second = temp;
        }

        RandomImage1 = first.ImageUrl;
        RandomImage2 = second.ImageUrl;
    }

    private string GetQueryParameter(string queryString, string key, string defaultValue)
    {
        var parameters = System.Web.HttpUtility.ParseQueryString(queryString);
        return parameters[key] ?? defaultValue;
    }

    private void ToggleSelection(string url, string id)
    {
        if (SelectedImageUrls.Contains(url))
        {
            SelectedImageUrls.Remove(url);
            SelectedImageIds.Remove(id);
            RemovedImages.Add(id);
        }
        else
        {
            SelectedImageUrls.Add(url);
            SelectedImageIds.Add(id);
            RemovedImages.Remove(id);
        }
    }

    private async Task SaveChanges()
    {
        IsBusy = true;

        bool confirmed = false;

        foreach (var imageId in RemovedImages)
        {
            confirmed = await DeleteConceptImageFromDatabaseAsync(imageId);
        }

        IsBusy = false;

        if (confirmed)
        {
            // Success: hide balloon, close modal
            IsConceptPopoverVisible = false;

            // Notify parent of removed images
            if (OnImagesRemoved.HasDelegate)
            {
                await OnImagesRemoved.InvokeAsync(RemovedImages.ToList());
            }

            if (OnConfirm.HasDelegate)
            {
                await OnConfirm.InvokeAsync(true);
            }

            await CloseModal();
        }
        else
        {
            // Failure: show balloon again
            IsConceptPopoverVisible = true;
        }
    }

    private async Task<ImageIdeaCountResult?> GetImageIdeaCountsAsync(string companyIdeaId)
    {
        try
        {
            HttpClient client = new HttpClient();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var url =
                    $"{ApiConfig.ApiBaseUrl}api/GetImageIdeaCountsByCompanyId?companyIdeaId={companyIdeaId}" +
                    "&code=REDACTED_FOR_GROOMING";

                var response = await client.GetAsync(url);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<ImageIdeaCountResult>();
                    if (result == null)
                        return null;

                    Console.WriteLine("✅ Retrieved image idea counts + idea info + deliverable types.");
                    return result;
                }
                else
                {
                    Console.WriteLine($"❌ Failed to retrieve image idea counts: {response.StatusCode}");
                    return null;
                }
            }

            Console.WriteLine("⚠️ User not authenticated.");
            return null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception retrieving image idea counts: {ex.Message}");
            return null;
        }
    }

    private async Task<bool> DeleteConceptImageFromDatabaseAsync(string imageId)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var requestBody = new { ImageId = imageId };

                var response = await Http.PostAsJsonAsync(
                    $"{ApiConfig.ApiBaseUrl}api/DeleteConceptImage?code=REDACTED_FOR_GROOMING",
                    requestBody);

                if (response.IsSuccessStatusCode)
                {
                    Console.WriteLine("✅ Deleted concept image successfully.");
                    return true;
                }
                else
                {
                    Console.WriteLine($"❌ Failed to delete concept image: {response.StatusCode}");
                    return false;
                }
            }

            Console.WriteLine("⚠️ User not authenticated.");
            return false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception deleting concept image: {ex.Message}");
            return false;
        }
    }

    private async Task CloseModal()
    {
        if (GenerationGuard is null && (IsBusy)) return;
        if (!await ConfirmGenerationCloseAsync()) return;

        // Reset the state when closing
        RemovedImages.Clear();
        Show = false;
        _randomImagesLoaded = false;
        _dataLoaded = false; // Reset so data reloads next time modal opens
        await ShowChanged.InvokeAsync(false);
    }
}

