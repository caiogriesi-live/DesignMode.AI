    private async Task GoToGenerateImages()
    {
        if (isGeneratingWebsiteImages) return;
        await using var generationOperation = await BeginGenerationAsync();

        IsBusy = true;
        isGeneratingWebsiteImages = true;
        var uri = NavigationManager.Uri;
        var queryString = new Uri(uri).Query;
        string cid = GetQueryParameter(queryString, "cid", null);

        var imageIdeas = SelectedImages;

        var sortedIdeas = imageIdeas
            .OrderBy(idea => Int32.Parse(idea.CountId))
            .ToList();

        // Get main deliverable (Generic)
        var mainIdea = sortedIdeas.FirstOrDefault(idea =>
            string.Equals(idea.SubCategory, "Generic", StringComparison.OrdinalIgnoreCase));
        var MainDeliverable = "";
        var q = "";
        string promptTextCall = "";
        string promptIdCall = "";
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var username = user.Identity?.Name;
        // ✅ Apply your business rules
        string deliverableType = "";
        string subCategory = "";
        if (!string.IsNullOrWhiteSpace(username))
        {
            promptIdCall = PromptIdFromCID;
        }
        var pText = AllIdeas;
        var mainPrompt = "";
        if (mainIdea != null)
        {
            MainDeliverable = mainIdea.DeliverableType;

            bool isWebRelated = IsWebRelated(MainDeliverable);
            //IMPORTANT: pass the data to prevent multiple database calls
            if (isWebRelated)
            {
                q = MainPromptText;
                // ✅ Apply your business rules
                deliverableType = "Web & UX/UI Website";
                subCategory = "Generic";
            }
            else
            {
                if (pText == null || pText.Ideas == null || !pText.Ideas.Any())
                {
                    pText = await GetImageIdeaCountsAsync(cid);
                }
                // MODIFIED: Search pText.Ideas for web-related title
                if (pText != null && pText.Ideas != null && pText.Ideas.Any())
                {
                    // Find the first idea in pText.Ideas with a web-related title
                    var webRelatedIdea = pText.Ideas
                        .FirstOrDefault(idea => IsWebRelated(idea.Title));

                    deliverableType = "Secondary";
                    subCategory = webRelatedIdea.Title;

                    if (webRelatedIdea != null)
                    {
                        // Use title + description from the web-related idea in pText
                        q = $"{webRelatedIdea.Title} {webRelatedIdea.Description.TrimStart('-')}";
                        Console.WriteLine($"✅ Using web-related idea from pText: {webRelatedIdea.Title}");
                    }
                    else
                    {
                        // If no web-related idea found, use the first idea from pText
                        var firstIdea = pText.Ideas.First();
                        q = $"{firstIdea.Title} {firstIdea.Description.TrimStart('-')}";
                        Console.WriteLine($"⚠️ No web-related ideas in pText, using first: {firstIdea.Title}");
                    }
                }
                else
                {
                    // Fallback if pText has no ideas
                    q = "Professional website design - Modern responsive website with clean layout";
                    Console.WriteLine($"⚠️ pText has no ideas, using default");
                }
            }
        }
        mainPrompt = MainPromptText;
        var test = q;
        string[] parts = cid.Split(new string[] { "|~~|@@|^^|" }, StringSplitOptions.None);

        string name = string.Empty;
        string industry = string.Empty;

        if (parts.Length >= 2)
        {
            // Decode Base64 for company name and industry
            try
            {
                name = Encoding.UTF8.GetString(Convert.FromBase64String(parts[0]));
                industry = Encoding.UTF8.GetString(Convert.FromBase64String(parts[1]));
            }
            catch (FormatException ex)
            {
                Console.WriteLine($"Error decoding Base64 values: {ex.Message}");
            }
        }
        string mainDeliverableDetail = await FetchDeliverableDetail("Web & UX/UI Website");

        var match = Regex.Match(mainDeliverableDetail, @"Display:\s*(.*?)\s*(?=\w+:|$)", RegexOptions.IgnoreCase);
        var DisplayLocation = match.Success ? match.Groups[1].Value.Trim() : "Not found";
        var companyDescription = CompanyDescription;
        string packageModular = "";
        promptText = $"{DisplayLocation}|{q}|{name}|{industry}|{mainDeliverableDetail}|Web & UX/UI Website|{companyDescription}|{packageModular}";

        StateHasChanged();

        try
        {
            // Generate only the first (and only) prompt
            currentGenerationIndex = 1;

            try
            {
                var imageUrl = await CallRunwareImageFunction(promptText, 1344, 768, 1);

                if (!string.IsNullOrEmpty(imageUrl))
                {
                    string timestamp = DateTime.UtcNow.ToString("yyyyMMddTHHmmssZ");

                    int newCountId = 1;
                    var allImages = new List<Gen.ImageIdeaModel>();
                    if (SelectedImages != null) allImages.AddRange(SelectedImages);
                    if (newlyGeneratedImages != null) allImages.AddRange(newlyGeneratedImages);

                    if (allImages.Any())
                    {
                        var maxCount = allImages
                            .Select(img => int.TryParse(img.CountId, out var val) ? val : 0)
                            .Max();
                        newCountId = maxCount + 1;
                    }

                    string imageId = await CallSaveImageIdeaFunction(
                        deliverableType,
                        subCategory,
                        promptText,
                        imageUrl,
                        PromptIdFromCID,
                        timestamp,
                        newCountId.ToString()
                    );

                    if (string.IsNullOrEmpty(imageId))
                    {
                        imageId = Guid.NewGuid().ToString();
                        Console.WriteLine("⚠️ Image saved but no ID returned, using fallback GUID");
                    }

                    var newImage = new Gen.ImageIdeaModel
                        {
                            Id = imageId,
                            ImageUrl = imageUrl,
                            ImagePrompt = promptText,
                            DeliverableType = deliverableType,
                            SubCategory = subCategory,
                            CountId = newCountId.ToString(),
                        };

                    // Clear previous newly generated images and add only this one
                    newlyGeneratedImages.Clear();
                    newlyGeneratedImages.Add(newImage);

                    // Add to SelectedImages if not already there
                    if (SelectedImages != null && !SelectedImages.Any(img => img.ImageUrl == imageUrl))
                    {
                        SelectedImages.Add(newImage);
                    }

                    SelectedImageIds.Add(newImage.Id);
                    SelectedImageUrls.Add(newImage.ImageUrl);

                    // MARK: Image was generated - set flag to true
                    wasImageGenerated = true;

                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Error generating image for prompt '{promptText}': {ex.Message}");
            }

            if (newlyGeneratedImages.Any())
            {
                Console.WriteLine(
                    $"✅ Generated {newlyGeneratedImages.Count} image as {deliverableType} - {subCategory}"
                );

                websitePromptsToGenerate.Clear();
                StateHasChanged();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error in GoToGenerateImages: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
            isGeneratingWebsiteImages = false;
            currentGenerationIndex = 0;
            totalGenerations = 0;
            StateHasChanged();
        }
    }
    private async Task<string> CheckPackageLabelRelevance(string name, string industry, string prompt, string companyDescription = "")
    {
        HttpClient client = new HttpClient();
        string functionUrl = $"{ApiConfig.ApiBaseUrl}api/CheckPackageLabelRelevance?code=REDACTED_FOR_GROOMING";

        var payload = new
        {
            Name = name,
            Industry = industry,
            Prompt = prompt,
            CompanyDescription = companyDescription
        };

        var content = new StringContent(JsonConvert.SerializeObject(payload), Encoding.UTF8, "application/json");

        var response = await client.PostAsync(functionUrl, content);

        if (response.IsSuccessStatusCode)
        {
            // Just return the full response string
            return await response.Content.ReadAsStringAsync();
        }

        return "Error: Unable to check package label relevance.";
    }

    private async Task<string> GetPackageModularFormula(string name, string industry, string prompt, string companyDescription = "")
    {
        HttpClient client = new HttpClient();
        string functionUrl = $"{ApiConfig.ApiBaseUrl}api/GetPackageModularFormula?code=REDACTED_FOR_GROOMING";

        var payload = new
        {
            Name = name,
            Industry = industry,
            Prompt = prompt,
            CompanyDescription = companyDescription
        };

        var content = new StringContent(JsonConvert.SerializeObject(payload), Encoding.UTF8, "application/json");

        var response = await client.PostAsync(functionUrl, content);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadAsStringAsync();

            // Optional cleanup: remove leading/trailing quotes or whitespace
            string cleanedResult = result.Trim().Trim('"').Trim();

            return cleanedResult;
        }

        return "Error: Unable to retrieve modular packaging formula.";
    }

    private async Task<string> FetchCompanyDescription(string name, string industry, string prompt)
    {
        HttpClient client = new HttpClient();
        string functionUrl = $"{ApiConfig.ApiBaseUrl}api/GetCompanyDescription?code=REDACTED_FOR_GROOMING";

        var payload = new
        {
            Name = name,
            Industry = industry,
            Prompt = prompt
        };

        var content = new StringContent(JsonConvert.SerializeObject(payload), Encoding.UTF8, "application/json");

        var response = await client.PostAsync(functionUrl, content);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadAsStringAsync();

            // Normalize newlines and collapse to one line
            string singleLine = Regex.Replace(result, @"\s*\r?\n\s*", " ").Trim();
            return singleLine;
        }

        return "Error: Unable to fetch company description.";
    }

    private async Task<string> FetchDeliverableDetail(string deliverable)
    {
        HttpClient client = new HttpClient();
        string functionUrl = $"{ApiConfig.ApiBaseUrl}api/GetDeliverableDetail?code=REDACTED_FOR_GROOMING";

        var content = new StringContent($"\"{deliverable}\"", System.Text.Encoding.UTF8, "application/json");

        var response = await client.PostAsync(functionUrl, content);

        if (response.IsSuccessStatusCode)
        {
            var detail = await response.Content.ReadAsStringAsync();

            // Normalize newlines and collapse to one line
            string singleLine = Regex.Replace(detail, @"\s*\r?\n\s*", " ").Trim();
            return singleLine;
        }

        return "Error: Unable to fetch deliverable detail.";
    }

