@if (IsBusy)
{
    <div class="modal-busy-overlay">
        <div class="loader"></div>
    </div>
}

@if (Show)
{
    <div class="ai-modal-overlay" @onclick="CloseModal">
        <div class="ai-mobile-modal" @onclick:stopPropagation>

            <div class="ai-modal-header">
                <span>Brand Kit</span>
                <button class="ai-modal-close" @onclick="CloseModal" style="color:black">✕</button>
            </div>

            <div xxclass="concept-balloon" xxid="conceptPopover" @onclick:stopPropagation>
                <div class="concept-balloon-header">@(conceptImages.Count == 0 ? "No Assets Selected" : "Selected Images and Videos")</div>
                <div class="concept-balloon-items">
                    @if (conceptImages != null && conceptImages.Any())
                    {
                        int visibleCount = Math.Min(5, conceptImages.Count);

                        @for (int i = 0; i < visibleCount; i++)
                        {
                            var item = conceptImages[i];

                            // Check if this image has a video ID
                            bool hasVideoId = !string.IsNullOrEmpty(item.VideoId);

                            if (i == 4 && conceptImages.Count > 5)
                            {
                                <div class="concept-balloon-item" @onclick="HandleOpenEditConceptClick">
                                    <div class="concept-balloon-thumb extra-thumb">
                                        <img src="@item.ImageUrl" class="extra-thumb-img" />
                                        <div class="extra-thumb-overlay">+@(conceptImages.Count - 4)</div>
                                        @if (hasVideoId)
                                        {
                                            <div class="video-indicator">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="white" style="filter: drop-shadow(0 1px 2px rgba(0,0,0,0.5));">
                                                    <path d="M10 16.5l6-4.5-6-4.5v9zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" />
                                                </svg>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="concept-balloon-item" @onclick="() => HandleToggleSelectionClick(item.ImageUrl, item.ImageId, hasVideoId)">
                                    <div class="concept-balloon-thumb" style="position: relative;">
                                        <img src="@item.ImageUrl" class="concept-balloon-thumb" />
                                        @if (hasVideoId)
                                        {
                                            <div class="video-indicator">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="white" style="filter: drop-shadow(0 1px 2px rgba(0,0,0,0.5));">
                                                    <path d="M10 16.5l6-4.5-6-4.5v9zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" />
                                                </svg>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <p>No concept images selected</p>
                    }
                </div>

                <div class="concept-balloon-actions">
                    <button class="btn-third" @onclick="HandleOpenEditConceptClick" disabled="@(conceptImages == null || !conceptImages.Any())">
                        Edit Brand Kit
                    </button>

                    <button class="btn-fourth"
                            style="background-color: #f5f7fa;padding-left: 20px;padding-bottom: 11px;"
                            @onclick="HandleOpenAllAssetsClick">
                        🗃️ All Generated Assets
                        <span class="cart-count @(allImagesGenerated.Count > 0 ? "pulse" : "")">
                            @allImagesGenerated.Count
                        </span>
                    </button>

                    <div class="next-action">
                        <button class="btn-secondary">
                            Download Assets
                        </button>
                    </div>

                </div>

            </div>

        </div>
    </div>
}

