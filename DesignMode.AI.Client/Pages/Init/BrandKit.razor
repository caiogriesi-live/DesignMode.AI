    private bool IsWebRelated(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return false;

        string[] webKeywords =
        {
        "web",
        "website",
        "ux",
        "ui",
        "ux/ui",
        "user experience",
        "user interface",
        "frontend",
        "front-end",
        "web design",
        "web app",
        "landing page"
    };

        return webKeywords.Any(keyword =>
            text.Contains(keyword, StringComparison.OrdinalIgnoreCase));
    }

    // Method to get only 1 website prompt
    private List<string> GetSingleWebsitePrompt()
    {
        var websitePrompts = new List<string>();

        if (SelectedImages == null || !SelectedImages.Any())
            return websitePrompts;

        // Look for images that are already website-related
        var existingWebsiteImages = SelectedImages
            .Where(img => !string.IsNullOrWhiteSpace(img.ImagePrompt) &&
                         (img.DeliverableType?.ToLower().Contains("web") == true ||
                          img.SubCategory?.ToLower().Contains("web") == true ||
                          img.DeliverableType?.ToLower().Contains("digital") == true ||
                          img.SubCategory?.ToLower().Contains("digital") == true ||
                          img.DeliverableType?.ToLower().Contains("website") == true ||
                          img.SubCategory?.ToLower().Contains("website") == true))
            .Select(img => img.ImagePrompt)
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .ToList();

        if (existingWebsiteImages.Any())
        {
            // Use the first existing website prompt
            websitePrompts.Add(existingWebsiteImages.First());
        }
        else if (SelectedImages.Any(img => !string.IsNullOrWhiteSpace(img.ImagePrompt)))
        {
            // Transform the first non-website prompt for website use
            var firstImageWithPrompt = SelectedImages.First(img => !string.IsNullOrWhiteSpace(img.ImagePrompt));
            var websitePrompt = TransformPromptForWebsite(firstImageWithPrompt.ImagePrompt);
            websitePrompts.Add(websitePrompt);
        }
        else
        {
            // Default prompt
            websitePrompts.Add("modern website hero banner with clean design, professional layout, web interface");
        }

        return websitePrompts.Take(1).ToList(); // Only take 1 prompt
    }

    private List<string> GetWebsitePromptsFromSelectedImages()
    {
        // Now returns only 1 prompt
        return GetSingleWebsitePrompt();
    }

    private string TransformPromptForWebsite(string originalPrompt)
    {
        // Transform the prompt to be more website-focused
        var transformed = originalPrompt;

        // Remove any existing deliverable references
        transformed = transformed.Replace("logo", "")
                                .Replace("social media", "")
                                .Replace("print", "")
                                .Replace("brochure", "")
                                .Replace("flyer", "")
                                .Replace("label", "")
                                .Replace("package", "")
                                .Replace("event", "")
                                .Replace("activation", "");

        // Add website-specific terms
        if (!transformed.Contains("website") && !transformed.Contains("web"))
        {
            transformed = "website design for " + transformed;
        }

        // Add layout/UI terms
        if (!transformed.Contains("layout") && !transformed.Contains("interface") && !transformed.Contains("design"))
        {
            transformed += ", modern web layout, responsive design";
        }

        // Ensure it's for web dimensions
        if (!transformed.Contains("16:9") && !transformed.Contains("aspect ratio"))
        {
            transformed += ", 16:9 aspect ratio";
        }

        return transformed.Trim();
    }


    private string GetGenerateButtonText()
    {
        if (!SelectedImageIds.Any())
        {
            return "Select Images to Generate Website";
        }

        return $"Generate Website ({SelectedImageIds.Count} images selected)";
    }

    private async Task GenerateWebsite()
    {
        if (IsBusy || !SelectedImageIds.Any()) return;
        await using var generationOperation = await BeginGenerationAsync();

        IsBusy = true;
        StateHasChanged();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                // Get the selected image data
                var selectedImagesData = SelectedImages?
                    .Where(img => SelectedImageIds.Contains(img.Id))
                    .ToList() ?? new List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel>();

                // Prepare website generation request
                var websiteRequest = new
                {
                    SelectedImages = selectedImagesData,
                    SelectedImageIds = SelectedImageIds.ToList(),
                    WebsiteType = SelectedWebsiteType,
                    ColorScheme = SelectedColorScheme,
                    IncludeContactForm = IncludeContactForm,
                    MakeResponsive = MakeResponsive,
                    UserId = user.Identity.Name,
                    Timestamp = DateTime.UtcNow.ToString("yyyyMMddTHHmmssZ")
                };

                // Call API to generate website
                var response = await Http.PostAsJsonAsync(
                    $"{ApiConfig.ApiBaseUrl}api/GenerateWebsite?code=REDACTED_FOR_GROOMING",
                    websiteRequest);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<WebsiteGenerationResult>();

                    if (result != null && result.Success)
                    {
                        Console.WriteLine("✅ Website generated successfully!");
                        Console.WriteLine($"🌐 Preview URL: {result.PreviewUrl}");
                        Console.WriteLine($"📁 Download URL: {result.DownloadUrl}");

                        // Notify parent
                        if (OnWebsiteGenerated.HasDelegate)
                        {
                            await OnWebsiteGenerated.InvokeAsync(true);
                        }

                        // Close modal
                        if (generationOperation is not null) await generationOperation.DisposeAsync();
                        await CloseModal();
                        if (Show) return;
                    }
                    else
                    {
                        Console.WriteLine("❌ Website generation failed");
                    }
                }
                else
                {
                    Console.WriteLine($"❌ Failed to generate website: {response.StatusCode}");
                }
            }
            else
            {
                Console.WriteLine("⚠️ User not authenticated.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception generating website: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
            StateHasChanged();
        }
    }

    private async Task CloseModal()
    {
        if (GenerationGuard is null && (IsBusy)) return;
        if (!await ConfirmGenerationCloseAsync()) return;

        Show = false;

        await ShowChanged.InvokeAsync(false);

        if (OnModalClosed.HasDelegate)
        {
            await OnModalClosed.InvokeAsync();
        }
    }
