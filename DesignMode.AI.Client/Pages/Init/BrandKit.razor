    // Helper method to check if we have website images
    private bool HasWebsiteImages()
    {
        if (SelectedImages == null && newlyGeneratedImages == null)
            return false;

        // Check if we have any website-related images
        var allImages = new List<Gen.ImageIdeaModel>();
        if (SelectedImages != null) allImages.AddRange(SelectedImages);
        if (newlyGeneratedImages != null) allImages.AddRange(newlyGeneratedImages);

        return allImages.Any(img =>
            !string.IsNullOrWhiteSpace(img.ImageUrl) &&
            (img.DeliverableType?.ToLower().Contains("web") == true ||
             img.SubCategory?.ToLower().Contains("web") == true ||
             img.DeliverableType?.ToLower().Contains("digital") == true ||
             img.SubCategory?.ToLower().Contains("digital") == true ||
             img.DeliverableType?.ToLower().Contains("website") == true ||
             img.SubCategory?.ToLower().Contains("website") == true));
    }

    // Helper method to get unique website images (avoid duplicates)
    private List<Gen.ImageIdeaModel> GetUniqueWebsiteImages()
    {
        var allImages = new List<Gen.ImageIdeaModel>();

        // Add selected images
        if (SelectedImages != null)
        {
            allImages.AddRange(SelectedImages);
        }

        // Add newly generated images
        if (newlyGeneratedImages != null)
        {
            allImages.AddRange(newlyGeneratedImages);
        }

        // Filter for website images and remove duplicates by ImageUrl
        var websiteImages = allImages
            .Where(img => !string.IsNullOrWhiteSpace(img.ImageUrl) &&
                         (img.DeliverableType?.ToLower().Contains("web") == true ||
                          img.SubCategory?.ToLower().Contains("web") == true ||
                          img.DeliverableType?.ToLower().Contains("digital") == true ||
                          img.SubCategory?.ToLower().Contains("digital") == true ||
                          img.DeliverableType?.ToLower().Contains("website") == true ||
                          img.SubCategory?.ToLower().Contains("website") == true))
            .GroupBy(img => img.ImageUrl) // Group by ImageUrl to remove duplicates
            .Select(group => group.First()) // Take the first occurrence of each unique ImageUrl
            .ToList();

        return websiteImages;
    }

    protected override void OnParametersSet()
    {
        if (SelectedImages != null && SelectedImages.Any())
        {
            // Clear previous selections
            SelectedImageIds.Clear();
            SelectedImageUrls.Clear();

            // Get unique website images to avoid duplicates
            var websiteImages = GetUniqueWebsiteImages();

            foreach (var image in websiteImages)
            {
                if (!string.IsNullOrEmpty(image.Id))
                {
                    SelectedImageIds.Add(image.Id);
                    if (!string.IsNullOrEmpty(image.ImageUrl))
                    {
                        SelectedImageUrls.Add(image.ImageUrl);
                    }
                }
            }

            StateHasChanged();
        }
    }
