    private string billingInterval = "monthly";
    private string? returnUrl;
    private bool isProcessing = false;
    private string? processingPlan = null;

    private async Task StartCheckout(string plan, bool isOneTime)
    {
        if (isProcessing)
            return;

        try
        {
            isProcessing = true;
            processingPlan = plan;
            StateHasChanged();

            Console.WriteLine("[CHECKOUT ANALYTICS] unlock_clicked requested");
            var unlockDispatched = await Analytics.TrackAndFlushAsync("unlock_clicked", new { plan, funnel_stage = "unlock" });
            Console.WriteLine(unlockDispatched
                ? "[CHECKOUT ANALYTICS] unlock_clicked dispatched"
                : "[CHECKOUT ANALYTICS] unlock_clicked unavailable; checkout continuing");

            // ------------------------------------------------------------
            // 1. Get authenticated user
            // ------------------------------------------------------------
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                throw new Exception("User is not authenticated.");
            }

            var username = user.Identity?.Name?.Trim();

            if (string.IsNullOrWhiteSpace(username))
            {
                throw new Exception(
                    "The authenticated user does not have a username.");
            }

            Console.WriteLine($"Authenticated username: '{username}'");

            var apiBaseUrl = ApiConfig.ApiBaseUrl.TrimEnd('/');

            // ------------------------------------------------------------
            // 2. Get UserId from Azure Function
            // ------------------------------------------------------------
            var getUserIdUrl =
                $"{apiBaseUrl}/api/GetUserIdByUsername" +
                "?code=REDACTED_FOR_GROOMING";

            Console.WriteLine($"Calling GetUserIdByUsername for '{username}'");

            var userIdResponse = await Http.PostAsJsonAsync(
                getUserIdUrl,
                new GetUserIdRequest
                    {
                        Username = username
                    });

            var userIdResponseBody =
                await userIdResponse.Content.ReadAsStringAsync();

            Console.WriteLine(
                $"GetUserIdByUsername status: " +
                $"{(int)userIdResponse.StatusCode} " +
                $"{userIdResponse.StatusCode}");

            Console.WriteLine(
                $"GetUserIdByUsername body: {userIdResponseBody}");

            // ------------------------------------------------------------
            // 3. Handle user not found separately
            // ------------------------------------------------------------
            if (userIdResponse.StatusCode == HttpStatusCode.NotFound)
            {
                GetUserIdResponse? notFoundResult = null;

                try
                {
                    notFoundResult =
                        System.Text.Json.JsonSerializer.Deserialize<GetUserIdResponse>(
                            userIdResponseBody,
                            new JsonSerializerOptions
                                {
                                    PropertyNameCaseInsensitive = true
                                });
                }
                catch
                {
                    // Response wasn't valid JSON.
                }

                var attemptedUsername =
                    notFoundResult?.Username ?? username;

                throw new Exception(
                    $"No database user was found for username " +
                    $"'{attemptedUsername}'.");
            }

            // ------------------------------------------------------------
            // 4. Handle any other API error
            // ------------------------------------------------------------
            if (!userIdResponse.IsSuccessStatusCode)
            {
                throw new Exception(
                    $"GetUserIdByUsername failed with HTTP " +
                    $"{(int)userIdResponse.StatusCode} " +
                    $"({userIdResponse.StatusCode}). " +
                    $"Response: {userIdResponseBody}");
            }

            var userIdResult =
                System.Text.Json.JsonSerializer.Deserialize<GetUserIdResponse>(
                    userIdResponseBody,
                    new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        });

            var userId = userIdResult?.UserId;

            if (string.IsNullOrWhiteSpace(userId))
            {
                throw new Exception(
                    "The user was found, but no UserId was returned.");
            }

            Console.WriteLine($"Resolved UserId: '{userId}'");

            // ------------------------------------------------------------
            // 5. Get return URL / id
            // ------------------------------------------------------------
            var currentUri =
                NavigationManager.ToAbsoluteUri(
                    NavigationManager.Uri);

            returnUrl = currentUri.ToString();

            var query =
                System.Web.HttpUtility.ParseQueryString(
                    currentUri.Query);

            var id = query["id"];

            if (string.IsNullOrWhiteSpace(id))
            {
                throw new Exception(
                    "Missing id in the current URL.");
            }

            Console.WriteLine($"Checkout id: '{id}'");

            if (WebsiteFunnel && !await AttributionContext.ValidateAndSetActiveProjectAsync(query["projectId"] ?? ""))
                throw new InvalidOperationException("Your website project could not be restored. Sign in with the account that created it.");
            var attribution = await AttributionContext.GetContextAsync();

            // ------------------------------------------------------------
            // 6. Create Stripe checkout session
            // ------------------------------------------------------------
            var checkoutUrl =
                $"{apiBaseUrl}/api/CreateCheckoutSession" +
                "?code=REDACTED_FOR_GROOMING";

            var checkoutRequest = new
            {
                plan,
                billingInterval,
                isOneTime,
                returnUrl,
                landingVariant = WebsiteFunnel ? "website-funnel" : null,
                userId,
                id,
                projectId = attribution?.ProjectId,
                funnelId = attribution?.FunnelId,
                measurement = await Analytics.CheckoutContextAsync()
            };

            HttpResponseMessage checkoutResponse;
            if (WebsiteFunnel)
            {
                using var message = new HttpRequestMessage(HttpMethod.Post, checkoutUrl)
                {
                    Content = JsonContent.Create(checkoutRequest)
                };
                message.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer", await LocalStorage.GetItemAsync<string>("authToken"));
                checkoutResponse = await Http.SendAsync(message);
            }
            else
            {
                checkoutResponse = await Http.PostAsJsonAsync(checkoutUrl, checkoutRequest);
            }

            var checkoutResponseBody =
                await checkoutResponse.Content.ReadAsStringAsync();

            Console.WriteLine(
                $"CreateCheckoutSession status: " +
                $"{(int)checkoutResponse.StatusCode} " +
                $"{checkoutResponse.StatusCode}");

            Console.WriteLine(
                $"CreateCheckoutSession body: " +
                $"{checkoutResponseBody}");

            if (!checkoutResponse.IsSuccessStatusCode)
            {
                throw new Exception(
                    $"CreateCheckoutSession failed with HTTP " +
                    $"{(int)checkoutResponse.StatusCode} " +
                    $"({checkoutResponse.StatusCode}). " +
                    $"Response: {checkoutResponseBody}");
            }

            var checkoutResult =
                System.Text.Json.JsonSerializer.Deserialize<CheckoutResponse>(
                    checkoutResponseBody,
                    new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        });

            if (checkoutResult == null ||
                string.IsNullOrWhiteSpace(checkoutResult.Url))
            {
                throw new Exception(
                    "Checkout session was created but no URL was returned.");
            }

            Console.WriteLine("[CHECKOUT ANALYTICS] checkout creation succeeded");

            // ------------------------------------------------------------
            // 7. Redirect to Stripe
            // ------------------------------------------------------------
            Console.WriteLine("[CHECKOUT ANALYTICS] begin_checkout requested");
            var checkoutDispatched = await Analytics.TrackAndFlushAsync("begin_checkout", new
            {
                plan,
                billing_interval = isOneTime ? "one_time" : billingInterval,
                value = checkoutResult.Value,
                currency = checkoutResult.Currency,
                items = new[] { new { item_id = plan, quantity = 1, price = checkoutResult.Value } }
            });
            Console.WriteLine(checkoutDispatched
                ? "[CHECKOUT ANALYTICS] begin_checkout dispatched"
                : "[CHECKOUT ANALYTICS] begin_checkout unavailable; redirect continuing");
            Console.WriteLine("[CHECKOUT ANALYTICS] redirecting to Stripe");
            NavigationManager.NavigateTo(
                checkoutResult.Url,
                forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Checkout error: {ex.Message}");
            if (WebsiteFunnel) _websiteCheckoutError = "Checkout could not start. Please sign in with the account that created this website project and try again.";
        }
        finally
        {
            isProcessing = false;
            processingPlan = null;
            StateHasChanged();
        }
    }


