    private void StartProgressSimulation(DateTime? actualRenderStartedUtc = null)
    {
        progressTimer?.Stop();
        progressTimer?.Dispose();

        progressStartTime = actualRenderStartedUtc ?? DateTime.UtcNow;

        var initialElapsed = Math.Max(
            0,
            (DateTime.UtcNow - progressStartTime).TotalSeconds);

        videoProgress = CalculateAdaptiveProgress(
            initialElapsed,
            mainEstimatedSeconds);

        videoStatusText = GetMainVideoStatusText(
            videoProgress,
            initialElapsed);

        progressTimer = new System.Timers.Timer(500);
        progressTimer.AutoReset = true;

        progressTimer.Elapsed += async (_, _) =>
        {
            if (isVideoGenerated)
                return;

            var elapsedSeconds = Math.Max(
                0,
                (DateTime.UtcNow - progressStartTime).TotalSeconds);

            var newProgress = CalculateAdaptiveProgress(
                elapsedSeconds,
                mainEstimatedSeconds);

            if (newProgress == videoProgress)
                return;

            videoProgress = newProgress;
            videoStatusText = GetMainVideoStatusText(
                videoProgress,
                elapsedSeconds);

            await InvokeAsync(StateHasChanged);
        };

        progressTimer.Start();
    }

    private void StartBonusTextAnimation()
    {
        bonusTextTimer = new System.Timers.Timer(2200);
        bonusTextTimer.Elapsed += (sender, e) =>
        {
            // Start sliding animation
            isBonusSliding = true;
            bonusSlideDirection = "up";
            InvokeAsync(StateHasChanged);

            // After animation completes, update text
            Task.Delay(500).ContinueWith(_ =>
            {
                currentBonusIndex = (currentBonusIndex + 1) % bonusTexts.Length;
                isBonusSliding = false;
                InvokeAsync(StateHasChanged);
            });
        };
        bonusTextTimer.Start();
    }

