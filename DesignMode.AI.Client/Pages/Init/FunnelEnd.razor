    private void StartVideoStatusPolling(string imageId)
    {
        jobPollingCancellation?.Cancel();
        jobPollingCancellation?.Dispose();

        jobPollingCancellation =
            new CancellationTokenSource();

        CurrentVideoJobStatus = "Queued";
        CurrentVideoJobStep = "Queued";
        CurrentVideoPollAttempt = 0;
        GeneratedVideoUrl = null;
        VideoGenerationError = null;

        // Deliberately do not await this task.
        _ = PollDesignModeJobStatusAsync(
            imageId,
            jobPollingCancellation.Token);
    }

    private async Task PollDesignModeJobStatusAsync(
        string imageId,
        CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                DesignModeJobStatus? jobStatus =
                    await GetDesignModeJobStatusByImageIdAsync(imageId);

                if (jobStatus is null)
                {
                    await Task.Delay(
                        TimeSpan.FromSeconds(5),
                        cancellationToken);

                    continue;
                }

                CurrentVideoJobStatus =
                    jobStatus.Status;

                CurrentVideoJobStep =
                    jobStatus.CurrentStep;

                CurrentVideoPollAttempt =
                    jobStatus.VideoPollAttempt;

                if (jobStatus.IsCompleted)
                {
                    if (string.IsNullOrWhiteSpace(jobStatus.VideoUrl))
                    {
                        VideoGenerationError =
                            "The job completed but no video URL was returned.";
                    }
                    else
                    {
                        GeneratedVideoUrl =
                            jobStatus.VideoUrl;

                        CurrentVideoJobStatus =
                            "Completed";

                        CurrentVideoJobStep =
                            "Completed";

                        // Use the provider job creation time when available so
                        // the learned duration includes work started before this page loaded.
                        progressStartTime = ResolveRenderStartUtc(
                            jobStatus,
                            progressStartTime == default ? DateTime.UtcNow : progressStartTime);

                        // Set progress to 100% and open modal.
                        await OnVideoCompletedAsync(GeneratedVideoUrl);
                    }

                    await InvokeAsync(StateHasChanged);
                    return;
                }

                if (jobStatus.IsFailed)
                {
                    VideoGenerationError =
                        string.IsNullOrWhiteSpace(jobStatus.Error)
                            ? "Video generation failed."
                            : jobStatus.Error;

                    await InvokeAsync(StateHasChanged);
                    return;
                }

                await InvokeAsync(StateHasChanged);

                await Task.Delay(
                    TimeSpan.FromSeconds(5),
                    cancellationToken);
            }
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
            // Expected when polling is stopped or the component is disposed.
        }
        catch (Exception ex)
        {
            VideoGenerationError =
                $"Unable to check video status: {ex.Message}";

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnVideoCompletedAsync(string videoUrl)
    {
        Console.WriteLine($"Video completed: {videoUrl}");

        GeneratedVideoUrl = videoUrl;
        modalVideoUrl = videoUrl;
        isVideoGenerated = true;
        MainVideoReady = true;

        progressTimer?.Stop();
        progressTimer?.Dispose();
        progressTimer = null;

        // Set progress to 100% as soon as the API confirms completion.
        videoProgress = 100;
        videoStatusText = "✅ Video ready!";

        var renderDurationSeconds = Math.Max(
            1,
            (DateTime.UtcNow - progressStartTime).TotalSeconds);

        await RecordRenderDurationAsync(
            MainRenderHistoryKey,
            renderDurationSeconds);

        await InvokeAsync(StateHasChanged);

        // Automatically open the completed main-concept preview.
        // It starts muted because browsers normally block autoplay with sound
        // when playback was not initiated by a user gesture.
        await Task.Delay(250);
        await OpenVideoModalAsync(videoUrl, startMuted: true);

        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenVideoModalAsync(
        string videoUrl,
        bool startMuted = false)
    {
        if (string.IsNullOrWhiteSpace(videoUrl))
            return;

        // Stop any previous modal playback before replacing the source.
        try
        {
            await JS.InvokeVoidAsync("pauseVideo", videoElement);
        }
        catch
        {
            // The modal video may not be rendered yet.
        }

        modalVideoUrl = videoUrl;

        // Recreate the <video> element on every open. This prevents the browser
        // from preserving the previous video's playback position.
        modalVideoRenderKey++;

        showVideoModal = true;
        isVideoPlaying = true;

        await InvokeAsync(StateHasChanged);

        // Give Blazor one render cycle to create the new video element.
        await Task.Delay(75);

        bool started = false;

        try
        {
            started = await JS.InvokeAsync<bool>(
                "loadAndPlayVideoFromStart",
                videoElement,
                startMuted);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Unable to autoplay modal video: {ex.Message}");
        }

        isVideoPlaying = started;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenVideoModal()
    {
        var videoUrl = !string.IsNullOrWhiteSpace(GeneratedVideoUrl)
            ? GeneratedVideoUrl
