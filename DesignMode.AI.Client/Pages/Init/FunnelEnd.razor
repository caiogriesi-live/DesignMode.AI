@page "/init/funnelend"
@using Telerik.Blazor.Components
@using Telerik.Blazor
@using Telerik.SvgIcons
@using DesignMode.AI.Client.Services
@using Microsoft.AspNetCore.Components;
@using Microsoft.AspNetCore.Components.Authorization;
@using System.Text;
@using DesignMode.AI.Shared.Models;
@using Newtonsoft.Json;
@using System.Text.RegularExpressions;
@using DesignMode.AI.Client.Pages;
@using DesignMode.AI.Client.Pages.Init;
@inject NavigationManager NavigationManager
@inject ApiConfigService ApiConfig
@inject AuthenticationStateProvider AuthStateProvider
@inject SessionService _sessionService
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@using Microsoft.AspNetCore.WebUtilities
@using System.Text
@inject IJSRuntime JS
@inject HttpClient Http
@inject AttributionContextService AttributionContext
@using System.Net
@implements IDisposable
@using System.Net.Http
@using System.Net.Http.Json
@using System.Text.Json


<link rel="stylesheet" href="https://cloudflare.com">
<script src='https://kit.fontawesome.com/a076d05399.js' crossorigin='anonymous'></script>
<style>

    :root {
        --purple: #5b25f5;
        --purple-dark: #170064;
        --ink: #080742;
        --muted: #4d4a82;
        --border: #e7e7f2;
        --bg: #fbfbff;
        --card: #ffffff;
        --soft: #f5f1ff;
        --shadow: 0 24px 70px rgba(20, 16, 70, .14);
        --radius: 18px;
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: var(--bg);
        color: var(--ink);
        font-weight: 450;
    }

    header {
        height: 74px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 42px;
        border-bottom: 1px solid var(--border);
        background: rgba(255, 255, 255, .86);
        backdrop-filter: blur(16px);
        position: sticky;
        top: 0;
        z-index: 20;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        font-size: 18px;
    }

    .logo-mark {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: linear-gradient(135deg, #3512d8, #8b5cff);
    }

    .steps {
        display: flex;
        gap: 34px;
        align-items: center;
        font-size: 13px;
        font-weight: 600;
        color: var(--muted);
    }

    .step {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .step span {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: #ececf5;
            color: #5d5b83;
            font-size: 12px;
            font-weight: 600;
        }

        .step.active {
            color: var(--ink);
        }

            .step.active span {
                background: var(--purple);
                color: white;
            }

    .exit {
        background: white;
        border: 1px solid var(--border);
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 600;
        color: var(--ink);
    }

    .page {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 430px;
        gap: 36px;
        padding: 9px 42px 120px;
        max-width: 1480px;
        margin: 0 auto;
        align-items: start;
        overflow: visible;
    }

    .section-title {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        margin-bottom: 28px;
    }

    .number {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--purple);
        color: white;
        display: grid;
        place-items: center;
        font-weight: 700;
        flex: 0 0 auto;
        padding-bottom: 2px;
        margin-top: 6px;
    }

    h1,
    h2,
    h3,
    p {
        margin: 0;
        font-weight: 450;
    }

    h1 {
        font-size: clamp(24px, 3vw, 34px);
        line-height: 1.05;
        letter-spacing: -.04em;
        font-weight: 600;
    }

    .subtitle {
        color: var(--muted);
        margin-top: 10px;
        font-size: 15px;
        font-weight: 450;
    }

    .asset-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .asset-card,
    .system-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 14px;
        min-height: 210px;
        position: relative;
        box-shadow: 0 10px 28px rgba(12, 10, 60, .04);
    }

    .lock {
        position: absolute;
        top: 12px;
        right: 12px;
        color: var(--purple);
        font-size: 14px;
    }

    .thumb {
        width: 100%;
        height: 146px;
        border-radius: 10px;
        object-fit: cover;
        background: #f4f1ec;
        margin-bottom: 18px;
    }

    .asset-card h3,
    .system-card h3 {
        font-size: 14px;
        margin-bottom: 10px;
        font-weight: 550;
    }

    .asset-card p,
    .system-card p {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.55;
        font-weight: 450;
    }

    .note {
        margin: 18px 0;
        border-radius: 12px;
        background: linear-gradient(90deg, #f3edff, #fbf8ff);
        padding: 18px 24px;
        color: var(--muted);
        display: flex;
        gap: 16px;
        align-items: center;
        font-size: 14px;
        font-weight: 450;
    }

    .brand-system {
        border-top: 1px solid var(--border);
        margin-top: 18px;
        padding-top: 24px;
    }

    .system-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 16px;
        margin-top: 22px;
    }

    .system-card {
        min-height: 130px;
        text-align: center;
    }

        .system-card .thumb {
            height: 70px;
            margin-bottom: 10px;
        }

    .side {
        position: sticky;
        top: 96px;
        align-self: start;
        z-index: 10;
        max-height: calc(100vh - 61px);
        overflow-y: auto;
        background: white;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 24px;
    }

    .selected {
        color: var(--purple);
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 16px;
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .eyebrow {
        font-size: 12px;
        color: var(--muted);
        margin-bottom: 6px;
        font-weight: 450;
    }

    .side h2 {
        font-size: 18px;
        letter-spacing: -.04em;
        margin-bottom: 12px;
        font-weight: 550;
    }

    .side p {
        color: var(--muted);
        line-height: 1.5;
        font-size: 14px;
        font-weight: 450;
    }

    .designer {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 7px 0;
        padding-bottom: 7px;
    }

    .avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
    }

    .benefits {
        border-bottom: 1px solid var(--border);
        padding: 24px 0;
    }

    .benefit-grid {
        margin-top: 18px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px 20px;
        font-size: 13px;
        color: var(--muted);
        font-weight: 450;
    }

    .benefit::before {
        content: "✓";
        color: var(--purple);
        font-weight: 700;
        margin-right: 8px;
    }

    .price-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 24px 0 12px;
    }

    .price {
        font-size: 34px;
        font-weight: 700;
        letter-spacing: -.04em;
    }

        .price small {
            font-size: 13px;
            font-weight: 500;
            color: var(--muted);
        }

    .btn {
        border: 0;
        background: linear-gradient(135deg, #6729ff, #4e16df);
        color: white;
        border-radius: 10px;
        padding: 16px 26px;
        font-weight: 700;
        cursor: pointer;
        font-size: 13px;
        box-shadow: 0 10px 24px rgba(91, 37, 245, .28);
    }

    .mobile-bar {
        display: none;
    }

    @@media (max-width: 1100px) {
        .page {
            grid-template-columns: 1fr;
        }

        .side {
            display: none;
        }

        .asset-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .system-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .mobile-bar {
            position: fixed;
            left: 12px;
            right: 12px;
            bottom: 12px;
            z-index: 50;
            display: grid;
            grid-template-columns: 58px 1fr auto;
            align-items: center;
            gap: 12px;
            background: white;
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 12px;
            box-shadow: 0 18px 50px rgba(20, 16, 70, .22);
        }

            .mobile-bar img {
                width: 58px;
                height: 58px;
                border-radius: 12px;
                object-fit: cover;
            }

            .mobile-bar h3 {
                font-size: 14px;
                margin-bottom: 4px;
                font-weight: 550;
            }

            .mobile-bar p {
                font-size: 12px;
                line-height: 1.35;
                color: var(--muted);
                font-weight: 450;
            }

            .mobile-bar .btn {
                padding: 13px 16px;
                white-space: nowrap;
            }
    }

    @@media (max-width: 720px) {
        header {
            padding: 0 18px;
        }

        .steps {
            display: none;
        }

        .page {
            padding: 28px 16px 120px;
        }

        .asset-grid,
        .system-grid {
            grid-template-columns: 1fr;
        }

        .asset-card {
            min-height: auto;
        }

        .thumb {
            height: 150px;
        }

        .mobile-bar {
            grid-template-columns: 48px 1fr;
        }

            .mobile-bar .btn {
                grid-column: 1 / -1;
                width: 100%;
            }

            .mobile-bar img {
                width: 48px;
                height: 48px;
            }
    }

    /* Sections 3–6 */

    .unlock-sections {
        margin-top: 40px;
        border-top: 1px solid var(--border);
        padding-top: 40px;
    }

    .extra-block {
        padding-bottom: 42px;
        margin-bottom: 38px;
    }

    .flow-grid {
        display: grid;
        grid-template-columns: 1fr 50px 1fr 50px 1.2fr;
        align-items: center;
    }

    .flow-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 20px;
        min-height: 180px;
        text-align: center;
        box-shadow: 0 10px 28px rgba(12, 10, 60, .04);
    }

        .flow-card h3 {
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 18px;
        }

        .flow-card .thumb {
            height: 92px;
            margin-bottom: 0;
        }

    .flow-arrow {
        text-align: center;
        font-size: 32px;
        color: #d9cffd;
        font-weight: 700;
    }

    .brand-preview {
        height: 92px;
        display: grid;
        place-items: center;
    }

    .brand-preview-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-bottom: 14px;
    }

    .brand-mascot {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
    }

    .swatch {
        width: 24px;
        height: 28px;
        border-radius: 5px;
        display: block;
    }

    .aa-badge {
        width: 36px;
        height: 28px;
        border-radius: 6px;
        background: #fff0bd;
        display: grid;
        place-items: center;
        margin: 0 auto;
        font-weight: 700;
        font-size: 18px;
    }

    .deliverable-icons {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
    }

        .deliverable-icons div {
            height: 42px;
            border-radius: 10px;
            background: #f5f1ff;
            color: var(--purple);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 18px;
        }

    .designer-layout {
        display: grid;
        grid-template-columns: 260px 1fr 240px;
        gap: 30px;
        align-items: center;
    }

    .designer-large {
        display: flex;
        align-items: center;
        gap: 18px;
    }

        .designer-large .avatar {
            width: 88px;
            height: 88px;
        }

    .avatar-wrap {
        position: relative;
        flex: 0 0 auto;
    }

    .online-dot {
        position: absolute;
        right: 4px;
        bottom: 8px;
        width: 18px;
        height: 18px;
        border: 4px solid white;
        border-radius: 50%;
        background: #46c46a;
    }

    .online-dot-mobile {
        position: absolute;
        right: 23px;
        bottom: 64px;
        width: 18px;
        height: 18px;
        border: 4px solid white;
        border-radius: 50%;
        background: #46c46a;
    }

    .check-list {
        display: grid;
        gap: 12px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 450;
    }

        .check-list div::before {
            content: "✓";
            color: var(--purple);
            background: #f2ebff;
            border-radius: 50%;
            width: 16px;
            height: 16px;
            display: inline-grid;
            place-items: center;
            margin-right: 8px;
            font-weight: 700;
            font-size: 11px;
        }

    .callout {
        background: linear-gradient(135deg, #f1ebff, #fbf9ff);
        padding: 24px;
        border-radius: 14px;
    }

    .callout-icon {
        color: var(--purple);
        font-size: 24px;
        margin-bottom: 12px;
    }

    .callout h3 {
        font-size: 16px;
        line-height: 1.25;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .callout p {
        color: var(--muted);
        line-height: 1.45;
        font-size: 13px;
        font-weight: 450;
    }

    .timeline {
        position: relative;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 24px;
        margin-top: 30px;
    }

        .timeline::before {
            content: "";
            position: absolute;
            left: 6%;
            right: 6%;
            top: 30px;
            border-top: 2px dashed #e2d9fb;
        }

    .timeline-item {
        position: relative;
        z-index: 2;
        text-align: center;
    }

    .timeline-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 16px;
        border-radius: 50%;
        background: #f3edff;
        color: var(--purple);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .timeline-item h3 {
        font-size: 12px;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .timeline-item p {
        color: var(--muted);
        font-size: 11px;
        line-height: 1.5;
        font-weight: 450;
    }

    .unlock-card {
        background: linear-gradient(180deg, #faf8ff, #fff);
        border: 1px solid #f1ebff;
        border-radius: 16px;
        padding: 24px;
    }

    .unlock-layout {
        display: grid;
        grid-template-columns: 250px 1fr 210px;
        gap: 24px;
        align-items: center;
    }

        .unlock-layout .thumb {
            height: 150px;
            margin-bottom: 0;
        }

        .unlock-layout h2 {
            font-size: 25px;
            letter-spacing: -.04em;
            margin-bottom: 12px;
            font-weight: 600;
        }

        .unlock-layout p {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.55;
            font-weight: 450;
        }

    .unlock-price {
        font-size: 42px;
        font-weight: 700;
        letter-spacing: -.05em;
        margin-bottom: 6px;
    }

        .unlock-price small {
            font-size: 14px;
            color: var(--muted);
            letter-spacing: 0;
            font-weight: 450;
        }

    .secure-row {
        margin-top: 14px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        color: var(--muted);
        font-size: 11px;
        font-weight: 450;
    }

    /* Responsive */

    @@media (max-width: 1100px) {
        .flow-grid,
        .designer-layout,
        .unlock-layout {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .flow-arrow {
            transform: rotate(90deg);
        }

        .timeline {
            grid-template-columns: 1fr 1fr;
        }

            .timeline::before {
                display: none;
            }
    }

    @@media (max-width: 720px) {
        .timeline {
            grid-template-columns: 1fr;
        }

        .deliverable-icons {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .selected-direction-row {
        display: flex;
        gap: 16px;
        align-items: flex-start;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 18px;
    }

    .selected-thumb {
        width: 110px;
        height: 82px;
        object-fit: cover;
        border-radius: 10px;
        flex-shrink: 0;
    }

    .selected-copy {
        min-width: 0;
    }

        .selected-copy h2 {
            font-size: 18px;
            line-height: 1.1;
            letter-spacing: -.03em;
            margin: 4px 0 8px;
            font-weight: 600;
        }

        .selected-copy p {
            font-size: 13px;
            line-height: 1.45;
            color: var(--muted);
            font-weight: 450;
        }

    .side {
        position: sticky;
        top: 96px;
        align-self: start;
        z-index: 10;
        max-height: calc(100vh - 61px);
        overflow-y: auto;
        background: #fff;
        border: 1px solid rgba(231, 231, 242, .9);
        border-radius: 22px;
        box-shadow: 0 24px 70px rgba(20, 16, 70, .14);
        padding: 26px;
    }

    .selected {
        color: var(--purple);
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 20px;
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .selected-check {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #f0e9ff;
        display: grid;
        place-items: center;
    }

    .selected-direction-row {
        display: grid;
        grid-template-columns: 132px 1fr;
        gap: 18px;
        align-items: center;
    }

    .selected-thumb {
        width: 132px;
        height: 96px;
        object-fit: cover;
        border-radius: 14px;
        box-shadow: 0 10px 22px rgba(20, 16, 70, .12);
    }

    .selected-copy {
        min-width: 0;
    }

    .eyebrow,
    .side-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--muted);
        margin-bottom: 1px;
    }

    .selected-copy h2 {
        font-size: 22px;
        line-height: 1.08;
        letter-spacing: -.045em;
        margin: 0 0 10px;
        font-weight: 600;
    }

    .selected-copy p {
        font-size: 14px;
        line-height: 1.45;
        color: var(--muted);
        font-weight: 450;
    }

    .side-divider {
        height: 1px;
        background: var(--border);
        margin: 11px 0;
    }

    .designer {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 0;
    }

    .avatar-wrap {
        position: relative;
        flex: 0 0 auto;
    }

    .avatar {
        width: 80px;
        height: 78px;
        border-radius: 50%;
        object-fit: cover;
    }

    .online-dot {
        position: absolute;
        right: 2px;
        bottom: 4px;
        width: 15px;
        height: 15px;
        border-radius: 50%;
        background: #38c86b;
        border: 3px solid white;
    }

    .designer strong {
        display: block;
        font-size: 15px;
        margin-bottom: 6px;
        font-weight: 600;
    }

    .designer-pill {
        display: inline-flex;
        padding: 5px 8px;
        border-radius: 8px;
        background: #f2ebff;
        color: var(--purple);
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .designer p {
        font-size: 13px;
        color: var(--muted);
        font-weight: 450;
    }

    .included-list {
        display: grid;
        gap: 14px;
        font-size: 14px;
        color: var(--muted);
        font-weight: 450;
    }

        .included-list div::before {
            content: "✓";
            color: var(--purple);
            font-weight: 700;
            margin-right: 10px;
        }

    .price-row {
        display: block;
        padding: 0;
    }

    .price {
        font-size: 42px;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -.06em;
    }

        .price small {
            font-size: 14px;
            font-weight: 500;
            color: var(--muted);
            letter-spacing: 0;
        }

    .checkout-block .price-row p {
        margin-top: 8px;
        font-size: 13px;
        color: var(--muted);
        font-weight: 450;
    }

    .side-btn {
        width: 100%;
        margin-top: 18px;
        font-size: 15px;
        padding: 17px 20px;
    }

    .secure-mini {
        display: flex;
        justify-content: center;
        gap: 10px;
        color: var(--muted);
        font-size: 13px;
        margin-top: 16px;
        font-weight: 450;
    }

    @@media (max-width: 1240px) {
        .selected-direction-row {
            grid-template-columns: 108px 1fr;
        }

        .selected-thumb {
            width: 108px;
            height: 82px;
        }

        .selected-copy h2 {
            font-size: 19px;
        }

        .selected-copy p {
            font-size: 13px;
        }

        .price {
            font-size: 36px;
        }
    }

    .drag-arrow {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 8px 0;
        cursor: grab;
    }

        .drag-arrow:active {
            cursor: grabbing;
