        }

        .system-card.premium.locked .system-card-visual::after {
            font-size: 7px;
            top: 1px;
            right: 3px;
        }

        .system-card h3 {
            font-size: 9px;
            margin: 0;
        }

        .system-card p {
            font-size: 7px;
        }

        .wordmark {
            font-size: 12px;
        }

        .swatch-color {
            width: 11px;
            height: 11px;
            border-width: 1px;
        }

        .palette-swatches {
            gap: 2px;
        }

        .heading-sample {
            font-size: 9px;
        }

        .body-sample {
            font-size: 6px;
        }

        .illustration-visual .illustration-preview svg {
            width: 26px;
            height: 18px;
        }

        .photo-frame {
            width: 20px;
            height: 20px;
        }

            .photo-frame svg {
                width: 20px;
                height: 20px;
            }

        .voice-chip {
            font-size: 6px;
            padding: 1px 5px;
            border-radius: 10px;
        }

        .voice-chips {
            gap: 2px;
        }

        .connector-track {
            width: 95%;
        }

        .connector-dot {
            width: 5px;
            height: 5px;
        }

        .connector-line-segment {
            min-width: 8px;
        }

        .connector-label {
            font-size: 8px;
            padding: 2px 8px;
