        await OpenVideoModalAsync(videoUrl, startMuted: false);
    }

    private void CloseVideoModal()
    {
        showVideoModal = false;
        isVideoPlaying = false;
        StateHasChanged();

        // Pause video when modal closes
        try
        {
            JS.InvokeVoidAsync("pauseVideo", videoElement);
        }
        catch { }
    }

    private async Task TogglePlayPause()
    {
        try
        {
            if (isVideoPlaying)
            {
                await JS.InvokeVoidAsync("pauseVideo", videoElement);
                isVideoPlaying = false;
            }
            else
            {
                // playVideo restarts from 0 automatically when the video
                // has already reached its end.
                isVideoPlaying = await JS.InvokeAsync<bool>(
                    "playVideo",
                    videoElement);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Unable to toggle modal video playback: {ex.Message}");

            isVideoPlaying = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void HandleModalVideoEnded()
    {
        // Swap the bottom-right control from Pause to Play when playback ends.
        isVideoPlaying = false;
        StateHasChanged();
    }

    private async Task OpenVideoModalFromRightCard()
    {
        var videoUrl = !string.IsNullOrWhiteSpace(GeneratedVideoUrl)
            ? GeneratedVideoUrl
            : "https://sample-videos.com/video321/mp4/720/big_buck_bunny_720p_1mb.mp4";

        await OpenVideoModalAsync(videoUrl, startMuted: false);
    }

    private void StartOtherDirectionVideoTracking()
    {
        otherDirectionProgressTimer?.Stop();
        otherDirectionProgressTimer?.Dispose();
        otherDirectionPollingCancellation?.Cancel();
        otherDirectionPollingCancellation?.Dispose();

        var pendingDirections = otherDirectionVideos
            .Where(direction => !direction.IsReady)
            .ToList();

        if (pendingDirections.Count == 0)
            return;

        var fallbackStartedUtc = DateTime.UtcNow;

        foreach (var direction in pendingDirections)
        {
            if (direction.ProgressStartedUtc == default)
                direction.ProgressStartedUtc = fallbackStartedUtc;

            var elapsedSeconds = Math.Max(
                0,
                (DateTime.UtcNow - direction.ProgressStartedUtc).TotalSeconds);

            var rawSecondaryProgress = CalculateAdaptiveProgress(


                elapsedSeconds,


                otherEstimatedSeconds);



            direction.Progress = CalculateSecondaryDisplayProgress(


                rawSecondaryProgress);



            direction.LoadingText = GetOtherDirectionStatusText(


                direction.Progress,


                elapsedSeconds,


                otherEstimatedSeconds);
        }

        otherDirectionProgressTimer = new System.Timers.Timer(500);
        otherDirectionProgressTimer.AutoReset = true;

        otherDirectionProgressTimer.Elapsed += async (_, _) =>
        {
            await InvokeAsync(() =>
            {
                foreach (var direction in otherDirectionVideos.Where(x => !x.IsReady))
                {
                    var elapsedSeconds = Math.Max(
                        0,
                        (DateTime.UtcNow - direction.ProgressStartedUtc).TotalSeconds);

                    var rawSecondaryProgress = CalculateAdaptiveProgress(


                        elapsedSeconds,


                        otherEstimatedSeconds);



                    direction.Progress = CalculateSecondaryDisplayProgress(


                        rawSecondaryProgress);



                    direction.LoadingText = GetOtherDirectionStatusText(


                        direction.Progress,


                        elapsedSeconds,


                        otherEstimatedSeconds);
                }

                StateHasChanged();
            });
        };

        otherDirectionProgressTimer.Start();

        otherDirectionPollingCancellation = new CancellationTokenSource();

        foreach (var direction in pendingDirections)
        {
            _ = PollOtherDirectionVideoAsync(
                direction,
                otherDirectionPollingCancellation.Token);
        }
    }

    private async Task PollOtherDirectionVideoAsync(
        OtherDirectionVideo direction,
        CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested && !direction.IsReady)
            {
                var status = await GetDesignModeJobStatusByImageIdAsync(direction.ImageId);

                if (status?.IsCompleted == true && !string.IsNullOrWhiteSpace(status.VideoUrl))
                {
                    var actualStartedUtc = ResolveRenderStartUtc(
                        status,
                        direction.ProgressStartedUtc);

                    direction.ProgressStartedUtc = actualStartedUtc;

                    var renderDurationSeconds = Math.Max(
                        1,
                        (DateTime.UtcNow - actualStartedUtc).TotalSeconds);

                    await RecordRenderDurationAsync(
                        OtherRenderHistoryKey,
                        renderDurationSeconds);

                    await InvokeAsync(() =>
                    {
                        direction.VideoUrl = status.VideoUrl;
                        direction.Progress = 100;
                        direction.LoadingText = "Video preview ready";

                        if (otherDirectionVideos.All(x => x.IsReady))
                        {
                            otherDirectionProgressTimer?.Stop();
                            otherDirectionProgressTimer?.Dispose();
                            otherDirectionProgressTimer = null;
                        }

                        StateHasChanged();
                    });

                    return;
                }

                if (status?.IsFailed == true)
                {
                    await InvokeAsync(() =>
                    {
                        direction.LoadingText = "Preview is still being prepared";
                        StateHasChanged();
                    });
                }

                await Task.Delay(TimeSpan.FromSeconds(5), cancellationToken);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Expected when the component is disposed.
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to poll direction {direction.DirectionNumber}: {ex.Message}");
        }
    }

    private async Task OpenOtherDirectionVideo(OtherDirectionVideo direction)
    {
        if (!direction.IsReady || string.IsNullOrWhiteSpace(direction.VideoUrl))
            return;

        await OpenVideoModalAsync(direction.VideoUrl, startMuted: false);
    }

    private async void UnlockFullExperience()
    {
        // Close modal and navigate to unlock page or perform unlock action
        CloseVideoModal();
        // Navigate to unlock page or show unlock flow
        //NavigationManager.NavigateTo("/init/unlock");
        await StartCheckout("pro", false);
    }

    private string CleanDescription(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        text = text.Replace("STYLE DIRECTIVE:", "");

        text = text.Trim();

        // Keep only through the third period
        int periods = 0;
        for (int i = 0; i < text.Length; i++)
        {
            if (text[i] == '.')
            {
                periods++;
                if (periods == 3)
                    return text[..(i + 1)].Trim();
            }
        }

        return text;
    }

    // Helper method to get slide item class
    private string GetSlideClass(int index, bool isCurrent)
    {
        if (isCurrent)
        {
            if (isBonusSliding)
                return "exit-up";
            return "active";
        }
        else
        {
            // For the next item (the one sliding in)
            if (index == ((currentBonusIndex + 1) % bonusTexts.Length) && isBonusSliding)
                return "active";
            return "";
        }
    }

    private string GetMobileSlideClass(int index, bool isCurrent)
    {
        if (isCurrent)
        {
            if (isBonusSliding)
                return "exit-up";
            return "active";
        }
        else
        {
            if (index == ((currentBonusIndex + 1) % bonusTexts.Length) && isBonusSliding)
                return "active";
            return "";
        }
    }
}


