<script>
    // Mobile sheet toggle
    const mobileSheet = document.getElementById('mobileUpgradeSheet');
    const mobileToggle = mobileSheet?.querySelector('.mobile-expand-toggle');
    const mobileDrag = mobileSheet?.querySelector('.mobile-drag');
    const mobileToggleLabel = mobileSheet?.querySelector('.mobile-expand-label');
    const mobileToggleIcon = mobileSheet?.querySelector('.mobile-expand-icon');
    const mobileUpToggleIcon = mobileSheet?.querySelector('.svg-up');
    const mobileDownToggleIcon = mobileSheet?.querySelector('.svg-down');
    const mobileTopRowToggleIcon = mobileSheet?.querySelector('.top-row');

    function setMobileExpanded(isExpanded) {
        if (isExpanded) {
            mobileUpToggleIcon.style.display = 'none';
            mobileDownToggleIcon.style.display = 'block';
            mobileTopRowToggleIcon.style.marginTop = '10px';
        } else {
            mobileUpToggleIcon.style.display = 'block';
            mobileDownToggleIcon.style.display = 'none';
            mobileTopRowToggleIcon.style.marginTop = '0px';
        }

        mobileSheet.classList.toggle('is-expanded', isExpanded);
        mobileToggle?.setAttribute('aria-expanded', String(isExpanded));
        if (mobileToggleLabel) mobileToggleLabel.textContent = isExpanded ?
            'Hide everything' :
            'View everything included';

        if (mobileToggleIcon) mobileToggleIcon.textContent = isExpanded ? '⌃' : '⌄';
    }

    mobileToggle?.addEventListener('click', () => {
        setMobileExpanded(!mobileSheet.classList.contains('is-expanded'));
    });

    mobileDrag?.addEventListener('click', () => {
        setMobileExpanded(!mobileSheet.classList.contains('is-expanded'));
    });

    // also allow clicking the compact bonus to expand
    const compactBonus = document.getElementById('mobileBonusCompact');
    compactBonus?.addEventListener('click', () => {
        if (!mobileSheet.classList.contains('is-expanded')) {
            setMobileExpanded(true);
        }
    });

    // ===== SCROLL REVEAL FOR BONUS CARD - HEIGHT + FADE =====
    function setupBonusCardScrollReveal() {
        const bonusCard = document.getElementById('bonusCardScroll');
        if (!bonusCard) return;

        let hasBeenRevealed = false;
        let isExiting = false;

        function checkScroll() {
            const rect = bonusCard.getBoundingClientRect();
            const viewportHeight = window.innerHeight;
            const scrollY = window.scrollY || window.pageYOffset;

            const pageHeight = document.documentElement.scrollHeight || document.body.scrollHeight;
            const scrollPercent = (scrollY / (pageHeight - viewportHeight)) * 100;

            const shouldReveal = scrollPercent > 8 && scrollY > 50;
            const shouldHide = scrollPercent < 3;

            if (shouldReveal && !hasBeenRevealed) {
                bonusCard.classList.remove('exiting');
                bonusCard.classList.add('visible');
                hasBeenRevealed = true;
                isExiting = false;
            } else if (shouldHide && hasBeenRevealed && !isExiting) {
                bonusCard.classList.remove('visible');
                bonusCard.classList.add('exiting');
                isExiting = true;
                hasBeenRevealed = false;

                setTimeout(() => {
                    bonusCard.classList.remove('exiting');
                }, 600);
            } else if (!shouldReveal && !shouldHide && hasBeenRevealed) {
                bonusCard.classList.add('visible');
                bonusCard.classList.remove('exiting');
            }
        }

        window.addEventListener('scroll', checkScroll, { passive: true });
        window.addEventListener('resize', checkScroll, { passive: true });
        setTimeout(checkScroll, 300);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupBonusCardScrollReveal);
    } else {
        setupBonusCardScrollReveal();
    }

    window.setupBonusCardScrollReveal = setupBonusCardScrollReveal;

    // Video control functions
    window.loadAndPlayVideoFromStart = async function (element, startMuted) {
        if (!element) return false;

        const waitForPlayableState = () => new Promise((resolve) => {
            if (element.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
                resolve();
                return;
            }

            let finished = false;

            const finish = () => {
                if (finished) return;
                finished = true;
                element.removeEventListener("loadedmetadata", finish);
                element.removeEventListener("canplay", finish);
                element.removeEventListener("error", finish);
                resolve();
            };

            element.addEventListener("loadedmetadata", finish, { once: true });
            element.addEventListener("canplay", finish, { once: true });
            element.addEventListener("error", finish, { once: true });

            // Do not leave Blazor waiting indefinitely if the browser is slow.
            window.setTimeout(finish, 2500);
        });

        try {
            element.pause();
            element.muted = Boolean(startMuted);
            element.defaultMuted = Boolean(startMuted);
            element.playsInline = true;
            element.currentTime = 0;
            element.load();

            await waitForPlayableState();

            // Reset again after metadata is available. Some browsers ignore a
            // currentTime assignment made before the media timeline is loaded.
            element.currentTime = 0;
            await element.play();
            return true;
        } catch (error) {
            console.debug("Unable to autoplay modal video:", error);

            // If an unmuted user-initiated play is unexpectedly blocked,
            // retry muted so the preview still opens and begins playing.
            if (!startMuted) {
                try {
                    element.muted = true;
                    element.defaultMuted = true;
                    element.currentTime = 0;
                    await element.play();
                    return true;
                } catch (mutedError) {
                    console.debug(
                        "Muted autoplay retry also failed:",
                        mutedError);
                }
            }

            return false;
        }
    };

    window.playVideoFromStart = async function (element) {
        return await window.loadAndPlayVideoFromStart(element, false);
    };

    window.playVideo = async function (element) {
        if (!element) return false;

        try {
            // After the ended event, currentTime is at the video's duration.
            // Reset it so clicking the Play button starts a fresh replay.
            if (element.ended ||
                (Number.isFinite(element.duration) &&
                    element.currentTime >= element.duration - 0.05)) {
                element.currentTime = 0;
            }

            await element.play();
            return true;
        } catch (error) {
            console.debug("Unable to play video:", error);
            return false;
        }
    };

    window.pauseVideo = function (element) {
        if (!element) return;
        element.pause();
    };
</script>

