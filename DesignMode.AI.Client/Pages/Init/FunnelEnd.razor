    private int? CurrentVideoPollAttempt { get; set; }

    private string? GeneratedVideoUrl { get; set; }

    private string? VideoGenerationError { get; set; }
    private async Task<string?> PollDesignModeJobStatus(
        string imageId,
        CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                DesignModeJobStatus? jobStatus =
                    await GetDesignModeJobStatusByImageIdAsync(imageId);

                if (jobStatus is null)
                {
                    await Task.Delay(
                        TimeSpan.FromSeconds(5),
                        cancellationToken);

                    continue;
                }

                CurrentVideoJobStatus =
                    jobStatus.Status;

                CurrentVideoJobStep =
                    jobStatus.CurrentStep;

                CurrentVideoPollAttempt =
                    jobStatus.VideoPollAttempt;

                await InvokeAsync(StateHasChanged);

                if (jobStatus.IsCompleted)
                {
                    GeneratedVideoUrl =
                        jobStatus.VideoUrl;

                    await InvokeAsync(StateHasChanged);

                    return GeneratedVideoUrl;
                }

                if (jobStatus.IsFailed)
                {
                    VideoGenerationError =
                        string.IsNullOrWhiteSpace(jobStatus.Error)
                            ? "Video generation failed."
                            : jobStatus.Error;

                    await InvokeAsync(StateHasChanged);

                    return null;
                }

                await Task.Delay(
                    TimeSpan.FromSeconds(5),
                    cancellationToken);
            }

            return null;
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
            return null;
        }
        catch (Exception ex)
        {
            VideoGenerationError =
                $"An error occurred while checking video status: {ex.Message}";

            await InvokeAsync(StateHasChanged);

            return null;
        }
    }

