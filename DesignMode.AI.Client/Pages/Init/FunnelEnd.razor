    protected override async Task OnInitializedAsync()
    {
        // Check authentication before doing anything else
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            // Preserve the exact current URL, including query string
            var currentUrl = NavigationManager.Uri;

            // Send it to login so login can return here afterward
            var loginUrl =
                $"/login?returnUrl={Uri.EscapeDataString(currentUrl)}";

            NavigationManager.NavigateTo(loginUrl, forceLoad: true);
            return;
        }
        try
        {
            await LoadAdaptiveRenderEstimatesAsync();

            var uri = NavigationManager.Uri;
            var queryParams = QueryHelpers.ParseQuery(new Uri(uri).Query);

            if (queryParams.TryGetValue("e", out var encryptedEmail) && !string.IsNullOrEmpty(encryptedEmail))
            {
                Console.WriteLine($"✅ 'e' parameter detected, attempting to decrypt...");

                StateHasChanged();

                string savedemail = "";
                if (queryParams.TryGetValue("eid", out var saveemail))
                {
                    savedemail = saveemail.ToString();
                }
                var decryptedSavedEmail = DecryptEmail(savedemail);



                string inviteId = "";

                if (queryParams.TryGetValue("id", out var idParam))
                {
                    inviteId = idParam.ToString();
                }
                var invite = await GetInviteClientByIdAsync(inviteId);

                if (invite != null)
                {
                    var images = await FetchInviteClientImages(invite.Id);

                    var matchingImage = images.FirstOrDefault(i => i.ImageId == invite.ImageId);

                    // Load the other generated directions for section 8.
                    // Their completed video URLs are fetched from the same job-status endpoint.
                    var otherImages = images
                        .Where(i => i.ImageId != invite.ImageId)
                        .Take(2)
                        .ToList();

                    otherDirectionVideos = new List<OtherDirectionVideo>();
                    for (var index = 0; index < otherImages.Count; index++)
                    {
                        var image = otherImages[index];
                        var status = await GetDesignModeJobStatusByImageIdAsync(image.ImageId);

                        otherDirectionVideos.Add(new OtherDirectionVideo
                            {
                                DirectionNumber = index + 2,
                                ImageId = image.ImageId,
                                Name = image.Style ?? $"Direction {index + 2}",
                                Description = CleanDescription(image.StylePrompt),
                                ThumbnailUrl = image.ImageUrl,
                                VideoUrl = status?.IsCompleted == true ? status.VideoUrl : null,
                                Progress = status?.IsCompleted == true ? 100 : 0,
                                ProgressStartedUtc = ResolveRenderStartUtc(status, DateTime.UtcNow),
                                LoadingText = status?.IsCompleted == true ? "Video preview ready" : "Rendering preview..."
                            });
                    }

                    StartOtherDirectionVideoTracking();

                    if (matchingImage != null)
                    {
                        StartVideoStatusPolling(matchingImage.ImageId);
                        selectedImageUrl = matchingImage.ImageUrl;
                        selectedConceptName = matchingImage.Style ?? "Playful & Illustration-Driven";
                        selectedConceptDescription = matchingImage.StylePrompt ?? "A fun, memorable direction designed to stand out and connect.";

                        // Show the concept popup with animation
                        showConceptPopup = true;
                        StateHasChanged();

                        // Start video generation progress after a short delay
                        await Task.Delay(600);
                        showVideoProgress = true;
                        StateHasChanged();

                        // Start progress simulation (75 seconds)
                        StartProgressSimulation();

                        // Start bonus text animation (vertical sliding like modal)
                        StartBonusTextAnimation();

                        // Start scroll detection for bonus card reveal after 1.5s delay
                        await Task.Delay(1500);
                        await JS.InvokeVoidAsync("setupBonusCardScrollReveal");
                    }
                }
            }

        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error in OnInitializedAsync: {ex.Message}");
        }
    }

    private string DecryptEmail(string encryptedEmail)
    {
        if (string.IsNullOrEmpty(encryptedEmail))
            return "";

        try
        {
            var decoded = Uri.UnescapeDataString(encryptedEmail);
            var bytes = Convert.FromBase64String(decoded);
            return Encoding.UTF8.GetString(bytes);
        }
        catch
        {
            return "";
        }
    }

