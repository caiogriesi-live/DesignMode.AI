        string storageKey,
        double durationSeconds)
    {
        // Ignore obviously invalid or stale measurements.
        if (durationSeconds < 10 || durationSeconds > 300)
            return;

        try
        {
            var history =
                await LocalStorage.GetItemAsync<List<double>>(storageKey)
                ?? new List<double>();

            history.Add(durationSeconds);

            if (history.Count > MaximumHistoryItems)
            {
                history = history
                    .Skip(history.Count - MaximumHistoryItems)
                    .ToList();
            }

            await LocalStorage.SetItemAsync(storageKey, history);

            if (storageKey == MainRenderHistoryKey)
            {
                mainEstimatedSeconds = await GetAdaptiveEstimateAsync(
                    MainRenderHistoryKey,
                    DefaultMainEstimatedSeconds);
            }
            else
            {
                otherEstimatedSeconds = await GetAdaptiveEstimateAsync(
                    OtherRenderHistoryKey,
                    DefaultOtherEstimatedSeconds);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to save render timing history: {ex.Message}");
        }
    }

    private static DateTime ResolveRenderStartUtc(
        DesignModeJobStatus? status,
        DateTime fallbackUtc)
    {
        if (status is not null &&
            DateTime.TryParse(
                status.CreatedAtUtc,
                null,
                System.Globalization.DateTimeStyles.AssumeUniversal |
                System.Globalization.DateTimeStyles.AdjustToUniversal,
                out var createdUtc))
        {
            return createdUtc;
        }

        return fallbackUtc;
    }

    private static int CalculateAdaptiveProgress(
        double elapsedSeconds,
        double estimatedSeconds)
    {
        estimatedSeconds = Math.Max(
            MinimumEstimatedSeconds,
            estimatedSeconds);

        if (elapsedSeconds <= 0)
            return 0;

        var normalized = Math.Clamp(
            elapsedSeconds / estimatedSeconds,
            0,
            1);

        // Ease out quickly at first, then slow naturally near completion.
        const double curveStrength = 3.0;
        var eased =
            (1 - Math.Exp(-curveStrength * normalized)) /
            (1 - Math.Exp(-curveStrength));

        var progress = (int)Math.Round(eased * 95);

        if (elapsedSeconds <= estimatedSeconds)
            return Math.Clamp(progress, 0, 95);

        // After the estimate, creep from 95% to 98% while awaiting success.
        var overtimeSeconds = elapsedSeconds - estimatedSeconds;
        var overtimeWindow = Math.Max(30, estimatedSeconds * 0.75);
        var overtimeRatio = Math.Clamp(
            overtimeSeconds / overtimeWindow,
            0,
            1);

        return 95 + (int)Math.Floor(overtimeRatio * 3);
    }

    private int CalculateSecondaryDisplayProgress(int rawProgress)
    {
        rawProgress = Math.Clamp(rawProgress, 0, 98);

        if (isVideoGenerated)
            return rawProgress;

        if (videoProgress <= SecondaryProgressGap)
        {
            return Math.Min(
                rawProgress,
                SecondaryInitialProgressCap);
        }

        var secondaryMaximum =
            Math.Max(0, videoProgress - SecondaryProgressGap);

        return Math.Min(rawProgress, secondaryMaximum);
    }

    private string GetMainVideoStatusText(
        int progress,
        double elapsedSeconds)
    {
        if (progress < 20)
            return FunnelCopy("Preparing your campaign scenes.");

        if (progress < 45)
            return "Animating your creative direction.";

        if (progress < 70)
            return "Adding motion and transitions.";

        if (progress < 90)
            return WebsiteFunnel ? "Animating your website experience." : "Rendering your social preview.";

        if (progress < 95)
            return "Polishing the final animation.";

        if (elapsedSeconds > mainEstimatedSeconds + 30)
            return "Rendering is taking a little longer than usual.";

        return "Finalizing your personalized preview.";
    }

