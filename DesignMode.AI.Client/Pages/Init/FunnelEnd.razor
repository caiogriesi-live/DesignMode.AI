    }

    @@media (max-width: 720px) {
        .brand-concept-image {
            max-height: 160px;
            border-radius: 12px;
        }

        .selected-badge,
        .selected-badge-right {
            font-size: 11px;
            padding: 4px 10px 4px 7px;
            top: 10px;
            left: 10px;
            gap: 6px;
        }

        .selected-badge-icon {
            width: 16px;
            height: 16px;
            font-size: 10px;
        }

        .brand-features li {
            font-size: 14px;
            padding: 2px 0 2px 18px;
        }
