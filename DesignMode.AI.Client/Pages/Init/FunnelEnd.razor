    private async Task LoadAdaptiveRenderEstimatesAsync()
    {
        mainEstimatedSeconds = await GetAdaptiveEstimateAsync(
            MainRenderHistoryKey,
            DefaultMainEstimatedSeconds);

        otherEstimatedSeconds = await GetAdaptiveEstimateAsync(
            OtherRenderHistoryKey,
            DefaultOtherEstimatedSeconds);

        Console.WriteLine(
            $"Adaptive video estimates loaded. Main: {mainEstimatedSeconds:F1}s; " +
            $"Other directions: {otherEstimatedSeconds:F1}s.");
    }

    private async Task<double> GetAdaptiveEstimateAsync(
        string storageKey,
        double fallbackSeconds)
    {
        try
        {
            var history =
                await LocalStorage.GetItemAsync<List<double>>(storageKey)
                ?? new List<double>();

            var validHistory = history
                .Where(seconds =>
                    seconds >= 10 &&
                    seconds <= 300)
                .OrderBy(seconds => seconds)
                .ToList();

            // Keep using the safe fallback until there is enough real data.
            if (validHistory.Count < 5)
                return fallbackSeconds;

            // P75 is deliberately more conservative than the mean or median.
            var estimate = CalculatePercentile(validHistory, 0.75);

            return Math.Clamp(
                estimate,
                MinimumEstimatedSeconds,
                MaximumEstimatedSeconds);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to load render timing history: {ex.Message}");
            return fallbackSeconds;
        }
    }

    private static double CalculatePercentile(
        IReadOnlyList<double> sortedValues,
        double percentile)
    {
        if (sortedValues.Count == 0)
            return 0;

        if (sortedValues.Count == 1)
            return sortedValues[0];

        var position = (sortedValues.Count - 1) * percentile;
        var lowerIndex = (int)Math.Floor(position);
        var upperIndex = (int)Math.Ceiling(position);

        if (lowerIndex == upperIndex)
            return sortedValues[lowerIndex];

        var weight = position - lowerIndex;

        return sortedValues[lowerIndex] +
               ((sortedValues[upperIndex] - sortedValues[lowerIndex]) * weight);
    }

