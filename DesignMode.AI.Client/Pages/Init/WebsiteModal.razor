    private async Task GenerateWebsite()
    {
        if (IsBusy || IsGeneratingWebsite || isGeneratingWebsiteImages || !GetUniqueWebsiteImages().Any(i => SelectedImageIds.Contains(i.Id))) return;
        await using var generationOperation = await BeginGenerationAsync();

        // Set loading state and switch to Generated Website tab immediately
        IsGeneratingWebsite = true;
        ActiveTab = TabType.GeneratedWebsite;
        GenerationSteps.Clear();
        UpdateGenerationStatus("Starting website generation...", "Preparing your website assets", 5);
        websiteQuotaRejected = false;

        StateHasChanged();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                UpdateGenerationStatus("Selecting images...", "Choosing the best images for your website", 15);

                var selectedImage = GetUniqueWebsiteImages().FirstOrDefault(img => SelectedImageIds.Contains(img.Id));

                if (selectedImage == null)
                {
                    UpdateGenerationStatus("Error", "No suitable image found for website generation", 0);
                    Console.WriteLine("❌ No image selected.");
                    return;
                }

                // 1️⃣ Get image description
                UpdateGenerationStatus("Analyzing image...", "AI is analyzing your selected image content", 30);
                var websiteContext = await ResolveWebsiteProject(CompanyIdeaId)
                    ?? throw new InvalidOperationException("Website generation requires a current project.");
                var websiteGenerationJobId = Guid.NewGuid().ToString();

                var imageDescription = await GetAIImageDescriptionAsync(
                    selectedImage.ImageUrl, websiteGenerationJobId, websiteContext);

                if (string.IsNullOrWhiteSpace(imageDescription))
                {
                    Console.WriteLine($"❌ Failed to get image description for {selectedImage.ImageUrl}");
                    UpdateGenerationStatus("Warning", "Using default image description", 40);
                }
                else
                {
                    UpdateGenerationStatus("Image analyzed", "Successfully extracted image content", 45);
                }

                // 2️⃣ Extract clean website background
                UpdateGenerationStatus("Extracting background...", "Separating background elements from the image", 50);
                backgroundImage = await ExtractWebsiteBackgroundAsync(selectedImage.ImageUrl, websiteContext);

                var username = user.Identity?.Name;
                var uri = NavigationManager.Uri;
                var queryString = new Uri(uri).Query;
                string cid = GetQueryParameter(queryString, "cid", null);

                var promptId = await FetchPromptId(username, cid);
                var promptText = await FetchPromptText(promptId);

                string[] parts = cid.Split(new string[] { "|~~|@@|^^|" }, StringSplitOptions.None);

                string name = string.Empty;
                string industry = string.Empty;

                if (parts.Length >= 2)
                {
                    // Decode Base64 for company name and industry
                    try
                    {
                        name = Encoding.UTF8.GetString(Convert.FromBase64String(parts[0]));
                        industry = Encoding.UTF8.GetString(Convert.FromBase64String(parts[1]));
                        SelectedWebsiteName = name;
                        SelectedIndustry = industry;
                        UpdateGenerationStatus("Company data loaded", $"Building website for {name} in {industry}", 75);
                    }
                    catch (FormatException ex)
                    {
                        Console.WriteLine($"Error decoding Base64 values: {ex.Message}");
                    }
                }

                var safeCompanyName = string.Concat(SelectedWebsiteName
    .Where(c => !Path.GetInvalidFileNameChars().Contains(c)))
    .Replace(" ", "-").Replace("&", "");

                var versionData = await GetNextWebsiteVersionAsync(safeCompanyName);
                
                // ✅ Extract numeric version
                if (versionData.NextVersion > 1)
                {
                    var previousVersion = (versionData.NextVersion - 1).ToString();

                    Console.WriteLine($"📁 Copying images from v{previousVersion} → v{versionData.NextVersion}");

                    await CopyImagesToNewVersionAsync(
                        safeCompanyName,
                        previousVersion,
                        versionData.NextVersion.ToString()
                    );
                }

                if (string.IsNullOrWhiteSpace(backgroundImage))
                {
                    Console.WriteLine($"❌ Failed to extract background from {selectedImage.ImageUrl}");
                    UpdateGenerationStatus("Background extraction", "Using image as-is for website", 60);
                }
                else
                {
                    UpdateGenerationStatus("Background extracted", "Successfully extracted website background", 65);
                }

                UpdateGenerationStatus("Loading company data...", "Retrieving your company information", 70);

                // 3️⃣ Call NEW website generator (AI HTML output)
                UpdateGenerationStatus("Generating website HTML...", "AI is crafting your custom website layout", 80);
                //var generatedHtml = "";
                var generatedHtml = await GenerateWebsiteAsync(
                    selectedImage.ImageUrl,
                    SelectedWebsiteName,
                    SelectedIndustry,
                    promptText,
                    websiteGenerationJobId,
                    websiteContext
                    );

                // ✅ Extract only the full HTML document
                var cleanHtml = ExtractFullHtmlDocument(generatedHtml);

                // ✅ Save HTML file
                await SaveGeneratedHtmlAsync(cleanHtml, SelectedWebsiteName, versionData.NextVersion.ToString());

                if (string.IsNullOrWhiteSpace(generatedHtml))
                {
                    if (!websiteQuotaRejected)
                        UpdateGenerationStatus("Error", "Failed to generate website HTML", 0);
                    Console.WriteLine("❌ Failed to generate website HTML.");
                    return;
                }

                UpdateGenerationStatus("Processing website...", "Optimizing and formatting your website", 95);

                UpdateGenerationStatus("Complete!", "Your website has been successfully generated!", 100);

                await SaveWebsitePreviewAsync(
                    versionData.WebsiteId,
                    safeCompanyName,
                    $"v{versionData.NextVersion}",
                    DateTime.UtcNow.ToString("o")
                );

                // ✅ Wait a bit for HTML to be served
                await Task.Delay(1000);

                await SaveExtractedBackgroundAsync(
                    selectedImage.ImageUrl,
                    SelectedWebsiteName,
                    versionData.NextVersion.ToString()
                );

                // ✅ Take screenshot
                await SaveWebsiteScreenshotAsync(
                    SelectedWebsiteName,
                    versionData.NextVersion.ToString()
                );

                // ✅ Refresh the sorted websites after generation (keep all previous versions)
                var updatedWebsitesResponse = await GetWebsitesByCompanyAsync(safeCompanyName);
                if (updatedWebsitesResponse?.Data != null)
                {
                    sortedWebsites = updatedWebsitesResponse.Data;
                }

                // Update current version to the new one
                currentVersion = versionData.NextVersion.ToString();
                
                // Set the current screenshot URL
                GeneratedWebsiteHtml = $"{ApiConfig.StorageBaseUrl}" + safeCompanyName + $"-v{currentVersion}" + "/website-shot.png";

                Console.WriteLine("✅ Website generated successfully!");
                Console.WriteLine($"📄 HTML Length: {generatedHtml.Length}");
                Console.WriteLine($"📸 Total versions available: {sortedWebsites.Count}");

                // Optional: trigger UI update / modal close
                if (OnWebsiteGenerated.HasDelegate)
                    await OnWebsiteGenerated.InvokeAsync(true);
            }
            else
            {
                UpdateGenerationStatus("Error", "User not authenticated", 0);
                Console.WriteLine("⚠️ User not authenticated.");
            }
        }
        catch (Exception ex)
        {
            UpdateGenerationStatus("Error", $"Exception: {ex.Message}", 0);
            Console.WriteLine($"❌ Exception generating website: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
            // Keep IsGeneratingWebsite true for a moment to show completion, then clear after delay
            await Task.Delay(2000);
            IsGeneratingWebsite = false;
            StateHasChanged();
        }
    }
    private async Task SaveWebsiteScreenshotAsync(string companyName, string version)
    {
        if (string.IsNullOrWhiteSpace(companyName))
            return;

        try
        {
            var request = new
            {
                CompanyName = companyName,
                Version = version
            };

            // =========================
            // 🌍 USE URI-BASED CONFIG
            // =========================
            var isLocal = ApiConfig.ApiBaseUrl.Contains("localhost");

            var endpoint = isLocal
                ? "api/SaveWebsiteScreenshot?code=REDACTED_FOR_GROOMING"
                : "api/GenerateWebsiteScreenshot?code=REDACTED_FOR_GROOMING";

            var response = await Http.PostAsJsonAsync(
                $"{ApiConfig.ApiBaseUrl}{endpoint}",
                request
            );

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SaveScreenshotResponse>();

                Console.WriteLine($"✅ Screenshot processed: {result?.ScreenshotUrl}");

                if (!string.IsNullOrWhiteSpace(result?.SourceUrl))
                    Console.WriteLine($"🌍 Source URL: {result.SourceUrl}");

                if (!string.IsNullOrWhiteSpace(result?.Mode))
                    Console.WriteLine($"⚙️ Mode: {result.Mode}");
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();

                Console.WriteLine("❌ Screenshot failed");
                Console.WriteLine($"Status: {response.StatusCode}");
                Console.WriteLine($"Body: {content}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error calling screenshot API: {ex.Message}");
        }
    }

