    private async Task<string?> GenerateWebsiteAsync(string imageUrl, string name, string industry, string prompt,
        string generationJobId, DesignMode.AI.Shared.Models.Attribution.ProjectContextResponse context)
    {
        try
        {
            var request = new
            {
                ImageUrl = imageUrl,
                Name = name,
                Industry = industry,
                Prompt = prompt,
                GenerationJobId = generationJobId,
                ProjectId = context?.ProjectId,
                FunnelId = context?.FunnelId
            };
            using var message = new HttpRequestMessage(HttpMethod.Post,
                $"{ApiConfig.ApiBaseUrl}api/GenerateWebsiteFromImage?code=REDACTED_FOR_GROOMING")
            { Content = JsonContent.Create(request) };
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrWhiteSpace(token))
                message.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var response = await Http.SendAsync(message);

            if (await UsageRefresh.HandleResponseAsync(response))
            {
                websiteQuotaRejected = true;
                        UpdateGenerationStatus("Generation limit reached", "You've used all your AI Credits for this billing period.", 0);
                return null;
            }

            if (!response.IsSuccessStatusCode)
            {
                Console.WriteLine($"❌ Website generation failed: {response.StatusCode}");
                return null;
            }

            await UsageRefresh.RequestRefreshAsync();

            var json = await response.Content.ReadAsStringAsync();

            var data = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(json);

            if (data.TryGetProperty("html", out var htmlProp))
            {
                var html = htmlProp.GetString();

                if (!string.IsNullOrWhiteSpace(html))
                {
                    return html;
                }
            }

            return null;
        }
        catch (Exception ex)
        {
