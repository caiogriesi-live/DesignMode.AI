    // Add this method to update generation progress
    private void UpdateGenerationStatus(string step, string details = "", int progress = -1)
    {
        GenerationStatus = step;
        CurrentStepDetails = details;
        if (progress >= 0)
        {
            GenerationProgress = progress;
        }

        // Add to steps log if it's a new major step
        if (!string.IsNullOrEmpty(step) && (GenerationSteps.Count == 0 || GenerationSteps.Last() != step))
        {
            GenerationSteps.Add(step);
            // Keep only last 5 steps to prevent overflow
            if (GenerationSteps.Count > 5)
            {
                GenerationSteps.RemoveAt(0);
            }
        }

        StateHasChanged();
        InvokeAsync(StateHasChanged);
    }

    private async Task<string?> ExtractWebsiteBackgroundAsync(string imageUrl,
        DesignMode.AI.Shared.Models.Attribution.ProjectContextResponse context)
    {
        try
        {
            var request = new
            {
                ImageUrl = imageUrl,
                ProjectId = context.ProjectId
            };

            using var message = new HttpRequestMessage(HttpMethod.Post,
                $"{ApiConfig.ApiBaseUrl}api/ExtractWebsiteBackground?code=REDACTED_FOR_GROOMING")
            { Content = JsonContent.Create(request) };
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            message.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var response = await Http.SendAsync(message);

            if (!response.IsSuccessStatusCode)
            {
                Console.WriteLine($"❌ Background extraction failed: {response.StatusCode}");
                return null;
            }

            var json = await response.Content.ReadAsStringAsync();

            var data = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(json);

            if (data.TryGetProperty("image", out var imageProp))
            {
                var imageData = imageProp.GetString();

                if (!string.IsNullOrWhiteSpace(imageData))
                {
                    // remove data:image/png;base64,
                    return imageData.Replace("data:image/png;base64,", "");
                }
            }

            return null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception extracting background: {ex.Message}");
            return null;
        }
    }

    private async Task<GetWebsitesResponse?> GetWebsitesByCompanyAsync(string companyName)
    {
        try
        {
            HttpClient client = new HttpClient();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var urlEndpoint =
                    $"{ApiConfig.ApiBaseUrl}api/GetWebsitesByCompany" +
                    "?code=REDACTED_FOR_GROOMING";

                var body = new
                {
                    CompanyName = companyName
                };

                var json = System.Text.Json.JsonSerializer.Serialize(body);
                var content = new StringContent(json, Encoding.UTF8, "application/json");

                var response = await client.PostAsync(urlEndpoint, content);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<GetWebsitesResponse>();

                    if (result?.Data != null)
                    {
                        result.Data = result.Data
                            .OrderByDescending(x =>
                                DateTime.TryParse(x.TimeStamp, out var dt)
                                    ? dt
                                    : DateTime.MinValue)
                            .ToList();
                    }

                    Console.WriteLine($"✅ Retrieved {result?.Count ?? 0} websites (sorted)");

                    return result;
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"❌ Failed to retrieve websites: {error}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error calling GetWebsitesByCompany: {ex.Message}");
        }

        return null;
    }
