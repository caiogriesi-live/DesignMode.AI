    protected override async Task OnParametersSetAsync()
    {
        if (!Show)
        {
            autoGenerationTriggered = false;
            return;
        }
        if (imageProjectId != CompanyIdeaId)
        {
            imageProjectId = CompanyIdeaId;
            preparedImageId = null;
            SelectedImageIds.Clear();
            SelectedImageUrls.Clear();
            autoGenerationTriggered = false;
            hasLoadedVersions = false;
            sortedWebsites.Clear();
            GeneratedWebsiteHtml = "";
            SelectedWebsiteName = "";
            SelectedIndustry = "";
        }
        if (autoGenerationTriggered || isGeneratingWebsiteImages) return;
        autoGenerationTriggered = true;
        var cid = CompanyIdeaId;
        var parts = (cid ?? "").Split("|~~|@@|^^|", StringSplitOptions.None);
        if (parts.Length >= 2)
        {
            try
            {
                SelectedWebsiteName = Encoding.UTF8.GetString(Convert.FromBase64String(parts[0]));
                SelectedIndustry = Encoding.UTF8.GetString(Convert.FromBase64String(parts[1]));
            }
            catch (FormatException) { /* Opaque project identity. */ }
        }
        if (!TrySelectExistingWebsiteImage())
            await GoToGenerateImages();
        if (cid != CompanyIdeaId || !Show) return;
        if (!hasLoadedVersions && !string.IsNullOrWhiteSpace(SelectedWebsiteName))
        {
            hasLoadedVersions = true;
            var safeName = string.Concat(SelectedWebsiteName.Where(c => !Path.GetInvalidFileNameChars().Contains(c)))
                .Replace(" ", "-").Replace("&", "");
            await LoadExistingVersionsAsync(safeName);
        }
    }

    private async Task LoadExistingVersionsAsync(string companyName)
    {
        var websitesResponse = await GetWebsitesByCompanyAsync(companyName);
        
        if (websitesResponse?.Data != null)
        {
            sortedWebsites = websitesResponse.Data;

            // Get the current version (latest)
            if (sortedWebsites.Any())
            {
                var latestVersion = sortedWebsites.First();
                currentVersion = latestVersion.Version?.Replace("v", "") ?? "1";
                
                // If there are existing versions, set the latest screenshot as the current preview
                var safeCompanyName = string.Concat(SelectedWebsiteName
                    .Where(c => !Path.GetInvalidFileNameChars().Contains(c)))
                    .Replace(" ", "-").Replace("&", "");
                GeneratedWebsiteHtml = $"{ApiConfig.StorageBaseUrl}" + safeCompanyName + $"-v{currentVersion}" + "/website-shot.png";
            }

            Console.WriteLine($"📊 Loaded {sortedWebsites.Count} existing websites (sorted by newest)");

            foreach (var site in sortedWebsites)
            {
                Console.WriteLine($"🕒 {site.TimeStamp} | {site.Version}");
            }
        }
    }

