            SelectedImageUrls.Add(image.ImageUrl);
            Console.WriteLine("[WEBSITE IMAGE] modal state updated selected=true");
        }
        catch (Exception)
        {
            if (cid != CompanyIdeaId) return;
            SelectedImageIds.Clear();
            SelectedImageUrls.Clear();
            imageGenerationError = "Unable to prepare the Website image. Check your AI Credits or reopen Website to retry loading the saved image.";
            Console.WriteLine("[WEBSITE IMAGE] failed stage=modal-preparation");
        }
        finally
        {
            IsBusy = false;
            isGeneratingWebsiteImages = false;
            await InvokeAsync(StateHasChanged);
        }
    }
