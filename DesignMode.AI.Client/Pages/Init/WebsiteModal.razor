    private async Task DownloadWebsiteAsync(string companyName, string version)
    {
        if (string.IsNullOrWhiteSpace(companyName) || string.IsNullOrWhiteSpace(version))
            return;

        try
        {
            // ✅ Match backend sanitization
            var safeCompanyName = string.Concat(companyName
                .Where(c => !Path.GetInvalidFileNameChars().Contains(c)))
                .Replace(" ", "-")
                .Replace("&", "");

            var safeVersion = string.Concat(version
                .Where(c => !Path.GetInvalidFileNameChars().Contains(c)))
                .Replace(" ", "")
                .ToLower();

            // ✅ Build URL
            var url = $"{ApiConfig.ApiBaseUrl}api/DownloadWebsite" +
                      $"?code=REDACTED_FOR_GROOMING" +
                      $"&safecompanyname={Uri.EscapeDataString(safeCompanyName)}" +
                      $"&version={Uri.EscapeDataString(safeVersion)}";

            // ✅ Trigger download in new tab
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");

            Console.WriteLine($"⬇️ Download triggered: {url}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error downloading website: {ex.Message}");
        }
    }
