    private string ExtractFullHtmlDocument(string html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return string.Empty;

        var startIndex = html.IndexOf("<!DOCTYPE", StringComparison.OrdinalIgnoreCase);
        var endIndex = html.LastIndexOf("</html>", StringComparison.OrdinalIgnoreCase);

        if (startIndex >= 0 && endIndex > startIndex)
        {
            endIndex += "</html>".Length;
            return html.Substring(startIndex, endIndex - startIndex);
        }

        // fallback: return original if structure not found
        return html;
    }
    private async Task<string?> GetAIImageDescriptionAsync(string imageUrl, string generationJobId,
        DesignMode.AI.Shared.Models.Attribution.ProjectContextResponse context)
    {
        try
        {
            HttpClient client = new HttpClient();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var url =
                    $"{ApiConfig.ApiBaseUrl}api/GetWorkspaceAIImageDescription" +
                    "?code=REDACTED_FOR_GROOMING";

                var payload = new
                {
                    ImageUrl = imageUrl,
                    GenerationJobId = generationJobId,
                    ProjectId = context.ProjectId,
                    FunnelId = context.FunnelId
                };

                var content = new StringContent(
                    System.Text.Json.JsonSerializer.Serialize(payload),
                    Encoding.UTF8,
                    "application/json");

                var token = await LocalStorage.GetItemAsync<string>("authToken");
                if (!string.IsNullOrWhiteSpace(token))
                    client.DefaultRequestHeaders.Authorization =
                        new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                var response = await client.PostAsync(url, content);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadAsStringAsync();
                    Console.WriteLine("✅ Image description generated.");
                    return result;
                }
                else
                {
                    Console.WriteLine($"❌ Failed to generate image description: {response.StatusCode}");
                    return null;
                }
            }

            Console.WriteLine("⚠️ User not authenticated.");
            return null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception generating image description: {ex.Message}");
            return null;
        }
    }

    private async Task CloseModal()
    {
        if (GenerationGuard is null && (!Show || IsBusy || IsGeneratingWebsite || isGeneratingWebsiteImages)) return;
        if (!await ConfirmGenerationCloseAsync()) return;
        // Prevent closing during generation
        if (!Show) return;

        Show = false;
        autoGenerationTriggered = false;
        var imageToCheck = preparedImageId;
        preparedImageId = null;

        await ShowChanged.InvokeAsync(false);

        // Reset to Generate New tab when closing
        ActiveTab = TabType.GenerateNew;

        // Existing-image opens do no work on close. Gen checks whether a prepared image
        // was already published before deciding whether any reload is necessary.
        if (!string.IsNullOrWhiteSpace(imageToCheck))
            await OnModalClosed.InvokeAsync(imageToCheck);
    }

