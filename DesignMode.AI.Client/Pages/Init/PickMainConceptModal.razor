    private System.Timers.Timer _timer;
    private DateTime _startTime;
    private string CounterDisplay = "0.00s";

    private void UpdateCounter(object sender, System.Timers.ElapsedEventArgs e)
    {
        var elapsed = DateTime.Now - _startTime;
        var seconds = (int)elapsed.TotalSeconds;
        var milliseconds = elapsed.Milliseconds / 10; // 2 digits
        CounterDisplay = $"{seconds}.{milliseconds:D2}s";

        StateHasChanged();
    }

    public class InviteClientData
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public string Industry { get; set; }
        public string Prompt { get; set; }
        public string Email { get; set; }
        public string ImagePath { get; set; }
        public string ImageId { get; set; }
        public bool UseSameImageSeedForAll { get; set; }
        public string TimeStamp { get; set; }
    }

    protected async override void OnInitialized()
    {
        _startTime = DateTime.Now;

        _timer = new System.Timers.Timer(10); // update every 10ms for smooth milliseconds
        _timer.Elapsed += UpdateCounter;
        _timer.Start();
        await LoadInviteDataFromUrl();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Show && !isPreloading)
        {
            await PreloadVideosAsync();
            await JS.InvokeVoidAsync("initScrollAnimation");
            await JS.InvokeVoidAsync("initVerticalTicker");
            await JS.InvokeVoidAsync("initVerticalTextTicker");
            await JS.InvokeVoidAsync("initStepBadge");
        }
        else if (firstRender)
        {
            await JS.InvokeVoidAsync("initScrollAnimation");
            await JS.InvokeVoidAsync("initVerticalTicker");
            await JS.InvokeVoidAsync("initVerticalTextTicker");
            await JS.InvokeVoidAsync("initStepBadge");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Show && !isPreloading && !PreloadedVideos.Any())
        {
            await PreloadVideosAsync();
        }
    }

