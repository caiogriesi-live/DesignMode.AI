    private async Task<string?> SaveInviteClientImageAsync(
        string inviteId,
        string imageId,
        string imageUrl,
        string countId,
        string style,
        string stylePrompt,
        string important,
        string project,
        string outputRequirements)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var requestBody = new
                {
                    InviteId = inviteId,
                    ImageId = imageId,
                    ImageUrl = imageUrl,
                    CountId = countId,
                    TimeStamp = DateTime.UtcNow.ToString("o"),

                    Style = style,
                    StylePrompt = stylePrompt,
                    Important = important,
                    Project = project,
                    OutputRequirements = outputRequirements
                };

                var response = await Http.PostAsJsonAsync(
                    $"{ApiConfig.ApiBaseUrl}api/SaveInviteClientImage?code=REDACTED_FOR_GROOMING",
                    requestBody);

                if (!response.IsSuccessStatusCode)
                {
                    Console.WriteLine($"❌ Failed to save invite client image: {response.StatusCode}");
                    return null;
                }

                var jsonResponse = await response.Content
                    .ReadFromJsonAsync<SaveInviteClientImageResponse>();

                Console.WriteLine("✅ Invite client image saved successfully.");

                return jsonResponse?.Id;
            }

            Console.WriteLine("⚠️ User not authenticated. Skipping invite client image save.");
            return null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception in SaveInviteClientImageAsync: {ex.Message}");
            return null;
        }
    }

