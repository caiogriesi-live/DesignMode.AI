    private async Task<string> CallRunwareImageFunction(string positivePrompt, int width, int height, int numberResults)
    {
        // Check if modal is still open before starting
        if (!_isModalOpen)
        {
            Console.WriteLine("🛑 Image generation cancelled - modal is closed");
            return string.Empty;
        }

        try
        {
            using HttpClient client = new HttpClient();
            string functionUrl = $"{ApiConfig.ApiBaseUrl}api/CallRunwareAPIInit?code=REDACTED_FOR_GROOMING";

            var requestBody = new
            {
                positivePrompt = positivePrompt,
                width = width,
                height = height,
                numberResults = numberResults
            };

            Console.WriteLine($"🎨 Generating image with prompt: {positivePrompt.Substring(0, Math.Min(100, positivePrompt.Length))}...");

            var response = await client.PostAsJsonAsync(functionUrl, requestBody);

            // Check again after the API call completes
            if (!_isModalOpen)
            {
                Console.WriteLine("🛑 Image generation cancelled after API call - modal is closed");
                return string.Empty;
            }

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RunwareResponse>();

                // Check one more time before processing results
                if (!_isModalOpen)
                {
                    Console.WriteLine("🛑 Image generation cancelled while processing results - modal is closed");
                    return string.Empty;
                }

                if (result != null && result.Data != null && result.Data.Any())
                {
                    var imageUrl = result.Data
                        .Where(img => !string.IsNullOrWhiteSpace(img.ImageURL))
                        .Select(img => img.ImageURL)
                        .FirstOrDefault();

                    if (!string.IsNullOrEmpty(imageUrl))
                    {
                        Console.WriteLine($"✅ Image generated successfully: {imageUrl.Substring(0, Math.Min(50, imageUrl.Length))}...");
                        return imageUrl;
                    }
                }

                Console.WriteLine($"⚠️ No image data in response");
                return string.Empty;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"❌ Runware API call failed: {response.StatusCode}, Error: {errorContent}");
                return string.Empty;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception in CallRunwareImageFunction: {ex.Message}");
            return string.Empty;
        }
    }
