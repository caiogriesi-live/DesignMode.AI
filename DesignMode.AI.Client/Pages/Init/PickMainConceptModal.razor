    private async void SelectPrimaryImage(string imageId)
    {
        var uri = NavigationManager.Uri;
        var queryParams = QueryHelpers.ParseQuery(new Uri(uri).Query);

        string decryptedEmail = null;

        // Check for encrypted email parameter
        if (queryParams.TryGetValue("e", out var encryptedEmail) && !string.IsNullOrEmpty(encryptedEmail))
        {
            Console.WriteLine($"✅ 'e' parameter detected, attempting to decrypt...");

            IsLoadingInviteData = true;
            StateHasChanged();

            // Decrypt the email
            decryptedEmail = DecryptEmail(encryptedEmail);

            // Call update function with email + imageId
            if (!string.IsNullOrEmpty(decryptedEmail) && !string.IsNullOrEmpty(imageId))
            {
                var updateSuccess = await UpdateInviteClientImageIdByEmail(decryptedEmail, imageId);

                if (updateSuccess)
                {
                    Console.WriteLine($"✅ InviteClient updated with ImageId: {imageId} for {decryptedEmail}");
                }
                else
                {
                    Console.WriteLine($"⚠️ Failed to update InviteClient ImageId for {decryptedEmail}");
                }
            }

            IsLoadingInviteData = false;
        }

        SelectedPrimaryImageId = imageId;
        isExpanded = true;
        showBrandPreview = true;
        showFooterAnimation = true;
        // ✅ Notify the parent that a concept was selected
        //await OnConceptSelected.InvokeAsync(imageId);
        StateHasChanged();

        await Task.Delay(250);
        await JS.InvokeVoidAsync("playBrandVideo");
        await Task.Delay(100);
    }
    //private List<string> promptTexts { get; set; } = new List<string>();
    private void OnUnlockClick()
    {
        Console.WriteLine($"Unlocking concept: {SelectedPrimaryImageId}");

        if (InviteData != null)
        {
            Console.WriteLine($"For client: {InviteData.Name} ({InviteData.Email})");

            // Get current full URL
            var curUrl = NavigationManager.Uri;

            // Encode it for safe query string usage
            var encodedUrl = Uri.EscapeDataString(curUrl);

            NavigationManager.NavigateTo($"/init/upgrade?b={encodedUrl}", true);
        }
    }
    private async Task<string> FetchPromptIdInit(string userId, string companyIdeaId)
    {
        HttpClient client = new HttpClient();
        string functionUrl = $"{ApiConfig.ApiBaseUrl}api/GetPromptIdForCompanyIdea?code=REDACTED_FOR_GROOMING&userId={Uri.EscapeDataString(userId)}&companyIdeaId={Uri.EscapeDataString(companyIdeaId)}";

        var response = await client.GetAsync(functionUrl);

        if (response.IsSuccessStatusCode)
        {
            var promptId = await response.Content.ReadAsStringAsync();
            return promptId.Trim('"'); // Remove extra quotes if returned as a string
        }

        return "Error: Unable to fetch prompt ID.";
    }

