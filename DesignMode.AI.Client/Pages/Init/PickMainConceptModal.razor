<script>
    const isWindows = navigator.userAgent.includes("Windows");
    if (isWindows) {
        document.documentElement.classList.add("is-windows");
    }
    // Store preloaded iframe elements
    window.preloadedIframes = {};

    // Preload Vimeo video in background
    window.preloadVimeoVideo = (videoUrl) => {
        return new Promise((resolve) => {
            // Check if already preloaded
            if (window.preloadedIframes[videoUrl]) {
                resolve();
                return;
            }

            // Create hidden iframe for preloading
            const preloadIframe = document.createElement('iframe');
            preloadIframe.src = videoUrl;
            preloadIframe.style.display = 'none';
            preloadIframe.style.position = 'absolute';
            preloadIframe.style.width = '1px';
            preloadIframe.style.height = '1px';
            preloadIframe.style.opacity = '0';
            preloadIframe.style.pointerEvents = 'none';
            preloadIframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');

            // Store reference and resolve when ready
            preloadIframe.onload = () => {
                window.preloadedIframes[videoUrl] = preloadIframe;
                resolve();
            };

            document.body.appendChild(preloadIframe);
        });
    };

    // Enhanced video player with preloading support
    window.getOrCreateVideoPlayer = (videoUrl, containerElement) => {
        // Check if we have a preloaded version
        if (window.preloadedIframes[videoUrl]) {
            const preloadedIframe = window.preloadedIframes[videoUrl];
            // Move preloaded iframe to container
            containerElement.innerHTML = '';
            containerElement.appendChild(preloadedIframe);
            preloadedIframe.style.display = 'block';
            preloadedIframe.style.position = 'relative';
            preloadedIframe.style.width = '100%';
            preloadedIframe.style.height = '100%';
            return preloadedIframe;
        }

        // Fallback: create new iframe
        const iframe = document.createElement('iframe');
        iframe.src = videoUrl;
        iframe.setAttribute('frameborder', '0');
        iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
        iframe.setAttribute('allowfullscreen', 'true');
        iframe.style.width = '100%';
        iframe.style.height = '100%';
        iframe.style.position = 'absolute';
        iframe.style.top = '0';
        iframe.style.left = '0';
        containerElement.innerHTML = '';
        containerElement.appendChild(iframe);
        return iframe;
    };

    // Initialize step badge
    window.initStepBadge = () => {
        const stepNumber = document.getElementById('stepNumber');
        if (stepNumber) {
            stepNumber.textContent = '1';
        }
    };

    // Update step badge
    window.updateStepBadge = (step) => {
        const stepNumber = document.getElementById('stepNumber');
        if (stepNumber) {
            stepNumber.textContent = step;
            // Add a subtle pulse effect
            const badge = document.getElementById('stepCounterBadge');
            if (badge) {
                badge.style.transform = 'scale(1.05)';
                setTimeout(() => {
                    if (badge) badge.style.transform = 'scale(1)';
                }, 200);
            }
        }
    };

    // Complete step badge
    window.completeStepBadge = () => {
        const stepNumber = document.getElementById('stepNumber');
        if (stepNumber) {
            stepNumber.textContent = '3';
        }
    };

    // Vertical text ticker animation - only one visible at a time
    window.initVerticalTextTicker = () => {
        const container = document.querySelector('.vertical-text-ticker');
        const items = document.querySelectorAll('.ticker-text-item');
        if (!container || items.length === 0) return;

        let currentIndex = 0;
        let interval = null;
        let isAnimating = false;
        window.textTickerComplete = false;

        // Hide all items initially
        items.forEach(item => {
            item.classList.remove('active', 'exit-up', 'exit-down');
            item.style.opacity = '0';
            item.style.transform = 'translateY(100%)';
        });

        const showItem = (index, animate = true) => {
            if (isAnimating) return;
            isAnimating = true;

            if (window.textTickerComplete || window.generationComplete) {
                // Show the last item as completed
                items.forEach((item, i) => {
                    if (i === items.length - 1) {
                        item.classList.remove('exit-up', 'exit-down');
                        item.classList.add('active');
                        item.style.opacity = '1';
                        item.style.transform = 'translateY(0)';
                    } else {
                        item.classList.remove('active', 'exit-up', 'exit-down');
                        item.style.opacity = '0';
                    }
                });
                if (interval) clearInterval(interval);
                isAnimating = false;
                return;
            }

            // Hide all items first
            items.forEach((item, i) => {
                if (i === index) {
                    // Show the new item
                    item.classList.remove('exit-up', 'exit-down');
                    item.classList.add('active');
                    if (animate) {
                        item.style.animation = 'none';
                        item.offsetHeight; // Force reflow
                        item.style.transition = 'all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55)';
                    }
                    item.style.opacity = '1';
                    item.style.transform = 'translateY(0)';
                } else {
                    // Hide other items
                    item.classList.remove('active');
                    item.style.opacity = '0';
                    // Determine direction to exit
                    if (i < index) {
                        item.style.transform = 'translateY(-100%)';
                    } else {
                        item.style.transform = 'translateY(100%)';
                    }
                }
            });

            setTimeout(() => {
                isAnimating = false;
            }, 400);
        };

        // Function to advance to next item
        const advanceToNext = () => {
            if (window.textTickerComplete || window.generationComplete) {
                if (interval) clearInterval(interval);
                return;
            }

            if (currentIndex < items.length - 1) {
                currentIndex++;
                showItem(currentIndex);
            } else {
                // Reset to beginning
                currentIndex = 0;
                showItem(currentIndex);
            }
        };

        // Start with first item
        showItem(0, false);

        // Start continuous rotation (every 3 seconds)
        interval = setInterval(() => {
            advanceToNext();
        }, 3000);

        window.textTickerInterval = interval;

        // Function to check generation status
        window.checkTextTickerStatus = () => {
            if (window.generationComplete && !window.textTickerComplete) {
                window.textTickerComplete = true;
                if (window.textTickerInterval) {
                    clearInterval(window.textTickerInterval);
                    window.textTickerInterval = null;
                }
                // Show the last item as completed
                items.forEach((item, i) => {
                    if (i === items.length - 1) {
                        item.classList.remove('exit-up', 'exit-down');
                        item.classList.add('active');
                        item.style.opacity = '1';
                        item.style.transform = 'translateY(0)';
                    } else {
                        item.classList.remove('active', 'exit-up', 'exit-down');
                        item.style.opacity = '0';
                    }
                });
            }
        };

        // Check every 500ms
        window.textTickerStatusInterval = setInterval(() => {
            window.checkTextTickerStatus();
        }, 500);
    };

    // Complete the text ticker when generation finishes
    window.completeTextTicker = () => {
        window.generationComplete = true;
        window.textTickerComplete = true;

        const items = document.querySelectorAll('.ticker-text-item');

        if (window.textTickerInterval) {
            clearInterval(window.textTickerInterval);
            window.textTickerInterval = null;
        }
        if (window.textTickerStatusInterval) {
            clearInterval(window.textTickerStatusInterval);
            window.textTickerStatusInterval = null;
        }

        // Show the last step as completed, hide others
        items.forEach((item, i) => {
            if (i === items.length - 1) {
                item.classList.remove('exit-up', 'exit-down');
                item.classList.add('active');
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';
            } else {
                item.classList.remove('active', 'exit-up', 'exit-down');
                item.style.opacity = '0';
            }
        });

        createCompletionEffect();
    };

    // Vertical ticker animation (kept functional but hidden)
    window.initVerticalTicker = () => {
        const ticker = document.querySelector('.vertical-ticker');
        const items = document.querySelectorAll('.ticker-item');
        if (items.length === 0) return;

        let currentIndex = 0;
        let isAnimating = false;
        let interval = null;

        window.tickerComplete = false;

        const showItem = (index, animate = true) => {
            if (isAnimating) return;
            isAnimating = true;

            if (window.tickerComplete || window.generationComplete) {
                if (interval) clearInterval(interval);
                return;
            }

            updateProgressRing(index + 1, items.length);

            setTimeout(() => {
                isAnimating = false;
            }, 100);
        };

        const updateProgressRing = (step, total) => {
            const progressCircle = document.querySelector('.progress-ring-circle');
            const stepIndicator = document.querySelector('.step-indicator');
            const radius = 17;
            const circumference = 2 * Math.PI * radius;

            if (progressCircle && !window.tickerComplete && !window.generationComplete) {
                const progress = step / total;
                const offset = circumference - (progress * circumference);
                progressCircle.style.strokeDashoffset = offset;
            } else if (progressCircle && (window.tickerComplete || window.generationComplete)) {
                progressCircle.style.strokeDashoffset = 0;
                progressCircle.style.stroke = '#4caf50';
            }

            if (stepIndicator && !window.tickerComplete && !window.generationComplete) {
                stepIndicator.textContent = `${step}/${total}`;
            } else if (stepIndicator && (window.tickerComplete || window.generationComplete)) {
                stepIndicator.textContent = `✓ ${total}/${total}`;
                stepIndicator.style.color = '#4caf50';
            }

            const progressFill = document.querySelector('.progress-bar-fill');
            if (progressFill && !window.tickerComplete && !window.generationComplete) {
                const percent = (step / total) * 100;
                progressFill.style.width = `${percent}%`;
            } else if (progressFill && (window.tickerComplete || window.generationComplete)) {
                progressFill.style.width = '100%';
            }
        };

        updateProgressRing(1, items.length);

        window.checkGenerationStatus = () => {
            if (window.generationComplete && !window.tickerComplete) {
                window.tickerComplete = true;
                if (interval) clearInterval(interval);
                updateProgressRing(items.length, items.length);
            }
        };

        window.statusCheckInterval = setInterval(() => {
            window.checkGenerationStatus();
        }, 500);
    };

    window.updateTickerStep = (step) => {
        const items = document.querySelectorAll('.ticker-item');
        if (items.length === 0) return;

        const progressCircle = document.querySelector('.progress-ring-circle');
        const stepIndicator = document.querySelector('.step-indicator');
        const radius = 17;
        const circumference = 2 * Math.PI * radius;

        if (progressCircle && !window.generationComplete) {
            const progress = step / items.length;
            const offset = circumference - (progress * circumference);
            progressCircle.style.strokeDashoffset = offset;
        }

        if (stepIndicator && !window.generationComplete) {
            stepIndicator.textContent = `${step}/${items.length}`;
        }

        const progressFill = document.querySelector('.progress-bar-fill');
        if (progressFill && !window.generationComplete) {
            const percent = (step / items.length) * 100;
            progressFill.style.width = `${percent}%`;
        }
    };

    window.completeTicker = () => {
        // Already handled by completeTextTicker
    };

    // Add a subtle celebration effect when generation completes
    function createCompletionEffect() {
        const container = document.querySelector('.simple-spinner-container');
        if (!container) return;

        const celebration = document.createElement('div');
        celebration.className = 'completion-celebration';
        celebration.innerHTML = '✓';
        celebration.style.position = 'absolute';
        celebration.style.fontSize = '18px';
        celebration.style.opacity = '0';
        celebration.style.transition = 'all 0.3s ease';
        celebration.style.pointerEvents = 'none';
        celebration.style.color = '#4caf50';
        celebration.style.right = '-25px';
        celebration.style.top = '50%';
        celebration.style.transform = 'translateY(-50%)';

        container.style.position = 'relative';
        container.appendChild(celebration);

        setTimeout(() => {
            celebration.style.opacity = '1';
            celebration.style.transform = 'translateY(-50%) scale(1.2)';
        }, 10);

        setTimeout(() => {
            celebration.style.opacity = '0';
            setTimeout(() => {
                celebration.remove();
            }, 300);
        }, 1500);
    }

    // Scroll animation for locked features
    window.initScrollAnimation = () => {
        setTimeout(() => {
            const featuresElement = document.querySelector('#lockedFeatures');
            if (!featuresElement) {
                return;
            }

            const checkVisibility = () => {
                const rect = featuresElement.getBoundingClientRect();
                const windowHeight = window.innerHeight || document.documentElement.clientHeight;
                const isVisible = rect.top <= windowHeight - 100 && rect.bottom >= 100;

                if (isVisible) {
                    featuresElement.classList.add('visible');
                    return true;
                }
                return false;
            };

            if (checkVisibility()) {
                return;
            }

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.2, rootMargin: "0px 0px -50px 0px" });

            observer.observe(featuresElement);

            setTimeout(() => {
                if (!featuresElement.classList.contains('visible')) {
                    checkVisibility();
                }
            }, 1000);
        }, 100);
    };

    window.scrollToLockedFeatures = () => {
        const element = document.querySelector('#lockedFeatures');
        if (element) {
            const scrollContainer = document.querySelector('.modal-scroll-content-init');
            if (scrollContainer) {
                setTimeout(() => {
                    element.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    setTimeout(() => {
                        window.initScrollAnimation();
                    }, 600);
                }, 300);
            } else {
                setTimeout(() => {
                    element.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    setTimeout(() => {
                        window.initScrollAnimation();
                    }, 600);
                }, 300);
            }
        }
    };

    window.playBrandVideo = () => {
        const iframe = document.querySelector('.brand-video');
        if (iframe && iframe.contentWindow) {
            iframe.contentWindow.postMessage('{"method":"play"}', '*');
        }
    };

    document.addEventListener('DOMContentLoaded', () => {
        window.initScrollAnimation();
        window.initVerticalTicker();
        window.initVerticalTextTicker();
        window.initStepBadge();
    });
</script>