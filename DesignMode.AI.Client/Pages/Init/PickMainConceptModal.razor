    private async Task PreloadVideosAsync()
    {
        if (isPreloading) return;

        isPreloading = true;

        // Preload all video URLs
        var videoUrls = new[]
        {
            "https://player.vimeo.com/video/1185199899?autoplay=0&muted=1&loop=1&background=1&controls=0&title=0&byline=0&portrait=0",
            "https://player.vimeo.com/video/1185847340?autoplay=0&muted=1&loop=1&background=1&controls=0&title=0&byline=0&portrait=0"
        };

        foreach (var url in videoUrls)
        {
            if (!PreloadedVideos.ContainsKey(url))
            {
                await JS.InvokeVoidAsync("preloadVimeoVideo", url);
                PreloadedVideos[url] = true;
            }
        }

        isPreloading = false;
    }
