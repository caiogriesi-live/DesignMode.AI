<style>
    /* ===== RESPONSIVE DASHBOARD STYLES ===== */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #f1f5f9;
    }

    /* Mobile menu styles */
    .sidebar-nav {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        transform: translateX(-100%);
        z-index: 1050;
        border-radius: 0 28px 28px 0 !important;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

        .sidebar-nav.mobile-visible {
            transform: translateX(0);
            box-shadow: 10px 0 30px rgba(0,0,0,0.15);
        }

    .mobile-close-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 1060;
    }

    /* Desktop styles */
    @@media (min-width: 992px) {
        .sidebar-nav {
            position: static;
            transform: none;
            border-radius: 28px 0 0 28px !important;
            overflow-y: visible;
        }

        .mobile-close-btn {
            display: none !important;
        }
    }

    /* Tablet styles */
    @@media (min-width: 768px) and (max-width: 991px) {
        .sidebar-nav {
            width: 100px !important;
            min-width: 100px !important;
            padding: 24px 12px !important;
        }

        .nav-label {
            display: none;
        }

        .nav-item {
            justify-content: center;
            padding: 16px 0 !important;
        }

            .nav-item span:first-child {
                font-size: 28px !important;
                margin: 0 !important;
            }

        .d-flex.align-items-center.gap-2.mb-4 {
            justify-content: center;
            padding-left: 0 !important;
        }

            .d-flex.align-items-center.gap-2.mb-4 span:last-child {
                display: none;
            }

        .main-content {
            border-radius: 28px !important;
        }
    }

    /* Mobile adjustments */
    @@media (max-width: 767px) {
        .main-content {
            border-radius: 20px !important;
            padding: 16px !important;
        }

        .row.g-3 > [class*="col-"] {
            padding: 6px;
        }

        .btn, button {
            min-height: 44px;
            min-width: 44px;
        }

        input, select, textarea {
            font-size: 16px !important; /* Prevents zoom on iOS */
        }
    }

    /* Small phones */
    @@media (max-width: 375px) {
        .row.g-3 > [class*="col-"] {
            flex: 0 0 100%;
            max-width: 100%;
        }

        .d-flex.flex-column.flex-sm-row {
            flex-direction: column !important;
        }

            .d-flex.flex-column.flex-sm-row > div {
                max-width: 100% !important;
            }
    }

    /* Touch-friendly hover states */
    .nav-item, .btn, [role="button"] {
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

        .nav-item:active {
            background: #e5eef9 !important;
            transform: scale(0.98);
        }

        .btn:active {
            transform: scale(0.96);
        }

    /* Prevent text overflow */
    .nav-label, h1, h2, h3, h4, p, div {
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    /* Smooth scrolling */
    html {
        scroll-behavior: smooth;
    }

    /* Card hover effects - disabled on mobile */
    @@media (min-width: 768px) {
        [class*="col-"] > div:hover {
            border-color: #ffe19f !important;
            box-shadow: 0 12px 24px -12px rgba(0,0,0,0.08) !important;
            transform: translateY(-2px);
        }
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
        width: 4px;
        height: 4px;
    }

    ::-webkit-scrollbar-track {
        background: #e9eef3;
    }

    ::-webkit-scrollbar-thumb {
        background: #b1c2d1;
        border-radius: 10px;
    }

    .sidebar-nav {
    width: 260px;
    min-width: 260px;
    background: white;
    border-right: 1px solid rgba(0,0,0,0.04);
    padding: 24px 16px;
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 20px rgba(0,0,0,0.02);
    border-radius: 28px 0 0 28px;
