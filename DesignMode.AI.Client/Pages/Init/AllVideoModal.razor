            <div class="videos-modal-body">

                <div class="videos-balloon-items">
                    @if (videosList != null && videosList.Any())
                    {
                        int visibleCount = Math.Min(5, videosList.Count);

                        @for (int i = 0; i < visibleCount; i++)
                        {
                            var item = videosList[i];

                            if (i == 4 && videosList.Count > 5)
                            {
                                <div class="videos-balloon-item" @onclick="HandleVideoClick">
                                    <div class="videos-balloon-thumb extra-thumb">
                                        <img src="@item.ThumbnailUrl" class="extra-thumb-img" />
                                        <div class="extra-thumb-overlay">+@(videosList.Count - 5)</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="videos-balloon-item" @onclick="() => HandleVideoItemClick(item.VideoId)">
                                    <img src="@item.ThumbnailUrl" class="videos-balloon-thumb" />
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <p>No videos</p>
                    }
