    private async Task GenerateWebsite()
    {
        if (IsBusy || !SelectedImageIds.Any()) return;
        await using var generationOperation = await BeginGenerationAsync();

        IsBusy = true;
        StateHasChanged();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                // Get the selected image data
                var selectedImagesData = SelectedImages?
                    .Where(img => SelectedImageIds.Contains(img.Id))
                    .ToList() ?? new List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel>();

                // Prepare website generation request
                var websiteRequest = new
                {
                    SelectedImages = selectedImagesData,
                    SelectedImageIds = SelectedImageIds.ToList(),
                    WebsiteType = SelectedWebsiteType,
                    ColorScheme = SelectedColorScheme,
                    IncludeContactForm = IncludeContactForm,
                    MakeResponsive = MakeResponsive,
                    UserId = user.Identity.Name,
                    Timestamp = DateTime.UtcNow.ToString("yyyyMMddTHHmmssZ")
                };

                // Call API to generate website
                var response = await Http.PostAsJsonAsync(
                    $"{ApiConfig.ApiBaseUrl}api/GenerateWebsite?code=REDACTED_FOR_GROOMING",
                    websiteRequest);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<WebsiteGenerationResult>();

                    if (result != null && result.Success)
                    {
                        Console.WriteLine("✅ Website generated successfully!");
                        Console.WriteLine($"🌐 Preview URL: {result.PreviewUrl}");
                        Console.WriteLine($"📁 Download URL: {result.DownloadUrl}");

                        // Notify parent
                        if (OnWebsiteGenerated.HasDelegate)
                        {
                            await OnWebsiteGenerated.InvokeAsync(true);
                        }

                        // Close modal
                        if (generationOperation is not null) await generationOperation.DisposeAsync();
                        await CloseModal();
                        if (Show) return;
                    }
                    else
                    {
                        Console.WriteLine("❌ Website generation failed");
                    }
                }
                else
                {
                    Console.WriteLine($"❌ Failed to generate website: {response.StatusCode}");
                }
            }
            else
            {
                Console.WriteLine("⚠️ User not authenticated.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception generating website: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
            StateHasChanged();
        }
    }

    private async Task CloseModal()
    {
        if (GenerationGuard is null && (IsBusy)) return;
        if (!await ConfirmGenerationCloseAsync()) return;

        Show = false;

        await ShowChanged.InvokeAsync(false);

        if (OnModalClosed.HasDelegate)
        {
            await OnModalClosed.InvokeAsync();
        }
    }

    private RenderFragment ImageCard(DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel image) => __builder =>
    {
        var isSelected = SelectedImageIds.Contains(image.Id);
        var isNew = newlyGeneratedImages.Contains(image);

        <div class="image-card @(isSelected ? "website-selected" : "") @(isNew ? "newly-generated" : "")"
             @onclick="() => ToggleSelection(image.ImageUrl, image.Id)">
            <img src="@image.ImageUrl" alt="Website asset" class="image-thumb" />
            <div class="image-controls">
                <div class="website-selection-indicator @(isSelected ? "selected" : "")"
                     @onclick="() => ToggleSelection(image.ImageUrl, image.Id)"
                @onclick:stopPropagation>
                    @if (isSelected)
                    {
                        <span class="indicator-icon" title="Selected for website">✓</span>
                    }
                    else
                    {
                        <span class="indicator-icon" title="Select for website">+</span>
                    }
                </div>
            </div>
            @if (isSelected)
            {
                <div class="website-selection-badge">
                    <span class="badge-icon">🌐</span>
                    For Website
                </div>
            }
            @if (isNew)
            {
                <div class="new-image-badge">
                    <span class="badge-icon">🆕</span>
                    New
                </div>
            }
        </div>
    };
