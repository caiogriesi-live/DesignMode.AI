    public string promptText { get; set; }
    private HashSet<string> SelectedImageIds = new();
    private HashSet<string> SelectedImageUrls = new();

    // Website configuration
    private string SelectedWebsiteType = "LandingPage";
    private string SelectedColorScheme = "Light";
    private bool IncludeContactForm = true;
    private bool MakeResponsive = true;

    // For generating website images
    private bool isGeneratingWebsiteImages = false;
    private List<string> generatedWebsiteImageUrls = new();
    private List<Gen.ImageIdeaModel> newlyGeneratedImages = new();
    private List<string> websitePromptsToGenerate = new();
    private int currentGenerationIndex = 0;
    private int totalGenerations = 0;

    // NEW: Track if an image was generated during this modal session
    private bool wasImageGenerated = false;

    // Helper method to check if we have website images
    private bool HasWebsiteImages()
    {
        if (SelectedImages == null && newlyGeneratedImages == null)
            return false;

        // Check if we have any website-related images
        var allImages = new List<Gen.ImageIdeaModel>();
        if (SelectedImages != null) allImages.AddRange(SelectedImages);
        if (newlyGeneratedImages != null) allImages.AddRange(newlyGeneratedImages);

        return allImages.Any(img =>
            !string.IsNullOrWhiteSpace(img.ImageUrl) &&
            (img.DeliverableType?.ToLower().Contains("web") == true ||
             img.SubCategory?.ToLower().Contains("web") == true ||
             img.DeliverableType?.ToLower().Contains("digital") == true ||
             img.SubCategory?.ToLower().Contains("digital") == true ||
             img.DeliverableType?.ToLower().Contains("website") == true ||
             img.SubCategory?.ToLower().Contains("website") == true));
    }

    // Helper method to get unique website images (avoid duplicates)
    private List<Gen.ImageIdeaModel> GetUniqueWebsiteImages()
    {
        var allImages = new List<Gen.ImageIdeaModel>();

        // Add selected images
        if (SelectedImages != null)
        {
            allImages.AddRange(SelectedImages);
        }

        // Add newly generated images
        if (newlyGeneratedImages != null)
        {
            allImages.AddRange(newlyGeneratedImages);
        }

        // Filter for website images and remove duplicates by ImageUrl
        var websiteImages = allImages
            .Where(img => !string.IsNullOrWhiteSpace(img.ImageUrl) &&
                         (img.DeliverableType?.ToLower().Contains("web") == true ||
                          img.SubCategory?.ToLower().Contains("web") == true ||
                          img.DeliverableType?.ToLower().Contains("digital") == true ||
                          img.SubCategory?.ToLower().Contains("digital") == true ||
                          img.DeliverableType?.ToLower().Contains("website") == true ||
                          img.SubCategory?.ToLower().Contains("website") == true))
            .GroupBy(img => img.ImageUrl) // Group by ImageUrl to remove duplicates
            .Select(group => group.First()) // Take the first occurrence of each unique ImageUrl
            .ToList();

        return websiteImages;
    }

    protected override void OnParametersSet()
    {
        if (SelectedImages != null && SelectedImages.Any())
        {
            // Clear previous selections
            SelectedImageIds.Clear();
            SelectedImageUrls.Clear();

            // Get unique website images to avoid duplicates
            var websiteImages = GetUniqueWebsiteImages();

            foreach (var image in websiteImages)
            {
                if (!string.IsNullOrEmpty(image.Id))
                {
                    SelectedImageIds.Add(image.Id);
                    if (!string.IsNullOrEmpty(image.ImageUrl))
                    {
                        SelectedImageUrls.Add(image.ImageUrl);
                    }
                }
            }

            StateHasChanged();
        }
    }
    public class IdeaDto
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
    }

    public class IdeasResponse
    {
        public List<IdeaDto> Ideas { get; set; } = new();
        public int Count { get; set; }
    }
    private async Task<IdeasResponse> CallGetIdeasByCompanyIdeaId(string companyIdeaId)
    {
        try
        {
            var url = $"{ApiConfig.ApiBaseUrl}api/GetIdeasByCompanyIdeaId?code=REDACTED_FOR_GROOMING&companyIdeaId={companyIdeaId}";
            var response = await Http.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                return await response.Content.ReadFromJsonAsync<IdeasResponse>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calling GetIdeasByCompanyIdeaId: {ex.Message}");
        }

        return new IdeasResponse { Ideas = new List<IdeaDto>(), Count = 0 };
    }
    // Helper method to extract query parameter values
    private string GetQueryParameter(string queryString, string key, string defaultValue)
    {
        var parameters = System.Web.HttpUtility.ParseQueryString(queryString);
        return parameters[key] ?? defaultValue;
    }
