@page "/init/designer-select"
@using Telerik.Blazor.Components
@using Telerik.SvgIcons
@using Microsoft.AspNetCore.Components.Authorization
@using DesignMode.AI.Shared.Security
@using Microsoft.AspNetCore.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<link href="assets/css/brief-landing.css" rel="stylesheet" />

<div class="designer-select-wrapper">
    <div class="designer-select-container">
        <!-- Header -->
        <div class="designer-header">
            <div class="logo-container">
                <img src="assets/img/logo-left.png" width="26px" height="26px" alt="main_logo" />
                <span class="logo-text">
                    design<span class="logo-highlight">
                        <img src="images/logo-m3.svg" style="width: 30px; margin-left: 3px; margin-right: 3px; margin-bottom: 3px;">
                    </span>ode.ai
                </span>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content-designer">
            <h1 class="page-title">Choose Your Design Partner</h1>
            <p class="page-subtitle">Select a designer to help bring your vision to life</p>

            <!-- Designer Cards -->
            <div class="designer-grid">
                @foreach (var designer in designers)
                {
                    <div class="designer-card @(selectedDesigner?.Id == designer.Id ? "selected" : "")"
                         @onclick="() => SelectDesigner(designer)">
                        <div class="designer-avatar">
                            @if (!string.IsNullOrEmpty(designer.AvatarUrl))
                            {
                                <img src="@designer.AvatarUrl" alt="@designer.Name" />
                            }
                            else
                            {
                                <div class="avatar-placeholder" style="background: @designer.AvatarColor">
                                    @designer.Name[0]
                                </div>
                            }
                            @if (designer.IsAvailable)
                            {
                                <span class="availability-badge available"></span>
                            }
                        </div>
                        <div class="designer-info">
                            <h3 class="designer-name">@designer.Name</h3>
                            <p class="designer-title">@designer.Title</p>
                            <div class="designer-specialties">
                                @foreach (var specialty in designer.Specialties.Take(3))
                                {
                                    <span class="specialty-tag">@specialty</span>
                                }
                            </div>
                            <div class="designer-stats">
                                <span class="stat">
                                    <TelerikSvgIcon Icon="@SvgIcon.Star" /> @designer.Rating
                                </span>
                            </div>
                        </div>
                        <div class="designer-check">
                            @if (selectedDesigner?.Id == designer.Id)
                            {
                                <TelerikSvgIcon Icon="@SvgIcon.CheckCircle" class="check-icon" />
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Action Buttons -->
            <div class="action-buttons">
                <TelerikButton OnClick="@ContactDesigner"
                               Class="contact-button"
                               Enabled="@(selectedDesigner != null)">
                    <TelerikSvgIcon Icon="@SvgIcon.Envelope" />
                    Contact @(selectedDesigner?.Name ?? "Designer")
                </TelerikButton>

                <TelerikButton OnClick="@SkipToInit"
                               Class="skip-button">
                    Skip for Now
                </TelerikButton>
            </div>

            <!-- Loading Overlay -->
            @if (IsLoading)
            {
                <div class="loading-overlay">
                    <p>@LoadingMessage</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
