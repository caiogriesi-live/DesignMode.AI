                Specialties = new List<string> { "User Flows", "Wireframing", "A/B Testing" },
                Rating = 4.9,
                ProjectsCompleted = 112,
                Email = "james.t@designmode.ai",
                IsAvailable = true,
                AvatarColor = "#FFD93D"
            }
        };
    }

    private void SelectDesigner(Designer designer)
    {
        selectedDesigner = designer;
    }

    private async Task ContactDesigner()
    {
        if (selectedDesigner == null) return;

        IsLoading = true;
        LoadingMessage = $"Connecting you with {selectedDesigner.Name}...";

        try
        {
            await Task.Delay(1000);

            var subject = $"Design Project Inquiry - {selectedDesigner.Name}";
            var body = $"Hello {selectedDesigner.Name},%0D%0A%0D%0A" +
                      $"I'm interested in working with you on a design project.%0D%0A%0D%0A" +
                      $"Could you please let me know your availability and process?%0D%0A%0D%0A" +
                      $"Best regards";//,%0D%0A[Your Name]";

            var mailtoLink = $"mailto:{selectedDesigner.Email}?subject={subject}&body={body}";
            Navigation.NavigateTo(mailtoLink);

            LoadingMessage = "Opening email client...";
            await Task.Delay(500);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error contacting designer: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SkipToInit()
    {
        Navigation.NavigateTo("/init/init");
    }

    public class Designer
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public List<string> Specialties { get; set; } = new();
        public double Rating { get; set; }
        public int ProjectsCompleted { get; set; }
        public string Email { get; set; } = string.Empty;
        public bool IsAvailable { get; set; }
        public string AvatarUrl { get; set; } = string.Empty;
        public string AvatarColor { get; set; } = "#6C63FF";
    }
}