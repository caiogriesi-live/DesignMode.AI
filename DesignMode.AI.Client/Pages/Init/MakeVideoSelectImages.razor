    private List<string> _sceneScriptsPlain = new();
    private List<string> _sceneScriptsCamera = new();

    private void ParseVideoPromptsIntoScenes(string videoPrompts)
    {
        try
        {
            // Regex matches common numbered section markers:
            // "1.", "1:", "1)", "Scene 1:", "#1", etc.
            var pattern = @"(?<=^|\n|\r)(?:Scene\s*)?(\d{1,2})[.:)\-]\s*";
            var matches = Regex.Split(videoPrompts, pattern, RegexOptions.IgnoreCase);

            // matches will return: ["", "1", "content1", "2", "content2", ...]
            // So we now extract the content for numbers 1–6.

            // holds final scene text
            var parsedScenes = new string[6];

            for (int i = 1; i < matches.Length - 1; i += 2)
            {
                if (int.TryParse(matches[i], out int sceneNum) && sceneNum >= 1 && sceneNum <= 6)
                {
                    parsedScenes[sceneNum - 1] = matches[i + 1].Trim();
                }
            }

            // Fill any missing scenes with empty text
            for (int s = 0; s < 6; s++)
            {
                _sceneScripts[s] = parsedScenes[s] ?? string.Empty;
            }
        }
        catch
        {
            // Fallback → even distribution of words across 6 scenes
            var words = videoPrompts.Split(' ');
            var wordsPerScene = words.Length / 6;

            for (int i = 0; i < 6; i++)
            {
                var start = i * wordsPerScene;
                var end = Math.Min((i + 1) * wordsPerScene, words.Length);
                _sceneScripts[i] = string.Join(" ", words.Skip(start).Take(end - start));
            }
        }
    }

    private async Task RegenerateScript()
    {
        await using var generationOperation = await BeginGenerationAsync();
        _scriptGenerating = true;
        StateHasChanged();

        try
        {
            // Call AI again with potentially modified prompt
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var username = user.Identity?.Name;
            var uri = NavigationManager.Uri;
            var queryString = new Uri(uri).Query;
            string cid = GetQueryParameter(queryString, "cid", null);

            var promptId = await FetchPromptIdSelect(username, cid);
            var promptText = await FetchPromptTextSelect(promptId);

            // Use edited script as new base if user made changes
            var basePrompt = !string.IsNullOrEmpty(_editedScript) && _editedScript != _aiGeneratedScript
                ? _editedScript
                : promptText;

            _aiGeneratedScript = await GetAICommercialSentenceAsync(
                CompanyName,
                Industry,
                basePrompt
            );

            var videoPrompts = await GetAIVideoPromptSequenceAsync(_aiGeneratedScript);

            if (!string.IsNullOrEmpty(videoPrompts))
            {
                ParseVideoPromptsIntoScenes(videoPrompts);
            }

            _generatedScript = _aiGeneratedScript;
            _editedScript = _aiGeneratedScript;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error regenerating script: {ex.Message}");
        }
        finally
        {
            _scriptGenerating = false;
            StateHasChanged();
        }
    }

