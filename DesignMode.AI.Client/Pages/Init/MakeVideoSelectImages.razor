    private async Task PlayNarration()
    {
        if (string.IsNullOrWhiteSpace(_aiVoiceOverScript))
        {
            Console.WriteLine("❌ No voice-over script available");
            return;
        }

        try
        {
            // Get Scene 1 text only
            var scene1Text = ExtractScene1Text(_aiVoiceOverScript);

            // Extract plain text (remove HTML tags)
            _fullNarrationText = RemoveBoldTags(scene1Text);

            // Split text into words for the ticker visualization (first 5 words + ellipses)
            _scene1Words = SplitTextIntoWords(_fullNarrationText, 7);
            _currentWordIndex = 0;
            _tickerProgress = 0;

            // Start loading state
            _isLoadingAudio = true;
            StateHasChanged();

            var sentence = string.Join(" ", _scene1Words.Select(w => w.text));

            // ✅ STEP 1: Check if audio already exists in database
            var existingAudioUrls = await GetAudioSampleUrlsAsync(
                VideoIdGuid ?? string.Empty,
                sentence,
                _selectedVoice
            );

            string audioUrl = string.Empty;

            if (existingAudioUrls != null && existingAudioUrls.Any())
            {
                // ✅ Audio found in database - use existing URL
                audioUrl = existingAudioUrls.First();
                Console.WriteLine($"✅ Found existing audio in database: {audioUrl}");

                // Start the ticker animation
                StartTickerAnimation();

                // Use the audio element to play
                await PlayAudioViaElement(audioUrl);
            }
            else
            {
                // ✅ Audio not found in database - generate new
                Console.WriteLine("ℹ️ No existing audio found, generating new...");

                // xAI voice codes are sent directly to the Azure Function.
                // Fall back to Eve if an old/invalid saved voice somehow gets here.
                string voice = _voices.Contains(_selectedVoice)
                    ? _selectedVoice
                    : "eve";

                audioUrl = await GenerateAudioForTextAsync(sentence + "...", voice);

                if (!string.IsNullOrEmpty(audioUrl))
                {
                    Console.WriteLine($"✅ Audio generated: {audioUrl}");

                    // ✅ Save the new audio to database
                    await SaveAudioSampleAsync(new AudioSampleRequest
                        {
                            VideoId = VideoIdGuid ?? string.Empty,
                            Text = sentence,
                            Url = audioUrl,
                            VoiceOverActor = _selectedVoice,
                            TimeStamp = DateTime.UtcNow.ToString("o")
                        });

                    // Start the ticker animation
                    StartTickerAnimation();

                    // Use the audio element to play
                    await PlayAudioViaElement(audioUrl);
                }
                else
                {
                    Console.WriteLine("❌ Failed to generate audio");
                    _isLoadingAudio = false;
                    StateHasChanged();
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error playing narration: {ex.Message}");
            _isLoadingAudio = false;
            StateHasChanged();
        }
    }

