    private string ResolveSceneImageUrl(VideoImageModel savedScene)
    {
        if (savedScene == null)
            return string.Empty;

        if (!string.IsNullOrWhiteSpace(savedScene.ImageUrl))
            return savedScene.ImageUrl.Trim();

        if (!string.IsNullOrWhiteSpace(savedScene.ImageId))
        {
            var selectedMatch =
                SelectedImages?
                    .FirstOrDefault(x => x.Id == savedScene.ImageId);

            if (!string.IsNullOrWhiteSpace(selectedMatch?.ImageUrl))
                return selectedMatch.ImageUrl.Trim();

            var arrangedMatch =
                ArrangedImages?
                    .FirstOrDefault(x => x.Id == savedScene.ImageId);

            if (!string.IsNullOrWhiteSpace(arrangedMatch?.ImageUrl))
                return arrangedMatch.ImageUrl.Trim();

            var orderedMatch =
                OrderedImages?
                    .FirstOrDefault(x => x.Id == savedScene.ImageId);

            if (!string.IsNullOrWhiteSpace(orderedMatch?.ImageUrl))
                return orderedMatch.ImageUrl.Trim();
        }

        return string.Empty;
    }

    private async Task<string> EnsureCameraScriptForSceneAsync(
        string videoId,
        int sceneNumber,
        VideoImageModel savedScene,
        string imageUrl)
    {
        if (sceneNumber < 1 || sceneNumber > 6)
            return string.Empty;

        if (_sceneScriptsCamera == null ||
            _sceneScriptsCamera.Count != 6)
        {
            _sceneScriptsCamera =
                new List<string>(new string[6]);
        }

        // 1. Existing in-memory camera script.
        var cameraPrompt =
            _sceneScriptsCamera[sceneNumber - 1];

        if (!string.IsNullOrWhiteSpace(cameraPrompt))
            return cameraPrompt.Trim();

        // 2. Existing database Script from the scene already loaded.
        if (!string.IsNullOrWhiteSpace(savedScene?.Script))
        {
            cameraPrompt = savedScene.Script.Trim();
            _sceneScriptsCamera[sceneNumber - 1] = cameraPrompt;
            return cameraPrompt;
        }

        // 3. Re-read DynamoDB because the scene/script may have been written
        //    immediately before finalization.
        try
        {
            var refreshedScenes =
                await GetVideoImagesAsync(videoId)
                ?? new List<VideoImageModel>();

            var refreshedScene =
                refreshedScenes.FirstOrDefault(x =>
                    string.Equals(
                        x.Scene,
                        sceneNumber.ToString(),
                        StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(refreshedScene?.Script))
            {
                cameraPrompt = refreshedScene.Script.Trim();

                _sceneScriptsCamera[sceneNumber - 1] =
                    cameraPrompt;

                if (savedScene != null)
                    savedScene.Script = cameraPrompt;

                Console.WriteLine(
                    $"✅ Recovered camera script for scene {sceneNumber} from database.");

                return cameraPrompt;
            }

            // Keep the freshest scene fields available for the repair write.
            if (refreshedScene != null)
            {
                savedScene.ScriptPlain =
                    refreshedScene.ScriptPlain ?? savedScene.ScriptPlain;

                savedScene.ScriptWithSpeech =
                    refreshedScene.ScriptWithSpeech ?? savedScene.ScriptWithSpeech;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"⚠️ Could not re-read scene {sceneNumber} before camera-script repair: {ex.Message}");
        }

        // 4. Script is genuinely missing. Regenerate the full camera/motion
        //    scene description from the SAME scene image.
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            Console.WriteLine(
                $"❌ Scene {sceneNumber} camera script is missing and no image URL is available.");
            return string.Empty;
        }

        _finalizeStatus =
            $"Repairing camera script for scene {sceneNumber}...";
        StateHasChanged();

        Console.WriteLine(
            $"⚠️ Camera script missing for scene {sceneNumber}. Regenerating from scene image.");

        var imageDescription =
            await GetAIImageDescriptionAsync(imageUrl);

        if (string.IsNullOrWhiteSpace(imageDescription))
        {
            Console.WriteLine(
                $"❌ Could not analyze the image for scene {sceneNumber}.");
            return string.Empty;
        }

        var regeneratedCameraScript =
            await RegenerateSceneFromImageAsync(
                $"The prompt is for a company named {CompanyName} in the {Industry} industry.",
                sceneNumber,
                imageDescription);

        if (string.IsNullOrWhiteSpace(regeneratedCameraScript))
        {
            Console.WriteLine(
                $"❌ Could not regenerate the camera script for scene {sceneNumber}.");
            return string.Empty;
        }

        regeneratedCameraScript =
            regeneratedCameraScript.Trim();

        // Preserve ScriptPlain and ScriptWithSpeech while repairing Script.
        var updateSucceeded =
            await UpdateScriptByVideoIdAndSceneAsync(
                videoId: videoId,
                scene: sceneNumber.ToString(),
                script: regeneratedCameraScript,
                scriptPlain: savedScene?.ScriptPlain ?? string.Empty,
                scriptWithSpeech: savedScene?.ScriptWithSpeech ?? string.Empty);

        if (!updateSucceeded)
        {
            Console.WriteLine(
                $"⚠️ Camera script for scene {sceneNumber} was regenerated, " +
                "but saving it to the database failed. Finalization will still use it.");
        }
        else
        {
            Console.WriteLine(
                $"✅ Repaired and saved camera script for scene {sceneNumber}.");
        }

        _sceneScriptsCamera[sceneNumber - 1] =
            regeneratedCameraScript;

        if (savedScene != null)
            savedScene.Script = regeneratedCameraScript;

        return regeneratedCameraScript;
    }

    private async Task FinalizeVideo()
    {
        await using var generationOperation = await BeginGenerationAsync();
        _isFinalizing = true;
        _finalizationFailed = false;
        _finalizeErrorMessage = string.Empty;
        _finalizeStatus = "Preparing scenes...";
        _finalizePhase = "prepare";
        _finalizeProgressPercent = 3;
        _currentFinalizingScene = 0;
        _finalVideoUrl = string.Empty;
        StateHasChanged();

        try
        {
            await StopMusicPreview();

            var effectiveVideoId = VideoIdGuid ?? VideoId ?? string.Empty;
            if (string.IsNullOrWhiteSpace(effectiveVideoId))
                throw new InvalidOperationException("VideoId is missing.");

            _finalizeStatus = "Verifying project access...";
            _finalizeProgressPercent = 4;
            StateHasChanged();
            var commercialCid = GetQueryParameter(new Uri(NavigationManager.Uri).Query, "cid", null);
            var commercialContext = await AttributionContext.AuthorizeGenerationAsync(commercialCid);

            _commercialGenerationJobId = Guid.NewGuid().ToString();
            _commercialProjectId = commercialContext?.ProjectId ?? string.Empty;
            _commercialFunnelId = commercialContext?.FunnelId ?? string.Empty;

            // IMPORTANT: verify/repair all six DB scene rows BEFORE applying settings
            // or beginning Runware rendering. This directly prevents the old
            // "Scene 6 was not found" failure.
            _finalizeStatus = "Verifying all six scenes...";
            _finalizeProgressPercent = 5;
            StateHasChanged();
            var savedVideoImages = await EnsureSixSceneRecordsAsync(effectiveVideoId);

            // Save the latest aspect ratio / voice / music / voice-over settings.
            _finalizeStatus = "Saving your video settings...";
            _finalizeProgressPercent = 7;
            StateHasChanged();
            await UpdateAllScenesWithCurrentSettings();

            // Re-read after settings are persisted so rendering uses the latest data.
            savedVideoImages = await EnsureSixSceneRecordsAsync(effectiveVideoId);

            // Make sure the camera-script list is populated from Script (NOT ScriptPlain).
            if (_sceneScriptsCamera == null || _sceneScriptsCamera.Count != 6)
                _sceneScriptsCamera = new List<string>(new string[6]);

            foreach (var savedImage in savedVideoImages)
            {
                if (int.TryParse(savedImage.Scene, out var sceneNum) &&
                    sceneNum >= 1 && sceneNum <= 6 &&
                    !string.IsNullOrWhiteSpace(savedImage.Script))
                {
                    _sceneScriptsCamera[sceneNum - 1] = savedImage.Script;
                }
            }

            // Voice-over text is separate from the camera/motion prompt.
            var narrationScenes = ParseScenesFromVoiceOverScript(_aiVoiceOverScript ?? string.Empty);
            while (narrationScenes.Count < 6)
                narrationScenes.Add(string.Empty);

            var renderedVideos = new List<string>();
            var narrationAudioUrls = new List<string>();

            for (int sceneNum = 1; sceneNum <= 6; sceneNum++)
            {
                _currentFinalizingScene = sceneNum;
                _finalizePhase = "render";
                _finalizeStatus = $"Rendering scene {sceneNum} of 6...";
                _finalizeProgressPercent = 10 + ((sceneNum - 1) * 11);
                StateHasChanged();

                var savedScene = savedVideoImages
                    .FirstOrDefault(x => x.Scene == sceneNum.ToString());

                if (savedScene == null)
                    throw new InvalidOperationException($"Scene {sceneNum} was not found.");

                // Resolve the actual image URL for the selected scene first.
                // The image is also used to repair a missing camera script.
                var imageUrl = ResolveSceneImageUrl(savedScene);

                if (string.IsNullOrWhiteSpace(imageUrl))
                    throw new InvalidOperationException(
                        $"Scene {sceneNum} does not have a valid image URL.");

                // Camera/motion prompt:
                // 1. Use the in-memory camera script when available.
                // 2. Use VideoImages.Script from DynamoDB.
                // 3. Re-read DynamoDB in case a recent write was not reflected
                //    in the earlier list.
                // 4. If Script is genuinely missing, regenerate ONLY the camera
                //    prompt from this scene image, persist it to VideoImages.Script,
                //    and continue finalization.
                //
                // ScriptPlain is NEVER sent to Runware as the video prompt.
                var cameraPrompt =
                    await EnsureCameraScriptForSceneAsync(
                        effectiveVideoId,
                        sceneNum,
                        savedScene,
                        imageUrl);

                if (string.IsNullOrWhiteSpace(cameraPrompt))
                    throw new InvalidOperationException(
                        $"Scene {sceneNum} camera script could not be recovered or regenerated.");

                // Estimate scene length from narration so the generated clip is long enough
                // for the spoken audio. Seedance 1.0 Pro Fast accepts 1.2-12 second clips.
                var narrationText = narrationScenes[sceneNum - 1] ?? string.Empty;
                var sceneDuration = EstimateSceneDurationSeconds(narrationText);

                var renderedVideoUrl = await GenerateRunwareSceneVideoAsync(
                    sceneNum,
                    cameraPrompt,
                    imageUrl,
                    sceneDuration);

                if (string.IsNullOrWhiteSpace(renderedVideoUrl))
                    throw new InvalidOperationException(
                        $"Runware did not return a video for scene {sceneNum}.");

                renderedVideos.Add(renderedVideoUrl);

                _finalizePhase = "narration";
                _finalizeStatus = $"Generating narration {sceneNum} of 6...";
                _finalizeProgressPercent = 16 + ((sceneNum - 1) * 11);
                StateHasChanged();

                if (!string.IsNullOrWhiteSpace(narrationText))
                {
                    var voice = _voices.Contains(_selectedVoice)
                        ? _selectedVoice
                        : "eve";

                    var narrationUrl = await GenerateAudioForTextAsync(
                        narrationText,
                        voice,
                        sceneNum,
                        generationJobId: _commercialGenerationJobId);

                    narrationAudioUrls.Add(narrationUrl ?? string.Empty);

                    if (!string.IsNullOrWhiteSpace(narrationUrl))
                    {
                        await SaveAudioSampleAsync(new AudioSampleRequest
                            {
                                VideoId = VideoIdGuid ?? VideoId ?? string.Empty,
                                Text = narrationText,
                                Url = narrationUrl,
                                VoiceOverActor = voice,
                                TimeStamp = DateTime.UtcNow.ToString("o")
                            });
                    }
                }
                else
                {
                    narrationAudioUrls.Add(string.Empty);
                }
            }

            _currentFinalizingScene = 0;
            _finalizePhase = "compose";
            _finalizeStatus = "Combining scenes, narration, and music...";
            _finalizeProgressPercent = 88;
            StateHasChanged();

            string musicUrl = string.Empty;

            if (!string.Equals(_selectedMusic, "none", StringComparison.OrdinalIgnoreCase))
            {
                musicUrl = new Uri(
                    new Uri(NavigationManager.BaseUri),
                    GetMusicAudioUrl(_selectedMusic)).ToString();
            }

            _finalVideoUrl = await ComposeFinalCommercialAsync(
                renderedVideos,
                narrationAudioUrls,
                musicUrl);

            if (string.IsNullOrWhiteSpace(_finalVideoUrl))
                throw new InvalidOperationException(
                    "The final composition endpoint did not return a video URL.");

            // Persist the completed commercial in VideoImages so reopening the
            // modal can immediately show the finished video.
            _finalizeStatus = "Saving completed video...";
            _finalizeProgressPercent = 96;
            StateHasChanged();

            await SaveFinalVideoUrlAsync(
                VideoIdGuid ?? VideoId ?? string.Empty,
                _finalVideoUrl);

            _finalizePhase = "complete";
            _finalizeStatus = "Commercial finalized.";
            _finalizeProgressPercent = 100;
            _currentFinalizingScene = 0;

            Console.WriteLine($"✅ Final commercial URL: {_finalVideoUrl}");
            Console.WriteLine(
                $"✅ Settings: {_selectedAspectRatio}, {_selectedVoice}, {_selectedMusic}");

            // Do not close the modal here. The markup switches to the completed
            // section and displays the returned final video in the HTML5 player.
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error finalizing video: {ex}");
            _finalizeStatus = "Finalization failed.";
            _finalizePhase = "error";
            _finalizationFailed = true;
            _finalizeErrorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Something went wrong while creating the final video. Please try again."
                : ex.Message;
            StateHasChanged();
        }
        finally
        {
            _isFinalizing = false;
            _currentFinalizingScene = 0;
            StateHasChanged();
        }
    }

