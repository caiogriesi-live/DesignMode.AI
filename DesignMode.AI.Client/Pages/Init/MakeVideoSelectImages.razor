    private double EstimateSceneDurationSeconds(string narrationText)
    {
        if (string.IsNullOrWhiteSpace(narrationText))
            return 5.0;

        var wordCount = narrationText
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Length;

        // xAI TTS narration is typically around 2-3 spoken words/second.
        // Give a little breathing room and clamp to Seedance's supported range.
        var estimated = Math.Ceiling((wordCount / 2.35) + 0.75);

        return Math.Clamp(estimated, 3.0, 12.0);
    }

