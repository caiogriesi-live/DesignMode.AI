        };
    }

    private async Task<string?> GenerateRunwareSceneVideoAsync(
        int sceneNumber,
        string cameraScript,
        string imageUrl,
        double duration)
    {
        if (string.IsNullOrWhiteSpace(cameraScript) ||
            string.IsNullOrWhiteSpace(imageUrl))
        {
            return null;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity == null || !user.Identity.IsAuthenticated)
            throw new InvalidOperationException("User is not authenticated.");

        var (width, height) = GetVideoDimensionsForAspectRatio();

        var url =
            $"{ApiConfig.ApiBaseUrl}api/CallRunwareFinalizeSceneVideo" +
            "?code=REDACTED_FOR_GROOMING";

        var payload = new
        {
            positivePrompt = cameraScript,
            model = "bytedance:2@2",
            width,
            height,
            duration,
            numberResults = 1,
            outputType = "URL",
            outputFormat = "MP4",
            includeCost = true,
            frameImages = new[] { imageUrl },
            sceneNumber,
            generationJobId = _commercialGenerationJobId,
            providerOperationId = $"{_commercialGenerationJobId}:scene:{sceneNumber}",
            projectId = _commercialProjectId,
            funnelId = _commercialFunnelId
        };

        using var content = new StringContent(
            System.Text.Json.JsonSerializer.Serialize(payload),
            Encoding.UTF8,
            "application/json");

        using var client = new HttpClient
            {
                Timeout = TimeSpan.FromMinutes(7)
            };

        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (!string.IsNullOrWhiteSpace(token))
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        using var response = await client.PostAsync(url, content);
        if (await UsageRefresh.HandleResponseAsync(response)) throw new InvalidOperationException("You have insufficient AI Credits for this generation.");
        var responseBody = await response.Content.ReadAsStringAsync();

        if (!response.IsSuccessStatusCode)
        {
            Console.WriteLine(
                $"❌ Scene {sceneNumber} video generation failed. " +
                $"Status: {response.StatusCode}. Response: {responseBody}");

            throw new InvalidOperationException(
                $"Video generation failed for scene {sceneNumber}.");
        }

        var result = System.Text.Json.JsonSerializer.Deserialize<RunwareVideoFunctionResult>(
            responseBody,
            new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

        if (!string.IsNullOrWhiteSpace(result?.VideoUrl))
            await UsageRefresh.RequestRefreshAsync();
        return result?.VideoUrl;
    }

    private async Task<string?> ComposeFinalCommercialAsync(
        List<string> renderedVideos,
        List<string> narrationAudioUrls,
        string musicUrl)
    {
        if (renderedVideos == null || renderedVideos.Count == 0)
            return null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity == null || !user.Identity.IsAuthenticated)
            throw new InvalidOperationException("User is not authenticated.");

        var url =
            $"{ApiConfig.ApiBaseUrl}api/ComposeFinalCommercialVideo" +
            "?code=REDACTED_FOR_GROOMING";

        var payload = new
        {
            videoId = VideoIdGuid ?? VideoId ?? string.Empty,
            sceneVideoUrls = renderedVideos,
            projectId = _commercialProjectId,
            generationJobId = _commercialGenerationJobId,
            sceneDescriptions = _sceneScriptsCamera,
            narrationAudioUrls,
            musicUrl,
            musicVolume = 0.16,
            outputFileName = $"{VideoIdGuid ?? VideoId ?? Guid.NewGuid().ToString()}.mp4"
        };

        using var content = new StringContent(
            System.Text.Json.JsonSerializer.Serialize(payload),
            Encoding.UTF8,
            "application/json");

        using var client = new HttpClient
            {
                Timeout = TimeSpan.FromMinutes(10)
            };

        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (!string.IsNullOrWhiteSpace(token))
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        using var response = await client.PostAsync(url, content);
        var responseBody = await response.Content.ReadAsStringAsync();

        if (!response.IsSuccessStatusCode)
        {
            Console.WriteLine(
                $"❌ Final video composition failed. " +
                $"Status: {response.StatusCode}. Response: {responseBody}");

            throw new InvalidOperationException(
                "Final video composition failed.");
        }

        var result = System.Text.Json.JsonSerializer.Deserialize<ComposeCommercialResult>(
            responseBody,
            new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

        return result?.VideoUrl;
    }

