    private static Dictionary<string, int> SaveAudioSampleCallCount = new();

    private async Task<AudioSampleSaveResponse?> SaveAudioSampleAsync(AudioSampleRequest request)
    {
        // Initialize counter for this VideoId
        if (!SaveAudioSampleCallCount.ContainsKey(request.VideoId))
            SaveAudioSampleCallCount[request.VideoId] = 0;

        // BLOCK if 6 or more calls already made
        if (SaveAudioSampleCallCount[request.VideoId] >= 6)
        {
            Console.WriteLine($"⛔ Blocked SaveAudioSample call: limit reached for VideoId={request.VideoId}");
            return null;
        }

        // Increment count BEFORE making request
        SaveAudioSampleCallCount[request.VideoId]++;
        Console.WriteLine(
            $"🔥 SaveAudioSampleAsync CALLED ({SaveAudioSampleCallCount[request.VideoId]}/6) for VideoId={request.VideoId}");

        try
        {
            HttpClient client = new HttpClient();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var url =
                    $"{ApiConfig.ApiBaseUrl}api/SaveAudioSample" +
                    "?code=REDACTED_FOR_GROOMING";

                var response = await client.PostAsJsonAsync(url, request);

                if (response.IsSuccessStatusCode)
                {
                    return await response.Content.ReadFromJsonAsync<AudioSampleSaveResponse>();
                }
            }

            return null;
        }
        catch
        {
            return null;
        }
    }

