@inherits DesignMode.AI.Client.Components.GenerationAwareComponent
@using System.Collections.Generic
@using DesignMode.AI.Shared.Models
@using DesignMode.AI.Client.Services
@using Microsoft.AspNetCore.Components;
@using Microsoft.AspNetCore.Components.Authorization;
@using System.Text;
@using Microsoft.JSInterop;
@using System.Text.RegularExpressions;
@using System.Net;
@using System.Text.RegularExpressions;
@using System.Text.Json;
@using Newtonsoft.Json;
@using System.Text.Json.Serialization;
@using System.Net.Http.Headers
@inject ModalService ModalService
@inject IJSRuntime JSRuntime
@inject AttributionContextService AttributionContext
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject AIUsageRefreshService UsageRefresh

@if (IsBusy)
{
    <div class="mvsi-busy-overlay">
        <div class="mvsi-loader"></div>
        <div class="mvsi-loading-text">Generating commercial scenes...</div>
    </div>
}

@if (Show)
{
    var arrangedImages = new List<Gen.ImageIdeaModel>();
    <div class="mvsi-overlay generation-workspace-overlay" @onclick="CloseModal">
        <div class="mvsi-wrapper generation-workspace" @onclick:stopPropagation>
            <button class="modal-close" disabled="@(GenerationGuard is null && _isFinalizing)" @onclick="CloseModal" title="@(_isFinalizing ? "Video finalization is in progress" : "Close")">×</button>

            <div class="mvsi-scroll">
                @if (_isFinalizing)
                {
                    <!-- FINALIZATION PROGRESS -->
                    <div class="mvsi-finalize-state">
                        <div class="mvsi-finalize-icon-wrap">
                            <div class="mvsi-finalize-spinner"></div>
                        </div>

                        <h2 class="mvsi-finalize-title">Building Your Commercial</h2>
                        <p class="mvsi-finalize-description">
                            Keep this window open while the scene videos, narration, background music, and final video are prepared.
                        </p>

                        <div class="mvsi-finalize-progress-card">
                            <div class="mvsi-finalize-progress-header">
                                <span>@_finalizeStatus</span>
                                <strong>@_finalizeProgressPercent%</strong>
                            </div>

                            <div class="mvsi-finalize-progress-track"
                                 role="progressbar"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 aria-valuenow="@_finalizeProgressPercent">
                                <div class="mvsi-finalize-progress-fill"
                                     style="width: @_finalizeProgressPercent%;"></div>
                            </div>

                            @if (_currentFinalizingScene > 0 && _currentFinalizingScene <= 6)
                            {
                                <div class="mvsi-finalize-scene-status">
                                    <span>Scene @_currentFinalizingScene of 6</span>
                                    <span class="mvsi-finalize-dot">•</span>
                                    <span>@GetFinalizePhaseLabel()</span>
                                </div>
                            }
                        </div>

                        <div class="mvsi-finalize-steps">
                            <div class="mvsi-finalize-step @GetFinalizeStepClass(1)">
                                <span class="mvsi-finalize-step-number">1</span>
                                <span>Prepare</span>
                            </div>
                            <div class="mvsi-finalize-step-line @GetFinalizeStepLineClass(1)"></div>
                            <div class="mvsi-finalize-step @GetFinalizeStepClass(2)">
                                <span class="mvsi-finalize-step-number">2</span>
                                <span>Render scenes</span>
                            </div>
                            <div class="mvsi-finalize-step-line @GetFinalizeStepLineClass(2)"></div>
                            <div class="mvsi-finalize-step @GetFinalizeStepClass(3)">
                                <span class="mvsi-finalize-step-number">3</span>
                                <span>Mix audio</span>
                            </div>
                            <div class="mvsi-finalize-step-line @GetFinalizeStepLineClass(3)"></div>
                            <div class="mvsi-finalize-step @GetFinalizeStepClass(4)">
                                <span class="mvsi-finalize-step-number">4</span>
                                <span>Complete</span>
                            </div>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_finalVideoUrl))
                {
                    <!-- FINAL VIDEO PLAYER -->
                    <div class="mvsi-final-video-section">
                        <div class="mvsi-final-video-success-icon">✓</div>
                        <h2 class="mvsi-final-video-title">Your Commercial Is Ready</h2>
                        <p class="mvsi-final-video-description">
                            Your scenes, narration, and background music have been combined into the final video.
                        </p>

                        <div class="mvsi-final-video-player-wrap">
                            <video class="mvsi-final-video-player"
                                   src="@_finalVideoUrl"
                                   controls
                                   preload="metadata"
                                   playsinline>
                                Your browser does not support HTML5 video.
                            </video>
                        </div>

                        <div class="mvsi-final-video-actions">
                            <a class="mvsi-final-video-open"
                               href="@_finalVideoUrl"
                               target="_blank"
                               rel="noopener noreferrer">
                                Open Video
                            </a>
                            <button type="button"
                                    class="mvsi-final-video-done"
                                    @onclick="CloseModal">
                                Done
                            </button>
                        </div>
                    </div>
                }
                else if (_finalizationFailed)
                {
                    <!-- FINALIZATION ERROR -->
                    <div class="mvsi-finalize-state mvsi-finalize-error-state">
                        <div class="mvsi-finalize-error-icon">!</div>
                        <h2 class="mvsi-finalize-title">Video Finalization Failed</h2>
                        <p class="mvsi-finalize-description">
                            @_finalizeErrorMessage
                        </p>
                        <div class="mvsi-finalize-error-actions">
                            <button type="button" class="mvsi-btn-secondary" @onclick="GoBackToCustomizationAfterFinalizeError">
                                Back to Customize
                            </button>
                            <button type="button" class="save-button mvsi-save" @onclick="FinalizeVideo">
                                Try Again
                            </button>
                        </div>
                    </div>
                }
                else if (!_showScriptSection && !_showCustomizationSection)
                {
                    <!-- STEP 1: Image Selection -->
                    <div class="mvsi-header">
                        <h2>Generate Commercial</h2>
                        <p class="mvsi-pick-text">Step 1: Pick images to inspire each scene of your commercial</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_scenePersistenceWarning))
                    {
                        <div class="mvsi-scene-persistence-warning">
                            <strong>Scene save is still syncing.</strong>
                            <span>@_scenePersistenceWarning</span>
                        </div>
                    }

                    @if (SelectedImages != null && SelectedImages.Any())
                    {
                        // Define the special subcategories (in order)
                        var categorySets = CategorySets;

                        var normalScenes = new List<IGrouping<string, Gen.ImageIdeaModel>>();

                        // Keep track of already selected images
                        var selectedImages = new HashSet<Gen.ImageIdeaModel>();

                        foreach (var categories in categorySets)
                        {
                            // Extract data from the array
                            var categoryName = categories[0];
                            var numberValue = categories[1];
                            var idValue = categories[2];

                            var scenes = SelectedImages
                            .Where(img => img.Id == idValue
                            && !selectedImages.Contains(img)) // exclude already used
                            .GroupBy(img => img.SubCategory)
                            .OrderBy(g => g.Key)
                            .Take(1)
                            .ToList();

                            // Add selected images to tracking set
                            foreach (var img in scenes.SelectMany(g => g))
                                selectedImages.Add(img);

                            // Add this group to the combined list
                            normalScenes.AddRange(scenes);
                        }

                        var sceneIndex = 1;
                        var sel = SelectedImages.ToList();
                        if (GenerateNew)
                        {
                            // Row 1: first "video"
                            var video1 = sel.FirstOrDefault(i => i.SubCategory?.ToLower().Contains("video") == true || i.DeliverableType?.ToLower().Contains("video") == true);
                            if (video1 != null)
                            {
                                arrangedImages.Add(video1);
                                sel.Remove(video1);
                            }

                            // Row 2: random
                            if (sel.Any())
                            {
                                var random1 = sel.First();
                                arrangedImages.Add(random1);
                                sel.Remove(random1);
                            }

                            // Row 3: second "video"
                            var video2 = sel.FirstOrDefault(i => i.SubCategory?.ToLower().Contains("video") == true || i.DeliverableType?.ToLower().Contains("video") == true);
                            if (video2 != null)
                            {
                                arrangedImages.Add(video2);
                                sel.Remove(video2);
                            }

                            // Rows 4 and 5: random
                            for (int r = 0; r < 2 && sel.Any(); r++)
                            {
                                arrangedImages.Add(sel.First());
                                sel.RemoveAt(0);
                            }

                            // Row 6: logo or branding
                            var logoBranding = sel.FirstOrDefault(i => i.SubCategory?.ToLower().Contains("logo") == true
                            || i.SubCategory?.ToLower().Contains("branding") == true
                            || i.DeliverableType?.ToLower().Contains("logo") == true
                            || i.DeliverableType?.ToLower().Contains("branding") == true);
                            if (logoBranding != null)
                            {
                                arrangedImages.Add(logoBranding);
                                sel.Remove(logoBranding);
                            }
                        }
                        // Fill up to 6 rows if still less
                        arrangedImages.AddRange(sel.Take(6 - arrangedImages.Count));

                        // Step 1: Build a list of initial recommended images
                        var recommendedImages = arrangedImages.Take(6).ToList();
                        if (GenerateNew)
                        {
                            ArrangedImages = arrangedImages;
                        }
                        else
                        {
                            ArrangedImages = OrderedImages;
                        }
                        SceneSelections.Clear();
                        @if (!IsBusy)
                        {
                            @foreach (var img in (GenerateNew ? arrangedImages.Take(6) : OrderedImages.Take(6)))
                            {
                                var sceneKey = BuildSceneKey(img.SubCategory, img.CountId);
                                var mainImage = GetMainImage(sceneKey);

                                // ✅ Capture the correct scene number for this iteration
                                var currentSceneNumber = sceneIndex;


                                // Step 2: Check if the current mainImage matches any initially recommended image
                                var isRecommended = recommendedImages.Any(r =>
                                r.SubCategory == img.SubCategory &&
                                r.CountId == img.CountId &&
                                r.ImageUrl == mainImage
                                );

                                <div class="mvsi-scene">
                                    <h3 class="mvsi-scene-title">Scene @sceneIndex</h3>

                                    <div class="mvsi-section">
                                        <div class="mvsi-row">
                                            <div class="mvsi-main">
                                                <div class="mvsi-main-wrapper @(isRecommended ? "mvsi-recommended" : "")">
                                                    <img src="@mainImage" alt="Main scene image" class="mvsi-main-img" />
                                                </div>
                                                @if (isRecommended)
                                                {
                                                    <div class="mvsi-recommended-label">Recommended</div>
                                                }
                                            </div>

                                            <div class="mvsi-selection">
                                                <div class="mvsi-choose-label">Choose an Image</div>

                                                <div class="mvsi-carousel-container">
                                                    <button class="mvsi-carousel-btn mvsi-carousel-prev"
                                                            @onclick="() => NavigateCarousel(sceneKey, -1)"
                                                            disabled="@IsPrevDisabled(sceneKey)">
                                                        <span style="margin-bottom: 6px;font-size: 25px;margin-right: 1px;">‹</span>
                                                    </button>

                                                    <div class="mvsi-options">
                                                        @foreach (var alt in GetVisibleAlternatives(sceneKey))
                                                        {
                                                            <div class="mvsi-option mvsi-alt @(SelectedImageUrls.Contains(alt.ImageUrl) ? "mvsi-selected" : "")"
                                                                 title="@($"{alt.SubCategory} — {alt.DeliverableType}")"
                                                                 @onclick="async () =>
{
    ToggleSelection(alt.ImageUrl, alt.Id, currentSceneNumber);
    SetMainImage(sceneKey, alt.ImageUrl);

    // Find selected image Id
    var selectedImageId = alt.Id;
    var videoId = VideoIdGuid ?? string.Empty;

    if (!string.IsNullOrWhiteSpace(selectedImageId) &&
        !string.IsNullOrWhiteSpace(videoId))
    {
        await UpdateMainImageForSceneAsync(videoId, currentSceneNumber.ToString(), selectedImageId);

        // 🔥 Track that this scene has changed
        _changedScenes.Add(currentSceneNumber);

        // Update SceneSelections with the new image
        var existingSelection = SceneSelections.FirstOrDefault(s => s.Scene == currentSceneNumber.ToString());
                        if (existingSelection != null)
                        {
                            existingSelection.ImageId = selectedImageId;
                        }
                    }

                    // Recalculate missing scripts count
                    _missingScriptsCount = await GetMissingScriptsCountAsync();
                    StateHasChanged();
}">
                                                                <img src="@alt.ImageUrl" alt="Alt option" />
                                                            </div>
                                                        }
                                                    </div>

                                                    <button class="mvsi-carousel-btn mvsi-carousel-next"
                                                            @onclick="() => NavigateCarousel(sceneKey, 1)"
                                                            disabled="@IsNextDisabled(sceneKey)">
                                                        <span style="margin-bottom: 6px;font-size: 25px;margin-left: 0px;">›</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                var mainImageId = SelectedImages.FirstOrDefault(img => img.ImageUrl == mainImage)?.Id;
                                if (mainImageId != "")
                                {
                                    // Use null-safe access for PromptId and other fields
                                    var promptId = AllIdeas?.PromptId ?? AllIdeasGet?.PromptId ?? string.Empty;
                                    var request = new VideoImageRequest
                                    {
                                        ImageId = mainImageId ?? string.Empty,
                                        Scene = sceneIndex.ToString(),
                                        TimeStamp = DateTime.UtcNow.ToString("o"),
                                        PromptId = promptId,
                                        VideoId = VideoIdGuid ?? string.Empty,
                                        Script = string.Empty
                                    };

                                    // Only add if we actually have an ImageId
                                    if (!string.IsNullOrWhiteSpace(request.ImageId))
                                    {
                                        SceneSelections.Add(request);
                                    }

                                }
                                sceneIndex++;
                            }
                        }
                    }
                    else
                    {
                        <div class="mvsi-empty">
                            <p>No images available.</p>
                        </div>
                    }
                }
                else if (_showScriptSection && !_showCustomizationSection)
                {
                    <!-- Lock overlay when generating scripts -->
                    @if (_scriptGenerating)
                    {
                        <div class="mvsi-busy-overlay mvsi-script-generating-overlay">
                            <div class="mvsi-loader"></div>
                            <div class="mvsi-loading-text">
                                Generating scripts... @(_currentGeneratingScene > 0 ? $"({_currentGeneratingScene}/6)" : "")
                            </div>
                        </div>
                    }

                    <!-- STEP 2: Script Generation -->
                    <div class="mvsi-header">
                        <h2>Generate Commercial Script</h2>
                        <p class="mvsi-pick-text">
                            Step 2:
                            @if (_sceneScriptsPlain == null ||
                           !_sceneScriptsPlain.Any() ||
                           _sceneScriptsPlain.All(s => string.IsNullOrWhiteSpace(s)))
                            {
                                <span>
                                    Generating scripts...
                                    <span class="cart-count pulse">
                                        <img src="images/270-ring-with-bg.svg"
                                             alt="loading spinner"
                                             style="width: 18px; margin-bottom: 5px;" />
                                    </span>
                                </span>
                            }
                            else
                            {
                                <span>Customize and finalize your commercial script</span>
                            }
                        </p>
                    </div>

                    <div class="mvsi-script-section" style="margin-top: 0px;">
                        <!-- Always use SceneSelections first (what user selected in Step 1) -->
                        @if (SceneSelections != null && SceneSelections.Any())
                        {
                            // Sort by scene number
                            var sortedSelections = SceneSelections
                            .Where(s => !string.IsNullOrWhiteSpace(s.Scene))
                            .OrderBy(s => int.Parse(s.Scene))
                            .Take(6)
                            .ToList();

                            @for (int i = 0; i < sortedSelections.Count; i++)
                            {
                                var sceneNumber = i + 1;
                                var selection = sortedSelections[i];

                                // Find the image from SelectedImages
                                var imageDetail = SelectedImages?.FirstOrDefault(img => img.Id == selection.ImageId);
                                var imageUrl = imageDetail?.ImageUrl ?? "";

                                <div class="mvsi-scene">
                                    <h3 class="mvsi-scene-title">Scene @sceneNumber</h3>

                                    <div class="mvsi-section">
                                        <div class="mvsi-row">
                                            <div class="mvsi-main">
                                                <div class="mvsi-main-wrapper">
                                                    <img src="@imageUrl"
                                                         alt="Main scene image"
                                                         class="mvsi-main-img" />
                                                </div>
                                            </div>

                                            <div class="mvsi-selection">
                                                @if (_sceneScriptsPlain == null ||
                                               _sceneScriptsPlain.Count <= i ||
                                               string.IsNullOrWhiteSpace(_sceneScriptsPlain[i]))
                                                {
                                                    <div class="mvsi-options" style="margin-left: 250px; margin-top: 24px;">
                                                        <div class="spinner-container">
                                                            @if (_currentGeneratingScene >= sceneNumber)
                                                            {
                                                                <div class="loading-spinner"></div>
                                                                <span style="color: #666; font-size: 14px;margin-top: -15px;margin-left: 3px;">
                                                                    Generating script...
                                                                </span>
                                                            }
                                                            else if (_currentGeneratingScene == sceneNumber - 1)
                                                            {
                                                                <div class="loading-spinner" style="border-top-color: #3b82f6;"></div>
                                                                <span style="color: #3b82f6; font-weight: 500; font-size: 14px;margin-top: -15px;margin-left: 3px;">
                                                                    Currently generating...
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <div class="loading-spinner" style="border-color: #e5e7eb;"></div>
                                                                <span style="color: #999; font-size: 14px;margin-top: -15px;margin-left: 3px;">
                                                                    Waiting...
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="mvsi-options" style="margin-top: -38px;">
                                                        <div class="spinner-container">
                                                            @_sceneScriptsPlain[i]
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else if (_savedImagesForScript != null && _savedImagesForScript.Any())
                        {
                            <!-- Fallback to saved images if SceneSelections not available -->
                            var sortedImages = _savedImagesForScript.OrderBy(x => int.Parse(x.Scene)).ToList();

                            @for (int i = 0; i < Math.Min(6, sortedImages.Count); i++)
                            {
                                var sceneNumber = i + 1;
                                var savedImage = sortedImages[i];

                                // Find the corresponding image details from SelectedImages
                                var imageDetail = SelectedImages?.FirstOrDefault(img => img.Id == savedImage.ImageId);
                                var imageUrl = imageDetail?.ImageUrl ?? savedImage.ImageUrl;

                                <div class="mvsi-scene">
                                    <h3 class="mvsi-scene-title">Scene @sceneNumber</h3>

                                    <div class="mvsi-section">
                                        <div class="mvsi-row">
                                            <div class="mvsi-main">
                                                <div class="mvsi-main-wrapper">
                                                    <img src="@imageUrl"
                                                         alt="Main scene image"
                                                         class="mvsi-main-img" />
                                                </div>
                                            </div>

                                            <div class="mvsi-selection">
                                                @if (_sceneScriptsPlain == null ||
                                               _sceneScriptsPlain.Count <= i ||
                                               string.IsNullOrWhiteSpace(_sceneScriptsPlain[i]))
                                                {
                                                    <div class="mvsi-options" style="margin-left: 250px; margin-top: 24px;">
                                                        <div class="spinner-container">
                                                            @if (_currentGeneratingScene >= sceneNumber)
                                                            {
                                                                <div class="loading-spinner"></div>
                                                                <span style="color: #666; font-size: 14px;">
                                                                    Generating script...
                                                                </span>
                                                            }
                                                            else if (_currentGeneratingScene == sceneNumber - 1)
                                                            {
                                                                <div class="loading-spinner" style="border-top-color: #3b82f6;"></div>
                                                                <span style="color: #3b82f6; font-weight: 500; font-size: 14px;">
                                                                    Currently generating...
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <div class="loading-spinner" style="border-color: #e5e7eb;"></div>
                                                                <span style="color: #999; font-size: 14px;">
                                                                    Waiting...
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="mvsi-options" style="margin-top: -38px;">
                                                        <div class="spinner-container">
                                                            @_sceneScriptsPlain[i]
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Final fallback: Use ArrangedImages -->
                            @for (int i = 0; i < 6; i++)
                            {
                                var sceneNumber = i + 1;
                                <div class="mvsi-scene">
                                    <h3 class="mvsi-scene-title">Scene @sceneNumber</h3>

                                    <div class="mvsi-section">
                                        <div class="mvsi-row">
                                            <div class="mvsi-main">
                                                <div class="mvsi-main-wrapper">
                                                    <img src="@(ArrangedImages.Count > i ? ArrangedImages[i].ImageUrl : "")"
                                                         alt="Main scene image"
                                                         class="mvsi-main-img" />
                                                </div>
                                            </div>

                                            <div class="mvsi-selection">
                                                @if (_sceneScriptsPlain == null ||
                                               _sceneScriptsPlain.Count <= i ||
                                               string.IsNullOrWhiteSpace(_sceneScriptsPlain[i]))
                                                {
                                                    <div class="mvsi-options" style="margin-left: 250px; margin-top: 24px;">
                                                        <div class="spinner-container">
                                                            @if (_currentGeneratingScene >= sceneNumber)
                                                            {
                                                                <div class="loading-spinner"></div>
                                                                <span style="color: #666; font-size: 14px;">
                                                                    Generating script...
                                                                </span>
                                                            }
                                                            else if (_currentGeneratingScene == sceneNumber - 1)
                                                            {
                                                                <div class="loading-spinner" style="border-top-color: #3b82f6;"></div>
                                                                <span style="color: #3b82f6; font-weight: 500; font-size: 14px;">
                                                                    Currently generating...
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <div class="loading-spinner" style="border-color: #e5e7eb;"></div>
                                                                <span style="color: #999; font-size: 14px;">
                                                                    Waiting...
                                                                </span>
                                                            }
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="mvsi-options" style="margin-top: -38px;">
                                                        <div class="spinner-container">
                                                            @_sceneScriptsPlain[i]
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
                else if (_showCustomizationSection)
                {
                    <!-- STEP 3: Video Customization -->
                    <div class="mvsi-header">
                        <h2>Customize Your Video</h2>
                        <p class="mvsi-pick-text">Step 3: Select video aspect ratio, voice, and background music</p>
                    </div>

                    <div class="mvsi-customization-section" style="margin-top: 20px;">
                        <div class="mvsi-customization-grid">

                            <!-- Aspect Ratio Selection -->
                            <div class="mvsi-customization-card">
                                <h3 class="mvsi-customization-title">Aspect Ratio</h3>
                                <p class="mvsi-customization-description">Choose the dimensions for your video</p>
                                <div class="mvsi-option-grid">
                                    @foreach (var ratio in _aspectRatios)
                                    {
                                        <div class="mvsi-customization-option @(_selectedAspectRatio == ratio ? "mvsi-customization-selected" : "")"
                                             @onclick="async () => {
                            _selectedAspectRatio = ratio;
                            await UpdateAllScenesWithCurrentSettings();
                        }">
                                            <div class="mvsi-ratio-preview" data-ratio="@ratio">
                                                <div class="mvsi-ratio-inner"></div>
                                            </div>
                                            <span class="mvsi-option-label">@ratio</span>
                                            @if (ratio == "16:9")
                                            {
                                                @* <span class="mvsi-recommended-tag">Recommended</span> *@
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- AI-Generated Voice-Over Script -->
                            @if (!string.IsNullOrWhiteSpace(_aiVoiceOverScript))
                            {
                                <div class="mvsi-customization-card">
                                    <h3 class="mvsi-customization-title">Suggested Voice-Over Script</h3>
                                    <p class="mvsi-customization-description">
                                        This is a generated script for your commercial.
                                    </p>

                                    <!-- Audio Playback Section -->
                                    <div class="mvsi-audio-section" style="margin-bottom: 20px;">
                                        <div class="mvsi-audio-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                            <h4 style="margin: 0; font-size: 16px; font-weight: 600;">@CurrentVoiceDisplayName Narration Preview</h4>
                                            <audio id="narrationAudio" style="display: none;"></audio>
