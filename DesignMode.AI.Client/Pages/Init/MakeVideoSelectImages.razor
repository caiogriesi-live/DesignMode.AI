    {
        await using var generationOperation = await BeginGenerationAsync();
        try
        {
            if (string.IsNullOrWhiteSpace(_aiVoiceOverScript))
                return;

            // Parse the AI script into scenes
            var scenes = ParseScenesFromVoiceOverScript(_aiVoiceOverScript);

            for (int i = 0; i < scenes.Count; i++)
            {
                var sceneText = scenes[i];
                if (!string.IsNullOrWhiteSpace(sceneText))
                {
                    // Send the selected xAI voice code directly to CallRunwareAudio.
                    string voice = _voices.Contains(_selectedVoice)
                        ? _selectedVoice
                        : "eve";

                    var audioUrl = await GenerateAudioForTextAsync(sceneText, voice, i + 1);

                    if (!string.IsNullOrEmpty(audioUrl))
                    {
                        await SaveAudioSampleAsync(new AudioSampleRequest
                            {
                                VideoId = VideoIdGuid ?? string.Empty,
                                Text = sceneText,
                                Url = audioUrl,
                                VoiceOverActor = _selectedVoice,
                                TimeStamp = DateTime.UtcNow.ToString("o")
                            });

                        Console.WriteLine($"✅ Saved audio sample for scene {i + 1}");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error generating audio samples: {ex.Message}");
        }
    }

    private List<string> ParseScenesFromVoiceOverScript(string script)
    {
        var scenes = new List<string>();

        if (string.IsNullOrWhiteSpace(script))
            return scenes;

        // Remove HTML tags
        var plainText = RemoveBoldTags(script);

        // Split by scene markers
        var scenePattern = @"Scene\s+\d+\s*[:.\-]?\s*";
        var parts = Regex.Split(plainText, scenePattern, RegexOptions.IgnoreCase);

        // Skip the first element (text before first scene marker)
        for (int i = 1; i < parts.Length && i <= 6; i++)
        {
            scenes.Add(parts[i].Trim());
        }

        return scenes;
    }

    private async Task UpdateAllScenesWithCurrentSettings()
    {
        try
        {
            var effectiveVideoId = VideoIdGuid ?? VideoId ?? string.Empty;
            if (string.IsNullOrWhiteSpace(effectiveVideoId))
            {
                Console.WriteLine("⚠️ Cannot update scene settings because VideoId is empty.");
                return;
            }

            var videoImages = await GetVideoImagesAsync(effectiveVideoId);

            if (videoImages != null && videoImages.Any())
            {
                foreach (var videoImage in videoImages
                    .Where(x => int.TryParse(x.Scene, out var n) && n >= 1 && n <= 6)
                    .GroupBy(x => x.Scene)
                    .Select(g => g.First())
                    .OrderBy(x => int.Parse(x.Scene)))
                {
                    await UpdateVideoImageAudioAndResolutionAsync(
                        videoId: effectiveVideoId,
                        scene: videoImage.Scene,
                        resolution: _selectedAspectRatio,
                        voiceOverScript: _aiVoiceOverScript ?? string.Empty,
                        voiceOverActor: _selectedVoice,
                        backgroundMusic: _selectedMusic
                    );
                }

                Console.WriteLine($"✅ Updated all scenes with current settings: {_selectedAspectRatio}, {_selectedVoice}, {_selectedMusic}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error updating all scenes: {ex.Message}");
        }
    }

    private async Task LoadExistingCustomizationSettings()
    {
        try
        {
            // Check if we have any existing video images with customization
            var videoImages = await GetVideoImagesAsync(VideoIdGuid);

            if (videoImages != null && videoImages.Any())
            {
                // Take the first scene to get existing settings
                var firstScene = videoImages.FirstOrDefault();
                if (firstScene != null)
                {
                    // If you have stored these values in the video images table
                    if (!string.IsNullOrWhiteSpace(firstScene.Resolution))
                    {
                        _selectedAspectRatio = firstScene.Resolution;
                    }

                    if (!string.IsNullOrWhiteSpace(firstScene.VoiceOverActor) &&
                        _voices.Contains(firstScene.VoiceOverActor.ToLowerInvariant()))
                    {
                        _selectedVoice = firstScene.VoiceOverActor.ToLowerInvariant();
                    }
                    else
                    {
                        // Older records may contain Azure/ElevenLabs voice names.
                        // Those are no longer valid for xAI TTS.
                        _selectedVoice = "eve";
                    }

                    if (!string.IsNullOrWhiteSpace(firstScene.BackgroundMusic))
                    {
                        _selectedMusic = firstScene.BackgroundMusic;
                    }

                    // Only set voice-over script if we haven't already loaded it
                    if (!string.IsNullOrWhiteSpace(firstScene.VoiceOverScript) &&
                        string.IsNullOrWhiteSpace(_aiVoiceOverScript))
                    {
                        _aiVoiceOverScript = firstScene.VoiceOverScript;
                    }

                    Console.WriteLine($"✅ Loaded existing settings: {_selectedAspectRatio}, {_selectedVoice}, {_selectedMusic}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading existing customization settings: {ex.Message}");
        }
    }

