                                </div>
                            </div>

                        </div>
                    </div>

                }
            </div>
            <!-- Actions stay inside the workspace, outside the independently scrolling body. -->
            <!-- Footer for Image Selection Section -->
            @if (!_showScriptSection && !_showCustomizationSection && string.IsNullOrWhiteSpace(_finalVideoUrl))
            {
                <div class="mvsi-footer footer-actions">
                    <button class="discard-button" @onclick="CloseModal">
                        Discard
                    </button>
                    <button class="save-button mvsi-save @(_missingScriptsCount > 0 ? "with-missing" : "")"
                            @onclick="GenerateScript">
                        <div class="mvsi-save-content">
                            <span>Next: Generate Script</span>
                            @if (_missingScriptsCount > 0)
                            {
                                <span class="missing-count-badge">@_missingScriptsCount pending</span>
                            }
                            <span class="mvsi-arrow">➤</span>
                        </div>
                    </button>
                </div>
            }

            <!-- Footer for Script Section -->
            @if (_showScriptSection && !_showCustomizationSection)
            {
                <div class="mvsi-footer footer-actions">
                    <button class="discard-button" @onclick="GoBackToImages" disabled="@_scriptGenerating">
                        ← Back to Images
                    </button>

                    <button class="save-button mvsi-save"
                            @onclick="GoToCustomization"
                            disabled="@(_scriptGenerating || _sceneScriptsPlain == null ||
        !_sceneScriptsPlain.Any() ||
        _sceneScriptsPlain.All(s => string.IsNullOrWhiteSpace(s)))">
                        @if (_scriptGenerating)
                        {
                            <span>
                                <div class="spinner" style="display: inline-block; margin-right: 8px;"></div>
                                Generating...
                            </span>
                        }
                        else if (_sceneScriptsPlain == null ||
                        !_sceneScriptsPlain.Any() ||
                        _sceneScriptsPlain.All(s => string.IsNullOrWhiteSpace(s)))
                        {
                            <span>
                                <div class="spinner"></div>
                            </span>
                        }
                        else
                        {
                            <span>
                                Next: Customize Video
                                <span style="margin-left: 15px;">➤</span>
                            </span>
                        }
                    </button>
                </div>
            }

            <!-- Footer for Customization Section -->
            @if (_showCustomizationSection &&
           !_isFinalizing &&
           string.IsNullOrWhiteSpace(_finalVideoUrl) &&
           !_finalizationFailed)
            {
                <div class="mvsi-footer footer-actions">
                    <button class="discard-button" @onclick="GoBackToScripts" disabled="@_isFinalizing">
