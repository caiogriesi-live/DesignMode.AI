    private async Task<string> GetExistingVoiceOverScriptAsync(string videoId)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(videoId))
                return string.Empty;

            // Get video images to check for existing voice-over script
            var videoImages = await GetVideoImagesAsync(videoId);

            if (videoImages != null && videoImages.Any())
            {
                // Check any scene for existing voice-over script
                var firstSceneWithScript = videoImages.FirstOrDefault(v =>
                    !string.IsNullOrWhiteSpace(v.VoiceOverScript) &&
                    !v.VoiceOverScript.Contains("Error", StringComparison.OrdinalIgnoreCase) &&
                    !v.VoiceOverScript.Contains("generating", StringComparison.OrdinalIgnoreCase) &&
                    !v.VoiceOverScript.Contains("loading", StringComparison.OrdinalIgnoreCase));

                if (firstSceneWithScript != null)
                {
                    Console.WriteLine($"✅ Found existing voice-over script in scene {firstSceneWithScript.Scene}");
                    return firstSceneWithScript.VoiceOverScript;
                }

                // Also check the promptId-based voice-over storage
                var promptId = AllIdeas?.PromptId ?? AllIdeasGet?.PromptId ?? string.Empty;
                if (!string.IsNullOrWhiteSpace(promptId))
                {
                    var promptBasedScript = await GetVoiceOverScriptByPromptIdAsync(promptId, videoId);
                    if (!string.IsNullOrWhiteSpace(promptBasedScript))
                    {
                        Console.WriteLine("✅ Found voice-over script by promptId");
                        return promptBasedScript;
                    }
                }
            }

            Console.WriteLine("ℹ️ No existing voice-over script found in database");
            return string.Empty;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error checking for existing voice-over script: {ex.Message}");
            return string.Empty;
        }
    }

    private async Task<string> GetVoiceOverScriptByPromptIdAsync(string promptId, string videoId)
    {
        try
        {
            HttpClient client = new HttpClient();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var url =
                    $"{ApiConfig.ApiBaseUrl}api/GetVoiceOverScriptByPromptIdAndVideoId" +
                    $"?promptId={Uri.EscapeDataString(promptId)}" +
                    $"&videoId={Uri.EscapeDataString(videoId)}" +
                    "&code=REDACTED_FOR_GROOMING";

                var response = await client.GetAsync(url);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadAsStringAsync();
                    if (!string.IsNullOrWhiteSpace(result) && result != "null")
                    {
                        return result.Trim('"');
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error getting voice-over script by promptId: {ex.Message}");
        }

        return string.Empty;
    }

    private async Task SaveVoiceOverScriptToDatabaseAsync(string videoId, string voiceOverScript)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(videoId) || string.IsNullOrWhiteSpace(voiceOverScript))
                return;

            HttpClient client = new HttpClient();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var url =
                    $"{ApiConfig.ApiBaseUrl}api/SaveVoiceOverScript" +
                    "?code=REDACTED_FOR_GROOMING";

                var request = new
                {
                    VideoId = videoId,
                    VoiceOverScript = voiceOverScript,
                    PromptId = AllIdeas?.PromptId ?? AllIdeasGet?.PromptId ?? string.Empty,
                    TimeStamp = DateTime.UtcNow.ToString("o")
                };

                var json = System.Text.Json.JsonSerializer.Serialize(request);
                var content = new StringContent(json, Encoding.UTF8, "application/json");

                var response = await client.PostAsync(url, content);

                if (response.IsSuccessStatusCode)
                {
                    Console.WriteLine("✅ Voice-over script saved to database");
                }
                else
                {
                    Console.WriteLine($"⚠️ Failed to save voice-over script: {response.StatusCode}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error saving voice-over script: {ex.Message}");
        }
    }

