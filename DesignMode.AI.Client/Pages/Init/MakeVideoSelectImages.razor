    // JavaScript functions to control the audio element
    function playAudioViaElement(audioUrl, dotNetHelper) {
        const audioElement = document.getElementById('narrationAudio');

        if (!audioElement) {
            console.error('Audio element not found');
            if (dotNetHelper) {
                dotNetHelper.invokeMethodAsync('OnAudioEnded', 0);
            }
            return;
        }

        // Set the audio source
        audioElement.src = audioUrl;

        // Set up event listeners
        audioElement.onended = function () {
            if (dotNetHelper) {
                dotNetHelper.invokeMethodAsync('OnAudioEnded', 0);
            }
        };

        audioElement.onerror = function () {
            console.error('Error playing audio');
            if (dotNetHelper) {
                dotNetHelper.invokeMethodAsync('OnAudioEnded', 0);
            }
        };

        // Play the audio
        audioElement.play().catch(error => {
            console.error('Error playing audio:', error);
            if (dotNetHelper) {
                dotNetHelper.invokeMethodAsync('OnAudioEnded', 0);
            }
        });
    }

    function stopAudioViaElement() {
        const audioElement = document.getElementById('narrationAudio');

        if (audioElement) {
            audioElement.pause();
            audioElement.currentTime = 0;
            audioElement.src = '';

            // Remove event listeners
            audioElement.onended = null;
            audioElement.onerror = null;
        }
    }

    // Background music preview functions.
    // These use the dedicated #musicPreviewAudio element so narration and
    // background-music previews do not share an audio element.
    function playMusicPreview(audioUrl, dotNetHelper) {
        const audioElement = document.getElementById('musicPreviewAudio');

        if (!audioElement) {
            console.error('Music preview audio element not found');
            if (dotNetHelper) {
                dotNetHelper.invokeMethodAsync('OnMusicPreviewEnded');
            }
            return;
        }

        audioElement.pause();
        audioElement.currentTime = 0;
        audioElement.src = audioUrl;
        audioElement.load();

        audioElement.onended = function () {
            if (dotNetHelper) {
                dotNetHelper.invokeMethodAsync('OnMusicPreviewEnded');
            }
        };

        audioElement.onerror = function () {
            console.error('Error loading music preview:', audioUrl);
            if (dotNetHelper) {
                dotNetHelper.invokeMethodAsync('OnMusicPreviewEnded');
            }
        };

        audioElement.play().catch(error => {
            console.error('Error playing music preview:', error);
            if (dotNetHelper) {
                dotNetHelper.invokeMethodAsync('OnMusicPreviewEnded');
            }
        });
    }

    function stopMusicPreview() {
        const audioElement = document.getElementById('musicPreviewAudio');

        if (audioElement) {
            audioElement.pause();
            audioElement.currentTime = 0;
            audioElement.removeAttribute('src');
            audioElement.load();
            audioElement.onended = null;
            audioElement.onerror = null;
        }
    }

    // Keep the old functions for compatibility (if needed elsewhere)
    function playAudioFromUrl(audioUrl, sceneNumber, dotNetHelper) {
        // This function can remain for other audio playback needs
        const audio = new Audio(audioUrl);

        audio.onended = function () {
            dotNetHelper.invokeMethodAsync('OnAudioEnded', sceneNumber);
        };

        audio.play().catch(error => {
            console.error('Error playing audio:', error);
            dotNetHelper.invokeMethodAsync('OnAudioEnded', sceneNumber);
        });

        return audio;
    }

    function stopAllAudio() {
        // Stop all dynamically created Audio objects
        // This doesn't affect the narrationAudio element
        // You might want to keep track of created Audio objects
    }
</script>

