    private async Task LoadExistingVideoImagesAsync()
    {
        if (string.IsNullOrWhiteSpace(VideoId))
            return;

        var saved = await GetVideoImagesAsync(VideoId);

        if (saved == null || saved.Count == 0)
        {
            Console.WriteLine("⚠️ No saved video images found.");
            return;
        }

        Console.WriteLine("🎬 Loading saved video image selections...");

        // Build scene -> image URL mapping
        MainImagesByScene.Clear();

        int i = 1;
        foreach (var v in saved.OrderBy(x => x.Scene))
        {
            string sceneKey = $"scene_{i}";
            MainImagesByScene[sceneKey] = v.ImageUrl;
            i++;
        }

        // Also populate carousel alternatives from ALL SelectedImages (so the user can still re-pick)
        AlternativesByScene = SelectedImages
            .GroupBy(img => BuildSceneKey(img.SubCategory, img.CountId))
            .ToDictionary(
                g => g.Key,
                g => g.OrderBy(x => Guid.NewGuid()).ToList()
            );

        // Preselect URLs
        SelectedImageUrls = new HashSet<string>(saved.Select(s => s.ImageId));
        SelectedImageIds = new HashSet<string>(saved.Select(s => s.ImageId));

        Console.WriteLine("🎬 Existing video images loaded into modal.");
    }
