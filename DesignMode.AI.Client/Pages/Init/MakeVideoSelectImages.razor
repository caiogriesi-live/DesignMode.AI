            }

            // 🔍 STEP 1: Check database for incomplete/missing scripts
            var missingScenes = await GetMissingScenesAsync(VideoId);
            Console.WriteLine($"🔍 Missing/incomplete scenes: {string.Join(", ", missingScenes)}");

            // Get saved video images from database
            var savedVideoImages = await GetVideoImagesAsync(VideoId);

            // Initialize _sceneScriptsPlain with empty strings for 6 scenes
            _sceneScriptsPlain = new List<string>(new string[6]);
            _sceneScriptsCamera = new List<string>(new string[6]);

            // Load existing scripts from database (if any)
            if (savedVideoImages != null && savedVideoImages.Any())
            {
                foreach (var savedImage in savedVideoImages.OrderBy(x => int.Parse(x.Scene)))
                {
                    if (int.TryParse(savedImage.Scene, out int sceneNum) &&
                        sceneNum >= 1 &&
                        sceneNum <= 6)
                    {
                        // Camera Script and ScriptPlain are independent fields.
                        // Always hydrate the camera prompt from VideoImages.Script
                        // when it exists, even if ScriptPlain is missing/incomplete.
                        if (!string.IsNullOrWhiteSpace(savedImage.Script))
                        {
                            _sceneScriptsCamera[sceneNum - 1] =
                                savedImage.Script;
                        }

                        if (!string.IsNullOrWhiteSpace(savedImage.ScriptPlain) &&
                            !IsScriptIncomplete(savedImage.ScriptPlain))
                        {
                            _sceneScriptsPlain[sceneNum - 1] =
                                savedImage.ScriptPlain;
                        }
                        else
                        {
                            _sceneScriptsPlain[sceneNum - 1] =
                                string.Empty;
                        }
                    }
                }
            }

            // Combine missing scenes with changed scenes
            var scenesToGenerate = new HashSet<int>(missingScenes);
            scenesToGenerate.UnionWith(_changedScenes);

            Console.WriteLine($"🔄 Scenes to generate: {string.Join(", ", scenesToGenerate)}");

            // If no scenes need generation, show existing scripts
            if (!scenesToGenerate.Any() && savedVideoImages != null && savedVideoImages.Any())
            {
                Console.WriteLine("✅ All scenes have complete scripts, skipping generation");
                _scriptGenerating = false;
                _currentGeneratingScene = 0;

                // Load the complete script from first scene or generate summary
                var completeScenes = savedVideoImages
                    .Where(v => !string.IsNullOrWhiteSpace(v.ScriptPlain))
                    .OrderBy(v => int.Parse(v.Scene))
                    .Select(v => v.ScriptPlain);

                if (completeScenes.Any())
                {
                    _aiGeneratedScript = string.Join("\n\n", completeScenes);
                    _editedScript = _aiGeneratedScript;
                }

                StateHasChanged();
                return;
            }

            var username = user.Identity?.Name;
            var uri = NavigationManager.Uri;
            var queryString = new Uri(uri).Query;
            string cid = GetQueryParameter(queryString, "cid", null);

            // Use the images from SceneSelections (what user selected in Step 1)
            var imagesToUse = SceneSelections?
                .Where(s => !string.IsNullOrWhiteSpace(s.Scene))
                .OrderBy(s => int.Parse(s.Scene))
                .Take(6)
                .ToList() ?? new List<VideoImageRequest>();

            // If we have scenes to generate, proceed with AI generation
            if (scenesToGenerate.Any())
            {
                Console.WriteLine($"🎬 Generating scripts for scenes: {string.Join(", ", scenesToGenerate)}");

                // Fetch prompt info
                var promptId = await FetchPromptIdSelect(username, cid);
                var promptText = await FetchPromptTextSelect(promptId);

                // Only generate base commercial script if we haven't already
                if (string.IsNullOrWhiteSpace(_aiGeneratedScript))
                {
                    _aiGeneratedScript = await GetAICommercialSentenceAsync(
                        CompanyName,
                        Industry,
                        promptText
                    );
                }

                var videoPrompts = await GetAIVideoPromptSequenceAsync(_aiGeneratedScript);

                if (string.IsNullOrEmpty(videoPrompts))
                {
                    _scriptGenerating = false;
                    StateHasChanged();
                    return;
                }

                ParseVideoPromptsIntoScenes(videoPrompts);

                // Generate scripts only for scenes that need it
                foreach (var sceneNumber in scenesToGenerate.OrderBy(x => x))
                {
                    if (sceneNumber < 1 || sceneNumber > 6)
                        continue;

                    _currentGeneratingScene = sceneNumber;
                    StateHasChanged();

                    // Find the image for this scene
                    var sceneSelection = imagesToUse.FirstOrDefault(s => s.Scene == sceneNumber.ToString());
                    if (sceneSelection == null)
                    {
                        Console.WriteLine($"⚠️ No image found for scene {sceneNumber}");
                        _sceneScriptsPlain[sceneNumber - 1] = "[No image selected]";
                        continue;
                    }

                    var imageDetail = SelectedImages.FirstOrDefault(img => img.Id == sceneSelection.ImageId);

                    if (imageDetail == null || string.IsNullOrWhiteSpace(imageDetail.ImageUrl))
                    {
                        Console.WriteLine($"⚠️ Invalid image for scene {sceneNumber}");
                        _sceneScriptsPlain[sceneNumber - 1] = "[Invalid image]";
                        continue;
                    }

                    Console.WriteLine($"🔄 Generating script for scene {sceneNumber}");

                    // Get image description
                    var imageDescription = await GetAIImageDescriptionAsync(imageDetail.ImageUrl);
                    if (string.IsNullOrWhiteSpace(imageDescription))
                    {
                        Console.WriteLine($"❌ Failed to get image description for scene {sceneNumber}");
                        _sceneScriptsPlain[sceneNumber - 1] = "[Failed to analyze image]";
                        continue;
                    }

                    // Regenerate scene from image
                    var updatedSceneDescription = await RegenerateSceneFromImageAsync(
                        $"The prompt is for a company named {CompanyName} in the {Industry} industry.",
                        sceneNumber,
                        imageDescription
                    );

                    if (string.IsNullOrWhiteSpace(updatedSceneDescription))
                    {
                        Console.WriteLine($"❌ Failed to regenerate scene {sceneNumber}");
                        _sceneScriptsPlain[sceneNumber - 1] = "[Failed to generate scene]";
                        continue;
                    }

                    // Get dialogue and plain script
                    var dialogue = await GetAISceneDialogueAsync(updatedSceneDescription);
                    var plainScript = await GetAISceneCameraDescriptionAsync(updatedSceneDescription);

                    // Keep both script collections synchronized.
                    //
                    // IMPORTANT:
                    // Video generation uses the full camera/motion scene prompt
                    // stored in VideoImages.Script. ScriptPlain is not used as
                    // the Runware video prompt.
                    _sceneScriptsPlain[sceneNumber - 1] =
                        plainScript ?? string.Empty;

                    if (_sceneScriptsCamera == null ||
                        _sceneScriptsCamera.Count != 6)
                    {
                        _sceneScriptsCamera =
                            new List<string>(new string[6]);
                    }

                    _sceneScriptsCamera[sceneNumber - 1] =
                        updatedSceneDescription ?? string.Empty;

                    // Save to DB
                    var success = await UpdateScriptByVideoIdAndSceneAsync(
                        videoId: VideoId,
                        scene: sceneNumber.ToString(),
                        script: updatedSceneDescription ?? string.Empty,
                        scriptPlain: plainScript ?? string.Empty,
                        scriptWithSpeech: dialogue ?? string.Empty
                    );

                    if (success)
                    {
                        Console.WriteLine($"✅ Saved script for scene {sceneNumber}");
                    }
                    else
                    {
                        Console.WriteLine($"⚠️ Failed to save script for scene {sceneNumber}");
                    }

                    // Force UI update after each scene
                    StateHasChanged();

                    // Small delay to prevent overwhelming the server
                    await Task.Delay(500);
                }
            }


            _generatedScript = _aiGeneratedScript;
            _editedScript = _aiGeneratedScript;
            _scriptGenerating = false;
            _currentGeneratingScene = 0;

            // Clear changed scenes after processing
            _changedScenes.Clear();

            // Reset missing scripts count (should be 0 now)
            _missingScriptsCount = 0;

            Console.WriteLine("✅ Script generation completed");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error generating script: {ex.Message}");
            _generatedScript = "Error generating script.";
            _editedScript = _generatedScript;
            _scriptGenerating = false;
            _currentGeneratingScene = 0;

            // Recalculate missing scripts after error
            _missingScriptsCount = await GetMissingScriptsCountAsync();

            // Try to save error state to database
            try
            {
                await UpdateScriptByVideoIdAndSceneAsync(
                    videoId: VideoId,
                    scene: "1",
                    script: $"Error: {ex.Message}",
                    scriptPlain: "Failed to generate script",
                    scriptWithSpeech: string.Empty
                );
            }
            catch { }
        }
        finally
        {
            StateHasChanged();
        }
    }

