    private async Task LoadExistingFinalVideoUrlAsync()
    {
        _finalVideoUrl = string.Empty;

        var videoId = VideoIdGuid ?? VideoId ?? string.Empty;
        if (string.IsNullOrWhiteSpace(videoId))
            return;

        try
        {
            HttpClient client = new HttpClient();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity == null || !user.Identity.IsAuthenticated)
                return;

            var url =
                $"{ApiConfig.ApiBaseUrl}api/GetFinalVideoUrlByVideoId" +
                $"?videoId={Uri.EscapeDataString(videoId)}" +
                "&code=REDACTED_FOR_GROOMING";

            var response = await client.GetAsync(url);

            if (!response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadAsStringAsync();

                // A missing/temporarily unavailable final-video record must never
                // prevent the rest of the modal from loading.
                Console.WriteLine(
                    $"⚠️ Could not load final video URL. " +
                    $"Status: {(int)response.StatusCode} {response.StatusCode}. " +
                    $"Response: {responseBody}");

                return;
            }

            var result = await response.Content.ReadFromJsonAsync<FinalVideoUrlResult>(
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (result != null && !string.IsNullOrWhiteSpace(result.VideoUrl))
            {
                _finalVideoUrl = result.VideoUrl;
                _finalizePhase = "complete";
                _finalizeStatus = "Commercial finalized.";
                _finalizeProgressPercent = 100;
                _finalizationFailed = false;

                Console.WriteLine($"✅ Loaded saved final video URL: {_finalVideoUrl}");
            }
        }
        catch (Exception ex)
        {
            // Do not block the rest of the modal if an older database does not
            // have a final video yet.
            Console.WriteLine($"⚠️ Error loading saved final video URL: {ex.Message}");
        }
    }

    private async Task SaveFinalVideoUrlAsync(string videoId, string videoUrl)
    {
        if (string.IsNullOrWhiteSpace(videoId))
            throw new InvalidOperationException("VideoId is required to save the final video.");

        if (string.IsNullOrWhiteSpace(videoUrl))
            throw new InvalidOperationException("Final video URL is empty.");

        HttpClient client = new HttpClient();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity == null || !user.Identity.IsAuthenticated)
            throw new InvalidOperationException("User must be authenticated to save the final video.");

        var url =
            $"{ApiConfig.ApiBaseUrl}api/UpdateFinalVideoUrlByVideoId" +
            "?code=REDACTED_FOR_GROOMING";

        var payload = new
        {
            videoId,
            videoUrl
        };

        using var content = new StringContent(
            System.Text.Json.JsonSerializer.Serialize(payload),
            Encoding.UTF8,
            "application/json");

        var response = await client.PostAsync(url, content);
