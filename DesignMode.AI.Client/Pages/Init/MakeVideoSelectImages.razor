    private int GetTotalPages(string sceneKey)
    {
        if (!AlternativesByScene.ContainsKey(sceneKey)) return 0;

        var totalImages = AlternativesByScene[sceneKey].Count;
        return (int)Math.Ceiling((double)totalImages / ImagesPerPage);
    }

    private Task<List<Dictionary<string, string>>?> GetAICommercialSceneOrderAsync(
        string companyName,
        string industry,
        List<DesignMode.AI.Client.Pages.Init.MakeVideoModal.ImageIdeaItem> items)
    {
        try
        {
            Random rng = new();

            // Copy list so we can remove items without altering original
            var pool = new List<DesignMode.AI.Client.Pages.Init.MakeVideoModal.ImageIdeaItem>(items);

            // Helper: convert item → dictionary
            Dictionary<string, string> ToDict(DesignMode.AI.Client.Pages.Init.MakeVideoModal.ImageIdeaItem item) => new()
                {
                    ["subcategory"] = item.SubCategory,
                    ["countid"] = item.CountId,
                    ["id"] = item.Id
                };

            // Helper: take one unique random item from pool
            DesignMode.AI.Client.Pages.Init.MakeVideoModal.ImageIdeaItem? TakeRandom(Func<DesignMode.AI.Client.Pages.Init.MakeVideoModal.ImageIdeaItem, bool> filter)
            {
                var list = pool.Where(filter).ToList();
                if (!list.Any())
                    return null;

                var chosen = list[rng.Next(list.Count)];
                pool.Remove(chosen);
                return chosen;
            }

            var result = new List<Dictionary<string, string>>(6);

            // --- SCENE 1 → Prefer video ---
            var scene1 = TakeRandom(x =>
                x.DeliverableType.Contains("video", StringComparison.OrdinalIgnoreCase) ||
                x.SubCategory.Contains("video", StringComparison.OrdinalIgnoreCase));

            if (scene1 != null) result.Add(ToDict(scene1));

            // --- SCENE 2 → Any non-video ---
            var scene2 = TakeRandom(x =>
                !x.DeliverableType.Contains("video", StringComparison.OrdinalIgnoreCase) &&
                !x.SubCategory.Contains("video", StringComparison.OrdinalIgnoreCase));

            if (scene2 != null) result.Add(ToDict(scene2));

            // --- SCENE 3 → Prefer video ---
            var scene3 = TakeRandom(x =>
                x.DeliverableType.Contains("video", StringComparison.OrdinalIgnoreCase) ||
                x.SubCategory.Contains("video", StringComparison.OrdinalIgnoreCase));

            if (scene3 != null) result.Add(ToDict(scene3));

            // --- SCENE 4 → Any non-video ---
            var scene4 = TakeRandom(x =>
                !x.DeliverableType.Contains("video", StringComparison.OrdinalIgnoreCase) &&
                !x.SubCategory.Contains("video", StringComparison.OrdinalIgnoreCase));

            if (scene4 != null) result.Add(ToDict(scene4));

            // --- SCENE 5 → Any non-video ---
            var scene5 = TakeRandom(x =>
                !x.DeliverableType.Contains("video", StringComparison.OrdinalIgnoreCase) &&
                !x.SubCategory.Contains("video", StringComparison.OrdinalIgnoreCase));

            if (scene5 != null) result.Add(ToDict(scene5));

            // --- SCENE 6 → Prefer logo ---
            var scene6 = TakeRandom(x =>
                x.DeliverableType.Contains("logo", StringComparison.OrdinalIgnoreCase) ||
                x.SubCategory.Contains("logo", StringComparison.OrdinalIgnoreCase));

            if (scene6 != null) result.Add(ToDict(scene6));

            // ---------------------------------------------------------
            // 🔒 FILL MISSING SCENES WITH UNIQUE RANDOM ITEMS
            // ---------------------------------------------------------
            while (result.Count < 6)
            {
                if (pool.Count == 0)
                    break;

                var filler = pool[rng.Next(pool.Count)];
                pool.Remove(filler);
                result.Add(ToDict(filler));
            }

            // If still < 6, add empty but guaranteed 6 entries
            while (result.Count < 6)
                result.Add(new Dictionary<string, string>());

            return Task.FromResult<List<Dictionary<string, string>>?>(result);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception in GetAICommercialSceneOrderAsync: {ex.Message}");
            return Task.FromResult<List<Dictionary<string, string>>?>(null);
        }
    }

    private void OnIndicatorClick(string sceneKey, int indicatorIndex)
