    private List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel> GetVisibleAlternatives(string sceneKey)
    {
        if (!AlternativesByScene.ContainsKey(sceneKey))
            return new List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel>();

        var currentPage = CarouselCurrentPage.ContainsKey(sceneKey) ? CarouselCurrentPage[sceneKey] : 0;
        var alternatives = AlternativesByScene[sceneKey];

        return alternatives
            .Skip(currentPage * ImagesPerPage)
            .Take(ImagesPerPage)
            .ToList();
    }

