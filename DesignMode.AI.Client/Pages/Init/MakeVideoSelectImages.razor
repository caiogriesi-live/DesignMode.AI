    protected async override Task OnParametersSetAsync()
    {
        if (!Show)
        {
            _hasShownBusyForThisOpen = false;
            _hasLoadedFinalVideoForThisOpen = false;
            _pendingInitialSceneSave = false;
            _isSavingInitialScenes = false;
            _hasSavedInitialScenesForThisOpen = false;
            _scenePersistenceWarning = string.Empty;
            return;
        }

        if (!_hasShownBusyForThisOpen)
        {
            IsBusy = true;
            _hasShownBusyForThisOpen = true;
            StateHasChanged();
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAuthorized = user.Identity?.IsAuthenticated == true;

        // Always hydrate the completed video from VideoImages when the modal opens.
        // This runs before the ImageIdeas short-circuit below so reopening an
        // unchanged project still shows the saved final video.
        VideoIdGuid = VideoId ?? string.Empty;

        if (isAuthorized && !_hasLoadedFinalVideoForThisOpen)
        {
            await LoadExistingFinalVideoUrlAsync();
            _hasLoadedFinalVideoForThisOpen = true;
        }

        // A completed commercial is the terminal state for this VideoId. Do not
        // hydrate image selection, generate scene ordering, or load scripts when
        // the user returns to an already-finalized video.
        if (!string.IsNullOrWhiteSpace(_finalVideoUrl))
        {
            _showScriptSection = false;
            _showCustomizationSection = false;
            IsBusy = false;
            StateHasChanged();
            return;
        }

        var uri = NavigationManager.Uri;
        var queryString = new Uri(uri).Query;
        string cid = GetQueryParameter(queryString, "cid", null);

        string companyName = string.Empty;
        string companyIndustry = string.Empty;

        if (!string.IsNullOrEmpty(cid))
        {
            var latestIdeas = await GetImageIdeaCountsAsync(cid);

            // Compare with local session
            if (_sessionAllIdeas != null && AreIdeasEqual(_sessionAllIdeas, latestIdeas))
            {
                // No change in ideas, skip further processing
                IsBusy = false;
                return;
            }

            // Update session with latest ideas
            _sessionAllIdeas = latestIdeas;
            AllIdeasGet = latestIdeas;

            string[] parts = cid.Split(new string[] { "|~~|@@|^^|" }, StringSplitOptions.None);
            if (parts.Length >= 2)
            {
                try
                {
                    CompanyName = Encoding.UTF8.GetString(Convert.FromBase64String(parts[0]));
                    Industry = Encoding.UTF8.GetString(Convert.FromBase64String(parts[1]));
                }
                catch (FormatException ex)
                {
                    Console.WriteLine($"Error decoding Base64 values: {ex.Message}");
                }
            }

            // Only fetch AI scene order if it's the first time or ImageIdeas count has changed
            if (!_hasFetchedSceneOrder || AllIdeasGet.ImageIdeas.Count != _previousImageIdeaCount)
            {
                var sceneOrder = await GetAICommercialSceneOrderAsync(CompanyName, Industry, AllIdeasGet.ImageIdeas);

                if (sceneOrder != null)
                {
                    CategorySets = sceneOrder
                        .Select(scene => new[]
                        {
                        scene.ContainsKey("subcategory") ? scene["subcategory"] : "",
                        scene.ContainsKey("countid") ? scene["countid"] : "",
                        scene.ContainsKey("id") ? scene["id"] : ""
                                                                                        })
                        .ToArray();
                }

                _hasFetchedSceneOrder = true;
                _previousImageIdeaCount = AllIdeasGet.ImageIdeas.Count;
            }

            if (SelectedImages != null && SelectedImages.Any())
            {
                await InitializeImagesAsync();
                VideoIdGuid = VideoId;

                // Calculate missing scripts count
                _missingScriptsCount = await GetMissingScriptsCountAsync();
                Console.WriteLine($"📊 Missing scripts count: {_missingScriptsCount}");

                // IMPORTANT:
                // SceneSelections is rebuilt by the Razor markup during render.
                // Calling SaveAllVideoImagesAsync here runs too early and can see
                // only part of the six scenes. Defer the initial persistence until
                // OnAfterRenderAsync has allowed the markup to populate all visible
                // scene selections.
                if (GenerateNew && !_hasSavedInitialScenesForThisOpen)
                {
                    _pendingInitialSceneSave = true;
                }

                // 🔍 Check if scripts are missing/incomplete and generate if needed
                if (GenerateNew && _showScriptSection)
                {
                    var missingScenes = await GetMissingScenesAsync(VideoId);
                    if (missingScenes.Any())
                    {
                        Console.WriteLine($"🔍 Auto-resuming script generation for missing scenes: {string.Join(", ", missingScenes)}");
                        await GenerateScript();
                    }
                }
            }
        }

        IsBusy = false;
        StateHasChanged();
    }

    // Helper to compare two AllIdeasResponse objects
    private bool AreIdeasEqual(DesignMode.AI.Client.Pages.Init.MakeVideoModal.ImageIdeaCountResult a, DesignMode.AI.Client.Pages.Init.MakeVideoModal.ImageIdeaCountResult b)
    {
        if (a == null || b == null) return false;
        if (a.ImageIdeas.Count != b.ImageIdeas.Count) return false;

        // You may want a deeper comparison depending on ImageIdeas structure
        for (int i = 0; i < a.ImageIdeas.Count; i++)
        {
            if (!a.ImageIdeas[i].Equals(b.ImageIdeas[i]))
                return false;
        }

        return true;
    }

    private async Task InitializeImagesAsync()
    {
        bool imagesChanged = !SelectedImages.SequenceEqual(_previousSelectedImages);

        //if (!GenerateNew)
        //{
        savedVideoImages = await GetVideoImagesAsync(VideoId);
        //}
        if (!_isInitialized || imagesChanged)
        {
            OriginalImages = new(SelectedImages);
            SelectedImageUrls = new(SelectedImages.Select(x => x.ImageUrl));
            SelectedImageIds = new(SelectedImages.Select(x => x.Id));
            RemovedImages.Clear();

            var rand = new Random();

            var groupedScenes = SelectedImages
                .GroupBy(i => BuildSceneKey(i.SubCategory, i.CountId))
                .ToList();

            AlternativesByScene = groupedScenes.ToDictionary(
                g => g.Key,
                g => SelectedImages.OrderBy(x => rand.Next()).ToList()
            );

            MainImagesByScene = new Dictionary<string, string>();

            // Track used images to avoid duplicates
            var usedImages = new HashSet<string>();

            // ✅ If NOT generating new, load from saved video images instead
            if (!GenerateNew && savedVideoImages != null && savedVideoImages.Any())
            {
                // Build ordered arranged images from DB
                OrderedImages.Clear();

                foreach (var saved in savedVideoImages.OrderBy(x => int.Parse(x.Scene)))
                {
                    var match = SelectedImages.FirstOrDefault(img => img.Id == saved.ImageId);

                    if (match != null)
                    {
                        OrderedImages.Add(match);

                        var sceneKey = BuildSceneKey(match.SubCategory, match.CountId);
                        MainImagesByScene[sceneKey] = match.ImageUrl;
                        usedImages.Add(match.ImageUrl);
                    }
                }
            }
            else
            {
                // ✅ keep your GenerateNew logic unchanged
                foreach (var category in CategorySets)
                {
                    var countId = category[1];
                    var matchingImage = SelectedImages.FirstOrDefault(img => img.CountId == countId);

                    if (matchingImage != null)
                    {
                        var sceneKey = BuildSceneKey(matchingImage.SubCategory, matchingImage.CountId);
                        if (!MainImagesByScene.ContainsKey(sceneKey))
                        {
                            MainImagesByScene[sceneKey] = matchingImage.ImageUrl;
                            usedImages.Add(matchingImage.ImageUrl);
                        }
                    }
                }
            }

            // NEW LOGIC: Ensure no blank main images and avoid duplicates
            foreach (var sceneKey in AlternativesByScene.Keys)
            {
                if (!MainImagesByScene.ContainsKey(sceneKey) || string.IsNullOrWhiteSpace(MainImagesByScene[sceneKey]))
                {
                    // Find a random image that's not already used as a main image
                    var availableImages = AlternativesByScene[sceneKey]
                        .Where(img => !usedImages.Contains(img.ImageUrl) && !string.IsNullOrWhiteSpace(img.ImageUrl))
                        .ToList();

                    if (availableImages.Any())
                    {
                        var randomImage = availableImages[rand.Next(availableImages.Count)];
                        MainImagesByScene[sceneKey] = randomImage.ImageUrl;
                        usedImages.Add(randomImage.ImageUrl);
                    }
                    else
                    {
                        // Fallback: use any available image from this scene
                        var fallbackImage = AlternativesByScene[sceneKey]
                            .FirstOrDefault(img => !string.IsNullOrWhiteSpace(img.ImageUrl));

                        if (fallbackImage != null)
                        {
                            MainImagesByScene[sceneKey] = fallbackImage.ImageUrl;
                            usedImages.Add(fallbackImage.ImageUrl);
                        }
                    }
                }
            }

            foreach (var sceneKey in AlternativesByScene.Keys)
            {
                if (!CarouselCurrentPage.ContainsKey(sceneKey))
                    CarouselCurrentPage[sceneKey] = 0;
            }

            _isInitialized = true;
            _previousSelectedImages = new List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel>(SelectedImages);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            GenerateNewVar = GenerateNew;
        }

        // The Step 1 markup populates SceneSelections while rendering. Persisting
        // here avoids the OnParametersSetAsync race that previously saw only
        // scenes 1-4 and then threw while trying to recreate scene 5.
        if (Show &&
            GenerateNew &&
            _pendingInitialSceneSave &&
            !_isSavingInitialScenes &&
            !_hasSavedInitialScenesForThisOpen)
        {
            _pendingInitialSceneSave = false;
            _isSavingInitialScenes = true;

            try
            {
                await SaveAllVideoImagesAsync();
                _hasSavedInitialScenesForThisOpen = true;
            }
            catch (Exception ex)
            {
                // Never let persistence failure become an unhandled renderer
                // exception. Keep the modal usable and allow a later retry.
                _scenePersistenceWarning =
                    "Some scene records could not be saved yet. " +
                    "Please keep the modal open and try continuing again.";

                Console.WriteLine(
                    $"⚠️ Deferred scene persistence failed: {ex.Message}");
            }
            finally
            {
                _isSavingInitialScenes = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

