                        }
                        else
                        {
                            <span>
                                Finalize Commercial
                                <span style="margin-left: 15px;">✓</span>
                            </span>
                        }
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Inject] private ApiConfigService ApiConfig { get; set; }
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; }
    [Inject] private HttpClient Http { get; set; }
    // Add these fields to track changed scenes
    private HashSet<int> _changedScenes = new HashSet<int>();
    private Dictionary<int, string> _previousSceneImages = new Dictionary<int, string>();
    private bool IsBusy = false;
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public EventCallback<List<string>> OnImagesRemoved { get; set; }
    [Parameter] public EventCallback<bool> OnConfirm { get; set; }
    [Parameter] public List<string> RunwareImageIds { get; set; } = new();
    [Parameter] public List<string> SecondaryRunwareImageIds { get; set; } = new();
    [Parameter] public bool GenerateNew { get; set; }
    [Parameter] public string VideoId { get; set; }
    [Parameter] public List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel> SelectedImages { get; set; }
    [Parameter] public DesignMode.AI.Client.Pages.Init.MakeVideoModal.ImageIdeaCountResult AllIdeas { get; set; }
    [Parameter] public string PromptText { get; set; } = "";
    [Parameter] public EventCallback OnSecondaryModalClosed { get; set; }

    private List<VideoImageRequest> pendingVideoImages = new();

    private bool GenerateNewVar = false;

    // NEW FIELDS FOR SCRIPT SECTION
    private bool _showScriptSection = false;
    private bool _scriptGenerating = false;
    private string _generatedScript = "Generating Scripts ...";
    private string _editedScript = string.Empty;
    private string[] _sceneScripts = new string[6];
    private string _aiGeneratedScript = string.Empty;
    private int _currentGeneratingScene = 0; // Track which scene is currently generating

    // NEW FIELDS FOR CUSTOMIZATION SECTION
    private bool _showCustomizationSection = false;
    private string _selectedAspectRatio = "16:9";
    private string _selectedVoice = "eve";
    private string _selectedMusic = "upbeat";
    private string _aiVoiceOverScript = null;
    private bool _isFinalizing = false;
    private bool _hasLoadedCustomizationSettings = false;
    private bool _isCheckingDatabase = false;
    private string _aiCTA = string.Empty;
    private bool _loadingCTA = false;

    // List of available options
    private List<string> _aspectRatios = new List<string> { "16:9", "9:16", "1:1", "4:5" };
    // xAI TTS voices used by Runware model xai:tts@0
    private List<string> _voices = new List<string>
    {
        "eve",
        "ara",
        "leo",
        "rex",
        "sal"
    };
    private List<string> _musicTracks = new List<string>
    {
        "upbeat",
        "corporate",
        "emotional",
        "epic",
        "calm",
        "none"
    };

    // Background music preview state.
    // Each track maps directly to wwwroot/assets/music/<track>.wav.
    private string? _previewingMusic = null;
    private bool _isMusicPreviewPlaying = false;

    private string GetMusicDisplayName(string music)
    {
        return music switch
        {
            "upbeat" => "Upbeat",
            "corporate" => "Corporate",
            "emotional" => "Emotional",
            "epic" => "Epic",
            "calm" => "Calm",
            "none" => "No Music",
            _ => music
        };
    }

    private string GetMusicAudioUrl(string music)
    {
        if (string.IsNullOrWhiteSpace(music) || music == "none")
            return string.Empty;

        // Blazor WASM serves files from wwwroot. These resolve to:
        // wwwroot/assets/music/upbeat.wav, corporate.wav, etc.
        return $"https://designmode-storage.s3.us-east-1.amazonaws.com/{Uri.EscapeDataString(music)}.wav";
    }

    private async Task SelectMusicTrack(string music)
    {
        if (!_musicTracks.Contains(music))
            music = "none";

        _selectedMusic = music;

        // Selecting "No Music" also stops any active preview.
        if (music == "none")
        {
            await StopMusicPreview();
        }

        await UpdateAllScenesWithCurrentSettings();
        StateHasChanged();
    }

    private async Task ToggleMusicPreview(string music)
    {
        if (string.IsNullOrWhiteSpace(music) || music == "none" || !_musicTracks.Contains(music))
            return;

        try
        {
            if (_isMusicPreviewPlaying && _previewingMusic == music)
            {
                await StopMusicPreview();
                return;
            }

            // Stop the previous local music preview before starting another one.
            await JSRuntime.InvokeVoidAsync("stopMusicPreview");

            _previewingMusic = music;
            _isMusicPreviewPlaying = true;
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync(
                "playMusicPreview",
                GetMusicAudioUrl(music),
                DotNetObjectReference.Create(this));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error previewing music '{music}': {ex.Message}");
            _previewingMusic = null;
            _isMusicPreviewPlaying = false;
            StateHasChanged();
        }
    }

    private async Task StopMusicPreview()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("stopMusicPreview");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error stopping music preview: {ex.Message}");
        }
        finally
        {
            _previewingMusic = null;
            _isMusicPreviewPlaying = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task OnMusicPreviewEnded()
    {
        _previewingMusic = null;
        _isMusicPreviewPlaying = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task GenerateCTA()
    {
        if (string.IsNullOrWhiteSpace(_aiVoiceOverScript))
            return;
        await using var generationOperation = await BeginGenerationAsync();

        try
        {
            Console.WriteLine($"Generating the first CTA");
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var username = user.Identity?.Name;
            var uri = NavigationManager.Uri;
            var queryString = new Uri(uri).Query;
            string cid = GetQueryParameter(queryString, "cid", null);
            var promptId = await FetchPromptIdSelect(username, cid);
            var promptText = await FetchPromptTextSelect(promptId);

            _loadingCTA = true;

            _aiCTA = await GetAICommercialCTAAsync(
                CompanyName,
                Industry,
                promptText,
                _aiVoiceOverScript
            );

            Console.WriteLine($"CTA generated {_aiCTA}");

            var TimeStamp = DateTime.UtcNow.ToString("o");

            await InsertAudioSampleCTAAsync(VideoId, TimeStamp, _aiCTA);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"CTA generation failed: {ex.Message}");
        }
        finally
        {
            _loadingCTA = false;
        }

        StateHasChanged();
    }
    // Add these fields for voice-over script edit functionality
    private bool _editingVoiceOverScript = false;
    private string _editedVoiceOverScript = string.Empty;
    private bool _regeneratingVoiceOverScript = false;

    // Audio playback state
    private Dictionary<int, AudioState> _audioStates = new Dictionary<int, AudioState>();
    private string _currentPlayingAudioUrl = string.Empty;
    private bool _isLoadingAudio = false;
    private int? _currentlyPlayingScene = null;

    // News ticker visualization state
    private List<(string text, int index)> _scene1Words = new List<(string text, int index)>();
    private int _currentWordIndex = 0;
    private double _tickerProgress = 0;
    private Timer _tickerTimer;
    private string _fullNarrationText = string.Empty;

    // xAI TTS voices are sent directly to CallRunwareAudio.
    // There is no ElevenLabs voice-ID mapping anymore.
    private string GetVoiceDisplayName(string voiceCode)
    {
        return voiceCode switch
        {
            "eve" => "Eve",
            "ara" => "Ara",
            "leo" => "Leo",
            "rex" => "Rex",
            "sal" => "Sal",
            _ => "Eve"
        };
    }

    // Computed property for current voice display name
    private string CurrentVoiceDisplayName => GetVoiceDisplayName(_selectedVoice);

    public class AudioState
    {
        public string AudioUrl { get; set; }
        public bool IsPlaying { get; set; }
        public bool IsLoading { get; set; }
        public bool HasAudio { get; set; }
    }

    private async Task SaveAllVideoImagesAsync()
    {
        await using var generationOperation = await BeginGenerationAsync();
        var videoId = VideoIdGuid ?? VideoId ?? string.Empty;

        if (string.IsNullOrWhiteSpace(videoId))
        {
            Console.WriteLine("⚠️ Cannot save video images because VideoId is empty.");
            return;
        }

        _scenePersistenceWarning = string.Empty;

        // SceneSelections should normally contain all visible scenes by the time
        // this method is called from OnAfterRenderAsync. Build one request per
        // scene explicitly so a partial/stale collection cannot shift scene
        // numbers or cause a render-time exception.
        for (int sceneNumber = 1; sceneNumber <= 6; sceneNumber++)
        {
            var request = BuildSceneRequestForScene(sceneNumber, videoId);

            if (request == null)
            {
                Console.WriteLine(
                    $"⚠️ Scene {sceneNumber} could not be built yet. " +
                    "It will be checked again by the repair pass.");
                continue;
            }

            request.VideoId = videoId;
            await SaveVideoImageAsync(request);
        }

        // Repair/re-read without ever throwing into the Blazor renderer.
        var saved = await EnsureSixSceneRecordsAsync(videoId);

        var missing = Enumerable.Range(1, 6)
            .Where(n => !saved.Any(x =>
                string.Equals(
                    x.Scene,
                    n.ToString(),
                    StringComparison.OrdinalIgnoreCase)))
            .ToList();

        if (missing.Any())
        {
            _scenePersistenceWarning =
                $"Scenes {string.Join(", ", missing)} could not be saved yet. " +
                "You can continue choosing images; the page will retry before script/video generation.";

            Console.WriteLine($"⚠️ {_scenePersistenceWarning}");
        }
    }

    private VideoImageRequest? BuildSceneRequestForScene(
        int sceneNumber,
        string videoId)
    {
        if (sceneNumber < 1 || sceneNumber > 6)
            return null;

        string scene = sceneNumber.ToString();

        // 1. Prefer the exact selection currently displayed/changed by the user.
        var currentSelection = SceneSelections
            .LastOrDefault(x =>
                string.Equals(
                    x.Scene,
                    scene,
                    StringComparison.OrdinalIgnoreCase) &&
                !string.IsNullOrWhiteSpace(x.ImageId));

        if (currentSelection != null)
        {
            return new VideoImageRequest
                {
                    ImageId = currentSelection.ImageId,
                    Scene = scene,
                    TimeStamp = DateTime.UtcNow.ToString("o"),
                    PromptId = currentSelection.PromptId
                        ?? AllIdeas?.PromptId
                        ?? AllIdeasGet?.PromptId
                        ?? string.Empty,
                    VideoId = videoId,
                    Script = currentSelection.Script ?? string.Empty
                };
        }

        // 2. If the rendered main-image dictionaries already know the URL for the
        //    visual scene, map that URL back to its image record.
        DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel? image = null;

        if (GenerateNew && ArrangedImages.Count >= sceneNumber)
            image = ArrangedImages[sceneNumber - 1];

        if (image == null && OrderedImages.Count >= sceneNumber)
            image = OrderedImages[sceneNumber - 1];

        if (image == null && ArrangedImages.Count >= sceneNumber)
            image = ArrangedImages[sceneNumber - 1];

        // 3. Build a deterministic valid image pool. This is important when the
        //    source project currently has fewer than six unique images. Reusing a
        //    valid image is safer than throwing and crashing the modal.
        if (image == null || string.IsNullOrWhiteSpace(image.Id))
        {
            var candidates = new List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel>();

            if (ArrangedImages != null)
                candidates.AddRange(ArrangedImages);

            if (OrderedImages != null)
                candidates.AddRange(OrderedImages);

            if (SelectedImages != null)
                candidates.AddRange(SelectedImages);

            candidates = candidates
                .Where(x =>
                    x != null &&
                    !string.IsNullOrWhiteSpace(x.Id) &&
                    !string.IsNullOrWhiteSpace(x.ImageUrl))
                .GroupBy(x => x.Id)
                .Select(g => g.First())
                .ToList();

            if (candidates.Any())
            {
                // Stable cycling gives every missing scene a valid record even
                // when fewer than six unique source images exist.
                image = candidates[(sceneNumber - 1) % candidates.Count];

                Console.WriteLine(
                    $"ℹ️ Scene {sceneNumber} is using fallback image {image.Id}.");
            }
        }

        if (image == null || string.IsNullOrWhiteSpace(image.Id))
            return null;

        var promptId =
            AllIdeas?.PromptId
            ?? AllIdeasGet?.PromptId
            ?? string.Empty;

        return new VideoImageRequest
            {
                ImageId = image.Id,
                Scene = scene,
                TimeStamp = DateTime.UtcNow.ToString("o"),
                PromptId = promptId,
                VideoId = videoId,
                Script = string.Empty
            };
    }

    private async Task<List<VideoImageModel>> EnsureSixSceneRecordsAsync(
        string videoId)
    {
        if (string.IsNullOrWhiteSpace(videoId))
        {
            Console.WriteLine(
                "⚠️ VideoId is missing, so scene records cannot be verified.");

            return new List<VideoImageModel>();
        }

        var saved =
            await GetVideoImagesAsync(videoId)
            ?? new List<VideoImageModel>();

        // Attempt to repair each genuinely missing scene.
        for (int sceneNumber = 1; sceneNumber <= 6; sceneNumber++)
        {
            string scene = sceneNumber.ToString();

            bool exists = saved.Any(x =>
                string.Equals(
                    x.Scene,
                    scene,
                    StringComparison.OrdinalIgnoreCase));

            if (exists)
                continue;

            Console.WriteLine(
                $"⚠️ Scene {sceneNumber} is missing. " +
                "Attempting to repair it.");

            var repairRequest =
                BuildSceneRequestForScene(
                    sceneNumber,
                    videoId);

            if (repairRequest == null)
            {
                // Do NOT throw from a component lifecycle method. The modal must
                // remain usable even if its backing image data is still hydrating.
                Console.WriteLine(
                    $"⚠️ Scene {sceneNumber} cannot be repaired yet because " +
                    "no valid image is currently available.");

                continue;
            }

            var saveResult =
                await SaveVideoImageAsync(repairRequest);

            if (saveResult != null)
            {
                // Add a lightweight local representation so the same pass does
                // not repeatedly attempt this scene before DynamoDB is visible.
                saved.Add(new VideoImageModel
                    {
                        ImageId = repairRequest.ImageId,
                        Scene = repairRequest.Scene,
                        VideoId = repairRequest.VideoId,
                        Script = repairRequest.Script,
                        TimeStamp = repairRequest.TimeStamp
                    });
            }
        }

        // DynamoDB reads can briefly lag writes depending on the endpoint/query.
        // Retry a few times, but never crash the Blazor renderer.
        int[] retryDelaysMs = { 250, 500, 1000 };

        foreach (int delayMs in retryDelaysMs)
        {
            var missingNow = Enumerable.Range(1, 6)
                .Where(n => !saved.Any(x =>
                    string.Equals(
                        x.Scene,
                        n.ToString(),
                        StringComparison.OrdinalIgnoreCase)))
                .ToList();

            if (!missingNow.Any())
                break;

            await Task.Delay(delayMs);

            var refreshed =
                await GetVideoImagesAsync(videoId)
                ?? new List<VideoImageModel>();

            if (refreshed.Any())
                saved = refreshed;
        }

        var missing = Enumerable.Range(1, 6)
            .Where(n => !saved.Any(x =>
                string.Equals(
                    x.Scene,
                    n.ToString(),
                    StringComparison.OrdinalIgnoreCase)))
            .ToList();

        if (missing.Any())
        {
            Console.WriteLine(
                $"⚠️ Scene verification completed with missing rows: " +
                $"{string.Join(", ", missing)}. " +
                "The modal will stay open and retry later.");
        }
        else
        {
            Console.WriteLine("✅ All six VideoImages scene records are available.");
        }

        return saved
            .Where(x =>
                int.TryParse(x.Scene, out var n) &&
                n >= 1 &&
                n <= 6)
            .GroupBy(x => x.Scene)
            .Select(g => g
                .OrderByDescending(x => x.TimeStamp)
                .First())
            .OrderBy(x => int.Parse(x.Scene))
            .ToList();
    }

