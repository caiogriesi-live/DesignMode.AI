    private void NavigateCarousel(string sceneKey, int direction)
    {
        if (!CarouselCurrentPage.ContainsKey(sceneKey))
            CarouselCurrentPage[sceneKey] = 0;

        var currentPage = CarouselCurrentPage[sceneKey];
        var totalPages = GetTotalPages(sceneKey);

        var newPage = currentPage + direction;
        if (newPage >= 0 && newPage < totalPages)
        {
            CarouselCurrentPage[sceneKey] = newPage;
            StateHasChanged();
        }
    }

    private void GoToPage(string sceneKey, int page)
    {
        if (page >= 0 && page < GetTotalPages(sceneKey))
        {
            CarouselCurrentPage[sceneKey] = page;
            StateHasChanged();
        }
    }

    private bool IsPrevDisabled(string sceneKey)
    {
        return GetCurrentPage(sceneKey) <= 0;
    }

    private bool IsNextDisabled(string sceneKey)
    {
        return GetCurrentPage(sceneKey) >= GetTotalPages(sceneKey) - 1;
    }

