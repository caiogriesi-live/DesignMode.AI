    private string ExtractScene1Text(string fullScript)
    {
        if (string.IsNullOrWhiteSpace(fullScript))
            return string.Empty;

        // Extract Scene 1 content
        var scene1Match = Regex.Match(fullScript, @"<b>Scene\s*1\s*[:.\-]?\s*</b>\s*(.*?)(?=<b>Scene\s*2\s*[:.\-]?\s*</b>|$)", RegexOptions.IgnoreCase | RegexOptions.Singleline);

        if (scene1Match.Success && scene1Match.Groups.Count >= 2)
        {
            return scene1Match.Groups[1].Value.Trim();
        }

        // Fallback: take first 50 words
        var plainText = RemoveBoldTags(fullScript);
        var words = plainText.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join(" ", words.Take(50));
    }

    private async Task<List<int>> GetMissingScenesAsync(string videoId)
    {
        var missingScenes = new List<int>();

        try
        {
            // Get all saved video images for this video
            var savedVideoImages = await GetVideoImagesAsync(videoId);

            if (savedVideoImages == null || !savedVideoImages.Any())
            {
                // No scenes saved at all - all 6 are missing
                return Enumerable.Range(1, 6).ToList();
            }

            // Check each scene 1-6
            for (int sceneNum = 1; sceneNum <= 6; sceneNum++)
            {
                var scene = sceneNum.ToString();
                var savedScene = savedVideoImages.FirstOrDefault(v => v.Scene == scene);

                if (savedScene == null)
                {
                    // Scene not in database at all
                    missingScenes.Add(sceneNum);
                }
                else if (string.IsNullOrWhiteSpace(savedScene.ScriptPlain))
                {
                    // Scene exists but has no script (incomplete generation)
                    missingScenes.Add(sceneNum);
                }
                else if (IsScriptIncomplete(savedScene.ScriptPlain))
                {
                    // Scene has script but it appears incomplete
                    missingScenes.Add(sceneNum);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error checking for missing scenes: {ex.Message}");
            // If we can't check, assume all scenes are missing
            return Enumerable.Range(1, 6).ToList();
        }

        return missingScenes;
    }

    private bool IsScriptIncomplete(string script)
    {
        if (string.IsNullOrWhiteSpace(script))
            return true;

        // Check for common incomplete script patterns
        var incompletePatterns = new[]
        {
        "generating script",
        "loading...",
        "waiting",
        "processing",
        "error",
        "failed",
        "null",
        "undefined",
        "Scene description:",
        "Camera angle:",
        "Dialogue: ["
    };

        // If script is too short or matches incomplete patterns
        if (script.Length < 10 || incompletePatterns.Any(pattern =>
            script.Contains(pattern, StringComparison.OrdinalIgnoreCase)))
        {
            return true;
        }

        return false;
    }
