    private async Task<VideoImageSaveResponse?> SaveVideoImageAsync(VideoImageRequest request)
    {
        if (request == null ||
            string.IsNullOrWhiteSpace(request.VideoId) ||
            string.IsNullOrWhiteSpace(request.Scene) ||
            string.IsNullOrWhiteSpace(request.ImageId))
        {
            Console.WriteLine("⚠️ SaveVideoImageAsync skipped an invalid request.");
            return null;
        }

        try
        {
            HttpClient client = new HttpClient();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                Console.WriteLine("⚠️ SaveVideoImageAsync skipped because the user is not authenticated.");
                return null;
            }

            var url = $"{ApiConfig.ApiBaseUrl}api/SaveVideoImage?code=REDACTED_FOR_GROOMING";
            var response = await client.PostAsJsonAsync(url, request);

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                Console.WriteLine(
                    $"❌ SaveVideoImage failed for scene {request.Scene}: {(int)response.StatusCode} {response.StatusCode}. {body}");
                return null;
            }

            Console.WriteLine($"✅ Saved video image for scene {request.Scene}.");

            // Some successful endpoints return an empty body. Do not turn a
            // successful save into a failure just because there is no JSON payload.
            var responseBody = await response.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(responseBody))
            {
                return new VideoImageSaveResponse
                    {
                        Message = "Saved",
                        VideoId = request.VideoId
                    };
            }

            try
            {
                return System.Text.Json.JsonSerializer.Deserialize<VideoImageSaveResponse>(
                    responseBody,
                    new System.Text.Json.JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        });
            }
            catch (Exception jsonEx)
            {
                Console.WriteLine($"⚠️ Scene {request.Scene} saved, but response JSON could not be parsed: {jsonEx.Message}");
                return new VideoImageSaveResponse
                    {
                        Message = "Saved",
                        VideoId = request.VideoId
                    };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception saving scene {request.Scene}: {ex.Message}");
            return null;
        }
    }

