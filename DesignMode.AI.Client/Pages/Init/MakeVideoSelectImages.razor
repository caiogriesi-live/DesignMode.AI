    private string GetFinalizeStepClass(int step)
    {
        var activeStep = _finalizePhase switch
        {
            "prepare" => 1,
            "render" => 2,
            "narration" => 2,
            "compose" => 3,
            "complete" => 4,
            _ => 1
        };

        if (step < activeStep)
            return "mvsi-finalize-step-complete";

        if (step == activeStep)
            return "mvsi-finalize-step-active";

        return string.Empty;
    }

