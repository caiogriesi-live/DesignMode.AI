        _currentWordIndex = 0;
        _tickerProgress = 0;

        await ShowChanged.InvokeAsync(false);
        if (OnImagesRemoved.HasDelegate)
        {
            // Pass both additions and removals to let parent know to refresh
            var allChangedImages = new List<string>();
            await OnImagesRemoved.InvokeAsync(allChangedImages);
        }

        if (OnConfirm.HasDelegate)
        {
            await OnConfirm.InvokeAsync(true);
        }

        StateHasChanged();

        // 🔥 Bubble event up to parent modal
        await OnClose.InvokeAsync();

        // 🔁 Refresh the page
        //NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private bool HasSceneImageChanged(int sceneNumber, string currentImageId)
    {
        if (_previousSceneImages.TryGetValue(sceneNumber, out string previousImageId))
        {
            return previousImageId != currentImageId;
        }

        // If no previous image, it's new (count as changed)
        return true;
    }

    private string BuildSceneKey(string sub, string count)
    => $"{sub?.Trim().ToLower()}_{count?.Trim().ToLower()}";

    private void EditVoiceOverScript()
    {
        _editingVoiceOverScript = true;

        // Remove the <b> and </b> tags from the script when editing
        _editedVoiceOverScript = RemoveBoldTags(_aiVoiceOverScript);

        StateHasChanged();
    }

    // Helper method to remove bold tags while preserving content
    private string RemoveBoldTags(string htmlText)
    {
        if (string.IsNullOrWhiteSpace(htmlText))
            return htmlText;

        // Decode HTML entities first
        string decoded = WebUtility.HtmlDecode(htmlText);

        // Pattern to match <b>Scene X:</b> pattern
        var boldPattern = @"<b>\s*(Scene\s+\d+\s*[:.\-]?\s*)\s*</b>\s*";

        // Replace <b>Scene X:</b> with just "Scene X:"
        string withoutBold = Regex.Replace(decoded, boldPattern, "$1", RegexOptions.IgnoreCase);

        // Also handle any remaining bold tags
        withoutBold = withoutBold
            .Replace("<b>", "", StringComparison.OrdinalIgnoreCase)
            .Replace("</b>", "", StringComparison.OrdinalIgnoreCase)
            .Replace("<strong>", "", StringComparison.OrdinalIgnoreCase)
            .Replace("</strong>", "", StringComparison.OrdinalIgnoreCase);

        // Also handle any encoded versions
        withoutBold = withoutBold
            .Replace("&lt;b&gt;", "")
            .Replace("&lt;/b&gt;", "")
            .Replace("&lt;strong&gt;", "")
            .Replace("&lt;/strong&gt;", "");

        return withoutBold.Trim();
    }

    // Helper to check if script needs reformatting
    private bool NeedsReformatting(string script)
    {
        if (string.IsNullOrWhiteSpace(script))
            return true;

        // Check if script has any bold tags
        if (script.Contains("<b>"))
        {
            // Check if bold tags have proper spacing after them
            if (script.Contains(":</b>") && !script.Contains(":</b> "))
            {
                return true; // Missing space after </b>
            }

            // Check if bold tags wrap entire lines instead of just scene headers
            var lines = script.Split('\n');
            foreach (var line in lines)
            {
                if (line.Contains("<b>") && line.Contains("</b>"))
                {
                    // Extract content between bold tags
                    var match = Regex.Match(line, @"<b>(.*?)</b>");
                    if (match.Success)
                    {
                        var boldContent = match.Groups[1].Value.Trim();
                        // If it's not just a scene header (contains more text), needs reformatting
                        if (IsSceneHeader(boldContent) && boldContent.Contains(":") && boldContent.Length > 10)
                        {
                            return true;
                        }
                    }
                }
            }
        }

        return false;
    }

    private async Task SaveVoiceOverEdit()
    {
        if (!string.IsNullOrWhiteSpace(_editedVoiceOverScript))
        {
            // Split the edited script into scenes and add <b> tags to scene headers
            _aiVoiceOverScript = FormatScriptWithSceneHeaders(_editedVoiceOverScript);

            // Save the edited script to database
            await SaveVoiceOverScriptToDatabaseAsync(VideoId, _aiVoiceOverScript);

            // Update all scenes with the new script
            await UpdateAllScenesWithCurrentSettings();

            _editingVoiceOverScript = false;
            StateHasChanged();
        }
    }

    // Helper method to add bold tags ONLY to "Scene X:" part with proper spacing
    private string FormatScriptWithSceneHeaders(string plainText)
    {
        if (string.IsNullOrWhiteSpace(plainText))
            return plainText;

        // Split into lines
        var lines = plainText.Split('\n');
        var formattedLines = new List<string>();

        foreach (var line in lines)
        {
            var trimmedLine = line.Trim();

            // Check if this line starts with "Scene X:"
            if (IsSceneHeader(trimmedLine))
            {
                // Extract just the "Scene X:" part and bold it, keep the rest normal
                var match = Regex.Match(trimmedLine, @"^(Scene\s+\d+\s*[:.\-]?\s*)(.*)$", RegexOptions.IgnoreCase);

                if (match.Success && match.Groups.Count >= 3)
                {
                    var sceneHeader = match.Groups[1].Value.Trim();
                    var sceneContent = match.Groups[2].Value;

                    // Ensure scene header ends with proper punctuation
                    if (!sceneHeader.EndsWith(":") && !sceneHeader.EndsWith(".") && !sceneHeader.EndsWith("-"))
                    {
                        sceneHeader += ":";
                    }

                    // Add a space after the closing </b> tag
                    formattedLines.Add($"<b>{sceneHeader}</b> {sceneContent}");
                }
                else
                {
                    formattedLines.Add(trimmedLine);
                }
            }
            else
            {
                formattedLines.Add(trimmedLine);
            }
        }

        return string.Join("\n", formattedLines);
    }

    // Helper method to identify scene headers - more specific pattern
    private bool IsSceneHeader(string line)
    {
        if (string.IsNullOrWhiteSpace(line))
            return false;

        // More specific pattern for "Scene X:" format (with optional punctuation)
        var pattern = @"^Scene\s+\d+\s*[:.\-]?\s*.*$";

        return Regex.IsMatch(line, pattern, RegexOptions.IgnoreCase);
    }

    private void CancelVoiceOverEdit()
    {
        _editingVoiceOverScript = false;
        StateHasChanged();
    }

    private async Task RegenerateVoiceOverScript()
    {
        await using var generationOperation = await BeginGenerationAsync();
        try
        {
            _regeneratingVoiceOverScript = true;
            StateHasChanged();

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var username = user.Identity?.Name;

            var uri = NavigationManager.Uri;
            var queryString = new Uri(uri).Query;
            string cid = GetQueryParameter(queryString, "cid", null);

            var promptId = await FetchPromptIdSelect(username, cid);
            var promptText = await FetchPromptTextSelect(promptId);

            var videoImages = await GetVideoImagesAsync(VideoIdGuid);

            if (!string.IsNullOrWhiteSpace(CompanyName) &&
                !string.IsNullOrWhiteSpace(Industry) &&
                !string.IsNullOrWhiteSpace(promptText) &&
                videoImages != null &&
                videoImages.Any())
            {
                // Extract scene scripts as a list (max 6)
                var sceneScripts = videoImages
                    .Take(6)
                    .Select(v => v.Script)
                    .Where(s => !string.IsNullOrWhiteSpace(s))
                    .ToList();

                // Generate new voice-over script
                var rawScript = await GetAICommercialVoiceOverScriptAsync(
                    CompanyName,
                    Industry,
                    promptText,
                    sceneScripts
                );

                // Bold scene headers before storing
                _aiVoiceOverScript = FormatScriptWithSceneHeaders(rawScript);

                // Save to database
                await SaveVoiceOverScriptToDatabaseAsync(VideoId, _aiVoiceOverScript);

                // Update all scenes with the new script
                await UpdateAllScenesWithCurrentSettings();

                Console.WriteLine("✅ Regenerated voice-over script");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error regenerating voice-over script: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error regenerating script: {ex.Message}");
        }
        finally
        {
            _regeneratingVoiceOverScript = false;
            StateHasChanged();
        }
    }
}

