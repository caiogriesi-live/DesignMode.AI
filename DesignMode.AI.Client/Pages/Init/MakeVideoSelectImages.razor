    private List<(string text, int index)> SplitTextIntoWords(string text, int maxWords = int.MaxValue)
    {
        if (string.IsNullOrWhiteSpace(text))
            return new List<(string text, int index)>();

        var words = Regex.Split(text, @"(\s+)")
            .Where(w => !string.IsNullOrWhiteSpace(w))
            .Take(maxWords)
            .Select((w, i) => (text: w, index: i))
            .ToList();

        return words;
    }

    private void StartTickerAnimation()
    {
        // Clear existing timer
        if (_tickerTimer != null)
        {
            _tickerTimer.Dispose();
            _tickerTimer = null;
        }

        // Calculate total animation time based on word count (approx 150ms per word)
        var totalTime = _scene1Words.Count * 150;

        // Calculate interval to update progress smoothly
        var interval = Math.Max(50, totalTime / 100); // Update at least every 50ms, up to 100 times total

        // Start new timer for ticker animation
        _tickerTimer = new Timer(async state =>
        {
            await InvokeAsync(() =>
            {
                if (_currentWordIndex < _scene1Words.Count)
                {
                    _currentWordIndex++;
                    _tickerProgress = (_currentWordIndex / (double)_scene1Words.Count) * 100;
                    StateHasChanged();
                }

                if (_currentWordIndex >= _scene1Words.Count)
                {
                    _tickerTimer?.Dispose();
                    _tickerTimer = null;
                }
            });
        }, null, 0, interval);
    }
    private async Task<string?> GenerateAudioForTextAsync(
        string text,
        string voice = "eve",
        int sceneNumber = 0,
        string language = "en",
        string? generationJobId = null)
    {
        await using var generationOperation = await BeginGenerationAsync();
        if (string.IsNullOrWhiteSpace(text) || sceneNumber < 0)
            return null;

        try
        {
            // Initialize audio state for this scene
            if (!_audioStates.ContainsKey(sceneNumber))
            {
                _audioStates[sceneNumber] = new AudioState();
            }

            _audioStates[sceneNumber].IsLoading = true;
            _isLoadingAudio = true;
            StateHasChanged();

            HttpClient client = new HttpClient();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var url = $"{ApiConfig.ApiBaseUrl}api/CallRunwareAudio?code=REDACTED_FOR_GROOMING";

                // CallRunwareAudio now uses Runware xAI TTS (xai:tts@0).
                // Send the xAI voice code directly; do not send ElevenLabs IDs or speed.
                var operationJobId = string.IsNullOrWhiteSpace(generationJobId)
                    ? Guid.NewGuid().ToString()
                    : generationJobId;
                var audioCid = GetQueryParameter(new Uri(NavigationManager.Uri).Query, "cid", null);
                var audioContext = await AttributionContext.AuthorizeGenerationAsync(audioCid);
                var payload = new
                {
                    text = text,
                    voice = _voices.Contains(voice) ? voice : "eve",
                    language = language,
                    generationJobId = operationJobId,
                    providerOperationId = $"{operationJobId}:voice:{sceneNumber}",
                    projectId = audioContext.ProjectId,
                    funnelId = audioContext.FunnelId
                };

                var token = await LocalStorage.GetItemAsync<string>("authToken");
                if (!string.IsNullOrWhiteSpace(token))
                    client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

                var jsonPayload = new StringContent(
                    System.Text.Json.JsonSerializer.Serialize(payload),
                    Encoding.UTF8,
                    "application/json"
                );

                var response = await client.PostAsync(url, jsonPayload);

                if (response.IsSuccessStatusCode)
                {
                    var responseBody = await response.Content.ReadAsStringAsync();
                    var result = System.Text.Json.JsonSerializer.Deserialize<AudioResultDto>(
                        responseBody,
                        new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                    );

                    if (result != null && !string.IsNullOrEmpty(result.AudioUrl))
                    {
                        _audioStates[sceneNumber].AudioUrl = result.AudioUrl;
                        _audioStates[sceneNumber].HasAudio = true;
                        await UsageRefresh.RequestRefreshAsync();

                        return result.AudioUrl;
                    }
                }
                else
                {
                    var errorBody = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"❌ Audio generation failed. Status: {response.StatusCode}. Response: {errorBody}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Failed to generate audio: {ex.Message}");
        }
        finally
        {
            if (_audioStates.ContainsKey(sceneNumber))
            {
                _audioStates[sceneNumber].IsLoading = false;
            }
            _isLoadingAudio = false;
            StateHasChanged();
        }

        return null;
    }

