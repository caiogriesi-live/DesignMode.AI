@using System.Collections.Generic
@using DesignMode.AI.Shared.Models
@using DesignMode.AI.Client.Services
@using Microsoft.AspNetCore.Components;
@using Microsoft.AspNetCore.Components.Authorization;

@if (IsBusy)
{
    <div class="modal-busy-overlay">
        <div class="loader"></div>
    </div>
}

@if (Show)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="vertical-modal-wrapper" @onclick:stopPropagation>
            <button class="modal-close" @onclick="CloseModal">×</button>

            <div class="modal-scroll-content">
                <div class="modal-header">
                    <h2>Edit Your Brand Kit</h2>
                </div>
                <div style="margin-bottom: 30px;">
                    Review and manage your selected images and videos
                </div>

                <!-- Brand Kit Status -->
                <div class="brand-kit-status">
                    <span class="brand-kit-count">
                        <span class="brand-kit-icon">✨</span>
                        @(SelectedImages?.Count ?? 0) assets in Brand Kit
                    </span>
                </div>

                <div class="image-grid">
                    @if (SelectedImages != null && SelectedImages.Any())
                    {
                        // Group by DeliverableType and SubCategory
                        var groupedImages = SelectedImages
                        .GroupBy(img => img.SubCategory?.ToLower() == "generic" ? img.DeliverableType : img.SubCategory);

                        foreach (var group in groupedImages)
                        {
                            var firstImage = group.First();
                            var sectionTitle = group.Key;

                            // If this is a generic group, get the DeliverableType from the first image
                            if (firstImage.SubCategory?.ToLower() == "generic")
                            {
                                sectionTitle = firstImage.DeliverableType;
                            }

                            <div class="deliverable-section">
                                <h3 class="section-title">@sectionTitle</h3>
                                <div class="image-col">
                                    @foreach (var image in group.OrderBy(i => i.CountId))
                                    {
                                        @ImageCard(image)
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <p>No images selected for your concept</p>
                        </div>
                    }
                </div>
            </div>

            <div class="footer-actions sticky-footer">
                <button class="discard-button" @onclick="CloseModal">
                    Discard
                </button>
                <button class="save-button"
                        @onclick="SaveChanges"
                        disabled="@(!HasChanges)"
                        style="@(!HasChanges ? "background-color:#eee; color: #ababab;" : null)">
                    @GetSaveButtonText()
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private ApiConfigService ApiConfig { get; set; }
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; }
    [Inject] private HttpClient Http { get; set; }

    private bool IsBusy = false;

    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public List<DesignMode.AI.Client.Pages.Init.Gen.ConceptImageWithIdeaDto> SelectedImages { get; set; }
    [Parameter] public EventCallback<List<string>> OnImagesRemoved { get; set; }
    [Parameter] public EventCallback<bool> OnConfirm { get; set; }

    private HashSet<string> SelectedImageUrls = new();
    private HashSet<string> SelectedImageIds = new();
    private List<string> RemovedImages = new();
    private bool HasChanges => RemovedImages.Count > 0;
    private bool IsConceptPopoverVisible = false;

    protected override void OnParametersSet()
    {
        if (SelectedImages != null && SelectedImages.Any())
        {
            SelectedImageUrls = new HashSet<string>(SelectedImages.Select(x => x.ImageUrl));
            SelectedImageIds = new HashSet<string>(SelectedImages.Select(x => x.ImageId));
            RemovedImages.Clear();
        }
        else
        {
            SelectedImageUrls.Clear();
            SelectedImageIds.Clear();
            RemovedImages.Clear();
        }
    }

    private void ToggleSelection(string url, string id)
    {
        if (RemovedImages.Contains(id))
        {
            RemovedImages.Remove(id);
        }
        else
        {
            RemovedImages.Add(id);
        }
        StateHasChanged();
    }

    private string GetSaveButtonText()
    {
        if (!HasChanges)
        {
            return SelectedImages?.Any() ?? false ? "No Changes Made" : "No Assets Selected";
        }

        return $"Update Brand Kit ({RemovedImages.Count} asset{(RemovedImages.Count > 1 ? "s" : "")} to remove)";
    }

    private async Task SaveChanges()
    {
        if (IsBusy) return;

        IsBusy = true;
        StateHasChanged();

        try
        {
            bool allOperationsSuccessful = true;

            // Process removals
            if (RemovedImages.Any())
            {
                foreach (var imageId in RemovedImages)
                {
                    bool removed = await DeleteConceptImageFromDatabaseAsync(imageId);
                    if (!removed)
                    {
                        allOperationsSuccessful = false;
                    }
                }
            }

            if (allOperationsSuccessful)
            {
                // Success: hide balloon, close modal
                IsConceptPopoverVisible = false;

                // Notify parent of removed images
                if (OnImagesRemoved.HasDelegate)
                {
                    await OnImagesRemoved.InvokeAsync(RemovedImages.ToList());
                }

                if (OnConfirm.HasDelegate)
                {
                    await OnConfirm.InvokeAsync(true);
                }

                // Reset changes after successful save
                RemovedImages.Clear();

                IsBusy = false;

                // Close the modal
                await CloseModal();
            }
            else
            {
                // Handle partial failure
                Console.WriteLine("Some operations failed. Please try again.");
            }
        }
        finally
        {
            IsBusy = false;
            StateHasChanged();
        }
    }

    private async Task<bool> DeleteConceptImageFromDatabaseAsync(string imageId)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var requestBody = new { ImageId = imageId };

                var response = await Http.PostAsJsonAsync(
                    $"{ApiConfig.ApiBaseUrl}api/DeleteConceptImage?code=REDACTED_FOR_GROOMING",
                    requestBody);

                if (response.IsSuccessStatusCode)
                {
                    Console.WriteLine("✅ Deleted concept image successfully.");
                    return true;
                }
                else
                {
                    Console.WriteLine($"❌ Failed to delete concept image: {response.StatusCode}");
                    return false;
                }
            }

            Console.WriteLine("⚠️ User not authenticated.");
            return false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception deleting concept image: {ex.Message}");
            return false;
        }
    }

    private async Task CloseModal()
    {
        if (IsBusy)
            return;

        // Reset the state when closing
        RemovedImages.Clear();
        Show = false;
        await ShowChanged.InvokeAsync(false);
    }

    private RenderFragment ImageCard(DesignMode.AI.Client.Pages.Init.Gen.ConceptImageWithIdeaDto image) => __builder =>
    {
        var isMarkedForRemoval = RemovedImages.Contains(image.ImageId);

        <div class="image-card @(isMarkedForRemoval ? "marked-for-removal" : "in-brand-kit")"
             @onclick="() => ToggleSelection(image.ImageUrl, image.ImageId)">
            <img src="@image.ImageUrl" alt="Concept image" class="image-thumb" />
            <div class="image-controls">
                <div class="brand-kit-indicator @(isMarkedForRemoval ? "remove" : "selected")"
                     @onclick="() => ToggleSelection(image.ImageUrl, image.ImageId)"
                @onclick:stopPropagation>
                    @if (isMarkedForRemoval)
                    {
                        <span class="indicator-icon" title="Click to keep in Brand Kit">+</span>
                    }
                    else
                    {
                        <span class="indicator-icon" title="Click to remove from Brand Kit">✓</span>
                    }
                </div>
            </div>
            @if (isMarkedForRemoval)
            {
                <div class="change-badge remove-badge">
                    <span class="badge-icon">−</span>
                    To Remove
                </div>
            }
            else
            {
                <div class="brand-kit-badge">
                    <span class="badge-icon">✨</span>
                    In Brand Kit
                </div>
            }
        </div>
    };
}

