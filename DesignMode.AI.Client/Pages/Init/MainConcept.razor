                    var cardClass1 = "concept-card";
                    if (isSelected0) cardClass1 += " selected";
                    else if (!string.IsNullOrEmpty(SelectedPrimaryImageId)) cardClass1 += " blurred";
                    cardClass1 += finishedGenerating ? " concept-card-animate-ready" : " concept-card-animate-loading";

