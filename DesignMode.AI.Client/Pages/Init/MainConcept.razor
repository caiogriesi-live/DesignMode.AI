    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (finishedGenerating) await Analytics.TrackAsync("creative_directions_viewed", new { result_count = 3 }, once: true);
        if (firstRender && !isPreloading)
        {
            await JS.InvokeVoidAsync("initScrollAnimation");
            await JS.InvokeVoidAsync("initVerticalTicker");
            await JS.InvokeVoidAsync("initVerticalTextTicker");
            await JS.InvokeVoidAsync("initStepBadge");
        }
        else if (firstRender)
        {
            await JS.InvokeVoidAsync("initScrollAnimation");
            await JS.InvokeVoidAsync("initVerticalTicker");
            await JS.InvokeVoidAsync("initVerticalTextTicker");
            await JS.InvokeVoidAsync("initStepBadge");
        }

        // Check if we need to trigger the center animation
        if (!string.IsNullOrEmpty(SelectedPrimaryImageId) && !isConceptCentered && finishedGenerating && !isRedirecting)
        {
            isConceptCentered = true;
            selectedImageIdForJS = SelectedPrimaryImageId;
