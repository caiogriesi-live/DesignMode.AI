<!-- FULL PAGE CONTENT - NO MODAL -->
<div class="full-page-init">

    <div class="vertical-modal-wrapper-init" style="overflow: hidden !important;" @onclick:stopPropagation>

        <div class="modal-scroll-content-init">

            <!-- HEADER WITH LOADING STATUS -->
            <div class="brand-header">
                @if (!finishedGenerating)
                {
                    <h2>@(WebsiteFunnel ? "✨ Choose your website direction" : "✨ Your Designer System Has Prepared 3 Creative Directions")</h2>
                    <p>
                        Select the direction that best matches your vision and continue to see what your designer has prepared next.
                    </p>
                    <div class="loading-status-header" style="margin-top:-3px !important;">
                        <!-- Hidden ticker steps that still track progress for JS functions -->
                        <div class="vertical-ticker" style="display:none;">
                            <div class="ticker-item" data-step="1">
                                <span class="ticker-icon">🔍</span>
                                <span class="ticker-text">Understanding your brand</span>
                                <span class="ticker-status"></span>
                            </div>
                            <div class="ticker-item" data-step="2">
                                <span class="ticker-icon">🎨</span>
                                <span class="ticker-text">Exploring visual directions</span>
                                <span class="ticker-status"></span>
                            </div>
                            <div class="ticker-item" data-step="3">
                                <span class="ticker-icon">✨</span>
                                <span class="ticker-text">Crafting your first concepts</span>
                                <span class="ticker-status"></span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <h2>@(WebsiteFunnel ? "✨ Choose your website direction" : "✨ Your Designer System Has Prepared 3 Creative Directions")</h2>
                    <p>
                        Select the direction that best matches your vision and continue to see what your designer has prepared next.
                    </p>
                    <div class="recommended-strip">
                        <span>👩‍🎨 Recommended by your designer system</span>
                    </div>
                }
            </div>

            <!-- CONCEPT CARDS -->
            <div class="concept-grid" id="conceptGrid">
                <!-- Card 1 -->
                @if (loadingImage1)
                {
                    <div class="concept-card-pre loading-card concept-card-animate-loading" style="cursor:default; animation-delay: 0.3s;" disabled="true">
                        <div class="loading-image-placeholder shimmer-container">
                            <div class="shimmer-wrapper">
                                <div class="shimmer-effect"></div>
                            </div>
                            <div class="pulse-animation"></div>
                            <p>Finalizing concept...</p>
