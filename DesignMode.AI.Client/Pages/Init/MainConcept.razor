    private async Task<bool> UpdateInviteClientImageId(string id, string name, string imageId)
    {
        try
        {
            var client = new HttpClient();

            var requestBody = new
            {
                id = id,
                name = name,
                imageId = imageId
            };

            var json = System.Text.Json.JsonSerializer.Serialize(requestBody);
            var content = new StringContent(json, Encoding.UTF8, "application/json");

            var response = await client.PostAsync(
                $"{ApiConfig.ApiBaseUrl}api/UpdateInviteClientImageIdByIdAndName?code=REDACTED_FOR_GROOMING",
                content
            );

            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"✅ Successfully updated ImageId for Id: {id}, Name: {name}");
                Console.WriteLine($"Response: {responseContent}");
                return true;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"❌ Failed to update ImageId: {response.StatusCode}, Error: {errorContent}");
                return false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception updating InviteClient ImageId: {ex.Message}");
            return false;
        }
    }

    private async Task<string?> SaveInviteClientImageAsync(
        string inviteId,
        string imageId,
        string imageUrl,
        string countId,
        string style,
        string stylePrompt,
        string important,
        string project,
        string outputRequirements)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var requestBody = new
                {
                    InviteId = inviteId,
                    ImageId = imageId,
                    ImageUrl = imageUrl,
                    CountId = countId,
                    TimeStamp = DateTime.UtcNow.ToString("o"),

                    Style = style,
                    StylePrompt = stylePrompt,
                    Important = important,
                    Project = project,
                    OutputRequirements = outputRequirements
                };

                var response = await Http.PostAsJsonAsync(
                    $"{ApiConfig.ApiBaseUrl}api/SaveInviteClientImage?code=REDACTED_FOR_GROOMING",
                    requestBody);

                if (!response.IsSuccessStatusCode)
                {
                    Console.WriteLine($"❌ Failed to save invite client image: {response.StatusCode}");
                    return null;
                }

                var jsonResponse = await response.Content
                    .ReadFromJsonAsync<SaveInviteClientImageResponse>();

                Console.WriteLine("✅ Invite client image saved successfully.");

                return jsonResponse?.Id;
            }

            Console.WriteLine("⚠️ User not authenticated. Skipping invite client image save.");
            return null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception in SaveInviteClientImageAsync: {ex.Message}");
            return null;
        }
    }

    public class SaveInviteClientImageResponse
