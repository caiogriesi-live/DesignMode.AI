    private async Task<List<InviteClientImage>> FetchInviteClientImages(
    string inviteId)
    {
        HttpClient client = new HttpClient();

        string functionUrl =
            $"{ApiConfig.ApiBaseUrl}api/GetInviteClientImages?code=REDACTED_FOR_GROOMING";

        var response = await client.PostAsJsonAsync(
            functionUrl,
            new
            {
                InviteId = inviteId
            });

        if (response.IsSuccessStatusCode)
        {
            return await response.Content.ReadFromJsonAsync<List<InviteClientImage>>()
                   ?? new List<InviteClientImage>();
        }

        return new List<InviteClientImage>();
    }

