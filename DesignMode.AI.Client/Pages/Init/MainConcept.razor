    private async Task<InviteClientData> GetInviteClientByEmail(string email, string inviteId)
    {
        try
        {
            var client = new HttpClient();

            var requestBody = new
            {
                email = email,
                id = inviteId   // ✅ added
            };

            var json = System.Text.Json.JsonSerializer.Serialize(requestBody);
            var content = new StringContent(json, Encoding.UTF8, "application/json");

            var response = await client.PostAsync(
                $"{ApiConfig.ApiBaseUrl}api/GetInviteClientByEmail?code=REDACTED_FOR_GROOMING",
                content
            );

            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Response content: {responseContent}");

                using var document = System.Text.Json.JsonDocument.Parse(responseContent);

                var root = document.RootElement;

                if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    var firstItem = root;

                    string GetStringValue(System.Text.Json.JsonElement element, string propertyName)
                    {
                        if (element.TryGetProperty(propertyName, out var property))
                            return ExtractSValue(property);

                        foreach (var prop in element.EnumerateObject())
                        {
                            if (prop.Name.Equals(propertyName, StringComparison.OrdinalIgnoreCase))
                                return ExtractSValue(prop.Value);
                        }

                        return null;
                    }

                    bool GetBoolValue(System.Text.Json.JsonElement element, string propertyName)
                    {
                        if (element.TryGetProperty(propertyName, out var property))
                            return ExtractBoolValue(property);

                        foreach (var prop in element.EnumerateObject())
                        {
                            if (prop.Name.Equals(propertyName, StringComparison.OrdinalIgnoreCase))
                                return ExtractBoolValue(prop.Value);
                        }

                        return false;
                    }

                    bool ExtractBoolValue(System.Text.Json.JsonElement property)
                    {
                        if (property.ValueKind == System.Text.Json.JsonValueKind.Object)
                        {
                            if (property.TryGetProperty("BOOL", out var boolValue))
                                return boolValue.GetBoolean();

                            if (property.TryGetProperty("bool", out var boolValueLower))
                                return boolValueLower.GetBoolean();

                            if (property.TryGetProperty("S", out var stringValue))
                                return bool.TryParse(stringValue.GetString(), out var parsed) && parsed;

                            if (property.TryGetProperty("s", out var stringValueLower))
                                return bool.TryParse(stringValueLower.GetString(), out var parsed) && parsed;
                        }

                        if (property.ValueKind is System.Text.Json.JsonValueKind.True
                            or System.Text.Json.JsonValueKind.False)
                            return property.GetBoolean();

                        if (property.ValueKind == System.Text.Json.JsonValueKind.String)
                            return bool.TryParse(property.GetString(), out var parsed) && parsed;

                        return false;
                    }

                    string ExtractSValue(System.Text.Json.JsonElement property)
                    {
                        if (property.ValueKind == System.Text.Json.JsonValueKind.Object)
                        {
                            if (property.TryGetProperty("s", out var s))
                                return s.GetString();

                            if (property.TryGetProperty("S", out var S))
                                return S.GetString();
                        }

                        if (property.ValueKind == System.Text.Json.JsonValueKind.String)
                            return property.GetString();

                        return null;
                    }

                    var inviteData = new InviteClientData
                        {
                            Id = GetStringValue(firstItem, "Id"),
                            Name = GetStringValue(firstItem, "Name"),
                            Industry = GetStringValue(firstItem, "Industry"),
                            Prompt = GetStringValue(firstItem, "Prompt"),
                            Email = GetStringValue(firstItem, "Email"),
                            ImagePath = GetStringValue(firstItem, "ImagePath") ?? GetStringValue(firstItem, "Imagepath"),
                            ImageId = GetStringValue(firstItem, "ImageId"),
                            UseSameImageSeedForAll = GetBoolValue(firstItem, "UseSameImageSeedForAll"),
                            TimeStamp = GetStringValue(firstItem, "Timestamp") ?? GetStringValue(firstItem, "TimeStamp")
                        };

                    Console.WriteLine($"✅ Retrieved invite data for email: {email}");
                    return inviteData;
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                Console.WriteLine($"⚠️ No invite found for email: {email}");
                return null;
            }

            var errorContent = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"❌ Failed: {response.StatusCode}, Error: {errorContent}");
            return null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception: {ex.Message}");
            return null;
        }
    }

    private async void SelectPrimaryImage(string imageId)
    {
        if (isRedirecting) return; // Prevent multiple selections
        await Analytics.TrackAsync("main_concept_selected", new { funnel_stage = "directions" });

        var uri = NavigationManager.Uri;
        var queryParams = QueryHelpers.ParseQuery(new Uri(uri).Query);

        // Check for encrypted email parameter
        if (queryParams.TryGetValue("e", out var encryptedEmail) &&
        queryParams.TryGetValue("id", out var inviteId))
        {
            // Decrypt the email
            var decryptedEmail = DecryptEmail(encryptedEmail);
            Console.WriteLine($"✅ 'e' parameter detected, attempting to decrypt...");

            // ✅ Fetch invite data using email + invite ID
            InviteData = await GetInviteClientByEmail(decryptedEmail, inviteId);

            IsLoadingInviteData = true;
            StateHasChanged();

            // Decrypt the email
            decryptedEmail = DecryptEmail(encryptedEmail);

            // Call update function with email + imageId
            if (!string.IsNullOrEmpty(decryptedEmail) && !string.IsNullOrEmpty(imageId))
            {
                var updateSuccess = await UpdateInviteClientImageId(InviteData.Id, InviteData.Name, imageId);

                if (updateSuccess)
                {
                    Console.WriteLine($"✅ InviteClient updated with ImageId: {imageId} for {decryptedEmail}");
                    SelectedPrimaryImageId = imageId;
                    isExpanded = true;
                    showBrandPreview = true;
                    showFooterAnimation = true;
                    isConceptCentered = false; // Reset so animation triggers
                    selectedImageIdForJS = imageId;
                    StateHasChanged();

                    // The redirect will happen in OnAfterRenderAsync after the center animation completes
                }
                else
                {
                    if (WebsiteFunnel) { IsLoadingInviteData = false; return; }
                    Console.WriteLine($"⚠️ Failed to update InviteClient ImageId for {decryptedEmail}");
                }
            }

            IsLoadingInviteData = false;
        }

        SelectedPrimaryImageId = imageId;
        isExpanded = true;
        showBrandPreview = true;
        showFooterAnimation = true;
        isConceptCentered = false; // Reset so animation triggers
        selectedImageIdForJS = imageId;
        StateHasChanged();
    }

    private async Task PerformRedirect()
    {
        if (isRedirecting) return;
        isRedirecting = true;

        var uri = NavigationManager.Uri;
        var queryParams = QueryHelpers.ParseQuery(new Uri(uri).Query);

        var encryptedEmailParamId = "";

        // Store URL parameters for redirect
        if (queryParams.TryGetValue("eid", out var encryptedEmailId))
        {
            encryptedEmailParamId = encryptedEmailId.ToString();
        }

        // Build the redirect URL with the same parameters
        string redirectUrl = $"/init/funnelend?i=1&id={inviteIdParam}&e={encryptedEmailParam}&eid={encryptedEmailParamId}";

        if (WebsiteFunnel) redirectUrl = QueryHelpers.AddQueryString("/init/funnelendwebsite",
            queryParams.ToDictionary(pair => pair.Key, pair => (string?)pair.Value.ToString()));

        // Add a small delay to ensure the animation is fully visible
        //await Task.Delay(300);

        // Navigate to the next page
        NavigationManager.NavigateTo(redirectUrl, true);
    }

    private string DecryptEmail(string encryptedEmail)
    {
        if (string.IsNullOrEmpty(encryptedEmail))
            return "";

        try
        {
            var decoded = Uri.UnescapeDataString(encryptedEmail);
            var bytes = Convert.FromBase64String(decoded);
            return Encoding.UTF8.GetString(bytes);
        }
        catch
        {
            return "";
        }
    }

    private void OnUnlockClick()
    {
        Console.WriteLine($"Unlocking concept: {SelectedPrimaryImageId}");

        if (InviteData != null)
        {
            Console.WriteLine($"For client: {InviteData.Name} ({InviteData.Email})");

            // Get current full URL
            var curUrl = NavigationManager.Uri;

            // Encode it for safe query string usage
            var encodedUrl = Uri.EscapeDataString(curUrl);

            NavigationManager.NavigateTo($"/init/upgrade?b={encodedUrl}", true);
        }
    }
    private async Task<string> FetchPromptIdInit(string userId, string companyIdeaId)
    {
        HttpClient client = new HttpClient();
        string functionUrl = $"{ApiConfig.ApiBaseUrl}api/GetPromptIdForCompanyIdea?code=REDACTED_FOR_GROOMING&userId={Uri.EscapeDataString(userId)}&companyIdeaId={Uri.EscapeDataString(companyIdeaId)}";

        var response = await client.GetAsync(functionUrl);

        if (response.IsSuccessStatusCode)
        {
            var promptId = await response.Content.ReadAsStringAsync();
            return promptId.Trim('"'); // Remove extra quotes if returned as a string
        }

        return "Error: Unable to fetch prompt ID.";
    }

