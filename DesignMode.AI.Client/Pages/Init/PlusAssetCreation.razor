@if (IsBusy)
{
    <div class="modal-busy-overlay">
        <div class="loader"></div>
    </div>
}

@if (Show)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="vertical-modal-wrapper" style="height: auto; min-height: fit-content; padding-bottom: 0px;" @onclick:stopPropagation>
            <button class="modal-close" @onclick="CloseModal">×</button>

            <div class="modal-scroll-content" style="margin-left: -34px;margin-right: 6px;overflow-y:hidden;">
                <div class="modal-header">
                    <h2>@DeliverableName</h2>
                </div>
                <div style="margin-bottom: 30px;">
                </div>
                <div class="image-grid" style="margin-bottom: 8px;">
                    <!-- Options -->
                    <div class="asset-options">
                        <!-- Option 1: Create New -->
                        <div class="asset-card">
                            <div class="asset-icon">
                                <img src="assets/img/create-new.png" style="width: 75px;margin-left: -11px;" />
                            </div>
                            <h3>Create New</h3>
                            <p>Generate another AI image for your @DeliverableName to keep building your visual set or explore new styles.</p>
                            <button class="btn-blue" style="background-color:#f5f7fa;color:#000;" @onclick="GenerateImage">Generate Image</button>
                        </div>

                        <!-- Option 2: Upload Brand Image -->
                        @* <div class="asset-card">
                            <div class="asset-icon icon-upload"></div>
                            <h3>Upload Brand Image</h3>
                            <p>Upload your logo or existing brand visuals. The AI will generate matching assets or extend your brand system.</p>
                            <button class="btn-yellow" style="background-color:#000;color:#fff;">Upload Brand Image</button>
                        </div> *@

                        <!-- Option 3: Dynamic Template -->
                        <div class="asset-card" style="border: 2px dashed #244d88;">
                            <div class="asset-icon">
                                <img src="@DynamicOptionImage" style="@DynamicOptionImageDim" />
                            </div>
                            <h3>@DynamicOption.Title</h3>
                            <p>@DynamicOption.Description</p>
                            <button class="btn-green" @onclick="HandleDynamicOptionClick" style="background-color:#244d88;color:white;">@DynamicOption.ButtonLabel</button>
                        </div>
                    </div>
                    @functions {
                    RenderFragment ImageCard(DesignMode.AI.Client.Pages.Init.Gen.ConceptImageWithIdeaDto image) => __builder =>
                    {
                        var isMarkedForRemoval = RemovedImages.Contains(image.ImageId);
                        <div class="image-card @(isMarkedForRemoval ? "marked-for-removal" : "")"
                             @onclick="() => ToggleSelection(image.ImageUrl, image.ImageId)">
                            <img src="@image.ImageUrl" alt="Concept image" class="image-thumb" />
                            <div class="image-controls">
                                <button class="icon-btn"
                                        @onclick="() => ToggleSelection(image.ImageUrl, image.ImageId)"
                                        alt="Remove from Concept"
                                @onclick:stopPropagation>
                                    @if (isMarkedForRemoval)
                                    {
                                        <span style="color: red;font-weight: bold;">✕</span>
                                    }
                                    else
                                    {
                                        <text>🗑️</text>
                                    }
                                </button>
                            </div>
                        </div>
                    };
                }
            </div>
        </div>


    </div>
</div>
}

