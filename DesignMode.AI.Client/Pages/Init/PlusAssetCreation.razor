    private string finalPrompt { get; set; } = "";

    protected override void OnParametersSet()
    {
        if (Show)
        {
            var deliverableName = DeliverableName;
            var normalizedDeliverable = Normalize(deliverableName);

            Console.WriteLine($"CreateNewImage modal opened for deliverable: {deliverableName}");

            // Check single PromptText
            if (!string.IsNullOrEmpty(PromptText))
            {
                var parts = PromptText.Split('|');
                if (parts.Length > 5)
                {
                    var normalizedPart = Normalize(parts[5]);

                    if (normalizedPart.Contains(normalizedDeliverable) ||
                        normalizedDeliverable.Contains(normalizedPart))
                    {
                        finalPrompt = PromptText;
                    }
                }
            }

            // Check PromptTexts list
            if (PromptTexts != null)
            {
                foreach (var prompt in PromptTexts)
                {
                    var parts = prompt.Split('|');
                    if (parts.Length > 5)
                    {
                        var normalizedPart = Normalize(parts[5]);

                        if (normalizedPart.Contains(normalizedDeliverable) ||
                            normalizedDeliverable.Contains(normalizedPart))
                        {
                            finalPrompt = prompt;
                            break;
                        }
                    }
                }
            }
        }
        if (SelectedImages != null && SelectedImages.Any())
        {
            // Store the original list of images
            OriginalImages = new List<DesignMode.AI.Client.Pages.Init.Gen.ConceptImageWithIdeaDto>(SelectedImages);

            SelectedImageUrls = new HashSet<string>(SelectedImages.Select(x => x.ImageUrl));
            SelectedImageIds = new HashSet<string>(SelectedImages.Select(x => x.ImageId));
            RemovedImages.Clear();
        }
        else
        {
            OriginalImages.Clear();
            SelectedImageUrls.Clear();
            SelectedImageIds.Clear();
            RemovedImages.Clear();
        }
    }

    private string Normalize(string input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return string.Empty;

        return Regex.Replace(input, @"[\s\-_\|]", "")
                    .ToLowerInvariant()
                    .Trim();
    }

    private void ToggleSelection(string url, string id)
    {
        if (SelectedImageUrls.Contains(url))
        {
            SelectedImageUrls.Remove(url);
            SelectedImageIds.Remove(id);
            RemovedImages.Add(id);
        }
        else
        {
            SelectedImageUrls.Add(url);
            SelectedImageIds.Add(id);
            RemovedImages.Remove(id);
        }
    }

    private async Task SaveChanges()
    {
        IsBusy = true;

        bool confirmed = false;

        foreach (var imageId in RemovedImages)
        {
            confirmed = await DeleteConceptImageFromDatabaseAsync(imageId);
        }

        IsBusy = false;

        if (confirmed)
        {
            // Success: hide balloon, close modal
            IsConceptPopoverVisible = false;

            // Notify parent of removed images
            if (OnImagesRemoved.HasDelegate)
            {
                await OnImagesRemoved.InvokeAsync(RemovedImages.ToList());
            }

            if (OnConfirm.HasDelegate)
            {
                await OnConfirm.InvokeAsync(true);
            }

            await CloseModal();


            if (Show) return;
        }
        else
        {
            // Failure: show balloon again
            IsConceptPopoverVisible = true;
        }
    }
    private async Task<bool> DeleteConceptImageFromDatabaseAsync(string imageId)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var requestBody = new { ImageId = imageId };

                var response = await Http.PostAsJsonAsync(
                    $"{ApiConfig.ApiBaseUrl}api/DeleteConceptImage?code=REDACTED_FOR_GROOMING",
                    requestBody);

                if (response.IsSuccessStatusCode)
                {
                    Console.WriteLine("✅ Deleted concept image successfully.");
                    return true;
                }
                else
                {
                    Console.WriteLine($"❌ Failed to delete concept image: {response.StatusCode}");
                    return false;
                }
            }

            Console.WriteLine("⚠️ User not authenticated.");
            return false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception deleting concept image: {ex.Message}");
            return false;
        }
    }


    private async Task CloseModal()
    {
        if (GenerationGuard is null && (IsBusy)) return;
        if (!await ConfirmGenerationCloseAsync()) return;

        // Reset the state when closing
        RemovedImages.Clear();
        Show = false;
        await ShowChanged.InvokeAsync(false);
    }
}

