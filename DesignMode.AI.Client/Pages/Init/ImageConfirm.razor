@code {
    @using System.Text.Json;

    @using DesignMode.AI.Client.Services;
    @using DesignMode.AI.Shared.Models;
    @using Microsoft.AspNetCore.Components;
    @using Microsoft.AspNetCore.Components.Authorization;
    @using Newtonsoft.Json;
    @using System.Net.Http.Json;
    @using System.Text;
    @using System.Text.RegularExpressions;

    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string ImageUrl { get; set; }
    [Parameter] public string ImageId { get; set; }
    [Parameter] public string PromptId { get; set; }
    [Parameter] public string CompanyIdeaId { get; set; }
    [Parameter] public bool Save { get; set; }
    [Parameter] public bool IsVideo { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public EventCallback<bool> OnConfirm { get; set; }



    [Inject] private NavigationManager NavigationManager { get; set; }
    [Inject] private ApiConfigService ApiConfig { get; set; }
    [Inject] private SessionService _sessionService { get; set; }
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; }
    [Inject] private HttpClient Http { get; set; }

    private bool IsConceptPopoverVisible = false;

    private bool IsSaved = false;
    // Add this to the ImageConfirm modal's code
    [Parameter] public EventCallback<bool> IsBusyChanged { get; set; }

    private bool _isBusy;
    private bool IsBusy
    {
        get => _isBusy;
        set
        {
            if (_isBusy != value)
            {
                _isBusy = value;
                IsBusyChanged.InvokeAsync(value);
            }
        }
    }


    private async Task CloseModal()
    {
        if (IsBusy)
            return;

        Show = false;
        await ShowChanged.InvokeAsync(false);
    }

    private async Task HandleSaveOrDelete()
    {
        IsBusy = true;

        bool confirmed = false;

        if (Save)
        {
            var result = await SaveConceptImageToDatabaseAsync(ImageId, CompanyIdeaId, PromptId);
            confirmed = result != null;
        }
        else
        {
            confirmed = await DeleteConceptImageFromDatabaseAsync(ImageId);
        }

        IsSaved = true;
        IsBusy = false;

        if (confirmed)
        {
            // Success: hide balloon, close modal
            IsConceptPopoverVisible = false;

            if (OnConfirm.HasDelegate)
            {
                await OnConfirm.InvokeAsync(true);
            }

            await CloseModal();
        }
        else
        {
            // Failure: show balloon again
            IsConceptPopoverVisible = true;
        }
    }
    private async Task<string?> SaveConceptImageToDatabaseAsync(string imageId, string companyIdeaId, string promptId)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                string userId = user.Identity.Name;

                var requestBody = new
                {
                    ImageId = imageId,
                    CompanyIdeaId = companyIdeaId,
                    PromptId = promptId
                };

                var response = await Http.PostAsJsonAsync(
                    $"{ApiConfig.ApiBaseUrl}api/SaveConceptImage?code=REDACTED_FOR_GROOMING",
                    requestBody
                );

                if (!response.IsSuccessStatusCode)
                {
                    Console.WriteLine($"❌ Failed to save concept image: {response.StatusCode}");
                    return null;
                }
                else
                {
                    var jsonResponse = await response.Content.ReadFromJsonAsync<SaveConceptImageResponse>();
                    Console.WriteLine("✅ Concept image saved successfully.");
                    return jsonResponse?.Guid;
                }
            }
            else
            {
                Console.WriteLine("⚠️ User not authenticated. Skipping concept image save.");
                return null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception in SaveConceptImageToDatabaseAsync: {ex.Message}");
            return null;
        }
    }

    private async Task<bool> DeleteConceptImageFromDatabaseAsync(string imageId)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                string userId = user.Identity.Name;

                var requestBody = new
                {
                    ImageId = imageId
                };

                var response = await Http.PostAsJsonAsync($"{ApiConfig.ApiBaseUrl}api/DeleteConceptImage?code=REDACTED_FOR_GROOMING", requestBody);

                if (!response.IsSuccessStatusCode)
                {
                    Console.WriteLine($"❌ Failed to delete concept image: {response.StatusCode}");
                    return false;
                }
                else
                {
                    Console.WriteLine("✅ Concept image deleted successfully.");
                    return true;
                }
            }
            else
            {
                Console.WriteLine("⚠️ User not authenticated. Skipping concept image delete.");
                return false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception in DeleteConceptImageFromDatabaseAsync: {ex.Message}");
            return false;
        }
    }

    public class SaveConceptImageResponse
    {
        public string Guid { get; set; }
    }

    private async Task Confirm(bool confirmed)
    {
        IsConceptPopoverVisible = false;

        if (OnConfirm.HasDelegate)
        {
            await OnConfirm.InvokeAsync(confirmed);
        }

        Show = false;
        await ShowChanged.InvokeAsync(false);
    }

    [Parameter]
    public string DeliverableName { get; set; } = "Expand to Video";

    private string GetDeliverableName()
    {
        var deliverable = DeliverableName?.ToLower() ?? "";

        if (deliverable.Contains("social"))
        {
            DeliverableName = "Expand into Post";
        }
        else if (deliverable.Contains("web"))
        {
            DeliverableName = "Expand into Website";
        }
        else if (deliverable.Contains("print"))
        {
            DeliverableName = "Expand into Print";
        }
        else if (deliverable.Contains("label"))
        {
            DeliverableName = "Expand into Label";
        }
        else if (deliverable.Contains("digital"))
        {
            DeliverableName = "Expand into Campaign";
        }
        else if (deliverable.Contains("video"))
        {
            DeliverableName = "Expand into Video";
        }
        else if (deliverable.Contains("logo"))
        {
            DeliverableName = "Expand into Branding";
        }
        else if (deliverable.Contains("event"))
        {
            DeliverableName = "Expand into Event";
        }
        else
        {
            DeliverableName = "Use Template Asset";
        }

        return DeliverableName;
    }



}

<link href="assets/css/imageconfirmmodal.css" rel="stylesheet" />
@if (IsBusy)
{
    <div class="modal-busy-overlay">
        <div class="loader"></div>
    </div>
}
@if (Show)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-wrapper" @onclick:stopPropagation>
            <button class="modal-close" @onclick="CloseModal">×</button>
            @if (IsVideo)
            {
                <div class="video-indicator-confirm">
                    <svg width="50" height="50" viewBox="0 0 24 24" fill="white" style="filter: drop-shadow(0 1px 2px rgba(0,0,0,0.5));">
                        <path d="M10 16.5l6-4.5-6-4.5v9zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" />
                    </svg>
                </div>
            }
            <img src="@ImageUrl" alt="Full Size Image" class="modal-image" />
            <div class="modal-bottom" style="@(Save ? "padding: 0 1.3rem;" : "padding: 0 0.7em;")">

                @if (IsVideo)
                {
                    <!-- VIDEO-SPECIFIC BUTTONS -->
                    <button class="discard-button" style="background-color:#f5f7fa;" @onclick="() => Confirm(false)" disabled="@IsBusy">
                        ✏️ Edit Video
                    </button>
                }
                else
                {
                    <!-- IMAGE / OTHER ASSET BUTTONS -->
                    <button class="discard-button" @onclick="() => Confirm(false)" disabled="@IsBusy">
                        <span class="arrow">&#x21bb;</span> Make Similar
                    </button>

                    <button class="discard-button" style="background-color:#000;color: #fff;" @onclick="() => Confirm(false)" disabled="@IsBusy">
                        Upload Brand
                    </button>

                    <button class="discard-button" style="background-color:#f5f7fa;" @onclick="() => Confirm(false)" disabled="@IsBusy">
                        ➕ @GetDeliverableName()
                    </button>
                }

                <!-- This one can be shared -->
                <button title="@(Save ? "Adds this asset to your Brand Kit" : "Remove this asset from your Brand Kit")"
                        class="@(Save ? "save-button" : "remove-button")"
                        @onclick="HandleSaveOrDelete"
                        disabled="@IsBusy">
                    @(Save ? "Save Into Brand Kit" : "Remove From Brand Kit")
                </button>
            </div>

        </div>
    </div>
}
<style>
    .modal-bottom {
        background-color: white;
        height: 75px;
        display: flex;
        justify-content: space-between; /* Changed from center */
        align-items: center;
        border-top: 1px solid #eee;
        padding: 0 1.5rem; /* Add horizontal padding */
    }

    .bottom-button {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 0.6rem 1.2rem;
        font-size: 1rem;
        border-radius: 6px;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .bottom-button:hover {
            background-color: #0056b3;
        }

    .modal-image {
        width: 100%;
        display: block;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
        border-bottom-left-radius: 0; /* Remove bottom radius */
        border-bottom-right-radius: 0;
        box-shadow: none; /* Remove any shadow */
    }
    .modal-busy-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.7);
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
}

.loader {
    border: 4px solid #f3f3f3;
    border-top: 4px solid #007bff;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    animation: spin 1s linear infinite;
}

@@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

    .video-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(0, 0, 0, 0.75);
        color: white;
        font-size: 16px;
        padding: 6px 10px;
        border-radius: 20px;
        font-weight: bold;
        z-index: 10;
    }

    .modal-wrapper {
        position: relative;
    }

    .video-indicator-confirm {
        position: absolute;
        bottom: 90%;
        right: 4%;
        background: rgba(0, 0, 0, 0.6);
        border-radius: 50%;
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
    }
</style>
