        font-weight: 600;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        flex: 1;
        transition: background-color 0.2s;
    }

        .primary-action-btn:hover:not(:disabled) {
            background: #0da271;
        }

    /* Secondary button */
    .secondary-action-btn {
        background: #fff;
        border: 1px solid #d1d5db;
        padding: 12px 24px;
        font-size: 16px;
        font-weight: 500;
        border-radius: 8px;
        cursor: pointer;
