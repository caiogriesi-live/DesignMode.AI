    button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .social-images-modal {
            padding: 24px;
            width: 95%;
        }

        .image-options {
            grid-template-columns: 1fr;
        }

        .quantity-selector {
            flex-direction: column;
            gap: 15px;
            align-items: flex-start;
        }

        .button-row {
            flex-direction: column;
        }

        .title {
            font-size: 24px;
        }

        .subtitle {
            font-size: 16px;
        }

        .preview-images {
            gap: 5px;
        }

        .preview-image {
