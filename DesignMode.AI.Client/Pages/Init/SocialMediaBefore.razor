    .generated-preview {
        margin-top: 20px;
        text-align: center;
    }

    .preview-images {
        display: flex;
        gap: 10px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 15px;
    }

    .preview-image {
        width: 80px;
        height: 80px;
