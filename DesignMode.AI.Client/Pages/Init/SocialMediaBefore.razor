        margin: 20px 0 30px 0;
    }

    .option-card {
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        cursor: pointer;
        transition: all 0.2s ease;
        background: white;
    }

        .option-card:hover:not(.selected) {
            border-color: #9ca3af;
            transform: translateY(-2px);
        }

        .option-card.selected {
            border-color: #10b981;
            background: #f0fdf4;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.1);
        }

    .option-icon {
        font-size: 32px;
        margin-bottom: 12px;
    }

    .option-title {
        font-size: 16px;
        font-weight: 600;
        color: #111827;
        margin: 0 0 8px 0;
    }

    .option-desc {
        font-size: 14px;
        color: #6b7280;
        line-height: 1.4;
        margin: 0 0 12px 0;
        min-height: 40px;
    }

    .option-count {
        font-size: 13px;
        color: #10b981;
        font-weight: 600;
    }

    /* Quantity Selector */
    .quantity-selector {
        background: #f9fafb;
        border-radius: 10px;
        padding: 20px;
        margin: 25px 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .quantity-selector label {
            font-weight: 600;
            color: #374151;
        }

    .quantity-controls {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .quantity-btn {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        background: white;
        font-size: 18px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
