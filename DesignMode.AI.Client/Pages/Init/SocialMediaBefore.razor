@using Microsoft.AspNetCore.Components
@inject IJSRuntime JSRuntime
@using DesignMode.AI.Client.Services;
@using Newtonsoft.Json;
@using System.Text;

@if (Show)
{
    <div class="modal-overlay" @onclick="() => { if (!isGenerating) CloseModal(); }">
        <div class="social-images-modal" @onclick:stopPropagation>
            <button class="modal-close" @onclick="CloseModal" disabled="@isGenerating">×</button>

            <div class="content">
                <h2 class="title">Create Social Media Images</h2>
                <span class="ai-pill">AI RECOMMENDATION</span>

                <p class="subtitle">
                    Generate professional social media images to accompany your post.
                </p>

                <div class="image-options">
                    <div class="option-card @(selectedOption == 1 ? "selected" : "")" @onclick="() => SelectOption(1)">
                        <div class="option-icon">📱</div>
                        <h3 class="option-title">Instagram Style</h3>
                        <p class="option-desc">Square/vertical images optimized for Instagram feeds and stories</p>
                        <div class="option-count">@(selectedOption == 1 ? HowMuchMore.ToString() : "3") images</div>
                    </div>

                    <div class="option-card @(selectedOption == 2 ? "selected" : "")" @onclick="() => SelectOption(2)">
                        <div class="option-icon">📘</div>
                        <h3 class="option-title">Facebook/LinkedIn</h3>
                        <p class="option-desc">Horizontal images for Facebook posts and LinkedIn articles</p>
                        <div class="option-count">@(selectedOption == 2 ? HowMuchMore.ToString() : "3") images</div>
                    </div>

                    <div class="option-card @(selectedOption == 3 ? "selected" : "")" @onclick="() => SelectOption(3)">
                        <div class="option-icon">📸</div>
                        <h3 class="option-title">Mixed Collection</h3>
                        <p class="option-desc">Variety of sizes for different social platforms</p>
                        <div class="option-count">@(selectedOption == 3 ? HowMuchMore.ToString() : "5") images</div>
                    </div>
                </div>

                <div class="quantity-selector">
                    <label>Number of images to generate:</label>
                    <div class="quantity-controls">
                        <button class="quantity-btn" @onclick="DecreaseQuantity" :disabled="isGenerating || HowMuchMore <= 1">-</button>
                        <span class="quantity-display">@HowMuchMore</span>
                        <button class="quantity-btn" @onclick="IncreaseQuantity" :disabled="isGenerating">+</button>
                    </div>
                </div>

                @if (isGenerating)
                {
                    <div class="generating-overlay">
                        <div class="loading-spinner"></div>
                        <p>Generating @HowMuchMore social media images... This may take a moment.</p>
                        <div class="loading-counter">@loadingCounter</div>
                        @if (generatedImages.Count > 0)
                        {
                            <div class="generated-preview">
                                <p>Generated @generatedImages.Count/@HowMuchMore images so far:</p>
                                <div class="preview-images">
                                    @foreach (var image in generatedImages)
                                    {
                                        <img src="@image.ImageUrl" alt="Generated image" class="preview-image" />
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="button-row">
                    <button class="primary-action-btn"
                            style="background-color: #10b981;"
                            @onclick="GenerateSocialImages"
                            disabled="@isGenerating">
                        @(isGenerating ? "Generating..." : $"Generate Social Images")
                    </button>

                    <button class="secondary-action-btn"
                            @onclick="Skip"
                            disabled="@isGenerating">
                        Skip & Continue
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-message">
                        @errorMessage
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public int HowMuchMore { get; set; } = 3;
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }

    [Parameter] public EventCallback OnGenerateSocialImages { get; set; }
    [Parameter] public EventCallback OnSkip { get; set; }

    [Parameter] public string PostContent { get; set; } = "";
    [Parameter] public string PostType { get; set; } = "Social Media";
    [Parameter] public List<string> ExistingImageUrls { get; set; } = new();

    [Inject] private HttpClient Http { get; set; }
    [Inject] private NavigationManager NavigationManager { get; set; }
    [Inject] private ApiConfigService ApiConfig { get; set; }

    private bool isGenerating = false;
    private string errorMessage = "";
    private int loadingCounter = 0;
    private Timer loadingTimer;
    private List<GeneratedImage> generatedImages = new();
    private int selectedOption = 1;
    private Dictionary<int, int> optionDefaults = new Dictionary<int, int>
    {
        {1, 3}, // Instagram: 3 images
        {2, 3}, // Facebook/LinkedIn: 3 images
        {3, 5}  // Mixed: 5 images
    };

    public class GeneratedImage
    {
        public string ImageUrl { get; set; } = string.Empty;
        public string ImageId { get; set; } = string.Empty;
        public string Prompt { get; set; } = string.Empty;
        public string Platform { get; set; } = "Social Media";
    }

    protected override void OnInitialized()
    {
        // Set default based on selected option
        if (HowMuchMore <= 0) HowMuchMore = optionDefaults[selectedOption];
    }

    private void SelectOption(int option)
    {
        if (isGenerating) return;

        selectedOption = option;
        HowMuchMore = optionDefaults[option];
        StateHasChanged();
    }

    private void IncreaseQuantity()
    {
        if (isGenerating) return;

        var max = selectedOption == 3 ? 10 : 6; // Mixed allows more images
        if (HowMuchMore < max)
        {
            HowMuchMore++;
            StateHasChanged();
        }
    }

    private void DecreaseQuantity()
    {
        if (isGenerating || HowMuchMore <= 1) return;

        HowMuchMore--;
        StateHasChanged();
    }

    private async Task CloseModal()
    {
        if (isGenerating) return;

        Show = false;
        await ShowChanged.InvokeAsync(false);
    }

    private async Task GenerateSocialImages()
    {
        try
        {
            isGenerating = true;
            errorMessage = "";
            generatedImages.Clear();
            StateHasChanged();

            // Start loading counter
            loadingCounter = 0;
            loadingTimer = new Timer(async _ =>
            {
                loadingCounter++;
                if (loadingCounter > 99) loadingCounter = 0;
                await InvokeAsync(StateHasChanged);
            }, null, 0, 1000);

            // Generate images based on selected option
            for (int i = 0; i < HowMuchMore; i++)
            {
                try
                {
                    var (prompt, width, height, aspectRatio) = GetImageParameters(i);

                    var imageUrl = await CallRunwareImageFunction(prompt, width, height, 1);

                    if (!string.IsNullOrEmpty(imageUrl))
                    {
                        string timestamp = DateTime.UtcNow.ToString("yyyyMMddTHHmmssZ");

                        string imageId = await CallSaveImageIdeaFunction(
                            "Social Media",
                            GetSubCategory(),
                            prompt,
                            imageUrl,
                            "", // No prompt ID for social images
                            timestamp,
                            (i + 1).ToString()
                        );

                        var generatedImage = new GeneratedImage
                            {
                                ImageUrl = imageUrl,
                                ImageId = imageId ?? string.Empty,
                                Prompt = prompt,
                                Platform = GetPlatformName()
                            };

                        generatedImages.Add(generatedImage);
                        StateHasChanged();
                    }
                    else
                    {
                        Console.WriteLine($"Failed to generate social image {i + 1}");
                    }

                    // Small delay between generations
                    if (i < HowMuchMore - 1)
                    {
                        await Task.Delay(2000);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error generating social image {i + 1}: {ex.Message}");
                }
            }

            // Close modal and return generated images
            Show = false;
            await ShowChanged.InvokeAsync(false);

            if (OnGenerateSocialImages.HasDelegate)
            {
                await OnGenerateSocialImages.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error generating social images: {ex.Message}";
            Console.WriteLine($"❌ Error in GenerateSocialImages: {ex.Message}");
        }
        finally
        {
            isGenerating = false;
            loadingTimer?.Dispose();
            StateHasChanged();
        }
    }

    private (string prompt, int width, int height, string aspectRatio) GetImageParameters(int index)
    {
        string basePrompt = GenerateSocialImagePrompt(index);

        return selectedOption switch
        {
            1 => // Instagram
            (
                $"{basePrompt} Instagram square format, social media post, vibrant colors, modern design",
                index % 2 == 0 ? 1080 : 1080, // Mix of square and portrait
                index % 2 == 0 ? 1080 : 1350,
                index % 2 == 0 ? "1:1" : "4:5"
            ),

            2 => // Facebook/LinkedIn
            (
                $"{basePrompt} Facebook/LinkedIn post, professional, clean layout, business style",
                1200,
                630, // Standard Facebook link image ratio
                "1.91:1"
            ),

            3 => // Mixed Collection
            (
                $"{basePrompt} Social media graphic, eye-catching, shareable content",
                index switch
                {
                    0 => 1080, // Square
                    1 => 1080, // Square
                    2 => 1200, // Facebook
                    3 => 1080, // Portrait
                    _ => 1080  // Default square
                },
                index switch
                {
                    0 => 1080, // Square
                    1 => 1350, // Portrait
                    2 => 630,  // Facebook
                    3 => 1080, // Square
                    _ => 1080  // Default square
                },
                index switch
                {
                    0 => "1:1",
                    1 => "4:5",
                    2 => "1.91:1",
                    3 => "1:1",
                    _ => "1:1"
                }
            ),

            _ => // Default to Instagram
            (
                $"{basePrompt} Social media image, engaging content",
                1080,
                1080,
                "1:1"
            )
        };
    }

    private string GenerateSocialImagePrompt(int index)
    {
        // Use post content if available, otherwise generate based on context
        if (!string.IsNullOrEmpty(PostContent) && PostContent.Length > 50)
        {
            var contentPreview = PostContent.Length > 200 ?
                PostContent.Substring(0, 200) + "..." :
                PostContent;

            var styleModifiers = new[]
            {
                "modern graphic design, clean layout",
                "professional photography style, realistic",
                "minimalist design, white space",
                "bold typography, vibrant colors",
                "lifestyle photo, authentic feel"
            };

            var style = styleModifiers[index % styleModifiers.Length];

            return $"Social media image for post about: {contentPreview} | {style} | High quality, optimized for {GetPlatformName()}";
        }

        // Fallback prompt based on selected option
        return selectedOption switch
        {
            1 => $"Instagram social media post, square format, engaging visual content, {GetStyleByIndex(index)}",
            2 => $"Professional social media graphic for business, horizontal layout, {GetStyleByIndex(index)}",
            3 => $"Social media content image, versatile design, {GetStyleByIndex(index)}",
            _ => $"Social media graphic, digital content, {GetStyleByIndex(index)}"
        };
    }

    private string GetStyleByIndex(int index)
    {
        var styles = new[]
        {
            "clean and modern",
            "vibrant and colorful",
            "minimalist and elegant",
            "bold and impactful",
            "warm and inviting",
            "professional and sleek"
        };

        return styles[index % styles.Length];
    }

    private string GetSubCategory()
    {
        return selectedOption switch
        {
            1 => "Instagram",
            2 => "Facebook/LinkedIn",
            3 => "Mixed Social",
            _ => "Social Media"
        };
    }

    private string GetPlatformName()
    {
        return selectedOption switch
        {
            1 => "Instagram",
            2 => "Facebook/LinkedIn",
            3 => "Various Social Platforms",
            _ => "Social Media"
        };
    }

    private async Task<string> CallRunwareImageFunction(string positivePrompt, int width, int height, int numberResults)
    {
        try
        {
            HttpClient client = new HttpClient();
            string functionUrl = $"{ApiConfig.ApiBaseUrl}api/CallRunwareAPI?code=REDACTED_FOR_GROOMING";

            var requestBody = new
            {
                positivePrompt = positivePrompt,
                width = width,
                height = height,
                numberResults = numberResults
            };

            var response = await client.PostAsJsonAsync(functionUrl, requestBody);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RunwareResponse>();

                if (result != null && result.Data != null)
                {
                    var firstUrl = result.Data
                        .Where(img => !string.IsNullOrWhiteSpace(img.ImageURL))
                        .Select(img => img.ImageURL)
                        .FirstOrDefault();

                    Console.WriteLine($"Generated Social Image URL: {firstUrl}");
                    return firstUrl ?? string.Empty;
                }
            }
            else
            {
                Console.WriteLine($"Runware call failed: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in CallRunwareImageFunction: {ex.Message}");
        }

        return string.Empty;
    }

    private async Task<string> CallSaveImageIdeaFunction(string deliverableType, string subCategory, string imagePrompt, string imageUrl, string promptId, string timeStamp, string countId)
    {
        try
        {
            HttpClient client = new HttpClient();
            string functionUrl = $"{ApiConfig.ApiBaseUrl}api/SaveImageIdea?code=REDACTED_FOR_GROOMING";

            var requestBody = new
            {
                DeliverableType = deliverableType,
                SubCategory = subCategory,
                ImagePrompt = imagePrompt,
                ImageUrl = imageUrl,
                PromptId = promptId,
                TimeStamp = timeStamp,
                CountId = countId
            };

            var response = await client.PostAsJsonAsync(functionUrl, requestBody);

            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();

                var responseObject = System.Text.Json.JsonSerializer.Deserialize<SaveImageIdeaResponse>(responseContent, new System.Text.Json.JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });

                Console.WriteLine($"Social ImageIdea saved successfully. Id: {responseObject?.Id}");
                return responseObject?.Id;
            }
            else
            {
                Console.WriteLine($"SaveImageIdea call failed: {response.StatusCode}");
                return null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in CallSaveImageIdeaFunction: {ex.Message}");
            return null;
        }
    }

    public class RunwareResponse
    {
        public List<RunwareImage> Data { get; set; } = new();
    }

    public class RunwareImage
    {
        public string ImageURL { get; set; } = string.Empty;
    }

    public class SaveImageIdeaResponse
    {
        public string Id { get; set; } = string.Empty;
    }

    private async Task Skip()
    {
        Show = false;
        await ShowChanged.InvokeAsync(false);

        if (OnSkip.HasDelegate)
        {
            await OnSkip.InvokeAsync();
        }
    }

    public void Dispose()
    {
        loadingTimer?.Dispose();
    }
}

<style>
    /* Modal overlay */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    /* Modal wrapper */
    .social-images-modal {
        width: 800px;
        background: #ffffff;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.08);
        position: relative;
        max-width: 90vw;
        max-height: 90vh;
        overflow-y: auto;
    }

    /* Close button */
    .modal-close {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        font-size: 24px;
        border: none;
        background: #f3f4f6;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        line-height: 1;
    }

        .modal-close:hover {
            background: #e5e7eb;
        }

    /* Title */
    .title {
        font-size: 28px;
        font-weight: 700;
        margin: 8px 0 18px 0;
        color: #111827;
        line-height: 1.2;
    }

    /* Pill Tag */
    .ai-pill {
        display: inline-block;
        background: #d1fae5;
        color: #065f46;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 11px;
    }

    /* Subtitle */
    .subtitle {
        font-size: 18px;
        color: #374151;
        margin: 8px 0 30px 0;
        line-height: 1.5;
        font-weight: 500;
    }

    /* Image Options */
