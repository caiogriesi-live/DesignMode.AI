@code {
    private string billingInterval = "monthly";
    private string? returnUrl;
    private bool isProcessing = false;
    private string? processingPlan = null;

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);

        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query)
            .TryGetValue("b", out var b))
        {
            returnUrl = Uri.UnescapeDataString(b!);
        }
    }

    private void SetBillingInterval(string interval)
    {
        if (isProcessing) return;
        billingInterval = interval;
        StateHasChanged();
    }
    private async Task HandleClick()
    {
        if (isProcessing)
            return;

        GoBack();
    }
    private readonly Dictionary<string, string> CheckoutLinks = new()
{
    // One-time
    { "starter-one-time", "https://buy.stripe.com/test_00w28r0Md5mBgS13Fk5Rm01" },

    // Monthly
    { "plus-monthly", "https://buy.stripe.com/test_00weVd52t3eteJT0t85Rm00" },
    { "pro-monthly", "https://buy.stripe.com/test_8x28wP0Md7uJbxH4Jo5Rm02" },

    // Yearly
    { "plus-yearly", "https://buy.stripe.com/test_5kQ14n1Qh3etatDejY5Rm03" },
    { "pro-yearly", "https://buy.stripe.com/test_7sY28r0MdbKZatD1xc5Rm04" }
};

    private async Task StartCheckout(string plan, bool isOneTime)
    {
        if (isProcessing) return;

        try
        {
            isProcessing = true;
            processingPlan = plan;
            StateHasChanged();

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            var username = user.Identity?.Name;

            if (string.IsNullOrWhiteSpace(username))
                throw new Exception("User is not authenticated.");

            using HttpClient client = new HttpClient();

            // 1. Get UserId
            var userIdResponse = await client.PostAsJsonAsync(
                $"{ApiConfig.ApiBaseUrl}api/GetUserIdByUsername?code=REDACTED_FOR_GROOMING",
                new { username });

            userIdResponse.EnsureSuccessStatusCode();

            var userIdResult = await userIdResponse.Content
                .ReadFromJsonAsync<GetUserIdResponse>();

            var userId = userIdResult?.UserId;

            if (string.IsNullOrWhiteSpace(userId))
                throw new Exception("UserId could not be resolved.");

            // 2. Extract id from returnUrl safely
            var uri = new Uri(returnUrl);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

            var id = query["id"];

            if (string.IsNullOrWhiteSpace(id))
                throw new Exception("Missing id in returnUrl.");

            // 3. Call checkout session
            var response = await client.PostAsJsonAsync(
                $"{ApiConfig.ApiBaseUrl}api/CreateCheckoutSession?code=REDACTED_FOR_GROOMING",
                new
                {
                    plan,
                    billingInterval,
                    isOneTime,
                    returnUrl,
                    userId,
                    id
                });

            response.EnsureSuccessStatusCode();

            var result = await response.Content
                .ReadFromJsonAsync<CheckoutResponse>();

            NavigationManager.NavigateTo(result.Url, forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Checkout error: {ex.Message}");
            isProcessing = false;
            processingPlan = null;
            StateHasChanged();
        }
    }

    public class GetUserIdResponse
    {
        public bool Success { get; set; }
        public string UserId { get; set; }
    }

    public class CheckoutResponse
    {
        public string Url { get; set; }
        public string SessionId { get; set; }
    }

    private void GoBack()
    {
        if (isProcessing) return;

        if (!string.IsNullOrEmpty(returnUrl))
        {
            NavigationManager.NavigateTo(returnUrl, true);
        }
        else
        {
            NavigationManager.NavigateTo("/", true); // fallback
        }
    }
}