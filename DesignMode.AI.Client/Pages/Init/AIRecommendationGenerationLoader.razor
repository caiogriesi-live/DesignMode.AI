@if (IsVisible)
{
    <div class="loading-container text-center" role="status" aria-live="polite" aria-busy="true" style="padding: 1.5rem; max-width: 100%;">
        <div class="spinner-border text-primary mb-2" aria-hidden="true"></div>
        <p class="mb-1">@Message</p>
        <small>This may take a moment.</small>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Message { get; set; } = "Generating your image...";
}
