    private async Task<string?> SaveGeneratedPackageLabelFileAsync(
        string sourceImageUrl,
        string companyName,
        string version)
    {
        if (string.IsNullOrWhiteSpace(sourceImageUrl) ||
            string.IsNullOrWhiteSpace(companyName) ||
            string.IsNullOrWhiteSpace(version))
        {
            return null;
        }

        try
        {
            var request = new
            {
                ImageUrl = sourceImageUrl,
                CompanyName = companyName,
                Version = version,
                FileName = "package-label.png"
            };

            // This is the package-label equivalent of the website file-save calls.
            // The Azure Function should download ImageUrl and save it at:
            // {CompanyName}-package-label-v{Version}/package-label.png
            var response = await Http.PostAsJsonAsync(
                $"{ApiConfig.ApiBaseUrl}api/SavePackageLabelImage" +
                "?code=REDACTED_FOR_GROOMING",
                request);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                throw new InvalidOperationException(
                    $"SavePackageLabelImage returned {(int)response.StatusCode}: {error}");
            }

            var result = await response.Content.ReadFromJsonAsync<SavePackageLabelImageResponse>();

            if (!string.IsNullOrWhiteSpace(result?.ImageUrl))
                return result.ImageUrl;

            if (!string.IsNullOrWhiteSpace(result?.SavedUrl))
                return result.SavedUrl;

            // Match the website approach: reconstruct the deterministic URL even
            // if the save function only returns success.
            return GetPackageLabelPreviewUrl(companyName, version);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error saving package-label image file: {ex.Message}");
            throw;
        }
    }

    private async Task LoadExistingPackageLabelVersionsAsync(string companyName)
    {
        var packageLabelsResponse = await GetPackageLabelsByCompanyAsync(companyName);

        sortedPackageLabels = packageLabelsResponse?.Data?
            .OrderByDescending(x =>
                DateTime.TryParse(x.TimeStamp, out var dt)
                    ? dt
                    : DateTime.MinValue)
            .ToList()
            ?? new List<PackageLabelRecord>();

        GeneratedLabels.Clear();
        ActiveGeneratedLabel = null;
        GeneratedLabelPreviewUrl = "";
        GeneratedLabelDownloadUrl = "";
        GeneratedPrintReadyPdfUrl = "";

        if (!sortedPackageLabels.Any())
        {
            currentVersion = "1";
            Console.WriteLine("📦 No saved package-label versions found.");
            return;
        }

        // Website equivalent:
        // DB row tells us CompanyName + Version, and the local/storage file URL
        // is deterministically rebuilt from those values.
        foreach (var record in sortedPackageLabels)
        {
            var versionNumber =
                record.Version?.Replace("v", "", StringComparison.OrdinalIgnoreCase)
                ?? "1";

            var previewUrl = GetPackageLabelPreviewUrl(companyName, versionNumber);

            GeneratedLabels.Add(new GeneratedLabelRecord
                {
                    PreviewUrl = previewUrl,
                    DownloadUrl = previewUrl,
                    PrintReadyPdfUrl = "",
                    LabelId = "",
                    PackageLabelId = record.PackageLabelId ?? "",
                    Version = string.IsNullOrWhiteSpace(record.Version)
                        ? $"v{versionNumber}"
                        : record.Version,
                    ProductName = "Package Label",
                    LabelType = "",
                    LabelSize = "",
                    Material = "",
                    Orientation = "",
                    SkuBarcode = "",
                    AdditionalInfo = "",
                    CreatedAt = DateTime.TryParse(record.TimeStamp, out var createdAt)
                        ? createdAt
                        : DateTime.MinValue
                });
        }

        GeneratedLabels = GeneratedLabels
            .OrderByDescending(x => x.CreatedAt)
            .ToList();

        var latestVersion = sortedPackageLabels.First();
        currentVersion =
            latestVersion.Version?.Replace("v", "", StringComparison.OrdinalIgnoreCase)
            ?? "1";

        // Current/latest package label is shown large when the modal loads.
        var latestGenerated = GeneratedLabels.FirstOrDefault();

        if (latestGenerated != null)
            ViewGeneratedLabel(latestGenerated);

        Console.WriteLine(
            $"📦 Loaded {GeneratedLabels.Count} saved package-label files from {sortedPackageLabels.Count} database rows.");

        foreach (var label in sortedPackageLabels)
        {
            Console.WriteLine(
                $"🕒 {label.TimeStamp} | {label.Version} | " +
                GetPackageLabelPreviewUrl(companyName, label.Version ?? "1"));
        }
    }

