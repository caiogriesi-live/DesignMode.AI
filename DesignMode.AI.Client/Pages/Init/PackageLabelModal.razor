    private async Task<GetPackageLabelsResponse?> GetPackageLabelsByCompanyAsync(string companyName)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
                return null;

            var urlEndpoint =
                $"{ApiConfig.ApiBaseUrl}api/GetPackageLabelsByCompany" +
                "?code=REDACTED_FOR_GROOMING";

            var body = new
            {
                CompanyName = companyName
            };

            var json = System.Text.Json.JsonSerializer.Serialize(body);
            var content = new StringContent(json, Encoding.UTF8, "application/json");

            var response = await Http.PostAsync(urlEndpoint, content);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"❌ Failed to retrieve package labels: {response.StatusCode} - {error}");
                return null;
            }

            var result = await response.Content.ReadFromJsonAsync<GetPackageLabelsResponse>();

            if (result?.Data != null)
            {
                result.Data = result.Data
                    .OrderByDescending(x =>
                        DateTime.TryParse(x.TimeStamp, out var dt)
                            ? dt
                            : DateTime.MinValue)
                    .ToList();
            }

            Console.WriteLine($"✅ Retrieved {result?.Count ?? 0} package labels (sorted).");
            return result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error calling GetPackageLabelsByCompany: {ex.Message}");
            return null;
        }
    }

