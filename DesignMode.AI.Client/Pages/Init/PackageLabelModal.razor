@inherits DesignMode.AI.Client.Components.GenerationAwareComponent
@using System.Collections.Generic
@using DesignMode.AI.Shared.Models
@using DesignMode.AI.Client.Services
@using Microsoft.AspNetCore.Components;
@using Microsoft.AspNetCore.Components.Authorization;
@using Newtonsoft.Json;
@using System.Text;
@using System.Text.RegularExpressions;
@using Microsoft.JSInterop
@using System.Net.Http.Headers
@inject AttributionContextService AttributionContext
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject AIUsageRefreshService UsageRefresh

@if (IsBusy && !IsGeneratingLabel)
{
    <div class="modal-busy-overlay"><div class="loader"></div></div>
}

@if (Show)
{
    <div class="modal-overlay generation-workspace-overlay" @onclick="CloseModal">
        <div class="vertical-modal-wrapper generation-workspace" @onclick:stopPropagation>
            <button class="modal-close" @onclick="CloseModal">×</button>

            <div class="modal-tabs">
                <button class="tab-button @(ActiveTab == TabType.GenerateNew ? "active" : "")"
                        @onclick="() => SetActiveTab(TabType.GenerateNew)">
                    <span class="tab-icon">✨</span> Generate New
                </button>
                <button class="tab-button @(ActiveTab == TabType.GeneratedLabel ? "active" : "")"
                        aria-label="Generated Labels"
                        @onclick="() => SetActiveTab(TabType.GeneratedLabel)"
                        disabled="@(!IsGeneratingLabel && !HasExistingPackageLabels && string.IsNullOrWhiteSpace(GeneratedLabelPreviewUrl))">
                    <span class="tab-icon">📦</span> Results
                    @if (IsGeneratingLabel)
                    {
                        <span class="tab-badge generating">Generating...</span>
                    }
                    else if (HasExistingPackageLabels || GeneratedLabels.Any())
                    {
                        <span class="tab-badge">@GetGeneratedLabelCount()</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(GeneratedLabelPreviewUrl))
                    {
                        <span class="tab-badge">New</span>
                    }
                </button>
            </div>

            <div class="modal-scroll-content">
                @if (ActiveTab == TabType.GenerateNew)
                {
                    <div class="tab-content generate-new-tab">
                        <div class="modal-header"><h2>Generate Package Label</h2></div>
                        <div class="modal-intro">
                            Select <strong>one image</strong>. We'll use it as the visual reference and generate a professional package label from it using your label specifications.
                        </div>

                        <div class="label-status">
                            <span class="label-count">
                                <span class="label-icon">📦</span>
                                @if (HasLabelImages())
                                {
                                    <span>Package label images ready</span>
                                    @if (SelectedImageIds.Any())
                                    {
                                        <span class="selection-count">1 selected</span>
                                    }
                                }
                                else
                                {
                                    <span style="font-weight:bold;">No images available</span>
                                    <span style="font-weight:normal;"> – Generate images first to unlock package label creation</span>
                                }
                            </span>
                        </div>

                        <AIRecommendationGenerationLoader IsVisible="@isGeneratingLabelImages" Message="Generating package label source image..." />
                        @if (IsBusy && !isGeneratingLabelImages)
                        {
                            <div class="loading-container text-center">
                                <div class="spinner-border text-primary mb-2"></div>
                                <p>Loading images...</p>
                            </div>
                        }
                        else if (!isGeneratingLabelImages)
                        {
                            @if (!string.IsNullOrWhiteSpace(ImageGenerationError))
                            {
                                <p role="alert" class="generation-error">@ImageGenerationError</p>
                            }
                            <div class="image-grid">
                                @if (GetUniqueLabelImages().Any())
                                {
                                    @if (HasLabelImages())
                                    {
                                        var allLabelImages = GetUniqueLabelImages();
                                        var groupedImages = allLabelImages.GroupBy(img => img.SubCategory?.ToLower() == "generic" ? img.DeliverableType : img.SubCategory);
                                        @foreach (var group in groupedImages)
                                        {
                                            var firstImage = group.First();
                                            var sectionTitle = firstImage.SubCategory?.ToLower() == "generic" ? firstImage.DeliverableType : group.Key;
                                            var validImages = group.Where(i => !string.IsNullOrWhiteSpace(i.ImageUrl)).OrderBy(i => i.CountId).ToList();
                                            if (validImages.Any())
                                            {
                                                <div class="deliverable-section">
                                                    <h3 class="section-title">@sectionTitle</h3>
                                                    <div class="image-col">
                                                        @foreach (var image in validImages)
                                                        {
                                                            @ImageCard(image)
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }
                                    @if (isGeneratingLabelImages && !HasLabelImages())
                                    {
                                        <div class="image-generating-section">
                                            <h3 class="section-title">Generating Package Label Image...</h3>
                                            <div class="image-card image-card-loading">
                                                <div class="loading-placeholder"><div class="loading-spinner-small"></div><span>Generating source image...</span></div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="empty-state">
                                        <div class="empty-icon">📦</div>
                                        <h3>No Package Label Images Yet</h3>
                                        <p>Create a package label concept for your brand. Generate a label-ready image to use as the reference for your final label.</p>
                                        <button type="button" class="generate-images-button" @onclick="GeneratePackageLabelImageOnClickAsync"
                                                disabled="@isGeneratingLabelImages" aria-busy="@isGeneratingLabelImages">Generate Package Label Image</button>
                                    </div>
                                }
                            </div>
                        }

                        <div class="label-config-section">
                            <h3>Label Specifications</h3>
                            <div class="config-options two-col">
                                <div class="config-option"><label>Label Type</label><select @bind="SelectedLabelType" class="config-select"><option value="ProductLabel">Product Label</option><option value="ShippingLabel">Shipping Label</option><option value="WarningLabel">Warning/Caution Label</option><option value="InformationalLabel">Informational Label</option><option value="BrandedLabel">Branded Packaging</option><option value="PromotionalLabel">Promotional Sticker</option></select></div>
                                <div class="config-option"><label>Label Size</label><select @bind="SelectedLabelSize" class="config-select"><option value="4x6">4&quot; x 6&quot; (Standard)</option><option value="4x2">4&quot; x 2&quot; (Small)</option><option value="6x4">6&quot; x 4&quot; (Large)</option><option value="A4">A4 (210x297mm)</option><option value="Custom">Custom Size</option></select></div>
                                <div class="config-option"><label>Material</label><select @bind="SelectedMaterial" class="config-select"><option value="Paper">Paper</option><option value="Vinyl">Vinyl (Waterproof)</option><option value="Polyester">Polyester (Durable)</option><option value="Clear">Clear Transparent</option><option value="Kraft">Kraft Paper</option><option value="Glossy">Glossy Paper</option></select></div>
                                <div class="config-option"><label>Orientation</label><select @bind="SelectedOrientation" class="config-select"><option value="Portrait">Portrait</option><option value="Landscape">Landscape</option><option value="Square">Square</option></select></div>
                            </div>
                            <div class="custom-fields-section">
                                <h4>Label Information</h4>
                                <div class="config-options two-col">
                                    <div class="config-option"><label>Product Name</label><input type="text" @bind="ProductName" class="config-input" placeholder="Enter product name" /></div>
                                    <div class="config-option"><label>SKU/Barcode</label><input type="text" @bind="SkuBarcode" class="config-input" placeholder="Enter SKU or barcode" /></div>
                                </div>
                                <div class="config-option"><label>Additional Information</label><textarea @bind="AdditionalInfo" class="config-textarea" placeholder="Ingredients, warnings, instructions, claims, etc."></textarea></div>
                                <div class="checkbox-row">
                                    <label><input type="checkbox" @bind="IncludeBarcode" /> Include Barcode</label>
                                    <label><input type="checkbox" @bind="IncludeQrCode" /> Include QR Code</label>
                                    <label><input type="checkbox" @bind="IncludeBrandLogo" /> Include Brand Logo</label>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="tab-content generated-label-tab">
                        <div class="modal-header"><h2>Generated Package Label</h2></div>
                        @if (IsGeneratingLabel)
                        {
                            <div class="generation-loading-container">
                                <div class="generation-header"><h3>Creating Your Package Label</h3><div class="generation-status">@GenerationStatus</div></div>
                                <div class="progress-bar-container"><div class="progress-bar" style="width: @(GenerationProgress)%;"></div></div>
                                <div class="current-step-details">@CurrentStepDetails</div>
                                <div class="generation-steps-log">
                                    <h4>Generation Steps:</h4>
                                    <div class="steps-list">
                                        @foreach (var step in GenerationSteps)
                                        {
                                            <div class="step-item"><span class="step-check">✓</span><span>@step</span></div>
                                        }
                                        @if (GenerationProgress < 100)
                                        {
                                            <div class="step-item current"><span class="step-spinner"></span><span>@GenerationStatus</span></div>
                                        }
                                    </div>
                                </div>
                                <div class="label-skeleton"><div class="skeleton-logo"></div><div class="skeleton-line wide"></div><div class="skeleton-line"></div><div class="skeleton-image"></div><div class="skeleton-line short"></div></div>
                                <div class="generation-tip">💡 The AI is using the selected image as the visual reference for this label.</div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(GenerationError))
                        {
                            <div class="generation-error"><h3>Label generation failed</h3><p>@GenerationError</p><button class="save-button" @onclick="() => SetActiveTab(TabType.GenerateNew)">Back to Generate New</button></div>
                        }
                        else if (GeneratedLabels.Any() || HasExistingPackageLabels || !string.IsNullOrWhiteSpace(GeneratedLabelPreviewUrl))
                        {
                            @if (ActiveGeneratedLabel != null && !string.IsNullOrWhiteSpace(GeneratedLabelPreviewUrl))
                            {
                                <div class="generated-label-preview current-label-preview">
                                    <div class="preview-toolbar">
                                        <div class="preview-title-group">
                                            <div class="current-label-heading">
                                                <span class="current-label-pill">Current</span>
                                                <strong>@GetActiveProductName()</strong>
                                            </div>
                                            <span class="preview-meta">@GetActivePreviewMeta()</span>
                                        </div>

                                        <div class="preview-actions">
                                            <button class="toolbar-button" @onclick="OpenGeneratedLabel">↗ Open</button>
                                            <button class="toolbar-button primary" @onclick="DownloadGeneratedLabel">📥 Download</button>
                                        </div>
                                    </div>

                                    <div class="label-preview-stage current-label-stage">
                                        <img src="@GeneratedLabelPreviewUrl"
                                             alt="Current generated package label"
                                             class="generated-label-image" />
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(GeneratedPrintReadyPdfUrl))
                                    {
                                        <div class="print-ready-row">
                                            <a class="pdf-link"
                                               href="@GeneratedPrintReadyPdfUrl"
                                               target="_blank">
                                                Open print-ready PDF
                                            </a>
                                        </div>
                                    }
                                </div>
                            }

                            @if (GeneratedLabels.Any())
                            {
                                <div class="generated-history saved-label-gallery">
                                    <div class="generated-history-header">
                                        <div>
                                            <h4>Generated Labels</h4>
                                            <p>Click any saved label to show it full-size above.</p>
                                        </div>

                                        <span class="generated-count">@GeneratedLabels.Count</span>
                                    </div>

                                    <div class="history-grid saved-label-grid">
                                        @foreach (var item in GeneratedLabels.OrderByDescending(x => x.CreatedAt))
                                        {
                                            var isActive =
                                            ActiveGeneratedLabel != null &&
                                            string.Equals(
                                            item.PackageLabelId,
                                            ActiveGeneratedLabel.PackageLabelId,
                                            StringComparison.OrdinalIgnoreCase) &&
                                            string.Equals(
                                            item.Version,
                                            ActiveGeneratedLabel.Version,
                                            StringComparison.OrdinalIgnoreCase);

                                            <button type="button"
                                                    class="history-card saved-label-card @(isActive ? "active" : "")"
                                                    title="View @item.Version"
                                                    @onclick="() => ViewGeneratedLabel(item)">
                                                <div class="history-image-wrap saved-label-image-wrap">
                                                    <img src="@item.PreviewUrl"
                                                         alt="Saved package label @item.Version"
                                                         class="history-thumb saved-label-thumb" />

                                                    @* <span class="history-version">@item.Version</span>

                                                    @if (isActive)
                                                    {
                                                        <span class="history-current">Current</span>
                                                    } *@
                                                </div>

                                                <div class="history-card-info">
                                                    <strong>@(!string.IsNullOrWhiteSpace(item.ProductName) ? item.ProductName : "Package Label")</strong>

                                                    <span>
                                                        @if (!string.IsNullOrWhiteSpace(item.LabelType))
                                                        {
                                                            <text>@item.LabelType</text>
                                                            @if (!string.IsNullOrWhiteSpace(item.LabelSize))
                                                            {
                                                                <text> · @item.LabelSize</text>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <text>@item.Version</text>
                                                        }
                                                    </span>

                                                    <small>@item.CreatedAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</small>
                                                </div>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }

                            @if (HasExistingPackageLabels)
                            {
                                <div class="persisted-label-summary">
                                    <span class="persisted-label-icon">💾</span>
                                    <div>
                                        <strong>@sortedPackageLabels.Count saved label version@(sortedPackageLabels.Count == 1 ? "" : "s")</strong>
                                        <p>
                                            Labels are loaded from the PackageLabel database and their saved company/version image files.
                                        </p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state generated-empty-state">
                                <div class="empty-icon">📦</div>
                                <h3>No Label Generated Yet</h3>
                                <p>Go to Generate New, select one image, and create your label.</p>
                                <button class="save-button" @onclick="() => SetActiveTab(TabType.GenerateNew)">Start Generating</button>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (ActiveTab == TabType.GenerateNew)
            {
                <div class="footer-actions sticky-footer">
                    <button class="discard-button" @onclick="CloseModal">Cancel</button>
                    <button class="save-button" @onclick="GenerateLabel" disabled="@(!SelectedImageIds.Any() || IsGeneratingLabel || isGeneratingLabelImages)" style="@(!SelectedImageIds.Any() ? "background-color:#eee; color:#ababab;" : null)">@GetGenerateButtonText()</button>
                </div>
            }
            else
            {
                <div class="footer-actions sticky-footer"><button class="discard-button" disabled="@IsGeneratingLabel" @onclick="() => SetActiveTab(TabType.GenerateNew)">← Back to Generate New Label</button></div>
            }
        </div>
    </div>
}

@code {
    [Inject] private ApiConfigService ApiConfig { get; set; }
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; }
    [Inject] private HttpClient Http { get; set; }
    [Inject] private NavigationManager NavigationManager { get; set; }
    [Inject] private IJSRuntime JS { get; set; }

    private bool IsBusy = false;

    private enum TabType { GenerateNew, GeneratedLabel }
    private TabType ActiveTab { get; set; } = TabType.GenerateNew;
    private bool IsGeneratingLabel = false;
    private string GenerationStatus = "";
    private string CurrentStepDetails = "";
    private int GenerationProgress = 0;
    private string GenerationError = "";
    private List<string> GenerationSteps = new();
    private string GeneratedLabelPreviewUrl = "";
    private string GeneratedLabelDownloadUrl = "";
    private string GeneratedPrintReadyPdfUrl = "";
    private List<GeneratedLabelRecord> GeneratedLabels = new();
    private GeneratedLabelRecord? ActiveGeneratedLabel = null;

    // Persisted package-label versions, mirroring the website version flow
    private List<PackageLabelRecord> sortedPackageLabels = new();
    private string currentVersion = "1";
    private bool hasLoadedVersions = false;
    private string? loadedCompanyIdeaId;
    private string SelectedCompanyName = "";
    private bool HasExistingPackageLabels => sortedPackageLabels != null && sortedPackageLabels.Any();

    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public DesignMode.AI.Client.Pages.Init.MakeVideoModal.ImageIdeaCountResult AllIdeas { get; set; }

    // Updated parameter to accept the selected images
    [Parameter] public List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel> LabelImages { get; set; }

    [Parameter] public EventCallback<List<string>> OnImagesSelected { get; set; }
    [Parameter] public EventCallback<bool> OnLabelGenerated { get; set; }

    // New parameter for parent's CallRunwareImageFunction
    [Parameter] public Func<string, int, int, int, Task<string>> CallRunwareImageFunction { get; set; }

    // New parameter for parent's CallSaveImageIdeaFunction
    [Parameter] public Func<string, string, string, string, string, string, string, Task<string>> CallSaveImageIdeaFunction { get; set; }

    // New parameter for parent's other functions
    [Parameter] public string CompanyIdeaId { get; set; }
    [Parameter] public string CompanyDescription { get; set; }
    [Parameter] public string PromptIdFromCID { get; set; }
    [Parameter] public string MainPromptText { get; set; }

    [Parameter] public EventCallback OnModalClosed { get; set; }

    public string promptText { get; set; }
    private HashSet<string> SelectedImageIds = new();
    private HashSet<string> SelectedImageUrls = new();

    // Label configuration
    private string SelectedLabelType = "ProductLabel";
    private string SelectedLabelSize = "4x6";
    private string SelectedMaterial = "Paper";
    private string SelectedOrientation = "Portrait";
    private string ProductName = "";
    private string SkuBarcode = "";
    private string AdditionalInfo = "";
    private bool IncludeBarcode = true;
    private bool IncludeQrCode = false;
    private bool IncludeBrandLogo = true;

    // For generating label images
    private bool isGeneratingLabelImages = false;
    private string ImageGenerationError = "";
    private List<string> generatedLabelImageUrls = new();
    private List<Gen.ImageIdeaModel> newlyGeneratedImages = new();
    private List<string> labelPromptsToGenerate = new();
    private int currentGenerationIndex = 0;
    private int totalGenerations = 0;

    // NEW: Track if an image was generated during this modal session
    private bool wasImageGenerated = false;

    private bool HasLabelImages() => GetUniqueLabelImages().Any();

    private static bool IsPackageLabelImage(Gen.ImageIdeaModel image) =>
        !string.IsNullOrWhiteSpace(image.ImageUrl) &&
        (image.DeliverableType?.Contains("label", StringComparison.OrdinalIgnoreCase) == true ||
         image.SubCategory?.Contains("label", StringComparison.OrdinalIgnoreCase) == true ||
         image.DeliverableType?.Contains("packaging", StringComparison.OrdinalIgnoreCase) == true ||
         image.SubCategory?.Contains("packaging", StringComparison.OrdinalIgnoreCase) == true);

    // Helper method to get unique label images (avoid duplicates)
    private List<Gen.ImageIdeaModel> GetUniqueLabelImages()
    {
        var allImages = new List<Gen.ImageIdeaModel>();

        // Add selected images
        if (LabelImages != null)
        {
            allImages.AddRange(LabelImages);
        }

        // Add newly generated images
        if (newlyGeneratedImages != null)
        {
            allImages.AddRange(newlyGeneratedImages);
        }

        // Filter for label images and remove duplicates by ImageUrl
        var labelImages = allImages
            .Where(IsPackageLabelImage)
            .GroupBy(img => img.ImageUrl) // Group by ImageUrl to remove duplicates
            .Select(group => group.First()) // Take the first occurrence of each unique ImageUrl
            .ToList();

        return labelImages;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(loadedCompanyIdeaId, CompanyIdeaId, StringComparison.Ordinal))
        {
            loadedCompanyIdeaId = CompanyIdeaId;
            SelectedImageIds.Clear();
            SelectedImageUrls.Clear();
            newlyGeneratedImages.Clear();
            hasLoadedVersions = false;
        }

        if (Show)
        {
            var uri = NavigationManager.Uri;
            var queryString = new Uri(uri).Query;
            string cid = GetQueryParameter(queryString, "cid", "");

            if (!string.IsNullOrWhiteSpace(cid))
            {
                string[] parts = cid.Split(new string[] { "|~~|@@|^^|" }, StringSplitOptions.None);

                if (parts.Length >= 1)
                {
                    try
                    {
                        var decodedCompanyName = Encoding.UTF8.GetString(Convert.FromBase64String(parts[0]));
                        SelectedCompanyName = SanitizeCompanyName(decodedCompanyName);
                    }
                    catch (FormatException ex)
                    {
                        Console.WriteLine($"Error decoding company name: {ex.Message}");
                    }
                }
            }

            // Load persisted package-label versions exactly like the website modal:
            // DynamoDB is the version index and each image is rebuilt from the
            // deterministic company/version storage folder.
            if (!hasLoadedVersions && !string.IsNullOrWhiteSpace(SelectedCompanyName))
            {
                await LoadExistingPackageLabelVersionsAsync(SelectedCompanyName);
                hasLoadedVersions = true;
            }
        }

        // Opening the modal only resolves existing images. Generation requires a click.
    }

    public class IdeaDto
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
    }

    public class IdeasResponse
    {
        public List<IdeaDto> Ideas { get; set; } = new();
        public int Count { get; set; }
    }

    private async Task<IdeasResponse> CallGetIdeasByCompanyIdeaId(string companyIdeaId)
    {
        try
        {
            var url = $"{ApiConfig.ApiBaseUrl}api/GetIdeasByCompanyIdeaId?code=REDACTED_FOR_GROOMING&companyIdeaId={companyIdeaId}";
            var response = await Http.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                return await response.Content.ReadFromJsonAsync<IdeasResponse>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calling GetIdeasByCompanyIdeaId: {ex.Message}");
        }

        return new IdeasResponse { Ideas = new List<IdeaDto>(), Count = 0 };
    }

    // Helper method to extract query parameter values
    private string GetQueryParameter(string queryString, string key, string defaultValue)
    {
        var parameters = System.Web.HttpUtility.ParseQueryString(queryString);
        return parameters[key] ?? defaultValue;
    }

    private async Task GeneratePackageLabelImageOnClickAsync()
    {
        if (isGeneratingLabelImages || CallRunwareImageFunction == null || CallSaveImageIdeaFunction == null) return;
        IsBusy = true;
        isGeneratingLabelImages = true;
        ImageGenerationError = "";
        try
        {
        await using var generationOperation = await BeginGenerationAsync();
        var uri = NavigationManager.Uri;
        var queryString = new Uri(uri).Query;
        string cid = GetQueryParameter(queryString, "cid", null);

        var imageIdeas = LabelImages ?? new List<Gen.ImageIdeaModel>();

        var sortedIdeas = imageIdeas
            .OrderBy(idea => int.TryParse(idea.CountId, out var count) ? count : int.MaxValue)
            .ToList();

        // Get main deliverable (Generic)
        var mainIdea = sortedIdeas.FirstOrDefault(idea =>
            string.Equals(idea.SubCategory, "Generic", StringComparison.OrdinalIgnoreCase));
        var MainDeliverable = "";
        var q = "";
        string promptTextCall = "";
        string promptIdCall = "";
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var username = user.Identity?.Name;
        // ✅ Apply your business rules
        string deliverableType = "Secondary";
        string subCategory = "Package Label";
        if (!string.IsNullOrWhiteSpace(username))
        {
            promptIdCall = PromptIdFromCID;
        }
        var pText = AllIdeas;
        var mainPrompt = "";
        if (mainIdea != null)
        {
            MainDeliverable = mainIdea.DeliverableType;

            bool isLabelRelated = IsLabelRelated(MainDeliverable);
            //IMPORTANT: pass the data to prevent multiple database calls
            if (isLabelRelated)
            {
                q = MainPromptText;
                // ✅ Apply your business rules
                deliverableType = "Package Label";
                subCategory = "Generic";
            }
            else
            {
                if (pText == null || pText.Ideas == null || !pText.Ideas.Any())
                {
                    pText = await GetImageIdeaCountsAsync(cid);
                }
                // MODIFIED: Search pText.Ideas for label-related title
                if (pText != null && pText.Ideas != null && pText.Ideas.Any())
                {
                    // Find the first idea in pText.Ideas with a label-related title
                    var labelRelatedIdea = pText.Ideas
                        .FirstOrDefault(idea => IsLabelRelated(idea.Title));

                    deliverableType = "Secondary";
                    subCategory = "Package Label";

                    if (labelRelatedIdea != null)
                    {
                        // Use title + description from the label-related idea in pText
                        q = $"{labelRelatedIdea.Title} {labelRelatedIdea.Description.TrimStart('-')}";
                        Console.WriteLine($"✅ Using label-related idea from pText: {labelRelatedIdea.Title}");
                    }
                    else
                    {
                        q = "Package label design - Professional packaging for products";
                    }
                }
                else
                {
                    // Fallback if pText has no ideas
                    q = "Package label design - Professional packaging for products";
                    Console.WriteLine($"⚠️ pText has no ideas, using default");
                }
            }
        }
        mainPrompt = MainPromptText;
        var test = q;
        string[] parts = (cid ?? "").Split(new string[] { "|~~|@@|^^|" }, StringSplitOptions.None);

        string name = string.Empty;
        string industry = string.Empty;

        if (parts.Length >= 2)
        {
            // Decode Base64 for company name and industry
            try
            {
                name = Encoding.UTF8.GetString(Convert.FromBase64String(parts[0]));
                industry = Encoding.UTF8.GetString(Convert.FromBase64String(parts[1]));
            }
            catch (FormatException ex)
            {
                Console.WriteLine($"Error decoding Base64 values: {ex.Message}");
            }
        }
        string mainDeliverableDetail = await FetchDeliverableDetail("Package Label");

        var match = Regex.Match(mainDeliverableDetail, @"Display:\s*(.*?)\s*(?=\w+:|$)", RegexOptions.IgnoreCase);
        var DisplayLocation = match.Success ? match.Groups[1].Value.Trim() : "Not found";
        var companyDescription = CompanyDescription;
        string packageModular = "";

        // Pass label specifications into the string
        string labelContent = $"{SelectedLabelType} label: {ProductName} | Size: {SelectedLabelSize} | Material: {SelectedMaterial}";
        if (!string.IsNullOrWhiteSpace(AdditionalInfo))
        {
            labelContent += $" | Info: {AdditionalInfo.Substring(0, Math.Min(50, AdditionalInfo.Length))}...";
        }

        promptText = $"{DisplayLocation}|{q}|{name}|{industry}|{mainDeliverableDetail}|Package Label|{companyDescription}|{packageModular}";

        StateHasChanged();

            // Generate only the first (and only) prompt
            currentGenerationIndex = 1;

            try
            {
                var imageUrl = await CallRunwareImageFunction(promptText, 1344, 768, 1);

                if (string.IsNullOrWhiteSpace(imageUrl))
                    throw new InvalidOperationException("Package Label image generation returned no image.");

                if (!string.IsNullOrEmpty(imageUrl))
                {
                    string timestamp = DateTime.UtcNow.ToString("yyyyMMddTHHmmssZ");

                    int newCountId = 1;
                    var allImages = new List<Gen.ImageIdeaModel>();
                    if (LabelImages != null) allImages.AddRange(LabelImages);
                    if (newlyGeneratedImages != null) allImages.AddRange(newlyGeneratedImages);

                    if (allImages.Any())
                    {
                        var maxCount = allImages
                            .Select(img => int.TryParse(img.CountId, out var val) ? val : 0)
                            .Max();
                        newCountId = maxCount + 1;
                    }

                    string imageId = await CallSaveImageIdeaFunction(
                        deliverableType,
                        subCategory,
                        promptText,
                        imageUrl,
                        PromptIdFromCID,
                        timestamp,
                        newCountId.ToString()
                    );

                    if (string.IsNullOrWhiteSpace(imageId))
                        throw new InvalidOperationException("Package Label image could not be saved.");

                    var newImage = new Gen.ImageIdeaModel
                        {
                            Id = imageId,
                            ImageUrl = imageUrl,
                            ImagePrompt = promptText,
                            DeliverableType = deliverableType,
                            SubCategory = subCategory,
                            CountId = newCountId.ToString(),
                        };

                    // Clear previous newly generated images and add only this one
                    newlyGeneratedImages.Clear();
                    newlyGeneratedImages.Add(newImage);

                    // The image is persisted. Keep it visible even if the canonical refresh fails.
                    wasImageGenerated = true;
                    try
                    {
                        if (OnModalClosed.HasDelegate)
                            await OnModalClosed.InvokeAsync();
                    }
                    catch (Exception)
                    {
                        ImageGenerationError = "Image saved, but the project could not refresh. Reopen the modal to load it.";
                    }

                    SelectedImageIds.Clear();
                    SelectedImageUrls.Clear();
                    SelectedImageIds.Add(newImage.Id);
                    SelectedImageUrls.Add(newImage.ImageUrl);

                    StateHasChanged();
                }
            }
            catch (Exception)
            {
                ImageGenerationError = "Package Label image generation failed. Please try again.";
                Console.WriteLine("[PACKAGE LABEL] image generation failed");
            }

            if (newlyGeneratedImages.Any())
            {
                Console.WriteLine("[PACKAGE LABEL] generation completed and image selected");

                labelPromptsToGenerate.Clear();
                StateHasChanged();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception)
        {
            ImageGenerationError = "Package Label image generation failed. Please try again.";
            Console.WriteLine("[PACKAGE LABEL] image generation failed");
        }
        finally
        {
            IsBusy = false;
            isGeneratingLabelImages = false;
            currentGenerationIndex = 0;
            totalGenerations = 0;
            StateHasChanged();
        }
    }
    private async Task<string> FetchDeliverableDetail(string deliverable)
    {
        HttpClient client = new HttpClient();
        string functionUrl = $"{ApiConfig.ApiBaseUrl}api/GetDeliverableDetail?code=REDACTED_FOR_GROOMING";

        var content = new StringContent($"\"{deliverable}\"", System.Text.Encoding.UTF8, "application/json");

        var response = await client.PostAsync(functionUrl, content);

        if (response.IsSuccessStatusCode)
        {
            var detail = await response.Content.ReadAsStringAsync();

            // Normalize newlines and collapse to one line
            string singleLine = Regex.Replace(detail, @"\s*\r?\n\s*", " ").Trim();
            return singleLine;
        }

        return "Error: Unable to fetch deliverable detail.";
    }

    private bool IsLabelRelated(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return false;

        string[] labelKeywords =
        {
            "label",
            "package",
            "packaging",
            "product",
            "shipping",
            "barcode",
            "sku",
            "warning",
            "caution",
            "informational",
            "sticker",
            "tag"
    };

        return labelKeywords.Any(keyword =>
            text.Contains(keyword, StringComparison.OrdinalIgnoreCase));
    }

    private string SanitizeCompanyName(string companyName)
    {
        if (string.IsNullOrWhiteSpace(companyName))
            return string.Empty;

        return string.Concat(companyName
            .Where(c => !Path.GetInvalidFileNameChars().Contains(c)))
            .Replace(" ", "-")
            .Replace("&", "");
    }

    private string FormatDateTime(string dateTimeString)
    {
        if (string.IsNullOrWhiteSpace(dateTimeString))
            return "Unknown date";

        if (DateTime.TryParse(
            dateTimeString,
            null,
            System.Globalization.DateTimeStyles.RoundtripKind,
            out var dateTime))
        {
            return dateTime.ToLocalTime().ToString("MM/dd/yyyy hh:mm tt");
        }

        return dateTimeString;
    }

    private int GetNextPackageLabelVersion()
    {
        if (sortedPackageLabels == null || !sortedPackageLabels.Any())
            return 1;

        var maxVersion = sortedPackageLabels
            .Select(x =>
            {
                var value = x.Version?.Trim().TrimStart('v', 'V');
                return int.TryParse(value, out var version) ? version : 0;
            })
            .DefaultIfEmpty(0)
            .Max();

        return maxVersion + 1;
    }

    private string GetLogicalPackageLabelId(string generatedLabelId)
    {
        var existingId = sortedPackageLabels?
            .Where(x => !string.IsNullOrWhiteSpace(x.PackageLabelId))
            .OrderByDescending(x =>
                DateTime.TryParse(x.TimeStamp, out var dt)
                    ? dt
                    : DateTime.MinValue)
            .Select(x => x.PackageLabelId)
            .FirstOrDefault();

        if (!string.IsNullOrWhiteSpace(existingId))
            return existingId;

        if (!string.IsNullOrWhiteSpace(generatedLabelId))
            return generatedLabelId;

        return Guid.NewGuid().ToString();
    }

