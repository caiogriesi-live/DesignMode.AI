    private void ViewGeneratedLabel(GeneratedLabelRecord item)
    {
        if (item == null)
            return;

        ActiveGeneratedLabel = item;
        GeneratedLabelPreviewUrl = item.PreviewUrl;
        GeneratedLabelDownloadUrl =
            string.IsNullOrWhiteSpace(item.DownloadUrl)
                ? item.PreviewUrl
                : item.DownloadUrl;
        GeneratedPrintReadyPdfUrl = item.PrintReadyPdfUrl;

        if (!string.IsNullOrWhiteSpace(item.Version))
        {
            currentVersion = item.Version.Replace(
                "v",
                "",
                StringComparison.OrdinalIgnoreCase);
        }

        StateHasChanged();
    }

    private async Task CloseModal()
    {
        if (GenerationGuard is null && (IsBusy || IsGeneratingLabel || isGeneratingLabelImages)) return;
        if (!await ConfirmGenerationCloseAsync()) return;

        Show = false;
        await ShowChanged.InvokeAsync(false);
        if (OnModalClosed.HasDelegate && wasImageGenerated) await OnModalClosed.InvokeAsync();
        newlyGeneratedImages.Clear();
        wasImageGenerated = false;
        ImageGenerationError = "";
        ActiveTab = TabType.GenerateNew;
        hasLoadedVersions = false;
        ActiveGeneratedLabel = GeneratedLabels.FirstOrDefault();
    }

    private RenderFragment ImageCard(DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel image) => __builder =>
    {
        var isSelected = SelectedImageIds.Contains(image.Id);
        var isNew = newlyGeneratedImages.Contains(image);
        <div class="image-card @(isSelected ? "label-selected" : "") @(isNew ? "newly-generated" : "")" @onclick="() => ToggleSelection(image.ImageUrl, image.Id)">
            <img src="@image.ImageUrl" alt="Package label asset" class="image-thumb" />
            <div class="image-controls"><div class="label-selection-indicator @(isSelected ? "selected" : "")" @onclick="() => ToggleSelection(image.ImageUrl, image.Id)" @onclick:stopPropagation><span class="indicator-icon" title="@(isSelected ? "Selected for package label" : "Select for package label")">@(isSelected ? "✓" : "+")</span></div></div>
            @if (isSelected)
            {
                <div class="label-selection-badge"><span class="badge-icon">📦</span> Reference Image</div>
            }
            @if (isNew)
            {
                <div class="new-image-badge"><span class="badge-icon">🆕</span> New</div>
            }
        </div>
    };

