    private string GetGenerateButtonText() => SelectedImageIds.Any() ? "Generate Package Label" : "Select an Image to Generate Label";

    private async Task GenerateLabel()
    {
        if (IsGeneratingLabel || !SelectedImageIds.Any()) return;
        await using var generationOperation = await BeginGenerationAsync();

        IsGeneratingLabel = true;
        ActiveTab = TabType.GeneratedLabel;
        GenerationError = "";
        GenerationSteps.Clear();
        UpdateGenerationStatus("Starting label generation...", "Preparing your selected image and label specifications", 5);
        StateHasChanged();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated != true)
                throw new InvalidOperationException("You must be signed in to generate a package label.");

            UpdateGenerationStatus("Selecting reference image...", "Using your selected image as the design reference", 15);
            var allImages = new List<DesignMode.AI.Client.Pages.Init.Gen.ImageIdeaModel>();
            if (LabelImages != null) allImages.AddRange(LabelImages);
            if (newlyGeneratedImages != null) allImages.AddRange(newlyGeneratedImages);
            var selectedImage = allImages.FirstOrDefault(img => SelectedImageIds.Contains(img.Id) && !string.IsNullOrWhiteSpace(img.ImageUrl));
            if (selectedImage == null) throw new InvalidOperationException("The selected image could not be found.");

            UpdateGenerationStatus("Preparing label brief...", "Combining the image reference with your product and print settings", 30);
            var uri = NavigationManager.Uri;
            var queryString = new Uri(uri).Query;
            var cid = GetQueryParameter(queryString, "cid", "");
            string companyName = "";
            string industry = "";
            if (!string.IsNullOrWhiteSpace(cid))
            {
                var parts = cid.Split(new string[] { "|~~|@@|^^|" }, StringSplitOptions.None);
                if (parts.Length >= 2)
                {
                    try { companyName = Encoding.UTF8.GetString(Convert.FromBase64String(parts[0])); industry = Encoding.UTF8.GetString(Convert.FromBase64String(parts[1])); }
                    catch (FormatException) { }
                }
            }

            UpdateGenerationStatus("Generating package label...", "AI is creating a new label based on the selected image", 55);
            var generationJobId = Guid.NewGuid().ToString();
            var attribution = await AttributionContext.AuthorizeGenerationAsync(CompanyIdeaId);
            var labelRequest = new
            {
                ImageUrl = selectedImage.ImageUrl,
                SelectedImageUrl = selectedImage.ImageUrl,
                SelectedImageId = selectedImage.Id,
                Name = companyName,
                Industry = industry,
                CompanyDescription = CompanyDescription,
                Prompt = MainPromptText,
                LabelType = SelectedLabelType,
                LabelSize = SelectedLabelSize,
                Material = SelectedMaterial,
                Orientation = SelectedOrientation,
                ProductName,
                SkuBarcode,
                AdditionalInfo,
                IncludeBarcode,
                IncludeQrCode,
                IncludeBrandLogo,
                UserId = user.Identity?.Name,
                Timestamp = DateTime.UtcNow.ToString("yyyyMMddTHHmmssZ"),
                GenerationJobId = generationJobId,
                ProjectId = attribution?.ProjectId,
                FunnelId = attribution?.FunnelId
            };

            using var request = new HttpRequestMessage(
                HttpMethod.Post,
                $"{ApiConfig.ApiBaseUrl}api/GeneratePackageLabel?code=REDACTED_FOR_GROOMING")
            {
                Content = JsonContent.Create(labelRequest)
            };
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrWhiteSpace(token))
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            using var response = await Http.SendAsync(request);
            if (await UsageRefresh.HandleResponseAsync(response)) return;

            if (!response.IsSuccessStatusCode)
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                throw new InvalidOperationException($"GeneratePackageLabel returned {(int)response.StatusCode}: {errorBody}");
            }

            UpdateGenerationStatus("Processing generated label...", "Loading the generated preview and print assets", 85);
            var result = await response.Content.ReadFromJsonAsync<LabelGenerationResult>();
            if (result == null || !result.Success || string.IsNullOrWhiteSpace(result.PreviewUrl))
                throw new InvalidOperationException(result?.Error ?? "The function did not return a generated label preview URL.");

            await UsageRefresh.RequestRefreshAsync();

            GeneratedLabelPreviewUrl = result.PreviewUrl;
            GeneratedLabelDownloadUrl = string.IsNullOrWhiteSpace(result.DownloadUrl) ? result.PreviewUrl : result.DownloadUrl;
            GeneratedPrintReadyPdfUrl = result.PrintReadyPdfUrl ?? "";

            // Mirror the website version-persistence sequence.
            var safeCompanyName = !string.IsNullOrWhiteSpace(SelectedCompanyName)
                ? SelectedCompanyName
                : SanitizeCompanyName(companyName);

            if (string.IsNullOrWhiteSpace(safeCompanyName))
                throw new InvalidOperationException("Company name could not be determined for package-label persistence.");

            if (!hasLoadedVersions)
            {
                await LoadExistingPackageLabelVersionsAsync(safeCompanyName);
                hasLoadedVersions = true;
            }

            var nextVersion = GetNextPackageLabelVersion();
            var logicalPackageLabelId = GetLogicalPackageLabelId(result.LabelId);
            var versionText = $"v{nextVersion}";
            var timeStamp = DateTime.UtcNow.ToString("o");

            UpdateGenerationStatus(
                "Saving package label image...",
                $"Saving {versionText} to its local package-label version folder",
                90);

            // Save the actual generated image first. This is the package-label
            // equivalent of saving website HTML/background/screenshot files.
            var savedPreviewUrl = await SaveGeneratedPackageLabelFileAsync(
                result.PreviewUrl,
                safeCompanyName,
                nextVersion.ToString());

            if (string.IsNullOrWhiteSpace(savedPreviewUrl))
                throw new InvalidOperationException("The generated package-label image could not be saved.");

            UpdateGenerationStatus(
                "Saving package label version...",
                $"Adding {versionText} to package-label history",
                94);

            // Save the version index row after the file exists.
            await SavePackageLabelAsync(
                logicalPackageLabelId,
                safeCompanyName,
                versionText,
                timeStamp);

            // Same pattern as the website modal: re-query all DB rows and then
            // rebuild every displayed image from the local/storage version files.
            await LoadExistingPackageLabelVersionsAsync(safeCompanyName);

            currentVersion = nextVersion.ToString();

            // Replace the reconstructed latest record with the richer in-memory
            // metadata from this generation, but keep the persisted local file URL.
            var generatedRecord = GeneratedLabels.FirstOrDefault(x =>
                string.Equals(x.Version, versionText, StringComparison.OrdinalIgnoreCase));

            if (generatedRecord == null)
            {
                generatedRecord = new GeneratedLabelRecord
                    {
                        PreviewUrl = savedPreviewUrl,
                        DownloadUrl = savedPreviewUrl,
                        PackageLabelId = logicalPackageLabelId,
                        Version = versionText,
                        CreatedAt = DateTime.UtcNow
                    };

                GeneratedLabels.Insert(0, generatedRecord);
            }

            generatedRecord.PreviewUrl = savedPreviewUrl;
            generatedRecord.DownloadUrl = savedPreviewUrl;
            generatedRecord.PrintReadyPdfUrl = result.PrintReadyPdfUrl ?? "";
            generatedRecord.LabelId = result.LabelId ?? "";
            generatedRecord.PackageLabelId = logicalPackageLabelId;
            generatedRecord.ProductName = ProductName;
            generatedRecord.LabelType = SelectedLabelType;
            generatedRecord.LabelSize = SelectedLabelSize;
            generatedRecord.Material = SelectedMaterial;
            generatedRecord.Orientation = SelectedOrientation;
            generatedRecord.SkuBarcode = SkuBarcode;
            generatedRecord.AdditionalInfo = AdditionalInfo;
            generatedRecord.CreatedAt = DateTime.UtcNow;

            ViewGeneratedLabel(generatedRecord);

            UpdateGenerationStatus(
                "Complete!",
                $"Your package label {versionText} has been generated, saved, and added to the gallery",
                100);

            if (OnLabelGenerated.HasDelegate)
                await OnLabelGenerated.InvokeAsync(true);
        }
        catch (Exception ex)
        {
            GenerationError = ex.Message;
            GenerationStatus = "Generation failed";
            CurrentStepDetails = ex.Message;
            GenerationProgress = 0;
            Console.WriteLine($"❌ Exception generating label: {ex}");
        }
        finally
        {
            IsGeneratingLabel = false;
            StateHasChanged();
        }
    }

