@page "/init/init"

@using Telerik.Blazor.Components
@using Telerik.Blazor
@using Telerik.SvgIcons
@using Microsoft.AspNetCore.Components.Authorization
@using DesignMode.AI.Shared.Security
@using Microsoft.AspNetCore.Authorization
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject AuthService Auth

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<div class="setup-page" @onclick="HandlePageClick">

    <div class="setup-card">

        <!-- LEFT PANEL -->
        <div class="setup-left">

            <div class="logo-container">

                <img src="assets/img/logo-left.png"
                     class="logo-icon"
                     alt="logo" />

                <span class="logo-text" style="font-family: 'SF Pro Display','Arial'; font-weight: 650; font-size: 24px; color: #1f2951; text-transform: none;">
                    design
                    <img src="images/logo-m3.svg"
                         class="logo-m" />
                    ode.ai
                </span>

            </div>

            <h1 class="setup-title" style="'SF Pro Display','Arial' !important;">
                Let's set up<br />
                your business
            </h1>

            <p class="setup-description" style="'SF Pro Display','Arial' !important;">
                Tell us a little about your company
                so we can personalize your
                experience.
            </p>

            <div class="security-note">
                <span class="shield-icon">🛡️</span>
                <span style="'SF Pro Display','Arial' !important;">
                    Your information is secure
                    and never shared.
                </span>
            </div>

        </div>

        <!-- RIGHT PANEL -->
        <div class="setup-right">

            <div class="form-group">

                <label>
                    What's your company name?
                </label>

                <div class="input-wrapper">
                    <input class="setup-input"
                           type="text"
                           placeholder="e.g. Acme Studios"
                           @bind="organizationText"
                           @bind:event="oninput" />
                </div>

                @if (!string.IsNullOrEmpty(organizationError))
                {
                    <div class="validation-error">
                        @organizationError
                    </div>
                }

            </div>

            <div class="form-group">

                <label>
                    What industry are you in?
                </label>

                <div class="input-wrapper industry-input-wrapper" @onclick:stopPropagation="true">
                    <input id="industryInput"
                           class="setup-input industry-input"
                           type="text"
                           placeholder="e.g. Marketing Agency, Restaurant, SaaS Company"
                           @bind="industryText"
                           @bind:event="oninput"
                           @onkeyup="OnIndustryKeyUp"
                           @onfocus="OnIndustryFocus" />

                    @if (isLoadingIndustries)
                    {
                        <div class="loading-indicator loading-animation">
                            <TelerikLoader Size="@(ThemeConstants.Loader.Size.Small)" />
                            <span>Searching industries...</span>
                        </div>
                    }

                    @if (industrySuggestions.Any() &&
                    !string.IsNullOrEmpty(industryText) &&
                    !isLoadingIndustries &&
                    showDropdown)
                    {
                        <div class="suggestions-dropdown">

                            <!-- User's custom value -->
                            <div class="suggestion-item"
                                 @onclick="() => UseCustomIndustry()">
                                <span class="suggestion-emoji">🔍</span>
                                <span class="suggestion-text">
                                    Use "@industryText"
                                </span>
                            </div>

                            @foreach (var suggestion in industrySuggestions)
                            {
                                <div class="suggestion-item"
                                     @onclick="() => SelectIndustry(suggestion)">
                                    <span class="suggestion-emoji">
                                        @GetIndustryEmoji(suggestion)
                                    </span>
                                    <span class="suggestion-text">
                                        @suggestion
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(industryError))
                {
                    <div class="validation-error">
                        @industryError
                    </div>
                }

            </div>

            <div class="settings-note">
                🔒 You can change this anytime in settings.
            </div>

            <div class="button-section">

                <TelerikButton OnClick="@HandleContinue"
                               Class="continue-button">
                    Continue →
                </TelerikButton>

@*                 <div class="skip-wrapper">

                    <button class="skip-link"
                            @onclick="Skip">
                        Skip for now
                    </button>

                </div> *@

            </div>

            <div class="loader-container">

                <TelerikLoader Visible="@LoaderVisible"
                               Size="@(ThemeConstants.Loader.Size.Medium)"
                               ThemeColor="@ThemeConstants.Loader.ThemeColor.Warning" />

            </div>

        </div>

    </div>

</div>

