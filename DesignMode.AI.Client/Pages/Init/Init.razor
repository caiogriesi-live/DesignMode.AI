        min-width: 32px;
    }

    .suggestion-text {
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .suggestions-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 1px solid #d8dde8;
        border-radius: 14px;
        margin-top: 8px;
        max-height: 300px;
        overflow-y: auto;
        overflow-x: hidden;
        z-index: 1000;
        box-shadow: 0 10px 25px rgba(0,0,0,.1);
    }

    .suggestions-container {
        padding: 4px 0;
    }

    /* Hide scrollbar for Chrome, Safari and Opera */
    .suggestions-dropdown::-webkit-scrollbar {
        width: 6px;
    }

    .suggestions-dropdown::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    .suggestions-dropdown::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 10px;
    }

        .suggestions-dropdown::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }

    /* Desktop styles remain the same */
    @@media (min-width: 769px) {
        .suggestions-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            max-height: 300px;
        }
    }
</style>
<script>
    window.isMobileScreen = () => {
        return window.innerWidth <= 1024;
    };

    window.scrollFieldIntoView = (id) => {
        setTimeout(() => {
            const el = document.getElementById(id);
            if (el) {
                el.scrollIntoView({
                    behavior: 'smooth',
                    block: 'center'
                });
            }
        }, 300); // wait for keyboard animation
    };
</script>
@code {

    private void UseCustomIndustry()
    {
        industrySuggestions.Clear();
        showDropdown = false;
    }

    private string organizationText = "";
    private string industryText = "";
    private bool isLoadingIndustries = false;
    private List<string> industrySuggestions = new();
    private System.Timers.Timer debounceTimer;
    private string organizationError = "";
    private string industryError = "";
    private bool LoaderVisible = false;
    private bool showDropdown = true;
    private string selectedSuggestion = "";
    private ElementReference industryInputRef;

    private async Task HandleContinue()
    {
        if (!ValidateForm())
            return;

        await Next();
    }

    private void HandlePageClick()
    {
        // Close dropdown when clicking outside
        if (showDropdown)
        {
            showDropdown = false;
            StateHasChanged();
        }
    }

    private void OnIndustryFocus()
    {
        // Show dropdown when focusing on input if there are suggestions
        if (industrySuggestions.Any() && !string.IsNullOrEmpty(industryText))
        {
            showDropdown = true;
            StateHasChanged();
        }
    }

    private async Task OnIndustryKeyUp(KeyboardEventArgs e)
    {
        // Clear any previous error when user types
        industryError = "";

        // Show dropdown when typing
        showDropdown = true;

        // Cancel previous timer if exists
        debounceTimer?.Stop();
        debounceTimer?.Dispose();

        // If user typed something and it's valid, keep the typed value
        // No need to clear industryText - it stays as is

        if (industryText.Length < 2)
        {
            industrySuggestions.Clear();
            StateHasChanged();
            return;
        }

        // Debounce API calls
        debounceTimer = new System.Timers.Timer(500);
        debounceTimer.Elapsed += async (sender, args) =>
        {
            await InvokeAsync(async () =>
            {
                isLoadingIndustries = true;
                StateHasChanged();

                var suggestions = await FetchIndustrySuggestions(
                    industryText,
                    ApiConfig.ApiBaseUrl);

                bool isMobile =
    await JSRuntime.InvokeAsync<bool>("isMobileScreen");

                int maxSuggestions = isMobile ? 4 : 8;

                // Only show suggestions that match or are relevant to what user typed
                industrySuggestions = suggestions
                    .Where(s => s.Contains(industryText, StringComparison.OrdinalIgnoreCase))
                    .Take(maxSuggestions)
                    .ToList();

                isLoadingIndustries = false;
                showDropdown = true;
                StateHasChanged();
            });
            debounceTimer.Stop();
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    private bool IsMobile()
    {
        // Check if the screen width is 768px or less (typical mobile breakpoint)
        // You can also use JSRuntime to get actual window width, but this is simpler
        return System.Environment.GetEnvironmentVariable("BlazorEnvironment")?.Contains("Mobile") ?? false;
    }

    private async Task SelectIndustry(string industry)
    {
        // Apply selection animation
        selectedSuggestion = industry;
        StateHasChanged();

        // Wait for animation
        await Task.Delay(150);

        industryText = industry;
        industrySuggestions.Clear();
        industryError = "";
        showDropdown = false;
        selectedSuggestion = "";
        StateHasChanged();
    }
    private async Task ScrollToField(string id)
    {
        if (IsMobileDevice)
        {
            await JSRuntime.InvokeVoidAsync("scrollFieldIntoView", id);
        }
    }

    private async Task OnIndustryFocusAndScroll()
    {
        OnIndustryFocus();

        if (IsMobileDevice)
        {
            await JSRuntime.InvokeVoidAsync("scrollFieldIntoView", "industryInput");
        }
    }
    private string GetIndustryEmoji(string industry)
    {
        if (string.IsNullOrWhiteSpace(industry)) return "→";

        var lowerIndustry = industry.ToLower();

        // Technology
        if (lowerIndustry.Contains("technology") ||
            lowerIndustry.Contains("software") ||
            lowerIndustry.Contains("saas") ||
            lowerIndustry.Contains("it"))
            return "💻";

        // Marketing
        if (lowerIndustry.Contains("marketing") ||
            lowerIndustry.Contains("advertising") ||
            lowerIndustry.Contains("pr") ||
            lowerIndustry.Contains("social media"))
            return "📣";

        // Ecommerce / Retail
        if (lowerIndustry.Contains("ecommerce") ||
            lowerIndustry.Contains("e-commerce") ||
            lowerIndustry.Contains("retail") ||
            lowerIndustry.Contains("shop"))
            return "🛍️";

        // Design
        if (lowerIndustry.Contains("design") ||
            lowerIndustry.Contains("creative") ||
            lowerIndustry.Contains("art") ||
            lowerIndustry.Contains("graphic"))
            return "🎨";

        // Education
        if (lowerIndustry.Contains("education") ||
            lowerIndustry.Contains("training") ||
            lowerIndustry.Contains("learning") ||
            lowerIndustry.Contains("school"))
            return "🎓";

        // Healthcare
        if (lowerIndustry.Contains("health") ||
            lowerIndustry.Contains("medical") ||
            lowerIndustry.Contains("wellness"))
            return "🏥";

        if (lowerIndustry.Contains("fitness"))
            return "💪";

        // Finance
        if (lowerIndustry.Contains("finance") ||
            lowerIndustry.Contains("banking") ||
            lowerIndustry.Contains("investment") ||
            lowerIndustry.Contains("accounting"))
            return "💰";

        // Real Estate
        if (lowerIndustry.Contains("real estate") ||
            lowerIndustry.Contains("property") ||
            lowerIndustry.Contains("housing"))
            return "🏠";

        // Consulting
        if (lowerIndustry.Contains("consulting") ||
            lowerIndustry.Contains("strategy"))
            return "💼";

        // Manufacturing
        if (lowerIndustry.Contains("manufacturing") ||
            lowerIndustry.Contains("production"))
            return "🏭";

        // Hospitality
        if (lowerIndustry.Contains("restaurant"))
            return "🍽️";

        if (lowerIndustry.Contains("hotel") ||
            lowerIndustry.Contains("hospitality"))
            return "🏨";

        if (lowerIndustry.Contains("travel"))
            return "✈️";

        // Entertainment
        if (lowerIndustry.Contains("entertainment") ||
            lowerIndustry.Contains("film"))
            return "🎬";

        if (lowerIndustry.Contains("gaming"))
            return "🎮";

        if (lowerIndustry.Contains("media"))
            return "📺";

        // Construction
        if (lowerIndustry.Contains("construction") ||
            lowerIndustry.Contains("building"))
            return "🏗️";

        if (lowerIndustry.Contains("architecture"))
            return "📐";

        // Legal
        if (lowerIndustry.Contains("legal") ||
            lowerIndustry.Contains("law") ||
            lowerIndustry.Contains("attorney"))
            return "⚖️";

        // Nonprofit
        if (lowerIndustry.Contains("nonprofit") ||
            lowerIndustry.Contains("charity") ||
            lowerIndustry.Contains("ngo"))
            return "🤝";

        // Agriculture
        if (lowerIndustry.Contains("agriculture") ||
            lowerIndustry.Contains("farming"))
            return "🌾";

        if (lowerIndustry.Contains("food"))
            return "🍎";

        // Logistics
        if (lowerIndustry.Contains("transportation") ||
            lowerIndustry.Contains("logistics") ||
            lowerIndustry.Contains("delivery"))
            return "🚚";

        // Energy
        if (lowerIndustry.Contains("solar"))
            return "☀️";

        if (lowerIndustry.Contains("renewable"))
            return "🌱";

        if (lowerIndustry.Contains("energy") ||
            lowerIndustry.Contains("utilities"))
            return "⚡";

        // Oil & Gas
        if (lowerIndustry.Contains("gas utility"))
            return "🔥";

        if (lowerIndustry.Contains("gasoline"))
            return "⛽";

        if (lowerIndustry.Contains("oil"))
            return "🛢️";

        if (lowerIndustry.Contains("gas"))
            return "🔥";

        // Chemicals
        if (lowerIndustry.Contains("chemical"))
            return "🧪";

        // Insurance
        if (lowerIndustry.Contains("insurance"))
            return "🛡️";

        // Automotive
        if (lowerIndustry.Contains("automotive") ||
            lowerIndustry.Contains("car") ||
            lowerIndustry.Contains("vehicle"))
            return "🚗";

        return "→";
    }

