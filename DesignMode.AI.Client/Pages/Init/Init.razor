    private async Task<bool> UpdateUserOnboarded(string userId, string url)
    {
        try
        {
            HttpClient client = new HttpClient();

            string functionUrl =
                $"{url}api/UpdateOnboarded?code=REDACTED_FOR_GROOMING";

            var response = await client.PostAsJsonAsync(
                functionUrl,
                new UpdateOnboardedRequest
                    {
                        UserId = userId,
                        Onboarded = "1"
                    });

            return response.IsSuccessStatusCode;
        }
        catch
