    private async Task<CheckUserOnboardedResponse> CheckUserOnboarded(string username, string url)
    {
        try
        {
            HttpClient client = new HttpClient();

            string functionUrl =
                $"{url}api/CheckUserOnboarded?username={Uri.EscapeDataString(username)}&code=REDACTED_FOR_GROOMING";

            var response = await client.GetAsync(functionUrl);

            if (!response.IsSuccessStatusCode)
                return null;

            var result = await response.Content.ReadFromJsonAsync<CheckUserOnboardedResponse>();

            return result;
        }
        catch
        {
            return null;
        }
    }
