@page "/signup"
@using System.ComponentModel.DataAnnotations
@using DesignMode.AI.Shared.Security
@using DesignMode.AI.Client.Services
@using DesignMode.AI.Shared.Util
@using System.Text
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject AuthService Auth
@inject NavigationManager Nav
@inject PostAuthNavigationService PostAuthNavigation
@inject SavePending SavePending
@inject ApiConfigService ApiConfig
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<link href="assets/css/brief-landing.css" rel="stylesheet" />

<!--
    Google Identity Services.
    Keep this Client ID in sync with the working Google auth used elsewhere
    in the app. This must be an OAuth 2.0 "Web application" Client ID, and
    every deployed origin must be listed in Authorized JavaScript origins.
-->
<meta name="google-signin-client_id"
      content="920601965266-dio1oduk6jek0jnlti1t8nbgsnb5a7g9.apps.googleusercontent.com" />

<div class="signup-page">
    <div class="signup-background">

        <!-- Logo above the card -->
        <button type="button"
                class="signup-logo-button"
                disabled="@isProcessing"
                @onclick="GoToHome"
                aria-label="Go to home">
            <img src="assets/img/logo-left.png"
                 class="signup-logo-left"
                 alt="DesignMode logo" />

            <span class="signup-logo-wordmark">
                design<span class="signup-logo-accent">
                    <img src="images/logo-m3.svg"
                         class="signup-logo-m3"
                         alt="" />
                </span>ode.ai
            </span>
        </button>

        <!-- Sign Up card -->
        <div class="signup-card">

            <h1 class="signup-title" tabindex="-1">
                Sign up
            </h1>

            <p class="signup-subtitle">
                Create your account to transform ideas into designs and connect with creators.
            </p>

            <!-- Google is intentionally first, matching the account modal -->
            <div class="signup-google-wrap @(isProcessing ? "is-disabled" : "")">
                <div id="signupGoogleButton"
                     class="signup-google-button"
                     aria-label="Continue with Google">
                </div>
            </div>

            <div class="signup-divider" aria-hidden="true">
                <hr />
                <span>OR</span>
                <hr />
            </div>

            <!-- Standard account creation -->
            <div class="signup-form">

                <input @bind="email"
                       type="email"
                       name="email"
                       autocomplete="username"
                       placeholder="Email address"
                       disabled="@isProcessing"
                       class="signup-input" />

                @if (!string.IsNullOrEmpty(email) && !IsValidEmail(email) && !isProcessing)
                {
                    <div class="signup-field-error">
                        Please enter a valid email address
                    </div>
                }

                <input @bind="phoneNumber"
                       type="tel"
                       name="phone"
                       autocomplete="tel"
                       placeholder="Phone number (optional)"
                       disabled="@isProcessing"
                       class="signup-input" />

                <input @bind="password"
                       type="password"
                       name="password"
                       autocomplete="new-password"
                       placeholder="Password"
                       disabled="@isProcessing"
                       class="signup-input" />

                <input @bind="confirmPassword"
                       type="password"
                       name="confirm-password"
                       autocomplete="new-password"
                       placeholder="Confirm Password"
                       disabled="@isProcessing"
                       class="signup-input" />


                @if (errorMessage is not null)
                {
                    <p class="signup-message signup-message-error">
                        @errorMessage
                    </p>
                }

                @if (successMessage is not null)
                {
                    <p class="signup-message signup-message-success">
                        @successMessage
                    </p>
                }

                <button @onclick="HandleSignup"
                        disabled="@isProcessing"
                        class="signup-primary-button">
                    @if (isProcessing && !isGoogleProcessing)
                    {
                        <span>Signing up...</span>
                    }
                    else
                    {
                        <span>Sign up</span>
                    }
                </button>

                <!-- Login link -->
                <div class="signup-login-row">
                    <span>Already have an account?</span>
                    <a href="@PostAuthNavigation.AuthenticationLink("/login")"
                       class="signup-link @(isProcessing ? "disabled-link" : "")">
                        Log in
                    </a>
                </div>

                <!-- Legal copy also covers the Google path -->
                <div class="signup-legal">
                    By continuing with Google or creating an account, you agree to our
                    <a href="/terms.html"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="signup-link">
                        Terms
                    </a>
                    and
                    <a href="/privacy.html"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="signup-link">
                        Privacy Policy
                    </a>.
                </div>

            </div>
        </div>
    </div>
</div>

<style>
