    private bool IsPasswordStrong(string value)
    {
        if (string.IsNullOrEmpty(value))
            return false;

        if (value.Length < 8)
            return false;

        if (!value.Any(char.IsUpper))
            return false;

        if (!value.Any(char.IsLower))
            return false;

        if (!value.Any(char.IsDigit))
            return false;

        if (!value.Any(ch => !char.IsLetterOrDigit(ch)))
            return false;

        return true;
    }
