<script src="https://accounts.google.com/gsi/client" async defer></script>

<script>
    window.signupGoogle = window.signupGoogle || (function () {
        "use strict";

        let dotNetHelper = null;
        let clientId = "";
        let renderRetryTimer = null;
        let resizeTimer = null;
        let lastRenderedWidth = 0;
        let initialized = false;

        function getHost() {
            return document.getElementById("signupGoogleButton");
        }

        function getSafeButtonWidth() {
            const host = getHost();

            if (!host) {
                return 320;
            }

            const rect = host.getBoundingClientRect();
            const availableWidth = Math.floor(rect.width || 320);

            /*
                Leave a small gutter for borders, sub-pixel rounding,
                mobile zoom, and device-pixel-ratio differences.
            */
            const safeWidth = Math.floor(availableWidth - 6);

            return Math.max(120, Math.min(400, safeWidth));
        }

        function render(forceRender) {
            const host = getHost();

            if (!host || !clientId) {
                return;
            }

            if (!window.google || !google.accounts || !google.accounts.id) {
                if (renderRetryTimer) {
                    clearTimeout(renderRetryTimer);
                }

                renderRetryTimer = setTimeout(function () {
                    render(forceRender);
                }, 250);

                return;
            }

            const width = getSafeButtonWidth();

            if (
                initialized &&
                !forceRender &&
                Math.abs(width - lastRenderedWidth) < 2
            ) {
                return;
            }

            try {
                google.accounts.id.initialize({
                    client_id: clientId,
                    callback: handleCredentialResponse,
                    ux_mode: "popup",
                    auto_select: false,
                    cancel_on_tap_outside: false
                });

                host.innerHTML = "";

                google.accounts.id.renderButton(
                    host,
                    {
                        type: "standard",
                        theme: "outline",
                        size: "large",
                        text: "continue_with",
                        shape: "pill",
                        logo_alignment: "left",
                        width: width
                    }
                );

                initialized = true;
                lastRenderedWidth = width;
            }
            catch (error) {
                console.error("Unable to initialize Google Identity Services:", error);
            }
        }

        async function handleCredentialResponse(response) {
            const idToken = response && response.credential;

            if (!idToken || !dotNetHelper) {
                return;
            }

            try {
                await dotNetHelper.invokeMethodAsync(
                    "CompleteGoogleSignup",
                    idToken
                );
            }
            catch (error) {
                console.error("Google signup failed:", error);
            }
        }

        function scheduleResize() {
            if (resizeTimer) {
                clearTimeout(resizeTimer);
            }

            resizeTimer = setTimeout(function () {
                resizeTimer = null;
                render(true);
            }, 120);
        }

        window.addEventListener("resize", scheduleResize);
        window.addEventListener("orientationchange", scheduleResize);

        return {
            initialize: function (helper, configuredClientId) {
                dotNetHelper = helper;
                clientId = (configuredClientId || "").trim();

                requestAnimationFrame(function () {
                    render(true);
                });
            },

            setDisabled: function (disabled) {
                const wrap = document.querySelector(".signup-google-wrap");

                if (wrap) {
                    wrap.classList.toggle("is-disabled", !!disabled);
                }
            },

            rerender: function () {
                requestAnimationFrame(function () {
                    render(true);
                });
            }
        };
    })();
</script>

@code {
    private const string GoogleClientId =
        "920601965266-dio1oduk6jek0jnlti1t8nbgsnb5a7g9.apps.googleusercontent.com";

    private string email = string.Empty;
    private string phoneNumber = string.Empty;
    private string password = string.Empty;
    private string confirmPassword = string.Empty;

    private string? successMessage;
    private string? errorMessage;

    private bool isProcessing = false;
    private bool isGoogleProcessing = false;
    private DotNetObjectReference<object>? _googleDotNetHelper;
    private bool _googleInitialized = false;

    private InviteClientData InviteData { get; set; } = new InviteClientData();

    protected override async Task OnInitializedAsync()
    {
        isProcessing = false;
        isGoogleProcessing = false;
        errorMessage = null;
        successMessage = null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var authenticatedEmail =
                authState.User.FindFirst("email")?.Value
                ?? authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? authState.User.Identity?.Name
                ?? string.Empty;

            if (!string.IsNullOrWhiteSpace(authenticatedEmail))
            {
                await RedirectLoggedInUser(authenticatedEmail);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_googleInitialized)
        {
            _googleInitialized = true;

            /*
                Store the reference as object so the Razor-generated component
                type does not need to be named explicitly.
            */
            _googleDotNetHelper = DotNetObjectReference.Create<object>(this);

            try
            {
                await JS.InvokeVoidAsync(
                    "signupGoogle.initialize",
                    _googleDotNetHelper,
                    GoogleClientId);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Google button initialization error: {ex.Message}");
            }
        }
    }

    private async Task RedirectLoggedInUser(string userEmail)
    {
        await RedirectAfterAuthentication(userEmail, replace: true);
    }

    private Task RedirectAfterAuthentication(string userEmail, bool replace = true) =>
        PostAuthNavigation.NavigateAsync(replace);

    private bool IsValidEmail(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        try
        {
            var addr = new System.Net.Mail.MailAddress(value);
            return addr.Address == value;
        }
        catch
        {
            return false;
        }
    }

    private bool IsValidPhoneNumber(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return true;

        var digits = new string(phone.Where(char.IsDigit).ToArray());
        return digits.Length >= 10;
    }

    private async Task HandleSignup()
    {
        if (isProcessing)
            return;

        isProcessing = true;
        isGoogleProcessing = false;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();

        await SetGoogleDisabled(true);

        try
        {
            if (string.IsNullOrWhiteSpace(email) ||
                string.IsNullOrWhiteSpace(password))
            {
                errorMessage = "Email and password are required.";
                await StopProcessing();
                return;
            }

            email = email.Trim();

            if (!IsValidEmail(email))
            {
                errorMessage = "Please enter a valid email address.";
                await StopProcessing();
                return;
            }

            if (password != confirmPassword)
            {
                errorMessage = "Passwords do not match.";
                await StopProcessing();
                return;
            }

            if (!IsPasswordStrong(password))
            {
                errorMessage =
                    "Password must be at least 8 characters and contain uppercase, lowercase, number, and special character.";
                await StopProcessing();
                return;
            }

            if (!IsValidPhoneNumber(phoneNumber))
            {
                errorMessage = "Invalid phone number.";
                await StopProcessing();
                return;
            }

            var result = await Auth.Signup(
                email,
                password,
                phoneNumber,
                ApiConfig.ApiBaseUrl);

            if (!result.Success)
            {
                errorMessage = result.ErrorMessage;
                await StopProcessing();
                return;
            }

            var loginSuccess = await Auth.Login(
                email,
                password,
                ApiConfig.ApiBaseUrl);

            if (!loginSuccess)
            {
                errorMessage = "Signup succeeded, but login failed.";
                await StopProcessing();
                return;
            }

            successMessage = "Account created. Redirecting...";
            StateHasChanged();

            await SavePending.SavePendingIdeasAfterLogin(ApiConfig.ApiBaseUrl);
            await SavePending.SavePendingCompanyInfoAfterLogin(ApiConfig.ApiBaseUrl);

            await RedirectAfterAuthentication(email, replace: true);
        }
        catch (Exception ex)
        {
            errorMessage = $"Signup error: {ex.Message}";
            await StopProcessing();
        }
    }

    [JSInvokable]
    public async Task CompleteGoogleSignup(string idToken)
    {
        if (isProcessing)
            return;

        isProcessing = true;
        isGoogleProcessing = true;
        errorMessage = null;
        successMessage = null;

        await InvokeAsync(StateHasChanged);
        await SetGoogleDisabled(true);

        try
        {
            if (string.IsNullOrWhiteSpace(idToken))
            {
                errorMessage = "Google did not return a valid sign-in token.";
                await StopProcessing();
                return;
            }

            /*
                This is the same Google authentication path used by the
                workspace account modal. The backend can create or authenticate
                the Google-backed account, then the page continues through the
                same post-login save + redirect pipeline as email signup.
            */
            var success = await Auth.LoginWithGoogle(
                idToken,
                ApiConfig.ApiBaseUrl);

            if (!success)
            {
                errorMessage = "Google signup failed. Please try again.";
                await StopProcessing();
                return;
            }

            await SavePending.SavePendingIdeasAfterLogin(ApiConfig.ApiBaseUrl);
            await SavePending.SavePendingCompanyInfoAfterLogin(ApiConfig.ApiBaseUrl);

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();

            if (authState.User.Identity?.IsAuthenticated != true)
            {
                errorMessage =
                    "Google signup succeeded, but the authenticated session is not ready.";
                await StopProcessing();
                return;
            }

            var authenticatedEmail =
                authState.User.FindFirst("email")?.Value
                ?? authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? authState.User.Identity?.Name
                ?? string.Empty;

            if (string.IsNullOrWhiteSpace(authenticatedEmail))
            {
                errorMessage =
                    "Google signup succeeded, but we could not determine your account email.";
                await StopProcessing();
                return;
            }

            successMessage = "Google signup successful. Redirecting...";
            await InvokeAsync(StateHasChanged);

            await RedirectAfterAuthentication(
                authenticatedEmail.Trim(),
                replace: true);
        }
        catch (Exception ex)
        {
            errorMessage = $"Google signup error: {ex.Message}";
            await StopProcessing();
        }
    }

    private async Task StopProcessing()
    {
        isProcessing = false;
        isGoogleProcessing = false;

        await InvokeAsync(StateHasChanged);
        await SetGoogleDisabled(false);

        try
        {
            await JS.InvokeVoidAsync("signupGoogle.rerender");
        }
        catch
        {
            // Ignore a re-render failure; the standard signup form still works.
        }
    }

    private async Task SetGoogleDisabled(bool disabled)
    {
        try
        {
            await JS.InvokeVoidAsync("signupGoogle.setDisabled", disabled);
        }
        catch
        {
            // Google may still be loading. No action is needed.
        }
    }

    private string EncryptEmail(string value)
    {
        if (string.IsNullOrEmpty(value))
            return "";

        try
        {
            var bytes = Encoding.UTF8.GetBytes(value);
            return Convert.ToBase64String(bytes);
        }
        catch
        {
            return "";
        }
    }

    private async Task<string?> CheckUserOnboarded(string username, string url)
    {
        try
        {
            using HttpClient client = new HttpClient();

            string functionUrl =
                $"{url}api/CheckUserOnboarded?username={Uri.EscapeDataString(username)}&code=REDACTED_FOR_GROOMING";

            var response = await client.GetAsync(functionUrl);

            if (!response.IsSuccessStatusCode)
                return null;

            var result =
                await response.Content.ReadFromJsonAsync<CheckUserOnboardedResponse>();

            return result?.Onboarded;
        }
        catch
        {
            return null;
        }
    }

    public class CheckUserOnboardedResponse
    {
        public bool Success { get; set; }
        public string? Username { get; set; }
        public string? UserId { get; set; }
