    private async Task<InviteClientData?> GetInviteClientByEmail(string userEmail)
    {
        try
        {
            using var client = new HttpClient();

            var requestBody = new
            {
                email = userEmail
            };

            var json =
                System.Text.Json.JsonSerializer.Serialize(requestBody);

            var content =
                new StringContent(json, Encoding.UTF8, "application/json");

            var response = await client.PostAsync(
                $"{ApiConfig.ApiBaseUrl}api/GetInviteClientByEmail?code=REDACTED_FOR_GROOMING",
                content);

            if (response.IsSuccessStatusCode)
            {
                var responseContent =
                    await response.Content.ReadAsStringAsync();

                using var document =
                    System.Text.Json.JsonDocument.Parse(responseContent);

                var root = document.RootElement;

                if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    var firstItem = root;

                    string? GetStringValue(
                        System.Text.Json.JsonElement element,
                        string propertyName)
                    {
                        if (element.TryGetProperty(propertyName, out var property))
                        {
                            return ExtractValue(property);
                        }

                        foreach (var prop in element.EnumerateObject())
                        {
                            if (prop.Name.Equals(
                                propertyName,
                                StringComparison.OrdinalIgnoreCase))
                            {
                                return ExtractValue(prop.Value);
                            }
                        }

                        return null;
                    }

                    string? ExtractValue(
                        System.Text.Json.JsonElement property)
                    {
                        if (property.ValueKind ==
                            System.Text.Json.JsonValueKind.Object)
                        {
                            if (property.TryGetProperty(
                                "s",
                                out var stringValue))
                            {
                                return stringValue.GetString();
                            }

                            if (property.TryGetProperty(
                                "S",
                                out var stringValueUpper))
                            {
                                return stringValueUpper.GetString();
                            }

                            if (property.TryGetProperty(
                                "BOOL",
                                out var boolValue))
                            {
                                return boolValue.GetBoolean().ToString();
                            }

                            if (property.TryGetProperty(
                                "bool",
                                out var boolValueLower))
                            {
                                return boolValueLower.GetBoolean().ToString();
                            }

                            if (property.TryGetProperty(
                                "N",
                                out var numberValue))
                            {
                                return numberValue.GetString();
                            }

                            if (property.TryGetProperty(
                                "n",
                                out var numberValueLower))
                            {
                                return numberValueLower.GetString();
                            }
                        }
                        else if (
                            property.ValueKind ==
                            System.Text.Json.JsonValueKind.String)
                        {
                            return property.GetString();
                        }
                        else if (
                            property.ValueKind ==
                                System.Text.Json.JsonValueKind.True ||
                            property.ValueKind ==
                                System.Text.Json.JsonValueKind.False)
                        {
                            return property.GetBoolean().ToString();
                        }
                        else if (
                            property.ValueKind ==
                            System.Text.Json.JsonValueKind.Number)
                        {
                            return property.ToString();
                        }

                        return null;
                    }

                    return new InviteClientData
                        {
                            Id = GetStringValue(firstItem, "Id"),
                            Name = GetStringValue(firstItem, "Name"),
                            Industry = GetStringValue(firstItem, "Industry"),
                            Prompt = GetStringValue(firstItem, "Prompt"),
                            Email = GetStringValue(firstItem, "Email"),
                            ImagePath =
                                GetStringValue(firstItem, "ImagePath")
                                ?? GetStringValue(firstItem, "Imagepath"),
                            UseSameImageSeedForAll =
                                GetBoolValue(
                                    firstItem,
                                    "UseSameImageSeedForAll"),
                            ImageId = GetStringValue(firstItem, "ImageId"),
                            TimeStamp =
                                GetStringValue(firstItem, "Timestamp")
                                ?? GetStringValue(firstItem, "TimeStamp")
                        };
                }
            }

            if (response.StatusCode ==
                System.Net.HttpStatusCode.NotFound)
            {
                return null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Exception getting invite client: {ex.Message}");
        }

        return null;
    }

    private bool GetBoolValue(
        System.Text.Json.JsonElement element,
        string propertyName)
    {
        if (element.TryGetProperty(propertyName, out var property))
        {
            return ExtractBoolValue(property);
        }

        foreach (var prop in element.EnumerateObject())
        {
            if (prop.Name.Equals(
                propertyName,
                StringComparison.OrdinalIgnoreCase))
            {
                return ExtractBoolValue(prop.Value);
            }
        }

        return false;
    }

    private bool ExtractBoolValue(
        System.Text.Json.JsonElement property)
    {
        if (property.ValueKind ==
            System.Text.Json.JsonValueKind.Object)
        {
            if (property.TryGetProperty("BOOL", out var boolValue))
            {
                return boolValue.GetBoolean();
            }

            if (property.TryGetProperty(
                "bool",
                out var boolValueLower))
            {
                return boolValueLower.GetBoolean();
            }
        }

        if (
            property.ValueKind ==
                System.Text.Json.JsonValueKind.True ||
            property.ValueKind ==
                System.Text.Json.JsonValueKind.False)
        {
            return property.GetBoolean();
        }

        if (property.ValueKind ==
            System.Text.Json.JsonValueKind.String)
        {
            if (bool.TryParse(
                property.GetString(),
                out bool result))
            {
                return result;
            }
        }

        return false;
    }

