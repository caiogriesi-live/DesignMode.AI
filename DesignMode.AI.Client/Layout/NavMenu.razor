@using Telerik.SvgIcons
@using Telerik.Blazor.Components
@using Telerik.Blazor
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@if (MainLayoutVariable == "")
{
}
else
{
}

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    // Receive the variable value from MainLayout
    [Parameter]
    public string MainLayoutVariable { get; set; }

    private string curPath;

    // ✅ Get FULL URL (includes query string)
    private string GetCurrentPath()
    {
        return NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    }

    protected override async Task OnInitializedAsync()
    {
        curPath = "/" + GetCurrentPath();

        // Save immediately
        if (!string.IsNullOrEmpty(curPath)
            && curPath != "/"
            && !curPath.Contains("/login")
            && !curPath.Contains("/signup")
            && !curPath.Contains("/logout")
            && !curPath.Contains("/forgot")
            && !curPath.Contains("/resetpassword"))
        {
            await JS.InvokeVoidAsync("sessionStorage.setItem", "returnUrl", curPath);
        }

        // Listen for future navigation changes
        //NavigationManager.LocationChanged += OnLocationChanged;
    }

    // ✅ Update session on every navigation
    private async void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        curPath = e.Location;

        await JS.InvokeVoidAsync("sessionStorage.setItem", "returnUrl", curPath);
    }

    // ✅ Prevent memory leaks
    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    public List<MenuModel> MenuData { get; set; }

    public void GenerateMenuData()
    {
        MenuData = new List<MenuModel>()
        {
            new MenuModel()
            {
                Text = "Test us",
                Url = "/contacts",
                Icon = SvgIcon.Envelope
            },
            new MenuModel()
            {
                Text = "Settings",
                Url = "/settings",
                Icon = SvgIcon.Gear,
                Items = new List<MenuModel>()
                {
                    new MenuModel()
                    {
                        Text = "Profile Settings",
                        Url = "/profile",
                        Icon = SvgIcon.User
                    },
                    new MenuModel()
                    {
                        Text = "Language Settings",
                        Url = "/language",
                        Icon = SvgIcon.Globe
                    }
                }
            }
        };
    }

    public class MenuModel
    {
        public string Text { get; set; }
        public string Url { get; set; }
        public ISvgIcon Icon { get; set; }
        public List<MenuModel> Items { get; set; }
    }
}

<style>
    .sidebar {
        background: transparent !important;
    }

    @@media (max-width: 768px) {
        .sidebar {
            display: none;
        }
    }
</style>