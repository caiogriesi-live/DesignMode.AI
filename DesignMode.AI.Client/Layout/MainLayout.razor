@code {
    private bool isAuthorized = false;
    private bool hasRedirected = false;
    private string username = "";

    private string GetLastPathSegment(string uri)
    {
        // Get the absolute path, excluding the domain
        string absolutePath = new Uri(uri).AbsolutePath;

        // Check if the URI contains a query string
        int queryStringIndex = absolutePath.IndexOf('?');

        if (queryStringIndex != -1)
        {
            // Extract the substring before the query string
            return absolutePath.Substring(1, queryStringIndex - 1); // Skip the leading slash
        }

        // If no query string, return the last segment after the last slash
        string[] pathSegments = absolutePath.Split('/');
        return pathSegments.Length > 0 ? pathSegments[1] : absolutePath;
    }

    private string GetPathAfterDomain(string uri)
    {
        // Get the absolute path, excluding the domain
        string absolutePath = new Uri(uri).AbsolutePath.TrimStart('/');

        // Extract the portion after the domain and the initial "/"
        return absolutePath;
    }

    protected override async Task OnInitializedAsync()
    {
        var currentUrl = Nav.Uri;  // Get the current URI
        var uri = new Uri(currentUrl);
        var pathAfterDomain = uri.AbsolutePath;  // This gives you the path after the domain

        var isAllowAnonymous = CheckIfAllowAnonymous(pathAfterDomain);

        // If the page has [AllowAnonymous], don't check for authentication
        if (isAllowAnonymous)
        {
            return;
        }

        // Check for authentication state
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not { IsAuthenticated: true })
        {
            // User is not authenticated, redirect to the login page
            if (!hasRedirected)
            {
                Nav.NavigateTo("/login", forceLoad: true);
                hasRedirected = true;
            }
        }
        else
        {
            // User is authenticated, continue to the requested page
            isAuthorized = true;

            // Try to get username from claims
            username = user.Identity?.Name;

            // Or fallback to claim manually if needed
            if (string.IsNullOrEmpty(username))
            {
                username = user.Claims.FirstOrDefault(c =>
                    c.Type == "name" || c.Type == "unique_name" || c.Type == "sub")?.Value ?? "Unknown";
            }

            var isExpired = await Auth.IsTokenExpired();
            if (isExpired)
            {
                // Token is expired, log out and redirect to login
                await Auth.Logout();
                if (!hasRedirected)
                {
                    Nav.NavigateTo("/login", forceLoad: true);
                    hasRedirected = true;
                }
            }
        }

        StateHasChanged();
    }

    private bool CheckIfAllowAnonymous(string url)
    {
        // Allow this specific page
        if (url.Contains("/init/mainconcept") || url.Contains("/init/funnelend"))
        {
            return true;
        }

        // Block other /app and /init pages
        if (url.Contains("/app") || url.Contains("/init"))
        {
            return false;
        }

        return true;
    }
}
