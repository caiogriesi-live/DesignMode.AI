@inject NavigationManager Navigation
@inject DesignMode.AI.Client.Services.FunnelProgressService Progress
@implements IDisposable

@if (_failed)
{
    <div role="alert" style="position:fixed;bottom:16px;right:16px;z-index:10000;max-width:360px;padding:12px 16px;border:1px solid #e5b75c;border-radius:8px;background:#fff8e8;color:#5b4317;box-shadow:0 2px 8px #0002">
        Your progress could not be saved. <button type="button" @onclick="RetryAsync">Retry</button>
    </div>
}

@code {
    private bool _failed;
    private bool _disposed;
    private int _revision;
    protected override void OnInitialized() => Navigation.LocationChanged += LocationChanged;
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await SaveAsync(Navigation.Uri); }
    private async void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
        => await SaveAsync(args.Location);
    private Task RetryAsync() => SaveAsync(Navigation.Uri);
    private async Task SaveAsync(string location)
    {
        var revision = ++_revision;
        bool failed = false;
        try { await Progress.SaveAsync(location); }
        catch (Exception ex) { failed = true; Console.Error.WriteLine($"Funnel progress save failed: {ex.GetType().Name}"); }
        if (!_disposed && revision == _revision)
        {
            _failed = failed;
            await InvokeAsync(StateHasChanged);
        }
    }
    public void Dispose() { _disposed = true; Navigation.LocationChanged -= LocationChanged; }
}
